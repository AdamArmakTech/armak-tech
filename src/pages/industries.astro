---
/**
 * Industries — one section per sector (id = slug, matching homepage links /industries/#{slug}).
 * The sector → service mapping below is a general guide derived from each sector's `need`;
 * TODO(content): confirm sectors and typical systems with Armak.
 */
import { ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import PageCta from '../components/pages/PageCta.astro';
import { services } from '../data/site';
import { industries } from '../data/content';

const rows = industries.map((ind) => ({
  ...ind,
  services: ind.systems.map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean),
}));

const description =
  'Low-voltage, network and security systems for offices, healthcare, schools, retail, hospitality, multifamily and industrial sites in Southern California.';
---

<Base title="Industries · Southern California" description={description} footerCta={false}>
  <PageHero
    title="Buildings we plan for."
    lead="Every type of building has its own constraints, like operating hours, compliance rules and size. We plan each install around them, and the cabling behind every system goes in to ANSI/TIA standards."
    crumbs={[{ label: 'Industries' }]}
    tone="ink"
  >
    <nav class="jump" aria-label="Jump to an industry">
      <ul role="list" class="jump__list">
        {rows.map((r) => (
          <li>
            <a href={`#${r.slug}`} class="jump__link">
              {r.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </PageHero>

  <div class="sectors container">
    {rows.map((r) => (
      <section id={r.slug} class="sector" data-sheet aria-labelledby={`${r.slug}-title`}>
        <div class="sector__main">
          <h2 id={`${r.slug}-title`} class="t-h2 sector__name">{r.name}</h2>
          <p class="t-lead sector__need">{r.need}</p>
        </div>

        <div class="sector__systems">
          <p class="sector__systems-head">Typical systems</p>
          <ul role="list" class="sector__list">
            {r.services.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`} class="sector__svc">
                  <span class="t-mono sector__svc-code">{s.code}</span>
                  <span class="sector__svc-name">{s.name}</span>
                  <ArrowRight class="sector__svc-arrow" size={18} stroke-width={1.75} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <PageCta
    code="G-09"
    title="Tell us about your building."
    body="Don’t see your sector? Call anyway. We’ll walk the building with you, document what’s there and scope the job before anything is priced."
  />
</Base>

<style>
  /* ── Jump nav (on the ink band: inverse outlines) ── */
  .jump {
    width: 100%;
  }

  .jump__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  .jump__link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--steel-light);
    border-radius: var(--radius);
    color: var(--paper);
    font-size: var(--fs-small);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .jump__link:hover {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }

  /*
   * Direction A: each building type is one SHEET on the paper, with its typical systems as
   * ruled rows like a schedule (rule 5).
   */
  .sectors {
    display: grid;
    gap: var(--sp-5);
    padding-bottom: var(--space-section);
  }

  .sector {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
    padding: clamp(1.25rem, 0.5rem + 3.4vw, 4rem);
    background: var(--white);
    border: 1px solid var(--hairline);
    scroll-margin-top: calc(var(--header-h) + var(--sp-5));
  }

  .sector__main {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .sector__name {
    max-width: 14ch;
    font-size: var(--fs-h1);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
  }

  .sector__need {
    color: var(--text);
  }

  .sector__systems {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .sector__systems-head {
    font-size: var(--fs-small);
    color: var(--steel);
  }

  .sector__list {
    border-top: 1px solid var(--ink);
  }

  .sector__list li {
    border-bottom: 1px solid var(--hairline);
  }

  .sector__svc {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 56px;
    padding: 0.875rem 0.25rem;
    transition: background var(--dur-fast) ease;
  }

  .sector__svc:hover {
    background: var(--paper);
  }

  .sector__svc-code {
    color: var(--steel);
  }

  .sector__svc-name {
    font-weight: 500;
  }

  .sector__svc :global(.sector__svc-arrow) {
    color: var(--steel);
    transition: transform var(--dur) var(--ease-out), color var(--dur-fast) ease;
  }

  .sector__svc:hover :global(.sector__svc-arrow) {
    color: var(--ink);
    transform: translateX(3px);
  }

  @media (min-width: 640px) {
    .jump__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    /* On a phone the sheets run edge to edge, like pages laid on the desk */
    .sector {
      margin-inline: calc(var(--gutter) * -1);
      border-inline: 0;
    }
  }

  @media (min-width: 1024px) {
    .jump__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .sector {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .sector__main {
      grid-column: 1 / span 6;
    }

    .sector__systems {
      grid-column: 8 / -1;
      padding-top: 0.5rem;
    }
  }
</style>
