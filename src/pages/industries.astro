---
/**
 * Industries — one section per sector (id = slug, matching homepage links /industries/#{slug}).
 * The sector → service mapping below is a general guide derived from each sector's `need`;
 * TODO(content): confirm sectors and typical systems with Armak.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import PageCta from '../components/pages/PageCta.astro';
import { services } from '../data/site';
import { industries } from '../data/content';

const rows = industries.map((ind) => ({
  ...ind,
  services: ind.systems.map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean),
}));

const description =
  'Low-voltage, network and security systems for offices, healthcare, schools, retail, hospitality, multifamily and industrial sites in Southern California.';
---

<Base title="Industries · Southern California" description={description} footerCta={false}>
  <PageHero
    title="Buildings we plan for."
    lead="Every type of building has its own constraints, like operating hours, compliance rules and size. We plan each install around them, and the cabling behind every system goes in to ANSI/TIA standards."
    crumbs={[{ label: 'Industries' }]}
  >
    <nav class="jump" aria-label="Jump to an industry" data-reveal>
      <ul role="list" class="jump__list">
        {rows.map((r) => (
          <li>
            <a href={`#${r.slug}`} class="jump__link">
              {r.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </PageHero>

  <div class="sectors container">
    {rows.map((r) => (
      <section id={r.slug} class="sector" aria-labelledby={`${r.slug}-title`}>
        <h2 id={`${r.slug}-title`} class="t-h2 sector__name" data-split>{r.name}</h2>
        <div class="sector__body" data-reveal-group>
          <p class="t-lead sector__need">{r.need}</p>
          <p class="sector__systems">
            Typical systems:{' '}
            {r.services.map((s, i) => (
              <>
                <a href={`/services/${s.slug}/`} class="sector__svc">{s.name}</a>{i < r.services.length - 1 ? ', ' : '.'}
              </>
            ))}
          </p>
        </div>
      </section>
    ))}
  </div>

  <PageCta
    code="industries"
    title="Tell us about your building."
    body="Don’t see your sector? Call anyway. We’ll walk the building with you, document what’s there and scope the job before anything is priced."
  />
</Base>

<style>
  /* ── Jump nav ── */
  .jump {
    width: 100%;
  }

  .jump__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  .jump__link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    background: var(--paper-sunken);
    border-radius: var(--radius);
    font-size: var(--fs-small);
    transition: background var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .jump__link:hover {
      background: var(--ink);
      color: var(--paper);
    }
  }

  /* ── Sector rows: separated by space only ── */
  .sectors {
    padding-bottom: var(--space-block);
  }

  .sector {
    display: grid;
    gap: 1.25rem var(--col-gap);
    padding-block: clamp(2rem, 1.4rem + 2.5vw, 4rem);
    scroll-margin-top: calc(var(--header-h) + var(--sp-4));
  }

  .sector__name {
    max-width: 14ch;
  }

  .sector__body {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    min-width: 0;
  }

  .sector__need {
    color: var(--text);
    max-width: 38em;
  }

  .sector__systems {
    font-size: var(--fs-body);
    color: var(--text);
    max-width: 38em;
  }

  .sector__svc {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    padding-block: 0.6rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .sector__svc:hover {
      color: var(--signal);
    }
  }

  @media (min-width: 640px) {
    .jump__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .jump__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .sector {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .sector__name {
      grid-column: 1 / span 4;
    }

    .sector__body {
      grid-column: 5 / -1;
    }
  }
</style>
