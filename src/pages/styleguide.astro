---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import { site } from '../data/site';
import { CTA_LABEL } from '../lib/cta';

const colors = [
  { name: 'Paper', token: '--paper', hex: '#F4F3EF', use: 'Page background' },
  { name: 'Paper sunken', token: '--paper-sunken', hex: '#EBE9E3', use: 'Recessed areas, idle chips, outline buttons' },
  { name: 'White', token: '--white', hex: '#FFFFFF', use: 'Raised sheets (no border, no shadow)' },
  { name: 'Ink', token: '--ink', hex: '#0B0D10', use: 'Headings, selected chips, inverse surfaces' },
  { name: 'Text', token: '--text', hex: '#2B3039', use: 'Running text and leads' },
  { name: 'Steel', token: '--steel', hex: '#565E6B', use: 'Metadata only (t-meta)' },
  { name: 'Signal', token: '--signal', hex: '#D0101A', use: 'Primary buttons and FAIL only' },
  { name: 'Pass', token: '--pass', hex: '#167640', use: 'PASS only' },
];

const typeScale = [
  { cls: 't-display', name: 'Display', sample: 'Built for the future.' },
  { cls: 't-h1', name: 'H1', sample: 'Every run tested.' },
  { cls: 't-h2', name: 'H2', sample: 'Every port labeled.' },
  { cls: 't-h3', name: 'H3', sample: 'Structured cabling and fiber' },
  { cls: 't-lead', name: 'Lead', sample: 'We design, install and certify the low-voltage systems Southern California’s facilities run on.' },
  { cls: '', name: 'Body', sample: 'Every drop we install is tested end to end and documented, so your IT team inherits a system they can maintain.' },
  { cls: 't-meta', name: 'Meta (t-meta)', sample: 'Breadcrumbs, form labels, captions and quiet notes.' },
  { cls: 't-readout', name: 'Readout (t-readout)', sample: 'IDF2-A-024  92.4 m  PASS' },
];

const projectTypes = ['Structured cabling', 'Network and Wi-Fi', 'Cameras', 'Access control', 'Not sure yet'];

// Dev-only page. The style guide is for building the site, not for visitors (owner, 2026-11-05).
// In a production build it answers "204 No Content" (an empty answer), so Astro writes no file
// for it and nothing reaches the live site; `npm run dev` still serves it at /styleguide/.
// (A 404 answer would not do: Astro then writes the 404 page's HTML at this address.)
if (import.meta.env.PROD) return new Response(null, { status: 204 });
---

<Base title="Style guide" noindex>
  <section class="container sg-intro">
    <h1 class="t-h1" data-split>Style guide.</h1>
    <p class="t-lead">
      The pieces every page is built from. The rules behind them are in ai/DESIGN.md.
    </p>
  </section>

  <section class="container sg-block">
    <SectionHead title="Color" intro="Paper is the page. White is a raised sheet and paper-sunken is a recessed area; neither has a border. Red marks the one next action, plus FAIL." split={false} />
    <ul role="list" class="swatches">
      {colors.map((c) => (
        <li class="swatch">
          <span class="swatch__chip" style={`background: var(${c.token})`} />
          <span class="swatch__name">{c.name}</span>
          <span class="t-meta">{c.hex}</span>
          <span class="t-small">{c.use}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container sg-block">
    <SectionHead title="Type" intro="Geist Sans for everything people read. Geist Mono only for what a technician reads off a tester or a drawing." split={false} />
    <ul role="list" class="type-list">
      {typeScale.map((t) => (
        <li class="type-row">
          <span class="t-meta type-row__name">{t.name}</span>
          <p class={t.cls}>{t.sample}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container sg-block">
    <SectionHead title="Buttons" split={false} />
    <div class="sg-grid-2">
      <div class="sg-panel">
        <p class="t-meta">On paper</p>
        <div class="sg-wrap">
          <Button>{CTA_LABEL}</Button>
          <Button variant="ink">Ink</Button>
          <Button variant="outline" icon="none">Outline</Button>
          <Button variant="link">Text link</Button>
          <Button variant="outline" icon="phone" href={site.phoneHref}>{site.phone}</Button>
        </div>
      </div>
      <div class="sg-panel sg-panel--ink surface-ink">
        <p class="t-meta">On ink</p>
        <div class="sg-wrap">
          <Button>Primary</Button>
          <Button variant="outline-inverse" icon="none">Outline</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="container sg-block">
    <SectionHead title="Form" intro="Chips are filled: paper-sunken idle, ink selected. Fields have an underline and a plain label above." split={false} />
    <form class="sg-form">
      <fieldset class="sg-form__chips">
        <legend class="field__label">What are you building?</legend>
        <div class="sg-wrap">
          {projectTypes.map((p, i) => (
            <label class="chip"><input type="checkbox" name="type" value={p} checked={i === 0} /><span>{p}</span></label>
          ))}
        </div>
      </fieldset>
      <div class="sg-form__fields">
        <label class="field"><span class="field__label">Name</span><input class="field__control" placeholder="Jane Cooper" /></label>
        <label class="field"><span class="field__label">Email</span><input class="field__control" type="email" placeholder="jane@company.com" /></label>
        <label class="field sg-form__full"><span class="field__label">Project details</span><textarea class="field__control" placeholder="Site location, size, timeline."></textarea></label>
      </div>
      <Button variant="primary" size="lg" type="submit">Send my request</Button>
    </form>
  </section>
</Base>

<script>
  // Demo form only: never submit (no inline handler, so it works under the site CSP)
  document.querySelectorAll<HTMLFormElement>('.sg-form').forEach((f) =>
    f.addEventListener('submit', (e) => e.preventDefault()),
  );
</script>

<style>
  .sg-intro {
    display: grid;
    gap: 2rem;
    justify-items: start;
    padding-block: clamp(3rem, 2rem + 5vw, 7rem) var(--space-block);
  }

  .sg-block {
    padding-block: var(--space-block);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1.5rem var(--col-gap);
  }

  .swatch {
    display: grid;
    gap: 0.25rem;
  }

  .swatch__chip {
    height: 96px;
    border-radius: var(--radius);
    margin-bottom: 0.5rem;
  }

  .swatch__name {
    font-weight: 600;
  }

  .type-list {
    display: grid;
    gap: var(--sp-6);
  }

  .type-row {
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 900px) {
    .type-row {
      grid-template-columns: 3fr 9fr;
      align-items: baseline;
      column-gap: var(--col-gap);
    }
  }

  .sg-grid-2 {
    display: grid;
    gap: var(--col-gap);
  }

  @media (min-width: 900px) {
    .sg-grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sg-panel {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding: 1.5rem;
    background: var(--white);
    border-radius: var(--radius);
  }

  .sg-panel--ink {
    background: var(--ink);
  }

  .sg-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .sg-form {
    display: grid;
    gap: 2.5rem;
    justify-items: start;
    max-width: 860px;
    padding: clamp(1.5rem, 1rem + 2vw, 3rem);
    background: var(--white);
    border-radius: var(--radius);
  }

  .sg-form__chips {
    border: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .sg-form__fields {
    display: grid;
    gap: 2rem var(--col-gap);
    width: 100%;
  }

  @media (min-width: 640px) {
    .sg-form__fields {
      grid-template-columns: 1fr 1fr;
    }

    .sg-form__full {
      grid-column: 1 / -1;
    }
  }
</style>
