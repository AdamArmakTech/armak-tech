---
/**
 * Service detail template — one page per entry in `services` (src/data/site.ts),
 * with rich copy from src/data/services-detail.ts. Adding a service = one entry in each.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import PhotoBand from '../../components/services/PhotoBand.astro';
import Capabilities from '../../components/services/Capabilities.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import PartnerLogos from '../../components/services/PartnerLogos.astro';
import FaqList from '../../components/services/FaqList.astro';
import OtherServices from '../../components/services/OtherServices.astro';
import TermPopover from '../../components/glossary/TermPopover.astro';
import ServiceCta from '../../components/services/ServiceCta.astro';
import JsonLd from '../../components/ui/JsonLd.astro';
import { services, site, serviceArea, type Service } from '../../data/site';
import { businessProvider } from '../../data/seo';
import { servicesDetail, servicePhotos } from '../../data/services-detail';
import { partners } from '../../data/content';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const detail = servicesDetail[service.slug];
const photo = servicePhotos[service.slug];
const hasPartners = partners.some((p) => detail.partnerCategories.includes(p.category));
const pageUrl = new URL(`/services/${service.slug}/`, site.url).href;

/* ── Structured data ── */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: service.name,
      serviceType: service.name,
      description: detail.metaDescription,
      url: pageUrl,
      provider: businessProvider,
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Southern California' },
        ...serviceArea.map((c) => ({ '@type': 'City', name: `${c.name}, CA` })),
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: service.name,
        itemListElement: detail.capabilities.map((c) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: c.title, description: c.body },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: detail.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
        { '@type': 'ListItem', position: 3, name: service.name, item: pageUrl },
      ],
    },
  ],
};
---

<Base
  title={detail.title}
  description={detail.metaDescription}
  footerCta={false}
>
  <JsonLd data={jsonLd} slot="head" />

  <ServiceHero service={service} detail={detail} />

  {photo && <PhotoBand photo={photo} testCard={service.slug === 'structured-cabling'} />}

  <Capabilities serviceName={service.name} items={detail.capabilities} />

  <section class="section section--tight how-we-run">
    <div class="container">
      <SectionHead
        title="Five steps, every job."
        intro="The same process from a single-rack retrofit to a multi-site rollout. Nothing is signed off until it has been tested and documented."
      >
        <a class="how-we-run__link" href="/#process">See how every job runs</a>
      </SectionHead>
    </div>
  </section>

  {hasPartners && <PartnerLogos categories={detail.partnerCategories} />}

  <FaqList faqs={detail.faqs} serviceName={service.name} />

  <TermPopover />

  <ServiceCta
    about={service.slug}
    title="Talk to us about your project."
    body="Tell us about the site. We’ll walk it with you, document what’s there and scope the job before anything is priced."
  />

  <OtherServices current={service.slug} />
</Base>

<style>
  .how-we-run__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--sp-4);
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .how-we-run__link:hover {
    color: var(--signal);
  }
</style>
