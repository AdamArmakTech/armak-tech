---
/** Services overview — every service as a full-width row, linking to its detail page. */
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Label from '../../components/ui/Label.astro';
import Button from '../../components/ui/Button.astro';
import SpecStrip from '../../components/ui/SpecStrip.astro';
import DeliverySteps from '../../components/services/DeliverySteps.astro';
import ServiceCta from '../../components/services/ServiceCta.astro';
import { services, site, FOUNDED, yearsInBusiness } from '../../data/site';
import { credentials } from '../../data/content';
// TODO(photo): replace with a real Armak install photo
import heroPhoto from '../../assets/photos/data-hall.webp';

const description =
  'Structured cabling, networking, video surveillance, access control, VoIP and AV — designed, installed and supported across Southern California since 1998.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${site.name} services`,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: new URL(`/services/${s.slug}/`, site.url).href,
  })),
};
---

<Base title="Low-Voltage, Networking & Security Services" description={description} footerCta={false}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="svc-index-hero container" aria-labelledby="services-title">
    <div class="svc-index-hero__copy">
      <Label code="A-00">Services</Label>
      <h1 id="services-title" class="t-h1 svc-index-hero__title">Every low-voltage system, one standard.</h1>
      <p class="t-lead" data-reveal>
        Cabling, networks, cameras, doors, voice and AV — designed, installed, certified and supported by
        one Southern California team for {yearsInBusiness} years. One crew, one point of contact, from the
        first conduit to the final report.
      </p>
      <div class="svc-index-hero__ctas" data-reveal style="--reveal-delay: 120ms">
        <Button href="/contact/" size="lg">Request a site assessment</Button>
        <Button href={site.phoneHref} variant="outline" size="lg" icon="phone">{site.phone}</Button>
      </div>
    </div>
    <figure class="svc-index-hero__media" data-reveal style="--reveal-delay: 150ms">
      <Image
        src={heroPhoto}
        alt="An aisle of network cabinets with color-coded patching in a data hall"
        widths={[560, 840, 1120]}
        sizes="(min-width: 1000px) 40vw, 100vw"
        loading="eager"
      />
      <span class="svc-index-hero__tag t-mono">Fig. A-00 · Data hall</span>
    </figure>
    <SpecStrip
      class="svc-index-hero__spec"
      items={[`Est. ${FOUNDED}`, `${site.hq.city} HQ`, `${services.length} disciplines`, 'Serving all of Southern California']}
    />
  </section>

  <section class="svc-list container" aria-label="All services">
    <ol role="list" class="svc-list__rows">
      {services.map((s) => (
        <li class="svc-row" data-reveal>
          <a class="svc-row__link" href={`/services/${s.slug}/`}>
            <span class="svc-row__code">{s.code}</span>
            <div class="svc-row__main">
              <span class="t-mono svc-row__layer">{s.layer}</span>
              <h2 class="svc-row__name">{s.name}</h2>
              <p class="svc-row__short t-muted">{s.short}</p>
            </div>
            <div class="svc-row__includes">
              <p class="visually-hidden">Includes:</p>
              <ul role="list" class="t-mono">
                {s.includes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <span class="svc-row__go" aria-hidden="true">
              <span class="t-mono svc-row__go-label">Explore</span>
              <span class="svc-row__go-icon"><ArrowRight size={20} stroke-width={1.75} /></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="creds container" aria-label="Credentials">
    <ul role="list" class="creds__list" data-reveal-stagger="80">
      {credentials.map((c, i) => (
        <li class="creds__item" data-reveal>
          <span class="t-mono creds__index">C-{String(i + 1).padStart(2, '0')}</span>
          <span class="creds__text">{c}</span>
        </li>
      ))}
    </ul>
  </section>

  <DeliverySteps code="A-00.1" />

  <ServiceCta
    code="A-00.2"
    title="Not sure where to start?"
    body="Most projects touch more than one system. Tell us about the site — we’ll walk it with you, document what’s there and scope the job before anything is priced."
  />
</Base>

<style>
  /* ── Hero ── */
  .svc-index-hero {
    display: grid;
    gap: var(--space-block);
    padding-top: clamp(2rem, 1.2rem + 3.5vw, 5rem);
    padding-bottom: var(--space-block);
  }

  .svc-index-hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .svc-index-hero__title {
    max-width: 13ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-index-hero__title {
      animation: svc-index-in 1.1s var(--ease-out) both;
    }
  }

  @keyframes svc-index-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .svc-index-hero__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .svc-index-hero__media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .svc-index-hero__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.55rem;
    background: var(--paper);
    border-radius: var(--radius);
  }

  .svc-index-hero :global(.svc-index-hero__spec) {
    grid-column: 1 / -1;
  }

  @media (min-width: 1000px) {
    .svc-index-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: end;
    }

    .svc-index-hero__copy {
      grid-column: 1 / span 7;
    }

    .svc-index-hero__media {
      grid-column: 8 / -1;
    }

    .svc-index-hero__media img {
      aspect-ratio: 4 / 5;
      max-height: 34rem;
    }
  }

  .svc-index-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Service rows ── */
  .svc-list__rows {
    border-top: 1px solid var(--ink);
  }

  .svc-row {
    border-bottom: 1px solid var(--hairline);
  }

  .svc-row__link {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 2rem 2.25rem;
    transition: background var(--dur) ease;
  }

  .svc-row__code {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 1rem + 2vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--hairline-strong);
    transition: color var(--dur) ease;
  }

  .svc-row__main {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .svc-row__layer {
    color: var(--signal);
  }

  .svc-row__name {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: var(--lh-heading);
  }

  .svc-row__short {
    max-width: 34em;
  }

  .svc-row__includes ul {
    display: grid;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--steel);
  }

  .svc-row__includes li {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--hairline);
  }

  .svc-row__includes li::before {
    content: "";
    flex: none;
    width: 5px;
    height: 5px;
    border: 1px solid var(--hairline-strong);
    transform: translateY(-1px);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .svc-row__go {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 500;
  }

  .svc-row__go-label {
    color: var(--steel);
  }

  .svc-row__go-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    transition: background var(--dur-fast) ease, color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .svc-row__link:hover .svc-row__code {
    color: var(--ink);
  }

  .svc-row__link:hover .svc-row__go-icon {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--white);
  }

  .svc-row__link:hover .svc-row__includes li::before {
    background: var(--ink);
    border-color: var(--ink);
  }

  .svc-row__link:hover .svc-row__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 760px) {
    .svc-row__link {
      grid-template-columns: 5.5rem minmax(0, 1fr) minmax(0, 0.8fr);
      column-gap: var(--col-gap);
      align-items: start;
    }

    .svc-row__code {
      grid-row: span 2;
    }

    .svc-row__go {
      grid-column: 2 / -1;
    }
  }

  @media (min-width: 1100px) {
    .svc-row__link {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      padding-block: 2.75rem;
    }

    .svc-row__code {
      grid-column: 1 / span 2;
      grid-row: auto;
    }

    .svc-row__main {
      grid-column: 3 / span 5;
    }

    .svc-row__includes {
      grid-column: 8 / span 4;
    }

    .svc-row__go {
      grid-column: 12 / -1;
      justify-content: flex-end;
      align-self: start;
    }

    .svc-row__go-label {
      display: none;
    }
  }

  /* ── Credentials ── */
  .creds {
    padding-block: var(--space-block);
  }

  .creds__list {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .creds__item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .creds__index {
    color: var(--signal);
  }

  .creds__text {
    font-size: var(--fs-h4);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (min-width: 900px) {
    .creds__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--hairline);
    }

    .creds__item {
      padding: 1.5rem 1.5rem;
      border-bottom: 0;
      border-left: 1px solid var(--hairline);
    }

    .creds__item:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
