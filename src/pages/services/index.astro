---
/** Services overview — every service as a full-width row, linking to its detail page. */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import SpecStrip from '../../components/ui/SpecStrip.astro';
import JsonLd from '../../components/ui/JsonLd.astro';
import { contactHref, CTA_LABEL } from '../../lib/cta';
import DeliverySteps from '../../components/services/DeliverySteps.astro';
import ServiceCta from '../../components/services/ServiceCta.astro';
import { services, site, FOUNDED, yearsInBusiness } from '../../data/site';
import { credentials } from '../../data/content';
// TODO(photo): replace with a real Armak install photo
import heroPhoto from '../../assets/photos/camera-ceiling.jpg';

const description = `Structured cabling, networking, video surveillance, access control, VoIP and AV, designed, installed and supported across Southern California since ${FOUNDED}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${site.name} services`,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: new URL(`/services/${s.slug}/`, site.url).href,
  })),
};
---

<Base title="Low-Voltage, Network & Security Services" description={description} footerCta={false}>
  <JsonLd data={jsonLd} slot="head" />

  <section class="svc-index-hero container" aria-labelledby="services-title">
    <div class="svc-index-hero__copy">
      <h1 id="services-title" class="t-h1 svc-index-hero__title">Six systems, one team.</h1>
      <p class="t-lead" data-reveal>
        Cabling, networks, cameras, doors, voice and AV, designed, installed, tested and supported by one
        Southern California team for {yearsInBusiness} years. You get one point of contact from the first
        walk-through to the final report.
      </p>
      <div class="svc-index-hero__ctas" data-dock-start data-reveal>
        <Button href={contactHref()} size="lg">{CTA_LABEL}</Button>
        <Button href={site.phoneHref} variant="outline" size="lg" icon="phone">{site.phone}</Button>
      </div>
    </div>
    <figure class="svc-index-hero__media">
      <Image
        src={heroPhoto}
        alt="A white bullet-style security camera on a mounting plate fixed to a ceiling, with a dome camera housing beside it"
        widths={[560, 840, 1120]}
        sizes="(min-width: 1000px) 40vw, 100vw"
        loading="eager"
      />
    </figure>
    <SpecStrip
      class="svc-index-hero__spec"
      items={[`Est. ${FOUNDED}`, `${site.hq.city} HQ`, `${services.length} disciplines`, 'Serving all of Southern California']}
    />
  </section>

  <section class="svc-list container" aria-label="All services">
    <ol role="list" class="svc-list__rows">
      {services.map((s) => (
        <li class="svc-row">
          <a class="svc-row__link" href={`/services/${s.slug}/`}>
            <h2 class="svc-row__name" data-split>{s.name}</h2>
            <p class="svc-row__short" data-reveal>{s.short}</p>
            <ul role="list" class="t-meta svc-row__includes" aria-label="Includes" data-reveal>
              {s.includes.map((item) => <li>{item}</li>)}
            </ul>
            <span class="svc-row__go" data-reveal="fade">See service</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="creds container" aria-label="What you get">
    <ul role="list" class="creds__list" data-reveal-group data-reveal-step="50">
      {credentials.map((c) => (
        <li class="creds__item">
          <span class="creds__text">{c}</span>
        </li>
      ))}
    </ul>
  </section>

  <DeliverySteps />

  <ServiceCta
    title="Start with a site walk."
    body="Most projects touch more than one system. Tell us about the site. We’ll walk it with you, document what’s there and scope the job before anything is priced."
  />
</Base>

<style>
  /* ── Hero ── */
  .svc-index-hero {
    display: grid;
    gap: var(--space-block);
    padding-top: clamp(2rem, 1.2rem + 3.5vw, 5rem);
    padding-bottom: var(--space-block);
  }

  .svc-index-hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .svc-index-hero__title {
    max-width: 13ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-index-hero__title {
      animation: svc-index-in 1.1s var(--ease-out) both;
    }

    /* The photo wipes up as the page opens. CSS-only, like the title, so this eager image never waits on a script */
    .svc-index-hero__media {
      animation: svc-media-in 1s var(--ease-out) 120ms both;
    }
  }

  @keyframes svc-media-in {
    from {
      clip-path: inset(100% 0 0 0);
      transform: translate3d(0, 12px, 0);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: none;
    }
  }

  @keyframes svc-index-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .svc-index-hero__media {
    position: relative;
  }

  .svc-index-hero__media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    /* The camera sits low in this tall photo; keep it in frame when the crop is wide */
    object-position: center 72%;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .svc-index-hero :global(.svc-index-hero__spec) {
    grid-column: 1 / -1;
  }

  @media (min-width: 1000px) {
    .svc-index-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: end;
    }

    .svc-index-hero__copy {
      grid-column: 1 / span 7;
    }

    .svc-index-hero__media {
      grid-column: 8 / -1;
    }

    .svc-index-hero__media img {
      aspect-ratio: 4 / 5;
      max-height: 34rem;
    }
  }

  .svc-index-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Service rows: separated by space, no lines */
  .svc-list__rows {
    display: grid;
    gap: var(--sp-8);
  }

  .svc-row__link {
    display: grid;
    gap: var(--sp-3);
    max-width: 44rem;
    align-content: start;
  }

  .svc-row__name {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: var(--lh-heading);
  }

  .svc-row__short {
    max-width: 34em;
    color: var(--text);
  }

  .svc-row__go {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  @media (hover: hover) and (pointer: fine) {
    .svc-row__link:hover .svc-row__name {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
    }
  }

  @media (min-width: 900px) {
    .svc-list__rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-8) var(--sp-9);
    }
  }

  /* Credentials: plain statements, no borders */
  .creds {
    padding-block: var(--space-block);
  }

  .creds__list {
    display: grid;
    gap: var(--sp-4);
  }

  .creds__text {
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .creds__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-6);
    }
  }
  .svc-row__includes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
</style>
