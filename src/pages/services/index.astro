---
/** Services overview — every service as a full-width row, linking to its detail page. */
import { ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import SpecStrip from '../../components/ui/SpecStrip.astro';
import DeliverySteps from '../../components/services/DeliverySteps.astro';
import ServiceCta from '../../components/services/ServiceCta.astro';
import { services, site, FOUNDED, yearsInBusiness } from '../../data/site';
import { credentials } from '../../data/content';

const description = `Structured cabling, networking, video surveillance, access control, VoIP and AV, designed, installed and supported across Southern California since ${FOUNDED}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${site.name} services`,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: new URL(`/services/${s.slug}/`, site.url).href,
  })),
};
---

<Base title="Low-Voltage, Network & Security Services" description={description} footerCta={false}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <section class="svc-index-hero container" aria-labelledby="services-title">
    <div class="svc-index-hero__copy">
      <h1 id="services-title" class="t-h1 svc-index-hero__title">Every low-voltage system, from one team.</h1>
      <p class="t-lead" data-reveal>
        Cabling, networks, cameras, doors, voice and AV, designed, installed, tested and supported by one
        Southern California team for {yearsInBusiness} years. You get one point of contact from the first
        walk-through to the final report.
      </p>
      <div class="svc-index-hero__ctas" data-dock-start>
        <Button href="/contact/" size="lg">Request a site assessment</Button>
        <Button href={site.phoneHref} variant="outline" size="lg" icon="phone">{site.phone}</Button>
      </div>
    </div>
    <nav class="svc-index-hero__index" aria-label="Services index">
      <ol role="list">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`}>
              <span class="t-mono svc-index-hero__idx-code">{s.code}</span>
              <span class="svc-index-hero__idx-name">{s.name}</span>
              <span class="svc-index-hero__idx-go">See service <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" /></span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <SpecStrip
      class="svc-index-hero__spec"
      items={[`Est. ${FOUNDED}`, `${site.hq.city} HQ`, `${services.length} disciplines`, 'Serving all of Southern California']}
    />
  </section>

  <section class="svc-list container" aria-label="All services">
    <ol role="list" class="svc-list__rows">
      {services.map((s) => (
        <li class="svc-row">
          <a class="svc-row__link" href={`/services/${s.slug}/`}>
            <span class="svc-row__code">{s.code}</span>
            <div class="svc-row__main">
              <span class="svc-row__layer">{s.layer}</span>
              <h2 class="svc-row__name">{s.name}</h2>
              <p class="svc-row__short t-muted">{s.short}</p>
            </div>
            <div class="svc-row__includes">
              <p class="visually-hidden">Includes:</p>
              <ul role="list">
                {s.includes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <span class="svc-row__go" aria-hidden="true">
              <span class="svc-row__go-label">See service</span>
              <span class="svc-row__go-icon"><ArrowRight size={20} stroke-width={1.75} /></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="creds container" aria-label="Credentials">
    <ul role="list" class="creds__list">
      {credentials.map((c) => (
        <li class="creds__item">
          <span class="creds__text">{c}</span>
        </li>
      ))}
    </ul>
  </section>

  <DeliverySteps />

  <ServiceCta
    title="Start with a site walk."
    body="Most projects touch more than one system. Tell us about the site. We’ll walk it with you, document what’s there and scope the job before anything is priced."
  />
</Base>

<style>
  /* ── Hero ── */
  .svc-index-hero {
    display: grid;
    gap: var(--space-block);
    padding-top: clamp(2rem, 1.2rem + 3.5vw, 5rem);
    padding-bottom: var(--space-block);
  }

  .svc-index-hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .svc-index-hero__title {
    max-width: 13ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-index-hero__title {
      animation: svc-index-in 1.1s var(--ease-out) both;
    }
  }

  @keyframes svc-index-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .svc-index-hero__index {
    border-top: 1px solid var(--ink);
  }

  .svc-index-hero__index a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--sp-3);
    padding-block: var(--sp-3);
    min-height: 44px;
    border-bottom: 1px solid var(--hairline);
  }

  .svc-index-hero__idx-code {
    color: var(--steel);
  }

  .svc-index-hero__idx-name {
    font-weight: 600;
    color: var(--ink);
  }

  .svc-index-hero__idx-go {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-size: var(--fs-small);
    color: var(--steel);
  }

  .svc-index-hero__index a:hover .svc-index-hero__idx-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 420px) {
    .svc-index-hero__idx-go {
      display: none;
    }

    .svc-index-hero__index a {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
  }

  .svc-index-hero :global(.svc-index-hero__spec) {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .svc-index-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: end;
    }

    .svc-index-hero__copy {
      grid-column: 1 / span 7;
    }

    .svc-index-hero__index {
      grid-column: 8 / -1;
    }
  }

  .svc-index-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Service rows ── */
  .svc-list__rows {
    border-top: 1px solid var(--ink);
  }

  .svc-row {
    border-bottom: 1px solid var(--hairline);
  }

  .svc-row__link {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 2rem 2.25rem;
    transition: background var(--dur) ease;
  }

  .svc-row__code {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 1rem + 2vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--steel);
    transition: color var(--dur) ease;
  }

  .svc-row__main {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .svc-row__layer {
    font-size: var(--fs-small);
    color: var(--steel);
  }

  .svc-row__name {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: var(--lh-heading);
  }

  .svc-row__short {
    max-width: 34em;
  }

  .svc-row__includes ul {
    display: grid;
    font-size: var(--fs-small);
    color: var(--steel);
  }

  .svc-row__includes li {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--hairline);
  }

  .svc-row__includes li::before {
    content: "";
    flex: none;
    width: 5px;
    height: 5px;
    border: 1px solid var(--hairline-strong);
    transform: translateY(-1px);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .svc-row__go {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 500;
  }

  .svc-row__go-label {
    font-size: var(--fs-small);
    color: var(--steel);
  }

  .svc-row__go-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    transition: background var(--dur-fast) ease, color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .svc-row__link:hover .svc-row__code {
    color: var(--ink);
  }

  .svc-row__link:hover .svc-row__go-icon {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .svc-row__link:hover .svc-row__includes li::before {
    background: var(--ink);
    border-color: var(--ink);
  }

  .svc-row__link:hover .svc-row__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 640px) {
    .svc-row__link {
      grid-template-columns: 5.5rem minmax(0, 1fr) minmax(0, 0.8fr);
      column-gap: var(--col-gap);
      align-items: start;
    }

    .svc-row__code {
      grid-row: span 2;
    }

    .svc-row__go {
      grid-column: 2 / -1;
    }
  }

  @media (min-width: 1024px) {
    .svc-row__link {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      padding-block: 2.75rem;
    }

    .svc-row__code {
      grid-column: 1 / span 2;
      grid-row: auto;
    }

    .svc-row__main {
      grid-column: 3 / span 5;
    }

    .svc-row__includes {
      grid-column: 8 / span 4;
    }

    .svc-row__go {
      grid-column: 12 / -1;
      justify-content: flex-end;
      align-self: start;
    }

    .svc-row__go-label {
      display: none;
    }
  }

  /* ── Credentials ── */
  .creds {
    padding-block: var(--space-block);
  }

  .creds__list {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .creds__item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .creds__text {
    font-size: var(--fs-h4);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (min-width: 1024px) {
    .creds__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--hairline);
    }

    .creds__item {
      padding: 1.5rem 1.5rem;
      border-bottom: 0;
      border-left: 1px solid var(--hairline);
    }

    .creds__item:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
