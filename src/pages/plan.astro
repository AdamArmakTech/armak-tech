---
/**
 * /plan/ — practical tools for people who are still figuring a project out:
 * a "before we visit" checklist (printable), a rough quantity estimator, a 3-question cabling
 * check and a sample certification report. Ends in the dark closing band.
 * Numbers here are planning rules of thumb, never a quote.
 */
import { Printer } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import PageCta from '../components/pages/PageCta.astro';
import CableTest from '../components/ui/CableTest.astro';
import CableCompare from '../components/plan/CableCompare.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';
import { contactHref } from '../lib/cta';

const description =
  'Planning a cabling, network or security project in Southern California? Use the site-walk checklist, a rough quantity estimator and a quick cabling check before you call anyone.';

const checklist = [
  { title: 'Floor plans, or a sketch', detail: 'Even a phone photo of the fire-evacuation map on the wall works.' },
  { title: 'Where the internet comes in', detail: 'Your provider, and where the modem or router lives.' },
  { title: 'Access to the closet and the ceiling', detail: 'The network closet or server room, plus who can let us in and where a ladder can go.' },
  { title: 'What’s there now', detail: 'Switches, phones, cameras, door readers, Wi-Fi access points. Photos are fine.' },
  { title: 'Headcount, now and in 2–3 years', detail: 'Desks today, planned hires, any moves or expansions.' },
  { title: 'Known problems', detail: 'Dead Wi-Fi spots, slow areas, doors that don’t lock, cameras that don’t record.' },
  { title: 'Building rules', detail: 'After-hours access, landlord requirements, hours when noisy work isn’t OK.' },
  { title: 'Who decides, and who runs IT day to day', detail: 'So the plan goes to the right people the first time.' },
];

const upgradeQuestions = [
  {
    name: 'cable',
    label: 'What’s printed on your network cables? (Look at the jacket near a wall jack.)',
    options: [
      ['5e', 'Cat 5e'],
      ['6', 'Cat 6'],
      ['6a', 'Cat 6A'],
      ['unknown', 'I can’t tell'],
    ],
  },
  {
    name: 'age',
    label: 'How old is the cabling?',
    options: [
      ['new', 'Under 5 years'],
      ['mid', '5 to 10 years'],
      ['old', 'Over 10 years, or no idea'],
    ],
  },
  {
    name: 'symptoms',
    label: 'Any of these happening?',
    options: [
      ['none', 'No, it works fine'],
      ['slow', 'Slow spots or weak Wi-Fi'],
      ['drops', 'Connections that drop or flap'],
    ],
  },
];
---

<Base title="Plan a Project: Checklist, Estimator & Cabling Check" description={description} footerCta={false}>
  <PageHero
    title="Start with the practical bits."
    lead="Three tools for the planning stage: what to have ready before anyone visits, a rough idea of quantities, and a quick check on whether your cabling is due for an upgrade."
    crumbs={[{ label: 'Plan a project' }]}
  >
    <nav class="plan__jump" aria-label="On this page">
      <a href="#checklist">Checklist</a>
      <a href="#estimator">Estimator</a>
      <a href="#upgrade">Cabling check</a>
      <a href="#which-cable">Which cable?</a>
      <a href="#sample-report">Sample report</a>
    </nav>
  </PageHero>

  <div class="plan container">
    <!-- ── Checklist ── -->
    <section class="plan__section plan__checklist" id="checklist" data-sheet aria-label="The site-walk checklist">
      <SectionHead title="The site-walk checklist." intro="Have these ready and the first visit does the work of two." />
      <div class="plan__body">
      <ol role="list" class="checklist">
        {checklist.map((item, i) => (
          <li class="checklist__item">
            <span class="checklist__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="checklist__text">
              <span class="checklist__title">{item.title}</span>
              <span class="checklist__detail">{item.detail}</span>
            </span>
          </li>
        ))}
      </ol>
      <div class="plan__tools">
        <button type="button" class="plan__print" data-print-checklist>
          <Printer size={18} stroke-width={1.75} aria-hidden="true" />
          Print or save as PDF
        </button>
        <p class="t-small t-muted plan__printnote">Printed from armak.tech/plan · {site.phone}</p>
      </div>
      </div>
    </section>

    <!-- ── Estimator ── -->
    <section class="plan__section" data-sheet id="estimator" aria-label="Estimate quantities for your office">
      <SectionHead title="Estimate quantities for your office." intro="Planning numbers from typical office layouts. Walls, ceiling height and how you use the space change them; the real count comes from the site walk." />

      <div class="plan__body">
      <form class="est" data-estimator>
        <div class="est__inputs">
          <label class="field">
            <span class="field__label">Floor area (sq ft)</span>
            <input class="field__control" type="number" autocomplete="off" inputmode="numeric" min="200" max="500000" step="100" value="5000" name="sqft" />
          </label>
          <label class="field">
            <span class="field__label">Desks or workstations</span>
            <input class="field__control" type="number" autocomplete="off" inputmode="numeric" min="0" max="5000" value="20" name="desks" />
          </label>
          <label class="field">
            <span class="field__label">Floors</span>
            <input class="field__control" type="number" autocomplete="off" inputmode="numeric" min="1" max="50" value="1" name="floors" />
          </label>
          <label class="field">
            <span class="field__label">Exterior doors</span>
            <input class="field__control" type="number" autocomplete="off" inputmode="numeric" min="0" max="100" value="2" name="doors" />
          </label>
        </div>

        <dl class="est__out" aria-live="polite">
          <div class="est__row">
            <dt>Data drops <a class="est__term" href="/glossary/#drop">what’s a drop?</a></dt>
            <dd><span data-out="drops">—</span></dd>
            <dd class="est__how">2 per desk, plus shared devices (printers, TVs) and ceiling devices.</dd>
          </div>
          <div class="est__row">
            <dt>Wi-Fi access points <a class="est__term" href="/glossary/#access-point">what’s that?</a></dt>
            <dd><span data-out="aps">—</span></dd>
            <dd class="est__how">About one per 2,000 sq ft of open office, at least one per floor. Walls and dense seating need more.</dd>
          </div>
          <div class="est__row">
            <dt>Cameras <a class="est__term" href="/glossary/#ip-camera">what’s covered?</a></dt>
            <dd><span data-out="cams">—</span></dd>
            <dd class="est__how">A starting point: every exterior door, the lobby, and the main corridor on each floor.</dd>
          </div>
          <div class="est__row">
            <dt>Door readers <a class="est__term" href="/glossary/#card-reader">what’s that?</a></dt>
            <dd><span data-out="readers">—</span></dd>
            <dd class="est__how">One per controlled door. Interior doors (server room, storage) add to this.</dd>
          </div>
        </dl>
      </form>
      <div class="est__send">
        <p class="t-small t-muted est__plan">Want these numbers checked against your actual floor? <a class="plan__link" href="/contact/?about=estimate#form">Send us your plan</a> and we’ll scope it.</p>
        <Button variant="ink" size="lg" href={contactHref({ about: 'structured-cabling' })} data-est-send>Send these numbers with my request</Button>
      </div>
      </div>
    </section>

    <!-- ── Cabling check ── -->
    <section class="plan__section" data-sheet id="upgrade" aria-label="Check the age of your cabling">
      <SectionHead title="Check the age of your cabling." />
      <div class="plan__body">
      <form class="quiz" data-upgrade-check>
        {upgradeQuestions.map((q) => (
          <fieldset class="quiz__q">
            <legend class="quiz__legend">{q.label}</legend>
            <div class="quiz__options">
              {q.options.map(([value, label]) => (
                <label class="chip"><input type="radio" name={q.name} value={value} /><span>{label}</span></label>
              ))}
            </div>
          </fieldset>
        ))}
        <div class="quiz__result" data-quiz-result hidden aria-live="polite">
          <p class="quiz__verdict" data-quiz-verdict></p>
          <p class="quiz__why" data-quiz-why></p>
        </div>
      </form>
      </div>
    </section>

    <!-- ── Which cable? ── -->
    <section class="plan__section plan__section--wide" id="which-cable" aria-label="Which cable?" data-sheet>
      <SectionHead title="Which cable?" intro="Four common choices, what each one can do, and when it makes sense." />
      <div class="plan__body">
        <CableCompare />
      </div>
    </section>
  </div>

  <!-- ── Sample report: the one blue field on the page ── -->
  <section class="plan-report" id="sample-report" aria-label="A sample certification report">
    <div class="container plan-report__layout">
      <SectionHead title="A sample certification report." intro="Every cable we install is tested like this. This is the kind of report that comes with the job, one per cable." />
      <div class="plan__report">
        <CableTest variant="full" />
      </div>
    </div>
  </section>

  <PageCta
    code="N-05"
    title="When you’re ready, we’ll walk the site."
    body="Call or send a note about your building. We’ll walk it with you and put the scope and price in writing."
  />
</Base>

<script>
  import { contactHref } from '../lib/cta';

  // ── Print just the checklist ──
  document.querySelectorAll<HTMLButtonElement>('[data-print-checklist]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.documentElement.classList.add('print-checklist');
      const done = () => document.documentElement.classList.remove('print-checklist');
      window.addEventListener('afterprint', done, { once: true });
      window.print();
    });
  });

  // ── Estimator ──
  document.querySelectorAll<HTMLFormElement>('[data-estimator]').forEach((form) => {
    form.addEventListener('submit', (e) => e.preventDefault());
    const num = (name: string) => Math.max(0, Number((form.elements.namedItem(name) as HTMLInputElement).value) || 0);
    const out = (name: string, value: number) => {
      const el = form.querySelector<HTMLElement>(`[data-out="${name}"]`);
      if (el) el.textContent = value.toLocaleString('en-US');
    };
    const update = () => {
      const sqft = num('sqft');
      const desks = num('desks');
      const floors = Math.max(1, num('floors'));
      const doors = num('doors');

      const aps = Math.max(floors, Math.ceil(sqft / 2000));
      const cams = doors + 1 + floors; // doors + lobby + one corridor per floor
      const shared = 4 * floors; // printers, TVs, copiers
      const drops = desks * 2 + shared + aps + cams;

      out('drops', drops);
      out('aps', aps);
      out('cams', cams);
      out('readers', doors);

      // "Send these numbers" button: link carries a plain sentence built from the current inputs/outputs
      const send = document.querySelector<HTMLAnchorElement>('[data-est-send]');
      if (send) {
        const ready = sqft >= 1 && drops > 0;
        send.setAttribute('aria-disabled', String(!ready));
        const n = (v: number, one: string, many: string) => `${v.toLocaleString('en-US')} ${v === 1 ? one : many}`;
        const note = `Estimator: about ${n(drops, 'drop', 'drops')}, ${n(aps, 'access point', 'access points')}, ${n(cams, 'camera', 'cameras')}, ${n(doors, 'reader', 'readers')} for a ${sqft.toLocaleString('en-US')} sq ft office on ${n(floors, 'floor', 'floors')}.`;
        send.href = contactHref({ about: 'structured-cabling', note });
      }
    };
    document.querySelector<HTMLAnchorElement>('[data-est-send]')?.addEventListener('click', (e) => {
      if ((e.currentTarget as HTMLElement).getAttribute('aria-disabled') === 'true') e.preventDefault();
    });
    form.addEventListener('input', update);
    update();
  });

  // ── Cabling check ──
  document.querySelectorAll<HTMLFormElement>('[data-upgrade-check]').forEach((form) => {
    form.addEventListener('submit', (e) => e.preventDefault());
    const result = form.querySelector<HTMLElement>('[data-quiz-result]')!;
    const verdict = form.querySelector<HTMLElement>('[data-quiz-verdict]')!;
    const why = form.querySelector<HTMLElement>('[data-quiz-why]')!;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let swapTimer: number | undefined;
    const pick = (name: string) => (form.elements.namedItem(name) as RadioNodeList | null)?.value || '';

    form.addEventListener('change', () => {
      const cable = pick('cable');
      const age = pick('age');
      const symptoms = pick('symptoms');
      if (!cable || !age || !symptoms) return;

      let v = '';
      let w = '';
      if (symptoms === 'drops' || cable === '5e' || age === 'old') {
        v = 'Worth an assessment now';
        w =
          'Dropping connections, Cat 5e, or cabling past ten years are the usual reasons a network feels unreliable. A site walk will show whether the fix is a few bad runs or a refresh.';
      } else if (symptoms === 'slow' || cable === 'unknown' || age === 'mid') {
        v = 'Probably fine today; plan ahead';
        w =
          'Cat 6 installed in the last decade still handles most office traffic. Slow spots are often a Wi-Fi coverage problem rather than cabling. When you add newer Wi-Fi access points or more powered devices, that is the moment to review it.';
      } else {
        v = 'You’re in good shape';
        w = 'Recent Cat 6A with no symptoms is as good as it gets. Keep the labels and test reports; they make every future change quick.';
      }
      const show = () => {
        verdict.textContent = v;
        why.textContent = w;
        result.hidden = false;
        result.classList.remove('is-out', 'is-in');
        void result.offsetWidth;
        result.classList.add('is-in');
      };
      window.clearTimeout(swapTimer);
      // Redone quiz: the old answer leaves quickly, then the new one enters. Reduced motion swaps at once.
      if (!result.hidden && !calm.matches && verdict.textContent !== v) {
        result.classList.remove('is-in');
        result.classList.add('is-out');
        swapTimer = window.setTimeout(show, 120);
      } else if (result.hidden || verdict.textContent !== v) {
        show();
      }
    });
  });
</script>

<style>
  .plan__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .plan__jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--hairline-strong);
    color: var(--ink);
  }

  .plan__jump a:hover {
    border-color: var(--ink);
  }

  /*
   * Direction A: each tool is a worksheet, a white SHEET on the paper. Heading at the left (held in
   * place on desktop), the worksheet rows at the right, hairlines only between rows (rule 5).
   */
  .plan {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-5);
    padding-bottom: var(--space-section);
  }

  .plan__section {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
    align-content: start;
    padding: clamp(1.25rem, 0.5rem + 3.4vw, 4rem);
    background: var(--white);
    border: 1px solid var(--hairline);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
    min-width: 0;
  }

  .plan__section :global(.section-head) {
    margin-bottom: 0;
  }

  .plan__body {
    display: grid;
    gap: var(--sp-6);
    align-content: start;
    min-width: 0;
  }

  @media (max-width: 899px) {
    /* On a phone the sheets run edge to edge, like pages laid on the desk */
    .plan__section {
      margin-inline: calc(var(--gutter) * -1);
      border-inline: 0;
    }
  }

  @media (min-width: 1024px) {
    .plan__section {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .plan__section > :global(.section-head) {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .plan__section > :global(.section-head .section-head__title) {
      font-size: var(--fs-h1);
    }

    .plan__body {
      grid-column: 5 / -1;
    }

    /* The comparison table needs the whole sheet */
    .plan__section--wide {
      grid-template-columns: minmax(0, 1fr);
    }

    .plan__section--wide > :global(.section-head) {
      grid-column: 1;
      position: static;
    }

    .plan__section--wide .plan__body {
      grid-column: 1;
    }
  }

  .plan__link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Worksheet rows: ruled, no boxes */
  .checklist,
  .est__out,
  .quiz {
    min-width: 0;
  }

  .checklist {
    display: grid;
    border-top: 1px solid var(--ink);
  }

  .checklist__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1rem;
  }

  .checklist__item + .checklist__item {
    border-top: 1px solid var(--hairline);
  }

  .checklist__num {
    color: var(--steel);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }

  .checklist__text {
    display: grid;
    gap: 0.25rem;
  }

  .checklist__title {
    font-weight: 600;
  }

  .checklist__detail {
    color: var(--text);
    font-size: var(--fs-small);
  }

  .plan__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .plan__print {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
    font-weight: 500;
  }

  .plan__print:hover {
    background: var(--graphite);
  }

  .plan__printnote {
    display: none;
  }

  /* Estimator */
  .est {
    display: grid;
    gap: var(--sp-6);
  }

  /* The inputs are a form slip: paper on the white sheet. Two by two, so no field is left alone on a row; one column on small phones. */
  .est__inputs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-5) var(--col-gap);
    padding: var(--sp-5);
    background: var(--paper);
    border: 1px solid var(--hairline);
    min-width: 0;
  }

  @media (max-width: 420px) {
    .est__inputs {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .est__out {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .est__plan {
    margin: 0;
  }

  .est__send :global(.btn[aria-disabled='true']) {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .est__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1.5rem;
    padding-block: 1rem;
  }

  .est__row + .est__row {
    border-top: 1px solid var(--hairline);
  }

  .est__row dt {
    font-weight: 600;
  }

  /* Measured figures read big, like the total on a bill of quantities */
  .est__row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .est__row .est__how {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--text);
  }

  .est__term {
    display: inline-block;
    /* 44px tap area, no visual change: padding grows the box, negative margin cancels it */
    padding-block: 13.5px;
    margin-block: -13.5px;
    margin-left: 0.5rem;
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--steel);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .est__term:hover {
    color: var(--ink);
  }

  /* Cabling check */
  .quiz {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink);
  }

  .quiz__q {
    padding: var(--sp-5) 0;
    border: 0;
    min-width: 0;
  }

  .quiz__q + .quiz__q,
  .quiz__result {
    border-top: 1px solid var(--hairline);
  }

  /*
   * The legend floats so it is an ordinary block inside the row. A normal legend sits ON the fieldset's
   * top edge: the row rule ran through the question text, the first question stuck to the ink rule, and
   * the row padding fell between a question and its own answers. Floated, all three rows read alike:
   * space above the question, a tight gap to its answers, then the next rule.
   */
  .quiz__legend {
    float: left;
    width: 100%;
    padding: 0;
    margin: 0 0 0.875rem;
    font-weight: 600;
  }

  .quiz__options {
    clear: left;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .quiz__result {
    display: grid;
    gap: 0.5rem;
    padding: var(--sp-5) 0 var(--sp-2);
  }

  .quiz__result[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .quiz__result.is-in .quiz__verdict,
    .quiz__result.is-in .quiz__why {
      animation: quiz-in 320ms var(--ease-out) both;
    }

    .quiz__result.is-in .quiz__why {
      animation-delay: 90ms;
    }

    .quiz__result.is-out {
      opacity: 0;
      transform: translateY(-4px);
      transition: opacity 120ms ease, transform 120ms ease;
    }
  }

  @keyframes quiz-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .quiz__verdict {
    color: var(--ink);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .quiz__why {
    line-height: 1.55;
  }

  /*
   * The sample report is the one blue field on the page, the drawing sheet the report lies on.
   */
  .plan-report {
    padding-block: var(--space-section);
    background: var(--armak-blue);
    color: var(--paper);
  }

  .plan-report__layout {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .plan-report :global(.section-head) {
    margin-bottom: 0;
  }

  .plan-report :global(.section-head__title),
  .plan-report :global(.section-head__intro) {
    color: var(--paper);
  }

  .plan__report {
    min-width: 0;
    container-type: inline-size;
  }

  @media (min-width: 1024px) {
    .plan-report__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .plan-report__layout > :global(.section-head) {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .plan-report__layout > :global(.section-head .section-head__title) {
      font-size: var(--fs-h1);
    }

    .plan__report {
      grid-column: 5 / -1;
    }
  }

  /* Print: only the checklist */
  @media print {
    :global(html.print-checklist .site-header),
    :global(html.print-checklist .site-footer),
