---
// Dev-only (noindex): preview of stock-photo candidates, hot-linked from Unsplash/Pexels for
// review. Nothing here is downloaded into the project. Full shortlist: ai/plans/stock-photos.md
import Base from '../../layouts/Base.astro';
import Label from '../../components/ui/Label.astro';

const u = (id: string) => `https://images.unsplash.com/${id}?w=1100&q=70&auto=format`;
const p = (id: string) => `https://images.pexels.com/photos/${id}/pexels-photo-${id}.jpeg?auto=compress&cs=tinysrgb&w=1100`;

const picks = [
  { n: 1, slot: 'Hero', file: 'hero-tech-rack.jpg', src: u('photo-1785682117029-86171f64c826'), page: 'https://unsplash.com/photos/fJTyegEd-6k', credit: 'Valentin Lacoste · Unsplash', tall: true },
  { n: 2, slot: 'Structured cabling', file: 'cabling-bundles-white.jpg', src: p('19166565'), page: 'https://www.pexels.com/photo/19166565/', credit: 'panumas nikhomkhai · Pexels' },
  { n: 3, slot: 'Networking', file: 'wifi-ap-tray.jpg', src: u('photo-1785682117495-d87ff069cdb5'), page: 'https://unsplash.com/photos/e8_JJxiiydc', credit: 'Valentin Lacoste · Unsplash' },
  { n: 4, slot: 'Video surveillance', file: 'camera-ceiling.jpg', src: u('photo-1643123182527-3bd30840e7ed'), page: 'https://unsplash.com/photos/ujSsIk5iZmA', credit: 'Franck V. · Unsplash', tall: true },
  { n: 5, slot: 'Access control', file: 'badge-reader.jpg', src: p('13657444'), page: 'https://www.pexels.com/photo/13657444/', credit: 'Susanne Plank · Pexels' },
  { n: 6, slot: 'Voice', file: 'desk-phone.jpg', src: u('photo-1587560699334-bea93391dcef'), page: 'https://unsplash.com/photos/Dkn8-zPIbwo', credit: 'Julian Hochgesang · Unsplash' },
  { n: 7, slot: 'Audio / video', file: 'conference-room.jpg', src: u('photo-1637665662134-db459c1bbb46'), page: 'https://unsplash.com/photos/s-KphF10sWM', credit: 'Craig Lovelidge · Unsplash' },
  { n: 8, slot: 'Team / about', file: 'tech-on-lift.jpg', src: u('photo-1785682117413-ff63308090f2'), page: 'https://unsplash.com/photos/uPUPJEck3qE', credit: 'Valentin Lacoste · Unsplash', tall: true },
];
---

<Base title="Dev: photo candidates" noindex>
  <section class="container gallery">
    <Label code="DEV">Stock photo candidates — not downloaded</Label>
    <h1 class="t-h2">Top pick per slot</h1>
    <ul role="list" class="gallery__grid">
      {picks.map((x) => (
        <li class:list={['gallery__item', { 'is-tall': x.tall }]}>
          <img src={x.src} alt={`${x.slot} candidate`} loading="eager" />
          <div class="gallery__meta">
            <span class="t-mono t-accent">{String(x.n).padStart(2, '0')} · {x.slot}</span>
            <span class="t-small t-muted">{x.credit}</span>
            <a class="t-small" href={x.page} target="_blank" rel="noopener">View on source ↗</a>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .gallery {
    display: grid;
    gap: 1.5rem;
    padding-block: 3rem;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .gallery__item {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .gallery__item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--hairline);
    background: var(--paper-sunken);
  }

  .gallery__item.is-tall img {
    aspect-ratio: 4 / 5;
  }

  .gallery__meta {
    display: grid;
    gap: 0.25rem;
  }

  .gallery__meta a {
    text-decoration: underline;
  }
</style>
