---
/**
 * Contact — site-assessment form (Web3Forms → sales inbox) beside direct contact details,
 * then the service-area map. Ends in the form, so the footer CTA is hidden.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import ServiceArea from '../components/home/ServiceArea.astro';
import { site } from '../data/site';
import { process as steps } from '../data/content';

const description = `Request a site assessment from Armak Technologies for cabling, networking, security and AV across Southern California. Call ${site.phone}.`;

/** "What happens next" uses the first two steps of the Armak standard. */
const next = steps.slice(0, 2);
---

<Base title="Contact Us & Request a Site Assessment" description={description} footerCta={false} ctaDock={false}>
  <PageHero
    title="Start with a site assessment."
    lead="Tell us what you’re building. Start with a free rough quote, or book an on-site assessment for an accurate estimate."
    crumbs={[{ label: 'Contact' }]}
  >
    <div slot="aside" class="surface-card contact__details contact__details--hero">
      <div class="contact__direct">
        <p class="t-muted">Prefer to talk?</p>
        <a class="contact__phone tel" href={site.phoneHref}>{site.phone}</a>
        <a class="contact__email" href={site.emailHref}>{site.email}</a>
      </div>

      <ul role="list" class="contact__rows">
        <li>
          <span class="contact__key">Hours</span>
          <span>{site.hours}</span>
        </li>
        <li>
          <span class="contact__key">Support</span>
          <span>{site.support}</span>
        </li>
        <li>
          <span class="contact__key">Headquarters</span>
          <span>{site.hq.city}, California<br /><span class="t-muted">Serving all of Southern California</span></span>
        </li>
      </ul>
    </div>
  </PageHero>

  <section class="contact container" aria-label="Contact form and details">
   <div class="coupon" data-sheet>
    <div class="contact__panel">
      <ContactForm id="form" headingLevel={2} />
    </div>

    <aside class="contact__info" aria-label="Contact details">
      <span class="coupon__perf" aria-hidden="true"></span>
      <div class="contact__details contact__details--body">
        <div class="contact__direct">
          <p class="t-muted">Prefer to talk?</p>
          <a class="contact__phone tel" href={site.phoneHref}>{site.phone}</a>
          <a class="contact__email" href={site.emailHref}>{site.email}</a>
        </div>

        <ul role="list" class="contact__rows">
          <li>
            <span class="contact__key">Hours</span>
            <span>{site.hours}</span>
          </li>
          <li>
            <span class="contact__key">Support</span>
            <span>{site.support}</span>
          </li>
          <li>
            <span class="contact__key">Headquarters</span>
            <span>{site.hq.city}, California<br /><span class="t-muted">Serving all of Southern California</span></span>
          </li>
        </ul>
      </div>

      <div class="contact__next">
        <p class="t-muted">What happens next</p>
        <ol role="list">
          {next.map((s) => (
            <li>
              <span class="t-mono contact__step">{s.code}</span>
              <div>
                <p class="contact__step-title">{s.title}</p>
                <p class="t-small t-muted">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </aside>
   </div>
  </section>

  <ServiceArea />
</Base>

<style>
  /*
   * Direction A: the form is a coupon on the paper. White card, hairline edge; the contact details are
   * the stub, parted from the form by a perforation with a notch cut at each end. The perforation and
   * notches are the homepage coupon's (src/components/home/ContactSection.astro): same --notch, same dash
   * tile, same start/end logic.
   */
  .contact {
    padding-bottom: var(--space-section);
  }

  .coupon {
    --notch: 28px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--white);
    border: 1px solid var(--hairline);
  }

  .contact__panel {
    min-width: 0;
    padding: clamp(1.25rem, 0.5rem + 3.4vw, 4rem);
  }

  .contact__info {
    position: relative;
    display: grid;
    gap: 2rem;
    align-content: start;
    min-width: 0;
    padding: clamp(1.25rem, 0.5rem + 3.4vw, 3rem);
  }

  /* The perforation: dashed, --hairline-strong, 11px tile (2px gap, 6px dash, 3px gap) laid out with `space`
     so first and last dash sit 5px from their notch. Narrow: along the stub's top edge. Wide: down its left. */
  .coupon__perf {
    --perf-start: calc(var(--notch) / 2 + 2px);
    --perf-end: calc(var(--notch) / 2 + 1px);
    position: absolute;
    z-index: 1;
    top: -1px;
    left: var(--perf-start);
    right: var(--perf-end);
    height: 2px;
    background: linear-gradient(90deg, transparent 2px, var(--hairline-strong) 2px 8px, transparent 8px) 0 0 / 11px 100% space;
    pointer-events: none;
  }

  /* Notches: a paper half-disc bitten from the sheet at each end of the perforation. Flat side on the
     sheet's outer edge, curved side the 1px hairline. Narrow: bites in the left and right edges. */
  .contact__info::before,
  .contact__info::after {
    content: '';
    position: absolute;
    top: calc(var(--notch) / -2);
    width: calc(var(--notch) / 2);
    height: var(--notch);
    background: var(--paper);
    border: 1px solid var(--hairline);
  }

  .contact__info::before {
    left: -1px;
    border-left-width: 0;
    border-radius: 0 calc(var(--notch) / 2) calc(var(--notch) / 2) 0;
  }

  .contact__info::after {
    right: -1px;
    border-right-width: 0;
    border-radius: calc(var(--notch) / 2) 0 0 calc(var(--notch) / 2);
  }

  .contact__details {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }

  /* The hero copy of the details: a white sheet on the ink band */
  .contact__details--hero {
    display: none;
    padding: var(--sp-6);
    background: var(--white);
  }

  .contact__direct {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .contact__phone {
    color: var(--ink);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .contact__email {
    color: var(--text);
  }

  .contact__phone,
  .contact__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    background: linear-gradient(currentColor, currentColor) left bottom / 0% 1px no-repeat;
    transition: background-size var(--dur) var(--ease-out);
  }

  .contact__phone:hover,
  .contact__email:hover {
    background-size: 100% 1px;
  }

  .contact__rows {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .contact__rows li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 0.875rem;
    align-items: start;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--hairline);
    font-size: var(--fs-small);
    overflow-wrap: anywhere;
  }

  .contact__key {
    padding-top: 0.2rem;
    color: var(--steel);
  }

  .contact__next {
    display: grid;
    gap: 0.75rem;
  }

  .contact__next ol {
    display: grid;
    border-top: 1px solid var(--ink);
  }

  .contact__next li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--hairline);
  }

  .contact__step {
    padding-top: 0.2rem;
    color: var(--steel);
  }

  .contact__step-title {
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  @media (max-width: 899px) {
    /* The notch half-circles poke 15px past the viewport when the coupon runs edge to edge: clip them
       here (clip, not hidden, so nothing becomes a scroll container) */
    .contact {
      overflow-x: clip;
    }

    /* On a phone the coupon runs edge to edge */
    .coupon {
      margin-inline: calc(var(--gutter) * -1);
      border-inline: 0;
    }

    /* No side border here, so the bites sit flush with the screen edge (the clip above catches the rest) */
    .contact__info::before {
      left: 0;
    }

    .contact__info::after {
      right: 0;
    }
  }

  /* Phones: tighter hero sheet so the form's first question is on the first screen (UX law 13). Spacing only. */
  @media (max-width: 640px) {
    :global(body .page-hero.page-hero--paper) {
      padding-top: 0.75rem;
      padding-bottom: 1rem;
    }

    :global(body .page-hero .page-hero__wrap) {
      gap: var(--sp-3);
    }
  }

  @media (max-width: 420px) {
    .contact__rows li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .contact__details--hero {
      display: grid;
    }

    /* The hero card is only a third of the row here: each label sits above its value so the values get the
       whole card width instead of breaking in the middle of a phrase */
    .contact__details--hero .contact__rows li {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__details--body {
      display: none;
    }

    /* Stretch, not start: the stub is as tall as the card, so the perforation and both notches always
       run the card's full height, whichever of the form (step 2) or the stub is taller */
    .coupon {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: stretch;
    }

    .contact__panel {
      grid-column: 1 / span 8;
    }

    /* Only "What happens next" shows in the stub here, so the stub is a plain block (a grid row would be only
       as tall as its content) and the sticky child below can slide down the stub's full height */
    .contact__info {
      grid-column: 9 / -1;
      display: block;
      padding: var(--sp-8) var(--sp-7);
    }

    /* What follows you down the long form. The stub itself stays put, so its perforation is never cut short */
    .contact__next {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }

    /* Wide: the perforation runs down the stub's left edge and the notches become bites in the sheet's top
       and bottom edges, centred on the line. */
    .coupon__perf {
      top: var(--perf-start);
      bottom: var(--perf-end);
      left: -1px;
      right: auto;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, transparent 2px, var(--hairline-strong) 2px 8px, transparent 8px) 0 0 / 100% 11px space;
    }

    .contact__info::before,
    .contact__info::after {
      left: calc(var(--notch) / -2);
      right: auto;
      width: var(--notch);
      height: calc(var(--notch) / 2);
      border-width: 1px;
    }

    .contact__info::before {
      top: -1px;
      border-top-width: 0;
      border-radius: 0 0 calc(var(--notch) / 2) calc(var(--notch) / 2);
    }

    .contact__info::after {
      top: auto;
      bottom: -1px;
      border-bottom-width: 0;
      border-radius: calc(var(--notch) / 2) calc(var(--notch) / 2) 0 0;
    }
  }
</style>
