---
/**
 * Contact — site-assessment form (Web3Forms → sales inbox) beside direct contact details,
 * then the service-area map. Ends in the form, so the footer CTA is hidden.
 * Old look: form panel beside the details column. No dark closing band (the form is the action).
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import ServiceArea from '../components/home/ServiceArea.astro';
import { site } from '../data/site';
import { process as steps } from '../data/content';

const description = `Request a site assessment from Armak Technologies for cabling, networking, security and AV across Southern California. Call ${site.phone}.`;

/** "What happens next" uses the first two steps of the Armak standard. */
const next = steps.slice(0, 2);
---

<Base title="Contact Us & Request a Site Assessment" description={description} footerCta={false} ctaDock={false}>
  <PageHero
    title="Start with a site assessment."
    lead="Tell us what you’re building. We’ll walk the site, scope the work and send you a clear written estimate."
    crumbs={[{ label: 'Contact' }]}
  />

  <section class="contact container" aria-label="Contact form and details">
    <div class="contact__panel" data-reveal="scale">
      <ContactForm id="form" headingLevel={2} />
    </div>

    <aside class="contact__info" aria-label="Contact details" data-reveal-group>
      <div class="contact__direct">
        <p class="t-meta">Prefer to talk?</p>
        <a class="contact__phone tel" href={site.phoneHref}>{site.phone}</a>
        <a class="contact__email" href={site.emailHref}>{site.email}</a>
      </div>

      <ul role="list" class="contact__rows">
        <li>
          <span class="t-meta contact__key">Hours</span>
          <span>{site.hours}</span>
        </li>
        <li>
          <span class="t-meta contact__key">Support</span>
          <span>{site.support}</span>
        </li>
        <li>
          <span class="t-meta contact__key">Headquarters</span>
          <span>{site.hq.city}, California<br />Serving all of Southern California</span>
        </li>
      </ul>

      <div class="contact__next">
        <p class="t-meta">What happens next</p>
        <ol role="list">
          {next.map((s) => (
            <li>
              <p class="contact__step-title">{s.title}</p>
              <p class="t-small">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </aside>
  </section>

  <ServiceArea />
</Base>

<style>
  .contact {
    display: grid;
    gap: var(--col-gap);
    align-items: start;
  }

  .contact__panel {
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    background: var(--white);
    border-radius: var(--radius);
    min-width: 0;
  }

  .contact__info {
    display: grid;
    gap: 2rem;
    align-content: start;
    min-width: 0;
  }

  .contact__direct {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .contact__phone {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .contact__email {
    color: var(--steel);
  }

  /* 44px tap height */
  .contact__phone,
  .contact__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__phone:hover,
    .contact__email:hover {
      text-decoration-color: currentColor;
    }
  }

  .contact__rows {
    display: grid;
    gap: var(--sp-4);
  }

  .contact__rows li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 0.875rem;
    align-items: start;
    font-size: var(--fs-small);
    overflow-wrap: anywhere;
  }

  .contact__key {
    padding-top: 0;
  }

  .contact__next {
    display: grid;
    gap: 0.75rem;
  }

  .contact__next ol {
    display: grid;
    gap: var(--sp-5);
  }

  .contact__next li {
    display: grid;
    gap: 0.25rem;
  }

  .contact__step-title {
    font-weight: 500;
  }

  @media (max-width: 420px) {
    .contact__rows li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .contact__panel {
      grid-column: 1 / span 8;
    }

    .contact__info {
      grid-column: 9 / -1;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
