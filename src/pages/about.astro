---
/**
 * About — facts card in the hero, story since 1998 (original site's copy, tightened),
 * team slot (placeholder until Armak supplies it).
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import PageCta from '../components/pages/PageCta.astro';
import PlaceholderNote from '../components/pages/PlaceholderNote.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Button from '../components/ui/Button.astro';
import CablePlant from '../components/pages/CablePlant.astro';
import { site, FOUNDED, yearsInBusiness, serviceArea, counties } from '../data/site';
import { contactHref, CTA_LABEL } from '../lib/cta';
// TODO(photo): interim stock (see assets/photos/CREDITS.md), replace with a real Armak photo
import storyPhoto from '../assets/photos/cabling-bundles-white.jpg';

const description = `Armak Technologies has designed and installed low-voltage, networking and security systems across Southern California since ${FOUNDED}. ${site.hq.city} HQ.`;

/** The original site's three "about" cards, tightened. */
const story = [
  {
    title: `Since ${FOUNDED}`,
    body: 'We design and install low-voltage and networking systems for businesses across Southern California.',
  },
  {
    title: 'Done to standard',
    body: 'Every job is built to ANSI/TIA standards, tested and documented, so it stays reliable and easy to maintain for years.',
  },
  {
    title: 'Cabling to security',
    body: 'From structured cabling to security systems, we install what a business needs to run day to day.',
  },
];

const thisYear = new Date().getFullYear();

/**
 * Placeholder slots (milestones, license, certifications, team) stay hidden on the live site.
 * Flip to true to preview them while gathering Armak's real content; add the real data to
 * src/data/site.ts / content.ts and render it instead before showing them publicly.
 */
const SHOW_PLACEHOLDERS = false;
---

<Base title={`About Us · SoCal Low-Voltage Since ${FOUNDED}`} description={description} footerCta={false}>
  <PageHero
    title={`Low-voltage installs since ${FOUNDED}.`}
    lead={`For ${yearsInBusiness} years, organizations across Southern California have relied on Armak Technologies to design, install and support the cabling, networks and security systems they run on.`}
    crumbs={[{ label: 'About' }]}
    spec={[`Est. ${FOUNDED}`, `${site.hq.city} HQ`]}
  >
    <div slot="aside">
      <dl class="facts" aria-label="Armak at a glance">
        <div class="facts__row">
          <dt>Founded</dt>
          <dd>{FOUNDED}</dd>
        </div>
        <div class="facts__row">
          <dt>Headquarters</dt>
          <dd>{site.hq.city}, California</dd>
        </div>
        <div class="facts__row">
          <dt>Cities served</dt>
          <dd>{serviceArea.length}</dd>
        </div>
        <div class="facts__row">
          <dt>Counties</dt>
          <dd>{counties.length}</dd>
        </div>
      </dl>
    </div>
  </PageHero>

  <!-- Story -->
  <section class="section story">
    <div class="container">
      <SectionHead title={`${yearsInBusiness} years in business.`} />

      <div class="story__body">
        <figure class="story__figure" data-reveal>
          <div class="story__photo">
            <Image
              src={storyPhoto}
              alt="Neatly dressed light-blue cable bundles with black Velcro ties running into a rack of patch panels"
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              loading="lazy"
            />
          </div>
        </figure>

        <div class="story__side">
          <ol role="list" class="story__list">
            {story.map((s) => (
              <li class="story__item">
                <h3 class="t-h3">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <CablePlant />

      <!-- Milestones: only the founding year and current totals are facts; the rest is a slot.
           Hidden until Armak supplies real milestones (two rows alone read as an empty template). -->
      {SHOW_PLACEHOLDERS && (
      <div class="timeline">
        <h3 class="t-h3">Milestones</h3>
        <ol role="list" class="timeline__rows">
          <li class="timeline__row">
            <span class="timeline__year">{FOUNDED}</span>
            <span class="timeline__text">{site.name} established.</span>
          </li>
          {SHOW_PLACEHOLDERS && (
            <li class="timeline__row timeline__row--slot">
              <span class="timeline__year" aria-hidden="true">····</span>
              <PlaceholderNote class="timeline__note" title="Key milestones">
                Firsts, growth and notable moments between {FOUNDED} and today, to be supplied by Armak.
              </PlaceholderNote>
            </li>
          )}
          <li class="timeline__row">
            <span class="timeline__year">{thisYear}</span>
            <span class="timeline__text">
              {site.projectsDelivered}+ projects delivered across {serviceArea.length} Southern California cities.
            </span>
          </li>
        </ol>
      </div>
      )}
    </div>
  </section>

  <!-- Team (slot until Armak supplies people, photos and permission) -->
  {SHOW_PLACEHOLDERS && (
  <section class="section team">
    <div class="container">
      <SectionHead
        title="The people behind the installs."
        intro="One crew and one point of contact from the first walk-through to the final report."
      />
      <ul role="list" class="team__grid">
        {[1, 2, 3, 4].map((n) => (
          <li class="member">
            <div class="member__photo" aria-hidden="true">
              <span class="t-meta member__flag">Placeholder</span>
            </div>
            <p class="t-meta">Team member {n}</p>
            <p class="member__name">Name to be supplied</p>
            <p class="t-meta">Role, photo and short bio, with permission</p>
          </li>
        ))}
      </ul>
      <div class="team__foot">
        <p class="t-small">Want to work with us?</p>
        <Button href={contactHref()} variant="link">{CTA_LABEL}</Button>
      </div>
    </div>
  </section>
  )}

  <PageCta
    code="about"
    title="Walk your building with us."
    body="Call or send a note about your building. We’ll walk it with you and put the scope and price in writing."
  />
</Base>

<style>
  /* ── Story ── */
  .story__body {
    display: grid;
    gap: var(--space-block) var(--col-gap);
  }

  .story__photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .story__photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .story__side {
    display: grid;
    gap: var(--space-block);
    align-content: start;
    min-width: 0;
  }

  .story__list {
    display: grid;
    gap: var(--sp-6);
  }

  .story__item {
    display: grid;
    gap: 0.75rem;
  }

  .story__item p {
    max-width: 34em;
  }

  /* At a glance: a white sheet, no border (sits in the hero aside) */
  .facts {
    max-width: 28rem;
    margin: 0;
    padding: var(--sp-3) var(--sp-5);
    background: var(--white);
    border-radius: var(--radius);
  }

  .facts__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    font-size: var(--fs-small);
  }

  .facts__row dt {
    color: var(--steel);
  }

  .facts__row dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .timeline {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin-top: var(--space-block);
  }

  .timeline__rows {
    display: grid;
    gap: var(--sp-5);
    width: 100%;
  }

  .timeline__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--col-gap);
    align-items: baseline;
  }

  .timeline__row--slot {
    align-items: start;
  }

  .timeline__year {
    font-size: 1.25rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .timeline__row--slot .timeline__year {
    color: var(--steel);
  }

  /* ── Team ── */
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem var(--col-gap);
  }

  .member {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .member__photo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    margin-bottom: 0.5rem;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .member__photo .member__flag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }

  .member__name {
    font-weight: 500;
    color: var(--steel);
  }

  .team__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-block);
  }

  @media (max-width: 420px) {
    .member__photo .member__flag {
      top: 0.5rem;
      left: 0.5rem;
    }
  }

  @media (min-width: 640px) {
    .timeline__row {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .story__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .story__figure {
      grid-column: 1 / span 5;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .story__photo img {
      aspect-ratio: 4 / 5;
    }

    .story__side {
      grid-column: 7 / -1;
    }

    .timeline {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }

    .timeline > h3 {
      grid-column: 1 / span 3;
    }

    .timeline__rows {
      grid-column: 4 / -1;
    }

    .team__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
