---
/**
 * About — every fact has one home on this page (owner, 2026-11-06: the same facts were repeated
 * four times and the rest was dead space):
 *   the founding year lives in the title only;
 *   the headquarters and the city and county counts live in "Where we work" only, above the real lists.
 * The story is the three stacked rows the owner likes: small red uppercase label, bold title, body,
 * a hairline between rows (owner decision 2026-11-06, overrides DESIGN.md rule 7 for these labels).
 * Then, so nothing is dead space: what we install (the six systems), where (every city by county),
 * how a job runs (the five steps) and the cable-plant chart. Hidden placeholder slots (milestones,
 * licence, team) render nothing at all, so the layout closes up around them.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import PageCta from '../components/pages/PageCta.astro';
import PlaceholderNote from '../components/pages/PlaceholderNote.astro';
import CablePlant from '../components/pages/CablePlant.astro';
import Button from '../components/ui/Button.astro';
import { site, FOUNDED, services, serviceArea, counties } from '../data/site';
import { process as steps, credentials } from '../data/content';
import { contactHref, CTA_LABEL } from '../lib/cta';

const description = `Armak Technologies has designed and installed low-voltage, networking and security systems across Southern California since ${FOUNDED}. ${site.hq.city} HQ.`;

/** The original site's three "about" cards, tightened. The year is in the title above, so the first row says what the work was and still is. */
const story = [
  {
    label: 'Legacy',
    title: 'The same trade from day one',
    body: 'Low-voltage and networking systems for businesses across Southern California. That was the work in the first year, and it is the work now.',
  },
  {
    label: 'Our standard',
    title: 'Done to standard',
    body: 'Every job is built to ANSI/TIA standards, tested and documented, so it stays reliable and easy to maintain for years.',
  },
  {
    label: 'Scope',
    title: 'Cabling to security',
    body: 'From structured cabling to security systems, we install what a business needs to run day to day.',
  },
];

/** Cities grouped by county, in the order the counties first appear (north to south). */
const areaRows = counties.map((county) => ({
  county,
  cities: serviceArea.filter((c) => c.county === county),
}));
const isHq = (name: string) => name === site.hq.city;

const thisYear = new Date().getFullYear();

/**
 * Placeholder slots (milestones, licence, team) stay hidden on the live site. Flip to true to preview
 * them while gathering Armak's real content; add the real data to src/data/site.ts / content.ts and
 * render it instead before showing them publicly. A hidden slot renders nothing, so no gap is left.
 */
const SHOW_PLACEHOLDERS = false;
---

<Base title={`About Us · SoCal Low-Voltage Since ${FOUNDED}`} description={description} footerCta={false}>
  <PageHero
    title={`Low-voltage installs since ${FOUNDED}.`}
    lead="Armak Technologies designs, installs, tests and supports the low-voltage systems that Southern California buildings run on. One team, from the first site walk to the final test report."
    crumbs={[{ label: 'About' }]}
  >
    <div slot="aside" class="promise" data-reveal>
      <p class="t-meta promise__head">On every job</p>
      <ul role="list" class="promise__list">
        {credentials.map((c) => <li class="promise__item">{c}</li>)}
        {site.license && <li class="promise__item">Licensed, CSLB no. {site.license}</li>}
      </ul>
    </div>
  </PageHero>

  <div class="about">
    <!-- Who we are: the three rows the owner likes -->
    <section class="block container" aria-labelledby="who-title">
      <div class="block__head">
        <h2 id="who-title" class="t-h2 block__title" data-split>Who we are.</h2>
      </div>
      <div class="block__body">
        <ol role="list" class="rows story">
          {story.map((s, i) => (
            <li class="row story__row" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
              <p class="story__label">{s.label}</p>
              <h3 class="t-h3 story__title">{s.title}</h3>
              <p class="story__body">{s.body}</p>
            </li>
          ))}
        </ol>

        <!-- Milestones: only the founding year and current totals are facts; the rest is a slot.
             Hidden until Armak supplies real milestones (two rows alone read as an empty template). -->
        {SHOW_PLACEHOLDERS && (
          <div class="timeline">
            <h3 class="t-h3">Milestones</h3>
            <ol role="list" class="rows">
              <li class="row timeline__row">
                <span class="timeline__year">{FOUNDED}</span>
                <span>{site.name} established.</span>
              </li>
              <li class="row timeline__row">
                <span class="timeline__year" aria-hidden="true">····</span>
                <PlaceholderNote title="Key milestones">
                  Firsts, growth and notable moments between {FOUNDED} and today, to be supplied by Armak.
                </PlaceholderNote>
              </li>
              <li class="row timeline__row">
                <span class="timeline__year">{thisYear}</span>
                <span>{site.projectsDelivered}+ projects delivered across {serviceArea.length} Southern California cities.</span>
              </li>
            </ol>
          </div>
        )}
      </div>
    </section>

    <!-- What we install: the six systems, each linking to its page -->
    <section class="block container" aria-labelledby="install-title">
      <div class="block__head">
        <h2 id="install-title" class="t-h2 block__title" data-split>What we install.</h2>
        <p class="block__intro" data-reveal>Six systems, from one team. Each has its own page.</p>
        <div data-reveal>
          <Button href="/services/" variant="link">All services</Button>
        </div>
      </div>
      <div class="block__body">
        <ul role="list" class="rows systems">
          {services.map((s, i) => (
            <li class="row system" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
              <h3 class="t-h3 system__name"><a href={`/services/${s.slug}/`}>{s.name}</a></h3>
              <p class="system__short">{s.short}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Where we work: the headquarters and the counts live here, above the real lists -->
    <section class="block container" aria-labelledby="where-title">
      <div class="block__head">
        <h2 id="where-title" class="t-h2 block__title" data-split>Where we work.</h2>
        <p class="block__intro" data-reveal>
          {serviceArea.length} cities across {counties.length} Southern California counties, served from our {site.hq.city} headquarters.
        </p>
        <div data-reveal>
          <Button href="/#service-area" variant="link">See the map</Button>
        </div>
      </div>
      <div class="block__body">
        <ul role="list" class="rows area" aria-label="Cities we serve, by county">
          {areaRows.map((r, i) => (
            <li class="row area__row" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
              <h3 class="area__county">{r.county} County</h3>
              <ul role="list" class="area__cities">
                {/* One line per item, the ", " inside it: a line break inside the tag would print as a space before the comma,
                    and items rendered from a map get no space between them. The name is the only part that cannot wrap. */}
                {r.cities.map((c, j) => (
                  <li class:list={['area__city', { 'is-hq': isHq(c.name) }]}><span class="area__name">{c.name}{isHq(c.name) && <span class="area__hq"> HQ</span>}</span>{j < r.cities.length - 1 && ', '}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- How a job runs: the five steps, in short; the live demos are on the home page -->
    <section class="block container" aria-labelledby="how-title">
      <div class="block__head">
        <h2 id="how-title" class="t-h2 block__title" data-split>How we run a job.</h2>
        <p class="block__intro" data-reveal>The same five steps on every job, from a single rack to a multi-site rollout.</p>
        <div data-reveal>
          <Button href="/#process" variant="link">Watch each step run</Button>
        </div>
      </div>
      <div class="block__body">
        <ol role="list" class="rows steps">
          {steps.map((s, i) => (
            <li class="row step" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
              <h3 class="t-h3 step__title">{s.title}</h3>
              <p class="step__body">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Cabling planned for the long run: the sourced chart -->
    <section class="block container" aria-labelledby="plant-title">
      <div class="block__head">
        <h2 id="plant-title" class="t-h2 block__title" data-split>Cabling planned for the long run.</h2>
        <p class="block__intro" data-reveal>
          Wi-Fi gets a new release every few years. The cabling behind it is meant to stay in the walls far longer, so we put in what the next round of equipment will need.
        </p>
      </div>
      <div class="block__body block__body--sheet" data-reveal>
        <CablePlant />
      </div>
    </section>

    <!-- Team (slot until Armak supplies people, photos and permission) -->
    {SHOW_PLACEHOLDERS && (
      <section class="block container" aria-labelledby="team-title">
        <div class="block__head">
          <h2 id="team-title" class="t-h2 block__title">The people behind the installs.</h2>
          <p class="block__intro">One crew and one point of contact from the first walk-through to the final report.</p>
        </div>
        <div class="block__body">
          <ul role="list" class="team__grid">
            {[1, 2, 3, 4].map((n) => (
              <li class="member">
                <div class="member__photo" aria-hidden="true">
                  <span class="t-meta member__flag">Placeholder</span>
                </div>
                <p class="t-meta">Team member {n}</p>
                <p class="member__name">Name to be supplied</p>
                <p class="t-meta">Role, photo and short bio, with permission</p>
              </li>
            ))}
          </ul>
          <div class="team__foot">
            <p class="t-small">Want to work with us?</p>
            <Button href={contactHref()} variant="link">{CTA_LABEL}</Button>
          </div>
        </div>
      </section>
    )}
  </div>

  <PageCta
    code="about"
    title="Walk your building with us."
    body="Call or send a note about your building. We’ll walk it with you and put the scope and price in writing."
  />
</Base>

<style>
  /* ── Hero aside: what you get on every job, as plain rows (no card) ── */
  .promise {
    display: grid;
    gap: var(--sp-3);
    width: 100%;
    max-width: 30rem;
  }

  .promise__list {
    display: grid;
  }

  .promise__item {
    padding-block: var(--sp-3);
    border-top: 1px solid var(--hairline);
    font-weight: 500;
    color: var(--ink);
  }

  .promise__item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .promise__item:last-child {
    padding-bottom: 0;
  }

  /* ── Page rhythm: neighbouring blocks share one section gap ── */
  .about {
    display: grid;
    row-gap: var(--space-section);
    padding-block: var(--space-block);
  }

  /* ── Block: heading on the left, rows on the right (one column on phones) ── */
  .block {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
  }

  .block__head {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
    justify-items: start;
    min-width: 0;
  }

  .block__title {
    max-width: 14ch;
  }

  .block__intro {
    max-width: 30em;
    color: var(--text);
  }

  .block__body {
    min-width: 0;
  }

  /* The chart sheet keeps its own top margin on phones only where it follows the heading */
  .block__body--sheet :global(.plant) {
    margin-top: 0;
  }

  /* ── Rows: hairlines only between rows ── */
  .rows {
    display: grid;
  }

  .row {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--hairline);
    min-width: 0;
  }

  .row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .row:last-child {
    padding-bottom: 0;
  }

  /* Story rows: red label, bold title, body */
  .story__row {
    gap: var(--sp-3);
    padding-block: var(--sp-6);
  }

  .story__label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--signal);
  }

  .story__title {
    max-width: 20ch;
  }

  .story__body {
    max-width: 34em;
    color: var(--text);
  }

  /* Systems: name links to the service page */
  .system__name a {
    display: inline-block;
    padding-block: 0.4rem;
    margin-block: -0.4rem;
    transition: color var(--dur-fast) ease;
  }

  .system__short {
    max-width: 32em;
    color: var(--text);
  }

  /* Counties: county, then its cities */
  .area__county {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* Cities read as one line of text: an inline list, the commas are in the markup */
  .area__cities {
    color: var(--text);
    max-width: 40em;
  }

  .area__city {
    display: inline;
  }

  .area__city.is-hq .area__name {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  /* The one red detail that means "here" (rule 7, round 3) */
  .area__hq {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--signal);
  }

  /* Steps: title, then what happens */
  .step__body {
    max-width: 34em;
    color: var(--text);
  }

  /* ── Placeholder slots (hidden on the live site) ── */
  .timeline {
    display: grid;
    gap: var(--sp-5);
    margin-top: var(--space-block);
  }

  .timeline__row {
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--col-gap);
    align-items: baseline;
  }

  .timeline__year {
    font-size: 1.25rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem var(--col-gap);
  }

  .member {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .member__photo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    margin-bottom: 0.5rem;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .member__photo .member__flag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }

  .member__name {
    font-weight: 500;
    color: var(--steel);
  }

  .team__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-block);
  }

  @media (hover: hover) and (pointer: fine) {
    .system__name a:hover {
      color: var(--signal);
    }
  }

  @media (min-width: 640px) {
    /* Six systems in two columns; the first two cells open the list with no line above */
    .systems {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }

    .systems .row:nth-child(2) {
      border-top: 0;
      padding-top: 0;
    }

    .systems .row:nth-last-child(2) {
      padding-bottom: 0;
    }

    /* County and step rows: the name on the left, the detail on the right */
    .area__row,
    .step {
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      column-gap: var(--col-gap);
      align-items: baseline;
    }

    /* "San Bernardino County" on one line */
    .area__row {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    }

    .timeline__row {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .block {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .block__head {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .block__body {
      grid-column: 5 / -1;
    }

    .team__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
