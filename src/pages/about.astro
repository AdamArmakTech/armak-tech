---
/**
 * About — story since 1998 (original site's copy, tightened), principles, credentials,
 * numbers, manufacturer partners, team slot (placeholder until Armak supplies it), service area.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import PageCta from '../components/pages/PageCta.astro';
import PlaceholderNote from '../components/pages/PlaceholderNote.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Label from '../components/ui/Label.astro';
import Button from '../components/ui/Button.astro';
import Numbers from '../components/home/Numbers.astro';
import PartnerStrip from '../components/home/PartnerStrip.astro';
import ServiceArea from '../components/home/ServiceArea.astro';
import { site, FOUNDED, yearsInBusiness, serviceArea, counties } from '../data/site';
import { pillars, credentials } from '../data/content';

const description = `Armak Technologies has designed and installed low-voltage, networking and security systems across Southern California since ${FOUNDED}. Glendale HQ.`;

/** The original site's three "about" cards, tightened. */
const story = [
  {
    tag: 'Legacy',
    title: `Since ${FOUNDED}`,
    body: 'We design and install low-voltage and networking systems for businesses across Southern California.',
  },
  {
    tag: 'Our standard',
    title: 'Done to standard',
    body: 'Every job is built to ANSI/TIA standards, tested and documented, so it stays reliable and easy to maintain for years.',
  },
  {
    tag: 'Scope',
    title: 'Cabling to security',
    body: 'From structured cabling to security systems, we install what a business needs to run day to day.',
  },
];

/** Tags from the original site's value cards, paired with `pillars` in order. */
const pillarTags = ['Precision', 'Scale', 'Speed', 'Service'];

const thisYear = new Date().getFullYear();

/**
 * Placeholder slots (milestones, license, certifications, team) stay hidden on the live site.
 * Flip to true to preview them while gathering Armak's real content; add the real data to
 * src/data/site.ts / content.ts and render it instead before showing them publicly.
 */
const SHOW_PLACEHOLDERS = false;
---

<Base title={`About Us · SoCal Low-Voltage Since ${FOUNDED}`} description={description} footerCta={false}>
  <PageHero
    title={`Low-voltage and network installs since ${FOUNDED}.`}
    lead={`For ${yearsInBusiness} years, organizations across Southern California have relied on Armak Technologies to design, install and support the cabling, networks and security systems they run on.`}
    crumbs={[{ label: 'About' }]}
    spec={[`Est. ${FOUNDED}`, `${site.hq.city} HQ`]}
  />

  <!-- Story -->
  <section class="section story">
    <div class="container">
      <SectionHead title={`${yearsInBusiness} years in business.`} />

      <div class="story__body">
        <ol role="list" class="story__list">
          {story.map((s) => (
            <li class="story__item">
              <span class="story__tag">{s.tag}</span>
              <h3 class="t-h3">{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>

        <dl class="story__facts" aria-label="Armak at a glance">
          <div class="story__fact">
            <dt>Founded</dt>
            <dd>{FOUNDED}</dd>
          </div>
          <div class="story__fact">
            <dt>Headquarters</dt>
            <dd>{site.hq.city}, California</dd>
          </div>
          <div class="story__fact">
            <dt>Cities served</dt>
            <dd>{serviceArea.length}</dd>
          </div>
          <div class="story__fact">
            <dt>Counties</dt>
            <dd>{counties.length}</dd>
          </div>
        </dl>
      </div>

      <!-- Milestones: only the founding year and current totals are facts; the rest is a slot.
           Hidden until Armak supplies real milestones (two rows alone read as an empty template). -->
      {SHOW_PLACEHOLDERS && (
      <div class="timeline">
        <h3 class="t-h4">Milestones</h3>
        <ol role="list" class="timeline__rows">
          <li class="timeline__row">
            <span class="timeline__year">{FOUNDED}</span>
            <span class="timeline__text">{site.name} established.</span>
          </li>
          {SHOW_PLACEHOLDERS && (
            <li class="timeline__row timeline__row--slot">
              <span class="timeline__year" aria-hidden="true">····</span>
              <PlaceholderNote class="timeline__note" title="Key milestones">
                Firsts, growth and notable moments between {FOUNDED} and today, to be supplied by Armak.
              </PlaceholderNote>
            </li>
          )}
          <li class="timeline__row">
            <span class="timeline__year">{thisYear}</span>
            <span class="timeline__text">
              {site.projectsDelivered}+ projects delivered across {serviceArea.length} Southern California cities.
            </span>
          </li>
        </ol>
      </div>
      )}
    </div>
  </section>

  <!-- Principles -->
  <section class="section section--flush-top principles">
    <div class="container">
      <SectionHead title="How we work on every job." />
      <ul role="list" class="principles__grid">
        {pillars.map((p, i) => (
          <li class="principle">
            <span class="principle__index">
              {String(i + 1).padStart(2, '0')}{pillarTags[i] && ` · ${pillarTags[i]}`}
            </span>
            <h3 class="t-h4">{p.title}</h3>
            <p class="t-small t-muted">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Credentials -->
  <section class="section section--flush-top creds">
    <div class="container">
      <SectionHead title="Licensing, certification and support." />
      <ul role="list" class="creds__grid">
        {credentials.map((c) => (
          <li class="cred">
            <span class="cred__text">{c}</span>
          </li>
        ))}
        {(site.license || SHOW_PLACEHOLDERS) && (
          <li class="cred">
            <span class="cred__text">Contractor license</span>
            {site.license ? (
              <span class="t-mono cred__value">{site.license}</span>
            ) : (
              <Label tone="signal" class="cred__flag">Placeholder · Lic. no. to confirm</Label>
            )}
          </li>
        )}
        {SHOW_PLACEHOLDERS && (
          <li class="cred">
            <span class="cred__text">Manufacturer certifications</span>
            <Label tone="signal" class="cred__flag">Placeholder · List to supply</Label>
          </li>
        )}
      </ul>
    </div>
  </section>

  <Numbers />

  <PartnerStrip />

  <!-- Team (slot until Armak supplies people, photos and permission) -->
  {SHOW_PLACEHOLDERS && (
  <section class="section team">
    <div class="container">
      <SectionHead
        title="The people behind the installs."
        intro="One crew and one point of contact from the first walk-through to the final report."
      />
      <ul role="list" class="team__grid">
        {[1, 2, 3, 4].map((n) => (
          <li class="member">
            <div class="member__photo" aria-hidden="true">
              <Label tone="signal" class="member__flag">Placeholder</Label>
            </div>
            <p class="t-small t-muted">Team member {n}</p>
            <p class="member__name">Name to be supplied</p>
            <p class="t-small t-muted">Role · photo and short bio, with permission</p>
          </li>
        ))}
      </ul>
      <div class="team__foot">
        <p class="t-small t-muted">Want to work with us?</p>
        <Button href="/contact/" variant="link">Request a site assessment</Button>
      </div>
    </div>
  </section>
  )}

  <ServiceArea />

  <PageCta
    code="about"
    title="Walk your building with us."
    body="Call or send a note about your building. We’ll walk it with you and put the scope and price in writing."
  />
</Base>

<style>
  .section--flush-top {
    padding-top: 0;
  }

  /* ── Story ── */
  .story__body {
    display: grid;
    gap: var(--space-block) var(--col-gap);
  }

  .story__list {
    max-width: 65ch;
  }

  .story__item {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--hairline);
  }

  .story__item:first-child {
    padding-top: 0;
  }

  .story__item p {
    color: var(--text);
  }

  .story__tag {
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--steel);
  }

  .story__facts {
    align-self: start;
    max-width: 28rem;
  }

  .story__fact {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    padding-block: var(--sp-3);
    border-bottom: 1px solid var(--hairline);
    font-size: var(--fs-small, 0.9375rem);
  }

  .story__fact:first-child {
    border-top: 1px solid var(--hairline);
  }

  .story__fact dt {
    color: var(--steel);
  }

  .story__fact dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
    text-align: right;
  }

  .timeline {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin-top: var(--space-block);
  }

  .timeline__rows {
    width: 100%;
    border-top: 1px solid var(--hairline);
  }

  .timeline__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--col-gap);
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .timeline__row--slot {
    align-items: start;
  }

  .timeline__year {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .timeline__row--slot .timeline__year {
    color: var(--hairline-strong);
  }

  /* ── Principles ── */
  .principles__grid {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .principle {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.5rem 0 2rem;
    border-bottom: 1px solid var(--hairline);
  }

  .principle p {
    max-width: 30em;
  }

  .principle__index {
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--steel);
  }

  /* ── Credentials ── */
  .creds__grid {
    display: grid;
    border-top: 1px solid var(--hairline);
    border-left: 1px solid var(--hairline);
  }

  .cred {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    justify-items: start;
    padding: 1.5rem 1.25rem 1.75rem;
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--white);
  }

  .cred__text {
    font-size: var(--fs-h4);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .cred :global(.cred__flag) {
    white-space: normal;
  }

  /* ── Team ── */
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem var(--col-gap);
  }

  .member {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .member__photo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    margin-bottom: 0.5rem;
    border: 1px dashed var(--hairline-strong);
    border-radius: var(--radius);
    background: var(--paper-sunken);
    color: var(--hairline-strong);
  }

  .member__photo :global(.member__flag) {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--paper);
  }

  .member__name {
    font-weight: 500;
    color: var(--steel);
  }

  .team__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-block);
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 420px) {
    .member__photo :global(.member__flag) {
      top: 0.5rem;
      left: 0.5rem;
    }
  }

  @media (min-width: 640px) {
    .principles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .principle {
      padding: 1.5rem 1.5rem 2rem;
    }

    .principle:nth-child(odd) {
      padding-left: 0;
    }

    .principle:nth-child(even) {
      border-left: 1px solid var(--hairline);
    }

    .creds__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cred:last-child {
      grid-column: 1 / -1;
    }

    .timeline__row {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  @media (min-width: 900px) {
    .story__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .story__list {
      grid-column: 1 / span 7;
    }

    .story__facts {
      grid-column: 9 / -1;
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .timeline {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }

    .timeline > :global(.label) {
      grid-column: 1 / span 3;
    }

    .timeline__rows {
      grid-column: 4 / -1;
    }

    /* 3 facts on the first row, the 2 pending items share the second */
    .creds__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .cred {
      grid-column: span 2;
    }

    .cred:nth-last-child(-n + 2) {
      grid-column: span 3;
    }

    .team__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .principles__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .principle,
    .principle:nth-child(odd) {
      padding: 1.5rem 1.5rem 0.5rem;
      border-bottom: 0;
      border-left: 1px solid var(--hairline);
    }

    .principle:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
