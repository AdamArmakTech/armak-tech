---
/**
 * About — every fact has one home on this page (owner, 2026-11-06: the same facts were repeated
 * four times and the rest was dead space):
 *   the founding year lives in the title only;
 *   the headquarters and the city and county counts live in "Where we work" only, above the real lists.
 * No lines between items and no labels above headings (owner, 2026-11-06, in the session that built this
 * page: "lists with lines" and "red caps labels" read as AI slop). Things are separated by space, links are
 * words in sentences, and the only surface is the chart's white sheet (DESIGN.md rule 5, round 1).
 * Then, so nothing is dead space: who we are (three short pieces), what we install (the six systems), where
 * (every city by county), how a job runs (the five steps) and the cable-plant chart. Hidden placeholder slots
 * (milestones, licence, team) render nothing at all, so the layout closes up around them.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import PageCta from '../components/pages/PageCta.astro';
import PlaceholderNote from '../components/pages/PlaceholderNote.astro';
import CablePlant from '../components/pages/CablePlant.astro';
import Button from '../components/ui/Button.astro';
import { site, FOUNDED, services, serviceArea, counties } from '../data/site';
import { process as steps } from '../data/content';
import { contactHref, CTA_LABEL } from '../lib/cta';

const description = `Armak Technologies has designed and installed low-voltage, networking and security systems across Southern California since ${FOUNDED}. ${site.hq.city} HQ.`;

/** The original site's three "about" cards, tightened. The year is in the title above, so the first piece says what the work was and still is. */
const story = [
  {
    title: 'The same trade from day one',
    body: 'Low-voltage and networking systems for businesses across Southern California. That was the work in the first year, and it is the work now.',
  },
  {
    title: 'Done to standard',
    body: 'Every job is built to ANSI/TIA standards, tested and documented, so it stays reliable and easy to maintain for years.',
  },
  {
    title: 'Cabling to security',
    body: 'From structured cabling to security systems, we install what a business needs to run day to day.',
  },
];

/** Cities grouped by county, in the order the counties first appear (north to south). */
const areaRows = counties.map((county) => ({
  county,
  cities: serviceArea.filter((c) => c.county === county),
}));
const isHq = (name: string) => name === site.hq.city;

const thisYear = new Date().getFullYear();

/**
 * Placeholder slots (milestones, licence, team) stay hidden on the live site. Flip to true to preview
 * them while gathering Armak's real content; add the real data to src/data/site.ts / content.ts and
 * render it instead before showing them publicly. A hidden slot renders nothing, so no gap is left.
 */
const SHOW_PLACEHOLDERS = false;
---

<Base title={`About Us · SoCal Low-Voltage Since ${FOUNDED}`} description={description} footerCta={false}>
  <PageHero
    title={`Low-voltage installs since ${FOUNDED}.`}
    lead="Armak Technologies designs, installs, tests and supports the low-voltage systems that Southern California buildings run on. One team, from the first site walk to the final test report."
    crumbs={[{ label: 'About' }]}
  />

  <div class="about">
    <!-- Who we are: three short pieces, separated by space -->
    <section class="block container" aria-labelledby="who-title">
      <div class="block__head">
        <h2 id="who-title" class="t-h2 block__title" data-split>Who we are.</h2>
      </div>
      <div class="block__body">
        <div class="story">
          {story.map((s, i) => (
            <div class="story__item" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
              <h3 class="t-h3 story__title">{s.title}</h3>
              <p class="story__body">{s.body}</p>
            </div>
          ))}
        </div>

        <!-- Milestones: only the founding year and current totals are facts; the rest is a slot.
             Hidden until Armak supplies real milestones (two rows alone read as an empty template). -->
        {SHOW_PLACEHOLDERS && (
          <div class="timeline">
            <h3 class="t-h3">Milestones</h3>
            <ol role="list" class="timeline__rows">
              <li class="timeline__row">
                <span class="timeline__year">{FOUNDED}</span>
                <span>{site.name} established.</span>
              </li>
              <li class="timeline__row">
                <span class="timeline__year" aria-hidden="true">····</span>
                <PlaceholderNote title="Key milestones">
                  Firsts, growth and notable moments between {FOUNDED} and today, to be supplied by Armak.
                </PlaceholderNote>
              </li>
              <li class="timeline__row">
                <span class="timeline__year">{thisYear}</span>
                <span>{site.projectsDelivered}+ projects delivered across {serviceArea.length} Southern California cities.</span>
              </li>
            </ol>
          </div>
        )}
      </div>
    </section>

    <!-- What we install: the six systems, each name linking to its page -->
    <section class="block container" aria-labelledby="install-title">
      <div class="block__head">
        <h2 id="install-title" class="t-h2 block__title" data-split>What we install.</h2>
        <p class="block__intro" data-reveal>
          Six systems, from one team. <a href="/services/">See all services.</a>
        </p>
      </div>
      <div class="block__body">
        <ul role="list" class="systems">
          {services.map((s, i) => (
            <li class="system" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
              <h3 class="t-h3 system__name"><a href={`/services/${s.slug}/`}>{s.name}</a></h3>
              <p class="system__short">{s.short}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Where we work: the headquarters and the counts live here, above the real lists -->
    <section class="block container" aria-labelledby="where-title">
      <div class="block__head">
        <h2 id="where-title" class="t-h2 block__title" data-split>Where we work.</h2>
        <p class="block__intro" data-reveal>
          {serviceArea.length} cities across {counties.length} Southern California counties, served from our {site.hq.city} headquarters. <a href="/#service-area">See the map.</a>
        </p>
      </div>
      <div class="block__body">
        <ul role="list" class="area" aria-label="Cities we serve, by county">
          {areaRows.map((r, i) => (
            <li class="area__group" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
              <h3 class="area__county">{r.county} County</h3>
              <ul role="list" class="area__cities">
                {/* One line per item, the ", " inside it: a line break inside the tag would print as a space before the comma,
                    and items rendered from a map get no space between them. The name is the only part that cannot wrap. */}
                {r.cities.map((c, j) => (
                  <li class:list={['area__city', { 'is-hq': isHq(c.name) }]}><span class="area__name">{c.name}{isHq(c.name) && <span class="area__hq"> HQ</span>}</span>{j < r.cities.length - 1 && ', '}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- How a job runs: the five steps as short paragraphs; the live demos are on the home page -->
    <section class="block container" aria-labelledby="how-title">
      <div class="block__head">
        <h2 id="how-title" class="t-h2 block__title" data-split>How we run a job.</h2>
        <p class="block__intro" data-reveal>
          The same five steps on every job, from a single rack to a multi-site rollout. <a href="/#process">Watch each step run on the home page.</a>
        </p>
      </div>
      <div class="block__body">
        <ol role="list" class="steps">
          {steps.map((s, i) => (
            <li class="step" data-reveal style={`--reveal-delay: ${i * 50}ms`}>
              <p><strong class="step__title">{s.title}.</strong> {s.body}</p>
            </li>
          ))}
        </ol>
        <p class="steps__promise" data-reveal>
          You get a written plan and price before the work starts, the cable test reports when it ends, and {site.supportHours} support for {site.supportScope}.
        </p>
      </div>
    </section>

    <!-- Cabling planned for the long run: the sourced chart -->
    <section class="block container" aria-labelledby="plant-title">
      <div class="block__head">
        <h2 id="plant-title" class="t-h2 block__title" data-split>Cabling planned for the long run.</h2>
        <p class="block__intro" data-reveal>
          Wi-Fi gets a new release every few years. The cabling behind it is meant to stay in the walls far longer, so we put in what the next round of equipment will need.
        </p>
      </div>
      <div class="block__body block__body--sheet" data-reveal>
        <CablePlant />
      </div>
    </section>

    <!-- Team (slot until Armak supplies people, photos and permission) -->
    {SHOW_PLACEHOLDERS && (
      <section class="block container" aria-labelledby="team-title">
        <div class="block__head">
          <h2 id="team-title" class="t-h2 block__title">The people behind the installs.</h2>
          <p class="block__intro">One crew and one point of contact from the first walk-through to the final report.</p>
        </div>
        <div class="block__body">
          <ul role="list" class="team__grid">
            {[1, 2, 3, 4].map((n) => (
              <li class="member">
                <div class="member__photo" aria-hidden="true">
                  <span class="t-meta member__flag">Placeholder</span>
                </div>
                <p class="t-meta">Team member {n}</p>
                <p class="member__name">Name to be supplied</p>
                <p class="t-meta">Role, photo and short bio, with permission</p>
              </li>
            ))}
          </ul>
          <div class="team__foot">
            <p class="t-small">Want to work with us?</p>
            <Button href={contactHref()} variant="link" icon="none">{CTA_LABEL}</Button>
          </div>
        </div>
      </section>
    )}
  </div>

  <PageCta
    code="about"
    title="Walk your building with us."
    body="Call or send a note about your building. We’ll walk it with you and put the scope and price in writing."
  />
</Base>

<style>
  /* ── Page rhythm: neighbouring blocks share one section gap ── */
  .about {
    display: grid;
    row-gap: var(--space-section);
    padding-block: var(--space-block);
  }

  /* ── Block: heading on the left, the content on the right (one column on phones) ── */
  .block {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
  }

  .block__head {
    display: grid;
    gap: var(--sp-4);
    align-content: start;
    min-width: 0;
  }

  .block__title {
    max-width: 14ch;
  }

  .block__intro {
    max-width: 30em;
    color: var(--text);
  }

  /* Links are words in the sentence: underlined, red only on hover (rule 7, round 3) */
  .block__intro a,
  .system__name a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    padding-block: 0.6rem;
    transition: color var(--dur-fast) ease;
  }

  .block__body {
    min-width: 0;
  }

  .block__body--sheet :global(.plant) {
    margin-top: 0;
  }

  /* ── Who we are: three short pieces ── */
  .story {
    display: grid;
    gap: var(--sp-6);
  }

  .story__item {
    display: grid;
    gap: var(--sp-2);
  }

  .story__title {
    max-width: 20ch;
  }

  .story__body {
    max-width: 34em;
    color: var(--text);
  }

  /* ── What we install: six short pieces, two columns from 640px ── */
  .systems {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
  }

  .system {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    min-width: 0;
  }

  .system__name a {
    text-decoration-color: var(--hairline-strong);
  }

  .system__short {
    max-width: 32em;
    color: var(--text);
  }

  /* ── Where we work: each county with its cities, as running text ── */
  .area {
    display: grid;
    gap: var(--sp-5);
  }

  .area__group {
    display: grid;
    gap: var(--sp-1);
    break-inside: avoid;
    min-width: 0;
  }

  .area__county {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .area__cities {
    color: var(--text);
    max-width: 40em;
  }

  .area__city {
    display: inline;
  }

  .area__city.is-hq .area__name {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  /* The one red detail that means "here" (rule 7, round 3) */
  .area__hq {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--signal);
  }

  /* ── How we run a job: five short paragraphs, the step name run in ── */
  .steps {
    display: grid;
    gap: var(--sp-4);
  }

  .step p {
    max-width: 38em;
    color: var(--text);
  }

  .step__title {
    font-weight: 600;
    color: var(--ink);
  }

  .steps__promise {
    margin-top: var(--sp-6);
    max-width: 38em;
    font-weight: 500;
    color: var(--ink);
  }

  /* ── Placeholder slots (hidden on the live site) ── */
  .timeline {
    display: grid;
    gap: var(--sp-5);
    margin-top: var(--space-block);
  }

  .timeline__rows {
    display: grid;
    gap: var(--sp-4);
  }

  .timeline__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--col-gap);
    align-items: baseline;
  }

  .timeline__year {
    font-size: 1.25rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem var(--col-gap);
  }

  .member {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .member__photo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    margin-bottom: 0.5rem;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .member__photo .member__flag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }

  .member__name {
    font-weight: 500;
    color: var(--steel);
  }

  .team__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-block);
  }

  @media (hover: hover) and (pointer: fine) {
    .block__intro a:hover,
    .system__name a:hover {
      color: var(--signal);
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 640px) {
    .systems {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Counties in two balanced columns */
    .area {
      display: block;
      column-count: 2;
      column-gap: var(--col-gap);
    }

    .area__group {
      margin-bottom: var(--sp-5);
    }

    .timeline__row {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .block {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .block__head {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .block__body {
      grid-column: 5 / -1;
    }

    .story {
      gap: var(--sp-7);
    }

    .systems {
      gap: var(--sp-7) var(--col-gap);
    }

    .team__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
