---
/**
 * Projects index. All entries in `projects` are placeholders until Armak supplies real,
 * permissioned case studies — the page says so plainly.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/pages/PageHero.astro';
import PageCta from '../../components/pages/PageCta.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { site, FOUNDED, serviceArea } from '../../data/site';
import { publishedProjects as projects, showProjects } from '../../data/content';

// Hidden until real projects exist: send anyone who lands here to the homepage
if (!showProjects) return Astro.redirect('/');

const description =
  'Structured cabling, networking and security projects by Armak Technologies across Southern California, with scope, sector and outcome for each install.';
---

<Base title="Projects & Case Studies" description={description} footerCta={false}>
  <PageHero
    label="Projects"
    title="Projects we’ve delivered."
    lead="Case studies from across Southern California: the site, the constraints, what we installed and what we handed over."
    crumbs={[{ label: 'Projects' }]}
    spec={[`${site.projectsDelivered}+ projects since ${FOUNDED}`, `${serviceArea.length} cities served`, 'Every install tested & documented']}
  />

  <section class="container plist" aria-label="Projects">
    <ul role="list" class="plist__grid" data-reveal-group="scale">
      {projects.map((p) => (
        <li>
          <ProjectCard project={p} headingLevel="h2" />
        </li>
      ))}
    </ul>
  </section>

  <PageCta
    code="projects-index"
    title="Send us your project."
    body="Tell us what you’re building. We’ll walk the site, scope the work and send you a clear written estimate."
  />
</Base>

<style>
  .plist {
    display: grid;
    gap: var(--col-gap);
  }

  .plist__grid {
    display: grid;
    gap: var(--col-gap);
  }

  @media (min-width: 1024px) {
    .plist__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
