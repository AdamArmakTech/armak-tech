---
/**
 * Privacy policy (CalOPPA). Plain English and limited to what the site really does. The page names kinds of
 * services, not companies, as the law asks and as other contractors do (owner, 2026-11-05). The real ones,
 * for the record: contact form → Web3Forms → Proofpoint spam filter → Microsoft 365 (GoDaddy) sales inbox;
 * hCaptcha human check on form step 2; Vercel hosting logs; OpenFreeMap map tiles; no analytics or ads,
 * no cookies set by the site itself (checked in the code 2026-10-29, wording updated 2026-11-05).
 * Armak should review the wording.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import { site } from '../data/site';

const effective = 'November 5, 2026';
const description = `How ${site.name} handles the information you send through armak.tech, including the contact form. No ads, no tracking, and your details are never sold.`;
---

<Base title="Privacy Policy" description={description}>
  <PageHero
    label="Privacy"
    title="Privacy policy."
    lead={`What ${site.name} collects through this website, why, and what you can ask us to do with it. Effective ${effective}.`}
    crumbs={[{ label: 'Privacy' }]}
  />

  <article class="privacy container" data-reveal-group>
    <section>
      <h2 class="t-h3">What we collect and why</h2>
      <p>
        The contact form sends us what you type: your name, company (optional), email address, phone number, the
        kind of project and your message, plus which kind of request it is and, if you came from a link on this site,
        the topic of that link. We use it to reply to you, schedule a site assessment and scope your project, and for
        nothing else. We keep those emails as business records. Like nearly every website, our web host keeps
        standard server logs: your IP address, browser type and the pages you visit.
      </p>
    </section>

    <section>
      <h2 class="t-h3">Who else sees it</h2>
      <p>
        Only the services that run this website and our email: hosting, delivery of the form to our inbox, email and
        spam filtering, the human check on the form, and the map on our service-area page. Each gets only what it
        needs for that job, such as what you typed or your IP address. We never sell your information or share it for
        marketing, and we share it otherwise only when the law requires it.
      </p>
    </section>

    <section>
      <h2 class="t-h3">Cookies and tracking</h2>
      <p>
        This site sets no cookies and has no analytics, ads or tracking, by us or by anyone else, so a “Do Not Track”
        signal changes nothing. The one exception: the human check on the contact form may store data in your browser
        while it runs.
      </p>
    </section>

    <section>
      <h2 class="t-h3">Your choices</h2>
      <p>
        To get a copy of what you’ve sent us, or to correct it, email <a href={site.emailHref}>{site.email}</a> or
        call <a href={site.phoneHref}>{site.phone}</a>.
      </p>
    </section>

    <section>
      <h2 class="t-h3">Changes</h2>
      <p>
        This website is for businesses and isn’t directed at children under 13. If this policy changes, the new
        version appears here with a new date. This version is effective {effective}.
      </p>
    </section>
  </article>
</Base>

<style>
  .privacy {
    display: grid;
    gap: 2.5rem;
    max-width: 46rem;
    padding-block: 1rem var(--space-section);
  }

  .privacy section {
    display: grid;
    gap: 0.875rem;
    padding-top: 1.5rem;
  }

  .privacy p,
  .privacy li {
    color: var(--text);
    line-height: 1.65;
  }

  .privacy strong {
    color: var(--ink);
    font-weight: 600;
  }

  .privacy ul {
    display: grid;
    gap: 0.625rem;
    padding-left: 1.25rem;
  }

  .privacy a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .privacy a:hover {
    color: var(--signal);
  }
</style>
