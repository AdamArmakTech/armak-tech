---
/**
 * /glossary/ — plain-English A–Z of low-voltage terms.
 * Every term is a <details> (works without JS, fully indexable). With JS, opening a term shows it
 * in a side drawer (bottom sheet on phones) with its Q&A; search, category chips and an A–Z bar filter.
 * Content: src/data/glossary/*.ts (merged + validated in index.ts).
 */
import { ChevronRight, Search, X } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/pages/PageHero.astro';
import PageCta from '../components/pages/PageCta.astro';
import TermDetail from '../components/glossary/TermDetail.astro';
import Button from '../components/ui/Button.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import { glossary, groups, alphabet, categoryLabels, type GlossaryCategory } from '../data/glossary';
import { site } from '../data/site';
import { contactHref } from '../lib/cta';

const usedCategories = (Object.keys(categoryLabels) as GlossaryCategory[]).filter((c) =>
  glossary.some((e) => e.category === c),
);
const lettersWithTerms = new Set(groups.map((g) => g.letter));

// Search ignores case, spaces, hyphens and dots, and treats "fibre" as "fiber" (so "wifi" finds Wi-Fi, "cat6" finds Cat 6).
const squash = (t: string) => t.toLowerCase().replace(/fibre/g, 'fiber').replace(/[\s.\-]+/g, '');
const haystack = (e: (typeof glossary)[number]) =>
  squash([e.term, e.stands_for, ...(e.aka ?? []), e.definition].filter(Boolean).join(' '));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${site.url}/glossary/`,
  name: `${site.name} glossary of low-voltage, networking and security terms`,
  hasDefinedTerm: glossary.map((e) => ({
    '@type': 'DefinedTerm',
    '@id': `${site.url}/glossary/#${e.slug}`,
    name: e.term,
    ...(e.stands_for ? { alternateName: e.stands_for } : {}),
    description: e.definition,
    inDefinedTermSet: `${site.url}/glossary/`,
  })),
};
---

<Base
  title="Glossary of Low-Voltage & Network Terms"
  description="Plain-English A–Z of cabling, networking, security camera, access control, phone and AV terms, with answers to the questions people ask."
  footerCta={false}
>
  <JsonLd data={jsonLd} slot="head" />

  <PageHero
    title="Low-voltage terms, in plain English."
    lead="Cabling, networks, cameras, doors, phones and AV come with a lot of jargon. Here’s what each word means, why it matters to your building, and the questions people usually ask. No background needed."
    crumbs={[{ label: 'Glossary' }]}
  >
    <p class="gl__stats">{glossary.length} terms in {usedCategories.length} categories. Tap any term for its Q&A.</p>
    <div slot="aside" class="gl-aside">
      <label class="gl-search" for="gl-search-input">
        <Search size={20} stroke-width={1.75} aria-hidden="true" />
        <span class="visually-hidden">Search the glossary</span>
        <input id="gl-search-input" type="search" placeholder="Search a term, like PoE" autocomplete="off" data-gl-search />
      </label>
    </div>
  </PageHero>

  <section class="gl container" aria-label="Glossary terms" data-gl>
    <div class="gl__toolbar">
      <nav class="gl__az" aria-label="Jump to letter">
        {alphabet.map((l) =>
          lettersWithTerms.has(l) ? (
            <a href={`#letter-${l === '#' ? 'num' : l}`} data-gl-letter={l}>{l}</a>
          ) : (
            <span aria-hidden="true" class="is-empty">{l}</span>
          ),
        )}
      </nav>
      <div class="gl__cats" role="group" aria-label="Filter by category">
        <label class="chip"><input type="radio" name="gl-cat" value="all" checked data-gl-cat /><span>All</span></label>
        {usedCategories.map((c) => (
          <label class="chip"><input type="radio" name="gl-cat" value={c} data-gl-cat /><span>{categoryLabels[c]}</span></label>
        ))}
      </div>
    </div>

    <p class="gl__status t-meta" aria-live="polite" data-gl-status></p>

    {groups.map((g) => (
      <section class="gl__group" id={`letter-${g.letter === '#' ? 'num' : g.letter}`} data-gl-group={g.letter} aria-labelledby={`gl-h-${g.letter === '#' ? 'num' : g.letter}`}>
        <h2 class="gl__letter" id={`gl-h-${g.letter === '#' ? 'num' : g.letter}`}>{g.letter === '#' ? '0–9' : g.letter}</h2>
        <ul role="list" class="gl__list">
          {g.entries.map((e) => (
            <li data-gl-term={e.slug} data-cat={e.category} data-search={haystack(e)}>
              <details class="term" id={e.slug}>
                <summary class="term__summary">
                  <span class="term__name">{e.term}</span>
                  {e.stands_for && <span class="term__expansion">{e.stands_for}</span>}
                  <ChevronRight class="term__chev" size={18} stroke-width={1.75} aria-hidden="true" />
                </summary>
                <div class="term__body" data-term-body data-term-title={e.term}>
                  <TermDetail entry={e} />
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="gl__empty" hidden data-gl-empty>
      No terms match that search. Try a shorter word, or <a href="/contact/">ask us directly</a>.
    </p>
  </section>

  <dialog class="gl-drawer" aria-labelledby="gl-drawer-title" data-gl-drawer data-lenis-prevent>
    <div class="gl-drawer__head">
      <p class="t-meta">Glossary</p>
      <button class="gl-drawer__close" type="button" data-gl-close>
        <X size={22} stroke-width={1.5} aria-hidden="true" />
        <span class="visually-hidden">Close</span>
      </button>
    </div>
    <h2 class="t-h2 gl-drawer__title" id="gl-drawer-title" data-gl-drawer-title></h2>
    <div class="gl-drawer__body" data-gl-drawer-body></div>
    <div class="gl-drawer__cta">
      <p class="t-meta">Not sure what your building needs?</p>
      <Button href={contactHref({ mode: 'quick' })} icon="arrow" data-gl-drawer-cta>Ask about this term</Button>
    </div>
  </dialog>

  <PageCta
    code="glossary"
    title="Talk it through with us."
    body="Tell us about the building. We’ll walk the site and explain the plan in plain English."
  />
</Base>

<script>
  import { prefersReducedMotion } from '../scripts/demo';
  import { contactHref } from '../lib/cta';

  const root = document.querySelector<HTMLElement>('[data-gl]');
  const drawer = document.querySelector<HTMLDialogElement>('[data-gl-drawer]');
  const drawerTitle = document.querySelector<HTMLElement>('[data-gl-drawer-title]');
  const drawerBody = document.querySelector<HTMLElement>('[data-gl-drawer-body]');
  const search = document.querySelector<HTMLInputElement>('[data-gl-search]');
  const status = document.querySelector<HTMLElement>('[data-gl-status]');
  const empty = document.querySelector<HTMLElement>('[data-gl-empty]');

  if (root && drawer && drawerTitle && drawerBody) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-gl-term]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-gl-group]')];
    const letters = [...root.querySelectorAll<HTMLAnchorElement>('[data-gl-letter]')];
    const total = items.length;

    /* ── Pinned toolbar height ──────────────────────────── */
    // The stylesheet already holds a safe height for each width (--gl-toolbar-h). This swaps in the real one,
    // so bigger text or an extra row of chips can't push the toolbar over a term the keyboard just focused.
    const toolbar = root.querySelector<HTMLElement>('.gl__toolbar');
    if (toolbar && 'ResizeObserver' in window) {
      const syncToolbarHeight = () => {
        const pinned = getComputedStyle(toolbar).position !== 'static';
        root.style.setProperty('--gl-toolbar-h', pinned ? `${toolbar.offsetHeight}px` : '0px');
      };
      syncToolbarHeight();
      new ResizeObserver(syncToolbarHeight).observe(toolbar);
      window.addEventListener('resize', syncToolbarHeight);
    }

    /* ── Drawer ─────────────────────────────────────────── */
    const openTerm = (slug: string, { updateHash = true } = {}) => {
      const details = document.getElementById(slug) as HTMLDetailsElement | null;
      const body = details?.querySelector<HTMLElement>('[data-term-body]');
      if (!details || !body) return;

      drawerTitle.textContent = body.dataset.termTitle ?? '';
      const cta = drawer.querySelector<HTMLAnchorElement>('[data-gl-drawer-cta]');
      if (cta) cta.href = contactHref({ about: body.dataset.termTitle ?? '', mode: 'quick' });
      drawerBody.replaceChildren(...[...body.children].map((n) => n.cloneNode(true)));
      drawerBody.scrollTop = 0;

      if (!drawer.open) {
        drawer.showModal();
        window.armakLenis?.stop();
      }
      if (updateHash) history.replaceState(null, '', `#${slug}`);
    };

    const closeDrawer = () => drawer.close();

    drawer.addEventListener('close', () => {
      drawer.style.transition = '';
      drawer.style.transform = '';
      window.armakLenis?.start();
      history.replaceState(null, '', location.pathname + location.search);
    });

    // Click on the dimmed backdrop (outside the panel) closes it
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) closeDrawer();
    });
    document.querySelector('[data-gl-close]')?.addEventListener('click', closeDrawer);

    // Phones: drag the header down to dismiss the sheet. Only the header starts a drag, so the content still scrolls.
    const dragHead = drawer.querySelector<HTMLElement>('.gl-drawer__head');
    const phone = window.matchMedia('(max-width: 639px)');
    if (dragHead) {
      let startY = 0;
      let lastY = 0;
      let lastT = 0;
      let velocity = 0;
      let dragging = false;
      let pid = -1;
      const settle = (ms: number, y: string) => {
        drawer.style.transition = prefersReducedMotion() ? 'none' : `transform ${ms}ms var(--ease-out)`;
        drawer.style.transform = y;
      };
      dragHead.addEventListener('pointerdown', (e) => {
        if (!phone.matches || !drawer.open || (e.target as Element).closest('button')) return;
        dragging = true;
        pid = e.pointerId;
        startY = lastY = e.clientY;
        lastT = e.timeStamp;
        velocity = 0;
        drawer.style.transition = 'none';
        dragHead.setPointerCapture(pid);
      });
      dragHead.addEventListener('pointermove', (e) => {
        if (!dragging || e.pointerId !== pid) return;
        const dt = e.timeStamp - lastT;
        if (dt > 0) velocity = (e.clientY - lastY) / dt;
        lastY = e.clientY;
        lastT = e.timeStamp;
        drawer.style.transform = `translateY(${Math.max(0, e.clientY - startY)}px)`;
      });
      const release = (e: PointerEvent) => {
        if (!dragging || e.pointerId !== pid) return;
        dragging = false;
        const dy = Math.max(0, e.clientY - startY);
        if (dy > drawer.offsetHeight * 0.3 || velocity > 0.6) {
          if (prefersReducedMotion()) closeDrawer();
          else {
            settle(160, 'translateY(100%)');
            window.setTimeout(closeDrawer, 160);
          }
        } else if (dy > 0) {
          settle(240, 'translateY(0)');
        }
      };
      dragHead.addEventListener('pointerup', release);
      dragHead.addEventListener('pointercancel', release);
    }

    // Term summaries open the drawer instead of expanding inline
    root.addEventListener('click', (e) => {
      const summary = (e.target as Element).closest('summary.term__summary');
      if (!summary) return;
      e.preventDefault();
      const details = summary.parentElement as HTMLDetailsElement;
      openTerm(details.id);
    });

    // Related-term chips (inside the drawer or inline) switch to that term
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest<HTMLAnchorElement>('[data-term-link]');
      if (!link) return;
      e.preventDefault();
      openTerm(link.dataset.termLink!);
    });

    // Shared links like /glossary/#poe open straight to the term — on load, and when only the
    // hash changes on an already-open page (in-page links, back/forward)
    const openFromHash = () => {
      let slug = '';
      try {
        slug = decodeURIComponent(location.hash.slice(1));
      } catch {
        return; // malformed hash: ignore it rather than stop the search and filters below
      }
      if (slug && document.getElementById(slug)?.matches('details.term')) {
        requestAnimationFrame(() => openTerm(slug, { updateHash: false }));
      }
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);

    /* ── Search + category filter ───────────────────────── */
    let category = 'all';

    const applyFilter = () => {
      const q = (search?.value ?? '').toLowerCase().replace(/fibre/g, 'fiber').replace(/[\s.\-]+/g, '');
      let shown = 0;

      for (const li of items) {
        const match = (category === 'all' || li.dataset.cat === category) && (!q || li.dataset.search!.includes(q));
        li.hidden = !match;
        if (match) shown++;
      }

      for (const g of groups) {
        const visible = g.querySelector('[data-gl-term]:not([hidden])');
        g.hidden = !visible;
        const letter = letters.find((a) => a.dataset.glLetter === g.dataset.glGroup);
        letter?.classList.toggle('is-empty', !visible);
      }

      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = shown === total ? '' : `${shown} of ${total} terms`;
    };

    search?.addEventListener('input', applyFilter);
    root.querySelectorAll<HTMLInputElement>('[data-gl-cat]').forEach((r) =>
      r.addEventListener('change', () => {
        category = r.value;
        applyFilter();
      }),
    );
  }
</script>

<style>
  /* ── Search ── */
  .gl-aside {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: var(--white);
    border-radius: var(--radius);
  }

  .gl-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.25rem 1rem;
    background: var(--paper-sunken);
    border-radius: var(--radius);
  }

  .gl-search:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .gl__stats {
    margin-bottom: var(--sp-4);
    color: var(--text);
  }

  .gl-search input {
    flex: 1;
    min-width: 0;
    padding: 0.875rem 0;
    border: 0;
    background: transparent;
    font-size: 1.0625rem;
  }

  .gl-search input:focus {
    outline: none;
  }

  /* The browser's default placeholder grey is 4.15:1 on the paper; the form-field token is 4.7:1 (WCAG 1.4.3). */
  .gl-search input::placeholder {
    color: var(--placeholder);
    opacity: 1;
  }

  /* ── Toolbar (pinned under the header on phones and from 1024px up) ── */
  .gl {
    padding-bottom: var(--space-block);
  }

  /* Sticky only on wide screens: wrapped letters and chips would cover most of a phone screen */
  .gl__toolbar {
    position: static;
    top: var(--header-h);
    z-index: 5;
    display: grid;
    gap: 0.875rem;
    padding-block: 1rem;
    margin-bottom: 1rem;
    background: var(--paper);
  }

  @media (min-width: 1024px) {
    .gl__toolbar {
      position: sticky;
    }
  }

  /*
   * How tall the toolbar is while it is pinned. The terms below it use this as their scroll-margin-top.
   * When the keyboard moves focus to a term (Shift+Tab especially), the browser scrolls it up to html's
   * scroll-padding-top, which is the header plus 1rem and sits above the bottom of the toolbar, so the
   * focused term stopped behind the toolbar (WCAG 2.4.11, focus not obscured). The extra margin lands it
   * just below the toolbar instead.
   * Phones: 139px, the A-Z bar and the chips are one-line strips. 1024px up: 239px, the height with two rows
   * of chips. With one row it is 185px: the script in this file swaps in the real height, and without scripts
   * the spare 54px does no harm. 640-1023px: the toolbar is not pinned, so 0 (see that media query below).
   */
  .gl {
    --gl-toolbar-h: 8.6875rem;
  }

  .gl__az {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem;
  }

  .gl__az::-webkit-scrollbar {
    display: none;
  }

  .gl__az a,
  .gl__az span {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .gl__az a:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .gl__az .is-empty {
    color: var(--hairline-strong);
    pointer-events: none;
  }

  .gl__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 2px;
  }

  .gl__cats::-webkit-scrollbar {
    display: none;
  }

  .gl__cats .chip {
    flex-shrink: 0;
  }

  /*
   * Phones keep one-line strips that swipe sideways. From 640px up there is room for everything, so the
   * A-Z bar and the category chips wrap instead: a mouse can't swipe a strip, and nothing showed that Z or
   * Standards were cut off. The letters are capped at 14 per row so they sit on two even rows (14 + 13).
   */
  @media (min-width: 640px) {
    .gl__az {
      flex-wrap: wrap;
      max-width: 41rem;
      overflow: visible;
    }

    .gl__cats {
      flex-wrap: wrap;
      overflow: visible;
    }
  }

  .gl__status:empty {
    display: none;
  }

  /* ── Letter groups ── */
  .gl__group {
    display: grid;
    gap: 1rem;
    padding-block: var(--sp-6);
    /* the html scroll-padding already clears the header; this clears the pinned toolbar below it */
    scroll-margin-top: var(--gl-toolbar-h);
  }

  /* display:grid above beats the browser's [hidden] rule, so letters with no matching term stayed on screen
     as empty rows (the first result sat under 0-9, A and B) */
  .gl__group[hidden] {
    display: none;
  }

  .gl__letter {
    font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .gl__list {
    display: grid;
    gap: 0.5rem var(--col-gap);
  }

  @media (min-width: 640px) {
    .gl__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /*
   * 640-1023px: the wrapped toolbar is up to 285px tall, too much to pin under the header, so it scrolls
   * with the page. Nothing is pinned, so a letter jump or a focused term only has to clear the header
   * (html scroll-padding-top).
   */
  @media (min-width: 640px) and (max-width: 1023px) {
    .gl__toolbar {
      position: static;
    }

    .gl {
      --gl-toolbar-h: 0px;
    }
  }

  @media (min-width: 1024px) {
    .gl__group {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      align-items: start;
    }

    .gl__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .gl {
      /* the pinned toolbar with two rows of chips: 239px (185px with one row) */
      --gl-toolbar-h: 14.9375rem;
    }
  }

  /* ── Term rows ── */
  .term {
    border-bottom: 1px solid var(--hairline);
  }

  /*
   * Keyboard focus and #links scroll a term up to just under the header. Adding the pinned toolbar's height
   * (--gl-toolbar-h, set with the toolbar above) lands it below the toolbar, not behind it. The summary is
   * what takes focus. The links inside a term only take focus in the no-JS fallback, where it opens inline.
   */
  .term,
  .term__summary,
  .term__body :global(a) {
    scroll-margin-top: var(--gl-toolbar-h);
  }

  .term__summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 0.75rem;
    min-height: 44px;
    padding: 0.875rem 0.25rem;
    cursor: pointer;
    list-style: none;
    transition: background var(--dur-fast) ease;
  }

  .term__summary::-webkit-details-marker {
    display: none;
  }

  .term__summary:hover {
    background: var(--white);
  }

  .term__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .term__expansion {
    grid-column: 1;
    font-size: var(--fs-small);
    color: var(--steel);
  }

  .term__chev {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--steel);
    transition: transform var(--dur) var(--ease-out), color var(--dur-fast) ease;
  }

  .term__summary:hover .term__chev {
    color: var(--signal);
  }

  @media (hover: hover) and (pointer: fine) {
    .term__summary:hover .term__chev {
      transform: translateX(3px);
    }
  }

  .term[open] .term__chev {
    transform: rotate(90deg);
  }

  /* No-JS fallback: details expand inline */
  .term__body {
    padding: 0.5rem 0.25rem 1.5rem;
  }

  .gl__empty {
    padding-block: 3rem;
    color: var(--steel);
  }

  .gl__empty a {
    text-decoration: underline;
  }

  /* ── Drawer ── */
  .gl-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(560px, 100vw);
    height: 100dvh;
    max-height: 100dvh;
    max-width: 100vw;
    margin: 0;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    background: var(--paper);
    color: var(--ink);
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .gl-drawer::backdrop {
    background: rgba(11, 13, 16, 0.45);
  }

  .gl-drawer[open] {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .gl-drawer__head {
    touch-action: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .gl-drawer__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border-radius: var(--radius);
  }

  .gl-drawer__close:hover {
    background: var(--white);
  }

  /* Related-term links in the sheet: 44px tap area, no visual change (padding grows the box, margin cancels it) */
  .gl-drawer__body :global(a:not(.btn)) {
    display: inline-block;
    padding-block: 10px;
    margin-block: -10px;
  }

  .gl-drawer__title {
    max-width: 18ch;
  }

  .gl-drawer__cta {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .gl-drawer__cta :global(.btn) {
    white-space: normal;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gl-drawer[open] {
      animation: gl-drawer-in var(--dur) var(--ease-out);
    }

    .gl-drawer[open]::backdrop {
      animation: gl-fade-in var(--dur) ease;
    }
  }

  @keyframes gl-drawer-in {
    from {
      transform: translateX(40px);
      opacity: 0;
    }
  }

  @keyframes gl-fade-in {
    from {
      opacity: 0;
    }
  }

  /* Phones: bottom sheet */
  @media (max-width: 639px) {
    .gl-drawer {
      inset: auto 0 0 0;
      width: 100vw;
      height: auto;
      max-height: 88dvh;
      border-left: 0;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

