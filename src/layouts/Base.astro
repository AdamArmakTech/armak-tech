---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CtaDock from '../components/layout/CtaDock.astro';
import { site } from '../data/site';
import { defaultTitle, defaultDescription, defaultOgImage, businessJsonLd } from '../data/seo';

interface Props {
  /** Page title; " | Armak Technologies" is appended. Omit on the homepage. Aim for ≤ 40 chars. */
  title?: string;
  /** Meta description, 120–155 chars */
  description?: string;
  /** Path to a 1200×630 social image in /public (defaults to /og-image.png) */
  ogImage?: string;
  /** Alt text for a custom ogImage */
  ogImageAlt?: string;
  noindex?: boolean;
  /** Hide the footer's "Let's scope your next build" CTA (for pages that end in a contact form) */
  footerCta?: boolean;
  /** Hide the phone-only sticky CTA bar (pages that are themselves the form) */
  ctaDock?: boolean;
}

const {
  title,
  description = defaultDescription,
  ogImage,
  ogImageAlt,
  noindex = false,
  footerCta = true,
  ctaDock = true,
} = Astro.props;

const siteUrl = Astro.site ?? site.url;
const fullTitle = title ? `${title} | ${site.name}` : defaultTitle;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const image = ogImage
  ? { src: ogImage, alt: ogImageAlt ?? fullTitle, width: undefined, height: undefined }
  : defaultOgImage;
const imageUrl = new URL(image.src, siteUrl).href;
// Escape "<" so no string in the data can close the script element early
const jsonLd = JSON.stringify(businessJsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    {image.width && <meta property="og:image:width" content={String(image.width)} />}
    {image.height && <meta property="og:image:height" content={String(image.height)} />}
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />

    <meta name="theme-color" content="#f4f3ef" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Enables motion styles only when JS runs; motion.ts takes over from here -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {ctaDock && <CtaDock />}
    <Footer cta={footerCta} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
