---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import { site, services, serviceArea, FOUNDED } from '../../data/site';
import { showProjects } from '../../data/content';

interface Props {
  cta?: boolean;
}

const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" data-dock-hide>
  <div class="container">
    {cta && (
    <div class="site-footer__cta">
      <p class="t-h1 site-footer__headline">Let’s scope your<br />next build.</p>
      <div class="site-footer__cta-actions">
        <Button href="/contact/" variant="primary" size="lg">Request a site assessment</Button>
        <Button href={site.phoneHref} variant="outline" size="lg" icon="phone" class="tel">{site.phone}</Button>
      </div>
    </div>
    )}

    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo height={44} />
        <p class="t-small t-muted">{site.description}</p>
      </div>

      <nav aria-label="Services" class="site-footer__col">
        <p class="site-footer__heading">Services</p>
        <ul role="list">
          {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Company" class="site-footer__col">
        <p class="site-footer__heading">Company</p>
        <ul role="list">
          <li><a href="/industries/">Industries</a></li>
          {showProjects && <li><a href="/projects/">Projects</a></li>}
          <li><a href="/about/">About</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>

      <div class="site-footer__col">
        <p class="site-footer__heading">Contact</p>
        <address>
          <ul role="list">
            <li><a class="tel" href={site.phoneHref}>{site.phone}</a></li>
            <li><a href={site.emailHref}>{site.email}</a></li>
            <li>{site.hq.city}, California</li>
            <li class="t-muted">{site.hours}</li>
            <li class="t-muted">{site.support}</li>
          </ul>
        </address>
      </div>
    </div>

    <div class="site-footer__area">
      <p class="site-footer__heading">Serving Southern California</p>
      <p class="t-small t-muted">{serviceArea.map((c) => c.name).join(' · ')}</p>
    </div>

    <div class="site-footer__legal">
      <span>© {year} {site.name}</span>
      <span>Est. {FOUNDED}</span>
      {site.license && <span>{site.license}</span>}
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>
  </div>
</footer>

<style>
  /* Direction A: the footer is paper with ink text and hairline rows (pages end light). */
  .site-footer {
    margin-top: 0;
    background: var(--paper);
    color: var(--ink);
    border-top: 1px solid var(--hairline);
  }

  /* Pages that end in a CTA sheet carry their own gap in the section padding; others get one here. */
  :global(main:not(:has(.cta-band:last-child))) ~ .site-footer {
    margin-top: var(--space-section);
  }

  .site-footer__cta {
    display: grid;
    gap: 2rem;
    padding-block: var(--space-block);
    border-bottom: 1px solid var(--hairline);
  }

  .site-footer__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .site-footer__cta {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: var(--space-block);
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 0.8fr 1fr;
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }

  .site-footer__brand {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    max-width: 30rem;
  }

  .site-footer__heading {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--steel);
    margin-bottom: 1rem;
  }

  .site-footer__col ul {
    display: grid;
    gap: 0.625rem;
    font-size: var(--fs-small);
  }

  /* Taller tap area (about 46px; rows are 34px apart so areas overlap a little, still above the 24px minimum) without changing the spacing: the padding is
     cancelled out by an equal negative margin. */
  .site-footer__col a,
  .site-footer__legal a {
    display: inline-block;
    padding-block: 0.7rem;
    margin-block: -0.7rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-fast) ease;
  }

  .site-footer__col a:hover,
  .site-footer__legal a:hover {
    text-decoration-color: currentColor;
  }

  .site-footer__legal a {
    text-decoration-color: currentColor;
  }

  .site-footer__legal a:hover {
    text-decoration-color: transparent;
  }

  address {
    font-style: normal;
  }

  .site-footer__area {
    padding-block: 2rem;
    border-top: 1px solid var(--hairline);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--steel);
  }
</style>
