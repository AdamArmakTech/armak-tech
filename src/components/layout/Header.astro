---
import { ChevronDown, Menu, X, Phone } from '@lucide/astro';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import { nav as allNav, services, site } from '../../data/site';
import { showProjects } from '../../data/content';

// "Projects" only appears once real projects exist
const nav = allNav.filter((item) => item.href !== '/projects/' || showProjects);
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container site-header__bar">
    <Logo height={36} class="site-header__logo" />

    <nav class="site-nav" aria-label="Primary">
      <ul role="list" class="site-nav__list">
        {nav.map((item) =>
          'mega' in item && item.mega ? (
            <li>
              <button
                type="button"
                class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
                aria-expanded="false"
                aria-controls="mega-services"
                data-mega-toggle
              >
                {item.label}
                <ChevronDown class="site-nav__chev" size={16} stroke-width={1.75} aria-hidden="true" />
              </button>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="site-header__contact">
        <a class="site-header__phone" href={site.phoneHref}>
          <Phone size={15} stroke-width={1.75} aria-hidden="true" />
          {site.phone}
        </a>
        <!-- Filled by the script below from the visitor's clock; empty (and hidden) until then -->
        <span class="site-header__status" data-hours={site.hours} data-header-status hidden></span>
      </div>
      <Button href="/contact/" variant="ink" class="site-header__cta">Request a site assessment</Button>
      <a class="site-header__call" href={site.phoneHref} aria-label={`Call Armak, ${site.phone}`}>
        <Phone size={22} stroke-width={1.5} aria-hidden="true" />
      </a>
      <button type="button" class="site-header__menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Menu</span>
        <Menu class="icon-open" size={24} stroke-width={1.5} aria-hidden="true" />
        <X class="icon-close" size={24} stroke-width={1.5} aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Services mega-menu (desktop) -->
  <div class="mega" id="mega-services" hidden data-mega>
    <div class="container mega__inner">
      <ul role="list" class="mega__grid">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`} class="mega__item">
              <span class="t-mono mega__code">{s.code}</span>
              <span class="mega__name">{s.name}</span>
              <span class="mega__short">{s.short}</span>
            </a>
          </li>
        ))}
      </ul>
      <aside class="mega__aside">
        <p class="t-muted mega__lead">Not sure what you need?</p>
        <p class="t-h4">Book a site assessment. We’ll walk the space and scope it with you.</p>
        <Button href="/contact/" variant="ink">Request a site assessment</Button>
        <a class="mega__all" href="/services/">All services →</a>
      </aside>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" hidden data-menu data-lenis-prevent>
    <div class="container mobile-menu__inner">
      <p class="t-muted mobile-menu__lead">Services</p>
      <ul role="list" class="mobile-menu__services">
        {services.map((s) => (
          <li>
            <a href={`/services/${s.slug}/`}><span class="t-mono">{s.code}</span>{s.name}</a>
          </li>
        ))}
      </ul>
      <ul role="list" class="mobile-menu__primary">
        {nav.filter((n) => !('mega' in n)).map((n) => (
          <li><a href={n.href}>{n.label}</a></li>
        ))}
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <div class="mobile-menu__actions">
        <Button href="/contact/" variant="primary" size="lg">Request a site assessment</Button>
        <Button href={site.phoneHref} variant="outline" size="lg" icon="phone">{site.phone}</Button>
      </div>
    </div>
  </div>
</header>

<script>
  import { parseHours, openStatus } from '../../lib/hours';

  const header = document.querySelector<HTMLElement>('[data-header]');

  if (header) {
    // Hairline + denser background once the page scrolls
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const megaToggle = header.querySelector<HTMLButtonElement>('[data-mega-toggle]');
    const mega = header.querySelector<HTMLElement>('[data-mega]');
    const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = header.querySelector<HTMLElement>('[data-menu]');

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const timers = new WeakMap<HTMLElement, number>();

    const setOpen = (toggle: HTMLButtonElement | null, panel: HTMLElement | null, open: boolean) => {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', String(open));
      if (toggle === menuToggle) {
        const label = toggle.querySelector('[data-menu-label]');
        if (label) label.textContent = open ? 'Close menu' : 'Menu';
      }
      // Drop in/out: `hidden` comes off first so the transition can run, and goes back on once the
      // close transition ends. While closing, the panel is inert so it can't take focus.
      window.clearTimeout(timers.get(panel));
      if (open) {
        panel.hidden = false;
        panel.inert = false;
        void panel.offsetHeight; // commit the start state before the open transition
        panel.setAttribute('data-shown', '');
      } else if (!panel.hidden) {
        panel.removeAttribute('data-shown');
        panel.inert = true;
        if (reduceMotion.matches) panel.hidden = true;
        else timers.set(panel, window.setTimeout(() => { panel.hidden = true; }, 170));
      }
      header.toggleAttribute(
        'data-open',
        megaToggle?.getAttribute('aria-expanded') === 'true' || menuToggle?.getAttribute('aria-expanded') === 'true',
      );
    };

    megaToggle?.addEventListener('click', () => {
      const open = megaToggle.getAttribute('aria-expanded') !== 'true';
      setOpen(megaToggle, mega, open);
      // The panel sits after the header actions in the DOM, so move focus into it
      if (open) mega?.querySelector<HTMLElement>('.mega__item')?.focus();
    });

    // Shift+Tab from the panel's first link goes back to the Services button, not past it to the CTA
    mega?.addEventListener('keydown', (e) => {
      if (e.key === 'Tab' && e.shiftKey && e.target === mega.querySelector('a')) {
        e.preventDefault();
        megaToggle?.focus();
      }
    });

    // Pause smooth scroll (Lenis) while the menu is open; fall back to overflow when it isn't running
    const lockScroll = (lock: boolean) => {
      if (window.armakLenis) {
        if (lock) window.armakLenis.stop();
        else window.armakLenis.start();
      } else {
        document.documentElement.style.overflow = lock ? 'hidden' : '';
      }
    };

    // Keep keyboard focus inside the open mobile menu
    const setBackgroundInert = (inert: boolean) => {
      document.querySelectorAll('main, footer').forEach((el) => el.toggleAttribute('inert', inert));
    };

    menuToggle?.addEventListener('click', () => {
      const open = menuToggle.getAttribute('aria-expanded') !== 'true';
      setOpen(menuToggle, menu, open);
      lockScroll(open);
      setBackgroundInert(open);
    });

    const closeAll = () => {
      const menuWasOpen = menuToggle?.getAttribute('aria-expanded') === 'true';
      setOpen(megaToggle, mega, false);
      setOpen(menuToggle, menu, false);
      if (menuWasOpen) {
        lockScroll(false);
        setBackgroundInert(false);
      }
    };

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const wasMega = megaToggle?.getAttribute('aria-expanded') === 'true';
      const wasMenu = menuToggle?.getAttribute('aria-expanded') === 'true';
      closeAll();
      if (wasMega) megaToggle?.focus();
      else if (wasMenu) menuToggle?.focus();
    });

    // Close the panels once keyboard focus moves to something outside the header.
    // A null relatedTarget (click on blank space, window blur) is left to the click handler.
    header.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      if (to && !header.contains(to)) closeAll();
    });

    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) closeAll();
    });

    // Leaving desktop width with the mobile menu open shouldn't lock scrolling
    matchMedia('(min-width: 1024px)').addEventListener('change', closeAll);

    // Open/closed line next to the phone number, refreshed every minute
    const statusEl = header.querySelector<HTMLElement>('[data-header-status]');
    const hours = statusEl ? parseHours(statusEl.dataset.hours ?? '') : null;
    if (statusEl && hours) {
      const update = () => {
        const s = openStatus(new Date(), hours);
        statusEl.textContent = s.label;
        statusEl.hidden = !s.label;
        statusEl.toggleAttribute('data-open-now', s.open);
      };
      update();
      const timer = window.setInterval(update, 60_000);
      window.addEventListener('pagehide', () => window.clearInterval(timer), { once: true });
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) ease;
  }

  /* Blur lives on a pseudo-element: backdrop-filter on the header itself would make it
     the containing block for the position:fixed mobile menu and collapse it. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    transition: background var(--dur) ease;
  }

  .site-header[data-scrolled],
  .site-header[data-open] {
    border-bottom-color: var(--hairline);
  }

  .site-header[data-scrolled]::before,
  .site-header[data-open]::before {
    background: color-mix(in srgb, var(--paper) 96%, transparent);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }

  /* Logo link: 36 px image, 44 px tall tap area (invisible, vertical only so it never reaches the buttons beside it) */
  .site-header :global(.site-header__logo) {
    position: relative;
  }

  .site-header :global(.site-header__logo)::after {
    content: "";
    position: absolute;
    inset-block: -4px;
    inset-inline: 0;
  }

  /* ── Primary nav (desktop) ── */
  .site-nav {
    display: none;
  }

  .site-nav__list {
    display: flex;
    gap: 0.25rem;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--steel);
    border-radius: var(--radius);
    transition: color var(--dur-fast) ease;
  }

  .site-nav__link:hover,
  .site-nav__link[aria-expanded='true'],
  .site-nav__link.is-active {
    color: var(--ink);
  }

  .site-nav__chev {
    transition: transform var(--dur) var(--ease-out);
  }

  .site-nav__link[aria-expanded='true'] .site-nav__chev {
    transform: rotate(180deg);
  }

  /* ── Right side ── */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
  }

  /* Phone number with the open/closed line under it; desktop only (no room below 1024) */
  .site-header__contact {
    display: none;
  }

  .site-header__status {
    font-size: var(--fs-label);
    line-height: 1.3;
    color: var(--steel);
    white-space: nowrap;
  }

  .site-header__status[hidden] {
    display: none;
  }

  .site-header__status[data-open-now] {
    color: var(--ink);
  }

  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Call icon for phones and tablets, where the full number is hidden */
  .site-header__call {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--ink);
  }

  .site-header__call:hover {
    color: var(--signal);
  }

  .site-header__phone:hover {
    color: var(--signal);
  }

  /* :global — the class lands on the child Button component, outside this component's scope */
  .site-header__actions :global(.site-header__cta) {
    display: none;
  }

  .site-header__menu {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
  }

  .site-header__menu .icon-close,
  .site-header__menu[aria-expanded='true'] .icon-open {
    display: none;
  }

  .site-header__menu[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (min-width: 640px) {
    .site-header__actions :global(.site-header__cta) {
      display: inline-flex;
    }
  }

  @media (min-width: 1024px) {
    .site-nav {
      display: block;
    }

    .site-header__menu {
      display: none;
    }

    /* Tighter gap so logo, nav, full number and CTA fit at exactly 1024px */
    .site-header__bar {
      gap: 1.25rem;
    }

    /* Full number replaces the call icon; the CTA is the last item, so both edges use the container padding */
    .site-header__contact {
      display: grid;
      justify-items: start;
      gap: 0.125rem;
    }

    .site-header__call {
      display: none;
    }
  }

  /* ── Mega-menu ── */
  .mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
    box-shadow: var(--shadow-raise);
  }

  /* Drop from the header: start state is up 8px and clear; close is faster than open */
  .mega,
  .mobile-menu {
    opacity: 0;
    transform: translate3d(0, -8px, 0);
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .mega[data-shown],
  .mobile-menu[data-shown] {
    opacity: 1;
    transform: none;
    transition-duration: 240ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega,
    .mobile-menu {
      transition: none;
    }
  }

  .mega__inner {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--col-gap);
    padding-block: 2rem 2.5rem;
  }

  .mega__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }

  .mega__item {
    display: grid;
    gap: 0.375rem;
    height: 100%;
    padding: 1.25rem;
    background: var(--paper);
    transition: background var(--dur-fast) ease;
  }

  .mega__item:hover {
    background: var(--white);
  }

  .mega__code {
    color: var(--steel);
  }

  .mega__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .mega__short {
    font-size: 0.875rem;
    color: var(--steel);
    line-height: 1.45;
  }

  .mega__aside {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--white);
    border: 1px solid var(--hairline);
  }

  .mega__all {
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .mega__all:hover {
    color: var(--signal);
  }

  .mega__lead,
  .mobile-menu__lead {
    font-size: var(--fs-small);
    font-weight: 500;
  }

  @media not all and (min-width: 1024px) {
    .mega {
      display: none;
    }
  }

  /* ── Mobile menu ── */
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    overflow-y: auto;
    background: var(--paper);
    border-top: 1px solid var(--hairline);
  }

  .mobile-menu__inner {
    display: grid;
    gap: 1rem;
    padding-block: 1.5rem 3rem;
  }

  .mobile-menu__services {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .mobile-menu__services a {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--hairline);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .mobile-menu__services .t-mono {
    color: var(--steel);
    min-width: 3.25rem;
  }

  .mobile-menu__primary {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
  }

  .mobile-menu__primary a {
    display: block;
    padding-block: 0.375rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .mobile-menu__actions {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 1024px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
