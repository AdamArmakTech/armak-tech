---
/**
 * Install — "The closet, before and after".
 * The same rack drawn two ways (tangled vs dressed + labeled) with a before/after slider, then a
 * 3-step timeline (pre-staged → after-hours install → cutover).
 * Teaches: a clean, labeled install is traceable and easy to change; work is planned around the
 * business. The slider works without JS animation; the script auto-sweeps it once, then hands over.
 *
 * Cable colours: cable jacket colours in this drawing code a drop's purpose (owner, 2026-11-06).
 * They are not status colours, so DESIGN.md rule 7 (red = next action, green = PASS only) does not
 * apply to them. Meanings follow the TIA-606 termination-field colours (see the legend).
 */
import DemoFrame from './DemoFrame.astro';
import TraceDemo from './TraceDemo.astro';
import { signature, isShown, installPhases } from '../../data/content';

const labelsAtBothEnds = isShown(signature.items.labelsAndAsBuilts);
const showHeadroom = signature.items.rackHeadroom.confirmed === 'yes';

// Stable id (no random part, so builds are repeatable): rendered once per page.
const uid = 'in-demo';

// Geometry (viewBox 400 × 215)
const portX = (i: number) => 133 + i * 11; // 12 ports per row
const PANEL_TOP = 32; // top-row ports y
const SWITCH_TOP = 104; // switch top-row ports y
const LABEL_X = 284; // right-hand label column, just outside the rack rail

// Deterministic "random" for the tangled version
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const pick = <T,>(a: T[]) => a[Math.floor(rand() * a.length)];
// Tangled version: a random-looking mix of cable colours with no system to it (shapes stay the same
// because pick() uses one rand() call whatever the list length).
const messColors = [
  'var(--cable-blue)', 'var(--cable-orange)', 'var(--ink)', 'var(--cable-green)', 'var(--cable-white)',
  'var(--steel)', 'var(--cable-orange)', 'var(--cable-blue)', 'var(--steel-light)', 'var(--cable-green)',
  'var(--cable-white)', 'var(--ink)',
];
const isWhite = (c: string) => c === 'var(--cable-white)';

// Old, abandoned cables that go nowhere: solid run, then a dashed dead end (or a coil / taped end)
const oldWires = [
  { d: 'M104 0 C 104 50, 150 80, 140 132', tail: 'M140 132 C 137 142, 147 150, 142 162' }, // loose end hanging past the switch
  { d: 'M62 0 C 72 36, 110 66, 121 92 C 100 80, 96 108, 118 108 C 134 108, 130 90, 112 92', tail: '' }, // coil hooked on the rail
  { d: 'M82 0 C 84 56, 60 96, 70 138', tail: 'M70 138 C 69 142, 70 144, 70 147', tape: { x1: 65, y1: 136, x2: 75, y2: 139 } }, // taped off
  { d: 'M240 0 C 252 56, 214 94, 232 136', tail: 'M232 136 C 236 146, 228 152, 233 164' }, // another loose end
];

const messyFeeds = Array.from({ length: 14 }, () => {
  const x0 = 110 + rand() * 180;
  const p = portX(Math.floor(rand() * 12)) + 4;
  return { d: `M${x0.toFixed(1)} 0 C ${(x0 + (rand() - 0.5) * 140).toFixed(1)} 20, ${(p + (rand() - 0.5) * 120).toFixed(1)} 6, ${p} ${PANEL_TOP}`, c: pick(messColors) };
});
const messyCords = Array.from({ length: 11 }, () => {
  const a = portX(Math.floor(rand() * 12)) + 4;
  const b = portX(Math.floor(rand() * 12)) + 4;
  const sag = 150 + rand() * 50;
  const side = (rand() - 0.5) * 160;
  return { d: `M${a} 39 C ${(a + side).toFixed(1)} ${sag.toFixed(1)}, ${(b - side).toFixed(1)} ${(sag - 20).toFixed(1)}, ${b} ${SWITCH_TOP}`, c: pick(messColors) };
});

// Dressed version: 4 bundles of 6 feeding the panel from above, 12 short cords straight down
const bundles = [0, 1, 2, 3].map((k) => ({
  lines: Array.from({ length: 6 }, (_, j) => 140 + k * 33 + j * 3),
  tie: 136 + k * 33,
  label: `A-${String(k * 6 + 1).padStart(2, '0')}–${String(k * 6 + 6).padStart(2, '0')}`,
  x: 147 + k * 33,
}));
type Cable = 'blue' | 'green' | 'orange' | 'white';
// Colour by purpose, grouped so the order looks intentional: blue horizontal drops first, then
// green equipment links, then the orange carrier hand-off and white backbone together.
const feedColors: Cable[][] = [
  ['blue', 'blue', 'blue', 'blue', 'blue', 'blue'],
  ['blue', 'blue', 'blue', 'blue', 'blue', 'blue'],
  ['blue', 'blue', 'blue', 'blue', 'green', 'green'],
  ['orange', 'orange', 'white', 'white', 'green', 'green'],
];
const cordColor = (i: number): Cable => (i < 7 ? 'blue' : i < 9 ? 'green' : i === 9 ? 'orange' : 'white');
const cords = Array.from({ length: 12 }, (_, i) => ({ x: portX(i) + 4, color: cordColor(i) }));

// TIA-606 termination-field colour meanings (plain words, one row per colour)
const legend: { color: Cable; text: string }[] = [
  { color: 'blue', text: 'Horizontal drops' },
  { color: 'green', text: 'Network gear' },
  { color: 'orange', text: 'Carrier hand-off' },
  { color: 'white', text: 'Backbone' },
];
const H = 258; // drawing height: the rack plus the legend under the label column
const legendY = (i: number) => 207 + i * 14;

const steps = installPhases;
---

<div class="in-pair">
<DemoFrame
  name="install"
  title="The closet, before and after"
  caption="Same closet, installed two ways. Drag the slider. When cables are dressed and every port is labeled, anyone can trace a connection in seconds and future changes are quick."
>
  <div class="in">
    <div class="in__compare">
      <svg class="in__rack" viewBox={`0 0 400 ${H}`} role="img" data-fit-text aria-label="A network rack shown two ways: on the left, tangled unlabeled cables in mixed colors plus old unused cables; on the right, neatly bundled, labeled, color-coded cables with short patch cords and a color key: blue horizontal drops, green network equipment, orange carrier hand-off, white backbone">
        <defs>
          <clipPath id={`${uid}-before`}><rect x="0" y="0" width="200" height={H} data-in-clip-before /></clipPath>
          <clipPath id={`${uid}-after`}><rect x="200" y="0" width="200" height={H} data-in-clip-after /></clipPath>
        </defs>

        <!-- rack + equipment (shared by both versions) -->
        <g class="in__gear">
          <rect x="120" y="8" width="8" height="205" class="in__rail" />
          <rect x="272" y="8" width="8" height="205" class="in__rail" />
          <rect x="128" y="28" width="144" height="30" />
          <rect x="128" y="64" width="144" height="14" />
          <rect x="128" y="100" width="144" height="30" />
          <rect x="128" y="160" width="144" height="36" />
          <text x="138" y="178" dy="0.35em" class="in__unit">UPS</text>
          {Array.from({ length: 12 }, (_, i) => (
            <g>
              <rect x={portX(i)} y={PANEL_TOP} width="8" height="7" class="in__port" />
              <rect x={portX(i)} y={PANEL_TOP + 13} width="8" height="7" class="in__port" />
              <rect x={portX(i)} y={SWITCH_TOP} width="8" height="7" class="in__port" />
              <rect x={portX(i)} y={SWITCH_TOP + 13} width="8" height="7" class="in__port" />
            </g>
          ))}
          {Array.from({ length: 8 }, (_, i) => <line x1={138 + i * 17} y1="64" x2={138 + i * 17} y2="70" />)}
        </g>

        <!-- BEFORE: tangled, unlabeled -->
        <g clip-path={`url(#${uid}-before)`} class="in__before">
          {oldWires.map((w) => (
            <g class="in__oldwire">
              <path d={w.d} />
              {w.tail && <path d={w.tail} class="in__old-tail" />}
              {w.tape && <line x1={w.tape.x1} y1={w.tape.y1} x2={w.tape.x2} y2={w.tape.y2} class="in__tape" />}
            </g>
          ))}
          {[...messyFeeds, ...messyCords].map((c) => (
            <>
              {isWhite(c.c) && <path d={c.d} class="in__under" />}
              <path d={c.d} style={`stroke:${c.c}`} />
            </>
          ))}
          <text x="10" y="160" class="in__tag in__tag--bad">Before</text>
          <text x="10" y="160" class="in__words">
            <tspan x="10" dy="1.3em">No labels,</tspan>
            <tspan x="10" dy="1.2em">no slack</tspan>
            <tspan x="10" dy="1.2em">management</tspan>
          </text>
        </g>

        <!-- AFTER: dressed bundles, labels, short cords -->
        <g clip-path={`url(#${uid}-after)`} class="in__after">
          {bundles.map((b, k) => (
            <g>
              {b.lines.map((x, j) => (
                <>
                  {feedColors[k][j] === 'white' && <line x1={x} y1="0" x2={x} y2={PANEL_TOP} class="in__feed in__under" />}
                  <line x1={x} y1="0" x2={x} y2={PANEL_TOP} class={`in__feed in__c--${feedColors[k][j]}`} />
                </>
              ))}
              <rect x={b.tie} y="11" width="24" height="3" class="in__tie" />
              <rect x={b.tie} y="21" width="24" height="3" class="in__tie" />
            </g>
          ))}
          {cords.map((c) => (
            <>
              {c.color === 'white' && <line x1={c.x} y1="39" x2={c.x} y2={SWITCH_TOP} class="in__cord in__under" />}
              <line x1={c.x} y1="39" x2={c.x} y2={SWITCH_TOP} class={`in__cord in__c--${c.color}`} />
            </>
          ))}
          <!-- labels sit outside the rails, level with what they name (room for phone-size text) -->
          <text x="116" y={PANEL_TOP + 2.5} dy="0.35em" class="in__label" text-anchor="end">A-01</text>
          <text x={LABEL_X} y={PANEL_TOP + 2.5} dy="0.35em" class="in__label">A-12</text>
          <text x={LABEL_X} y={PANEL_TOP + 17.5} dy="0.35em" class="in__label">A-13 … A-24<tspan x={LABEL_X} dy="1.2em" class="in__words">Spare</tspan></text>
          <text x={LABEL_X} y={SWITCH_TOP + 3.5} dy="0.35em" class="in__label">SW-1<tspan x={LABEL_X} dy="1.2em" class="in__note">ports 1–12</tspan></text>
          <text x={LABEL_X} y="160" class="in__tag in__tag--good">After</text>
          <text x={LABEL_X} y="160" class="in__words">
            <tspan x={LABEL_X} dy="1.3em">Dressed, labeled,</tspan>
            <tspan x={LABEL_X} dy="1.2em">tested</tspan>
          </text>

          <!-- colour key: TIA-606 termination-field colours, one row per colour -->
          <g class="in__legend">
            {legend.map((r, i) => (
              <g class="in__lg" style={`--i:${i}`}>
                {r.color === 'white' && <line x1={LABEL_X} y1={legendY(i)} x2={LABEL_X + 14} y2={legendY(i)} class="in__sw in__under" />}
                <line x1={LABEL_X} y1={legendY(i)} x2={LABEL_X + 14} y2={legendY(i)} class={`in__sw in__c--${r.color}`} />
                <text x={LABEL_X + 20} y={legendY(i)} dy="0.35em" class="in__lgtext">{r.text}</text>
              </g>
            ))}
          </g>

          {showHeadroom && (
            <g>
              <rect x="132" y="134" width="136" height="22" class="in__room" />
              <text x={LABEL_X} y="140" dy="0.35em" class="in__words in__words--ink">Room to grow</text>
            </g>
          )}

          <!-- callouts in the empty left margin (x 8 to 112); leaders end in a small dot -->
          <g class="in__callouts">
            <path d="M106 12 H136" class="in__leader" />
            <circle cx="136" cy="12" r="2" class="in__dot" />
            <text x="14" y="8" dy="0.35em" class="in__words in__words--ink"><tspan x="14">Dressed in</tspan><tspan x="14" dy="1.15em">bundles</tspan></text>

            <path d="M108 72 H137" class="in__leader" />
            <circle cx="137" cy="72" r="2" class="in__dot" />
            <text x="14" y="66" dy="0.35em" class="in__words in__words--ink"><tspan x="14">Short patch</tspan><tspan x="14" dy="1.15em">cords</tspan></text>

            <path d="M102 98 V47 H131" class="in__leader" />
            <circle cx="133" cy="47" r="2" class="in__dot" />
            <text x="14" y="94" dy="0.35em" class="in__words in__words--ink">
              {labelsAtBothEnds
                ? [<tspan x="14">Labeled at</tspan>, <tspan x="14" dy="1.15em">both ends</tspan>]
                : [<tspan x="14">Every port</tspan>, <tspan x="14" dy="1.15em">labeled</tspan>]}
            </text>
          </g>
        </g>

        <!-- divider -->
        <g class="in__divider" data-in-divider transform="translate(200 0)">
          <line x1="0" y1="0" x2="0" y2={H} />
          <circle cx="0" cy="107" r="11" />
          <path d="M-4 103 L-7 107 L-4 111 M4 103 L7 107 L4 111" />
        </g>
      </svg>

      <label class="in__slider">
        <span>Before</span>
        <input type="range" min="0" max="100" value="50" step="1" aria-label="Compare the closet before and after" data-in-range />
        <span>After</span>
      </label>
    </div>

    <ol role="list" class="in__steps">
      {steps.map(({ title, detail }) => (
        <li class="in__step is-on" data-in-step>
          <span class="in__step-text">
            <span class="in__step-title">{title}</span>
            <span class="in__step-detail">{detail}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</DemoFrame>
<TraceDemo />
</div>

<script>
  import { createRun, onFirstView, bindReplay, announce, finished, sleep, prefersReducedMotion, fitSvgText } from '../../scripts/demo';

  document.querySelectorAll<HTMLElement>('[data-demo="install"]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-in-range]')!;
    const clipBefore = root.querySelector<SVGRectElement>('[data-in-clip-before]')!;
    const clipAfter = root.querySelector<SVGRectElement>('[data-in-clip-after]')!;
    const divider = root.querySelector<SVGGElement>('[data-in-divider]')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-in-step]')];

    fitSvgText(root);

    // value = how much of the BEFORE picture shows, from the left (0–100%)
    const setSplit = (v: number) => {
      const x = (Math.max(0, Math.min(100, v)) / 100) * 400;
      clipBefore.setAttribute('width', x.toFixed(1));
      clipAfter.setAttribute('x', x.toFixed(1));
      clipAfter.setAttribute('width', (400 - x).toFixed(1));
      divider.setAttribute('transform', `translate(${x.toFixed(1)} 0)`);
      range.value = String(Math.round(v));
    };

    let sweeping = false;
    // The native slider already follows the finger with no easing (the clip changes in the same frame).
    range.addEventListener('input', () => {
      sweeping = false;
      setSplit(Number(range.value));
    });

    // Dragging on the picture itself: pointer capture, split follows the pointer exactly, no easing.
    const svg = root.querySelector<SVGSVGElement>('.in__rack')!;
    let dragging = false;
    const splitFromPointer = (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      if (r.width > 0) setSplit(((e.clientX - r.left) / r.width) * 100);
    };
    svg.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      sweeping = false;
      svg.setPointerCapture(e.pointerId);
      root.classList.add('in--dragging');
      splitFromPointer(e);
    });
    svg.addEventListener('pointermove', (e) => {
      if (dragging) splitFromPointer(e);
    });
    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove('in--dragging');
      if (svg.hasPointerCapture(e.pointerId)) svg.releasePointerCapture(e.pointerId);
    };
    svg.addEventListener('pointerup', endDrag);
    svg.addEventListener('pointercancel', endDrag);
    svg.addEventListener('lostpointercapture', endDrag);

    const tween = (from: number, to: number, ms: number, alive: () => boolean) =>
      new Promise<void>((resolve) => {
        const start = performance.now();
        const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
        const frame = (now: number) => {
          if (!alive() || !sweeping) return resolve();
          const t = Math.min(1, (now - start) / ms);
          setSplit(from + (to - from) * ease(t));
          if (t < 1) requestAnimationFrame(frame);
          else resolve();
        };
        requestAnimationFrame(frame);
      });

    // Decided once per demo: reset() hides the parts for the animation, so a setting changed later must not leave it blank.
    const reduced = prefersReducedMotion();

    // The colour key rises in row by row once the sweep reaches the dressed side
    const inEl = root.querySelector<HTMLElement>('.in')!;

    const reset = () => {
      root.classList.add('in--instant');
      inEl.classList.add('in--quick', 'in--lg-off');
      setSplit(100);
      steps.forEach((s) => s.classList.remove('is-on'));
      void root.offsetWidth;
      root.classList.remove('in--instant');
      inEl.classList.remove('in--quick');
    };

    const run = createRun(async (alive) => {
      if (reduced) return;
      reset();
      sweeping = true;
      announce(root, 'Before: tangled, unlabeled cables');
      await sleep(600);
      if (!alive()) return;
      await tween(100, 0, 1700, alive);
      if (!alive()) return;
      announce(root, 'After: dressed and labeled');
      inEl.classList.remove('in--lg-off');
      await sleep(400);
      if (!alive()) return; // a replay has taken over; don't touch its sweep
      await tween(0, 50, 650, alive);
      if (!alive()) return;
      sweeping = false;
      for (const s of steps) {
        await sleep(420);
        if (!alive()) return;
        s.classList.add('is-on');
      }
      announce(root, 'Pre-staged, installed after hours, cut over in phases');
      finished(root);
    });

    if (!reduced) {
      reset();
      onFirstView(root, run);
    }
    bindReplay(root, run);
  });
</script>

<style>
  .in-pair {
    display: grid;
    gap: 1rem;
  }

  .in {
    display: grid;
    gap: 1rem;
  }

  .in__compare {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .in__rack {
    width: 100%;
    height: auto;
    background: var(--paper-sunken);
    border-radius: var(--radius);
  }

  .in__gear rect {
    fill: var(--white);
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .in__gear .in__rail {
    fill: var(--paper-sunken);
  }

  .in__gear line {
    stroke: var(--hairline-strong);
    stroke-width: 1.25;
  }

  .in__gear .in__port {
    fill: var(--ink);
    stroke: none;
  }

  .in__before path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.85;
  }

  /* Horizontal drag moves the split; vertical swipes still scroll the page */
  .in__rack {
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
  }

  .in__feed {
    stroke-width: 1.75;
  }

  /* Cable jacket colours code a drop's purpose (TIA-606), not status */
  .in__c--blue {
    stroke: var(--cable-blue);
  }

  .in__c--green {
    stroke: var(--cable-green);
  }

  .in__c--orange {
    stroke: var(--cable-orange);
  }

  .in__c--white {
    stroke: var(--cable-white);
  }

  /* White needs an edge to show on the white sheet: a wider steel stroke sits underneath */
  .in__under {
    stroke: var(--steel);
    stroke-width: 2.75;
  }

  .in__cord.in__under {
    stroke-width: 3.25;
  }

  .in__sw {
    stroke-width: 3;
    stroke-linecap: round;
  }

  .in__sw.in__under {
    stroke-width: 4;
  }

  .in__before path.in__under {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.85;
  }

  /* Old, abandoned cables: thinner, faded, dashed dead ends */
  .in__before .in__oldwire path {
    stroke: var(--cable-old);
    stroke-width: 1.5;
    opacity: 1;
  }

  .in__before .in__oldwire .in__old-tail {
    stroke-dasharray: 3 3;
  }

  .in__tape {
    stroke: var(--steel);
    stroke-width: 4;
    stroke-linecap: butt;
  }

  /* Colour key: rows rise in one after another (transform + opacity only) */
  .in__lg {
    transition: opacity 0.3s ease, transform 0.35s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .in--lg-off .in__lg {
    opacity: 0;
    transform: translateY(4px);
  }

  .in--quick .in__lg {
    transition: none;
    transition-delay: 0s;
  }

  .in__lgtext {
    font-family: var(--font-sans);
    font-size: clamp(9px, calc(var(--u, 1) * 9.5px), 11.5px);
    fill: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .in__lg {
      transition: none;
    }

    .in--lg-off .in__lg {
      opacity: 1;
      transform: none;
    }
  }

  .in__tie {
    fill: var(--ink);
  }

  .in__cord {
    stroke-width: 2.25;
    stroke-linecap: round;
  }

  .in__room {
    fill: none;
    stroke: var(--steel);
    stroke-width: 1.25;
    stroke-dasharray: 4 3;
  }

  .in__leader {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }

  .in__dot {
    fill: var(--ink);
  }

  /* Plain words: Geist sans, sentence case (rule 4) */
  .in__words {
    font-family: var(--font-sans);
    font-size: clamp(9.5px, calc(var(--u, 1) * 10.5px), 12.5px);
    fill: var(--steel);
  }

  .in__words--ink {
    fill: var(--ink);
  }

  /* SVG text is sized in screen pixels via --u (see fitSvgText), capped to fit the drawing:
     the label column right of the rack and the corner notes leave room for the largest sizes.
     Rule 4: only the port and switch codes (A-01, SW-1) are mono; words (UPS, "ports 1–12", Before, After) are sans. */
  .in__label,
  .in__note,
  .in__unit {
    font-family: var(--font-sans);
    font-size: clamp(9px, calc(var(--u, 1) * 10px), 12.5px);
    letter-spacing: normal;
    fill: var(--steel);
  }

  .in__label {
    font-family: var(--font-mono);
    fill: var(--ink);
  }

  .in__tag {
    font-family: var(--font-sans);
    font-size: clamp(9px, calc(var(--u, 1) * 11px), 14px);
    font-weight: 600;
    letter-spacing: normal;
  }

  /* Paper halo keeps text readable where it crosses cables */
  .in__before text,
  .in__after text,
  .in__after .in__words {
    paint-order: stroke;
    stroke: var(--paper-sunken);
    stroke-width: calc(var(--u, 1) * 3px);
    stroke-linejoin: round;
  }

