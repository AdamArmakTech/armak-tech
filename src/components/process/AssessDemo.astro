---
/**
 * Step 01 · Assess — "Site walk".
 * A walk path draws through a small office floor plan; at each stop a pin drops and a finding
 * is logged. Teaches: the site is documented as it really is before anything is priced.
 * Server-renders the finished walk (no-JS / reduced motion); the script replays it.
 */
import DemoFrame from './DemoFrame.astro';
import OfficePlan from './OfficePlan.astro';

// Stops along the walk: [x, y] on the plan + what gets written down (sample findings)
const stops = [
  { x: 340, y: 196, title: 'Existing systems', detail: '2 analog cameras, 1 keypad door' },
  { x: 215, y: 196, title: 'Existing cabling', detail: 'Cat 5e, unlabeled' },
  { x: 215, y: 128, title: 'Pathways', detail: 'Open ceiling to the closet; one wall needs conduit' },
  { x: 40, y: 128, title: 'Power', detail: '1 dedicated circuit near the rack' },
  { x: 40, y: 52, title: 'Telecom closet', detail: '1 wall-mount rack, little free space' },
];

// The walk: lobby entrance → each stop in order (straight segments). Segment lengths give each
// stop's position along the path; the script moves the walker along the same points.
const points: [number, number][] = [[340, 248], ...stops.map((s) => [s.x, s.y] as [number, number])];
const walk = 'M' + points.map(([x, y]) => `${x} ${y}`).join(' L');
const segs = points.slice(1).map(([x, y], i) => Math.hypot(x - points[i][0], y - points[i][1]));
const total = segs.reduce((a, b) => a + b, 0);
const at = segs.map((_, i) => segs.slice(0, i + 1).reduce((a, b) => a + b, 0) / total);
---

<DemoFrame
  name="assess"
  title="Site walk"
  caption="Each stop on the walk is pinned on the floor plan and logged as a finding. The findings go into a written site report, and the price comes from that report."
>
  <div class="as">
    <svg class="as__plan" viewBox="0 0 400 262" role="img" data-fit-text aria-label="Floor plan of a small office with a walk path from the lobby to the telecom closet and five numbered findings">
      <defs>
        <pattern id="as-ceiling" width="16" height="16" patternUnits="userSpaceOnUse">
          <path d="M16 0H0V16" class="as__grid" />
        </pattern>
      </defs>

      <!-- open-ceiling area (pathway); label kept left of the walk's x=215 leg -->
      <rect x="92" y="112" width="196" height="40" fill="url(#as-ceiling)" />
      <text x="148" y="148" class="as__note" text-anchor="middle">OPEN CEILING</text>

      <OfficePlan />

      <!-- electrical panel on the west wall -->
      <rect x="10" y="118" width="10" height="22" class="as__panel" />
      <text x="24" y="150" class="as__note">ELEC</text>

      <!-- existing systems in the lobby: cameras + keypad -->
      <g class="as__existing">
        <circle cx="300" cy="166" r="3.5" />
        <circle cx="382" cy="166" r="3.5" />
        <rect x="364" y="241" width="7" height="7" rx="1" />
      </g>

      <!-- the walk -->
      <path class="as__walk is-drawn" d={walk} pathLength="1" data-as-walk data-points={JSON.stringify(points)} />
      <circle class="as__walker" r="6" cx={stops[4].x} cy={stops[4].y} data-as-walker />

      <!-- pins -->
      {stops.map((s, i) => (
        <g class="as__pin is-on" data-as-pin={i} data-at={at[i].toFixed(4)} transform={`translate(${s.x} ${s.y})`}>
          <circle r="10" />
          <text dy="0.36em" text-anchor="middle">{i + 1}</text>
        </g>
      ))}
    </svg>

    <div class="as__side">
      <p class="t-mono as__side-title">Findings</p>
      <ol role="list" class="as__list">
        {stops.map((s, i) => (
          <li class="as__item is-on" data-as-item={i}>
            <span class="as__num t-mono">{i + 1}</span>
            <span class="as__text">
              <span class="as__item-title">{s.title}</span>
              <span class="as__item-detail">{s.detail}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="as__done is-on t-mono" data-as-done>✓ Site report ready · priced from this</p>
    </div>
  </div>
</DemoFrame>

<script>
  import { createRun, onFirstView, bindReplay, announce, sleep, reduceMotion, fitSvgText } from '../../scripts/demo';

  document.querySelectorAll<HTMLElement>('[data-demo="assess"]').forEach((root) => {
    const walk = root.querySelector<SVGPathElement>('[data-as-walk]')!;
    const walker = root.querySelector<SVGCircleElement>('[data-as-walker]')!;
    const pins = [...root.querySelectorAll<SVGGElement>('[data-as-pin]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-as-item]')];
    const done = root.querySelector<HTMLElement>('[data-as-done]')!;
    const titles = items.map((li) => li.querySelector('.as__item-title')?.textContent ?? '');

    fitSvgText(root);

    // The walk is straight segments, so the walker is placed by simple interpolation —
    // no getTotalLength()/getPointAtLength(), which can throw while the panel is hidden.
    const points: [number, number][] = JSON.parse(walk.dataset.points || '[[340,248]]');
    const lengths = points.slice(1).map(([x, y], i) => Math.hypot(x - points[i][0], y - points[i][1]));
    const total = lengths.reduce((a, b) => a + b, 0) || 1;
    const pointAt = (t: number): [number, number] => {
      let d = t * total;
      for (let i = 0; i < lengths.length; i++) {
        if (d <= lengths[i] || i === lengths.length - 1) {
          const k = lengths[i] ? Math.min(1, d / lengths[i]) : 1;
          const [x0, y0] = points[i];
          const [x1, y1] = points[i + 1];
          return [x0 + (x1 - x0) * k, y0 + (y1 - y0) * k];
        }
        d -= lengths[i];
      }
      return points[points.length - 1];
    };
    const placeWalker = ([x, y]: [number, number]) => {
      walker.setAttribute('cx', x.toFixed(1));
      walker.setAttribute('cy', y.toFixed(1));
    };

    const reset = () => {
      root.classList.add('as--instant');
      walk.classList.remove('is-drawn');
      walk.style.strokeDashoffset = '1';
      pins.forEach((p) => p.classList.remove('is-on'));
      items.forEach((li) => li.classList.remove('is-on'));
      done.classList.remove('is-on');
      placeWalker(points[0]); // lobby entrance
      void root.offsetWidth;
      root.classList.remove('as--instant');
    };

    const run = createRun(async (alive) => {
      if (reduceMotion) return;
      reset();
      await sleep(250);
      if (!alive()) return;

      const duration = 4200;
      const start = performance.now();
      let next = 0;

      await new Promise<void>((resolve) => {
        const frame = (now: number) => {
          if (!alive()) return resolve();
          const t = Math.min(1, (now - start) / duration);
          placeWalker(pointAt(t));
          walk.style.strokeDashoffset = String(1 - t);

          // Drop each pin and log its finding as the walker reaches it
          while (next < pins.length && t >= Number(pins[next].dataset.at) - 0.002) {
            pins[next].classList.add('is-on');
            items[next].classList.add('is-on');
            announce(root, `Found: ${titles[next]}`);
            next++;
          }

          if (t < 1) requestAnimationFrame(frame);
          else resolve();
        };
        requestAnimationFrame(frame);
      });

      if (!alive()) return;
      await sleep(350);
      if (!alive()) return;
      done.classList.add('is-on');
      announce(root, 'Site report ready');
    });

    if (!reduceMotion) {
      reset();
      onFirstView(root, run);
    }
    bindReplay(root, run);
  });
</script>

<style>
  .as {
    display: grid;
    gap: 1rem;
  }

  .as__plan {
    width: 100%;
    height: auto;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .as__grid {
    fill: none;
    stroke: var(--hairline);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  /* SVG text is sized in screen pixels via --u (see fitSvgText), capped to fit the drawing */
  .as__note {
    font-family: var(--font-mono);
    font-size: clamp(9px, calc(var(--u, 1) * 9px), 11.5px);
    letter-spacing: 0.06em;
    fill: var(--steel);
  }

  .as__panel {
    fill: var(--white);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .as__existing {
    fill: var(--steel);
  }

  .as__walk {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }

  .as__walk.is-drawn {
    stroke-dashoffset: 0;
  }

  .as__walker {
    fill: var(--signal);
    stroke: var(--white);
    stroke-width: 2.5;
  }

  .as__pin {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .as__pin circle {
    fill: var(--ink);
    stroke: var(--white);
    stroke-width: 2;
  }

  .as__pin text {
    font-family: var(--font-mono);
    font-size: clamp(10px, calc(var(--u, 1) * 9.5px), 12.5px);
    font-weight: 600;
    fill: var(--white);
  }

  .as__pin.is-on {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .as__pin.is-on circle {
      animation: as-drop 0.45s var(--ease-out);
      transform-box: fill-box;
      transform-origin: center;
    }
  }

  @keyframes as-drop {
    from {
      transform: scale(2);
      opacity: 0;
    }
  }

  /* Findings list */
  .as__side {
    display: grid;
    gap: 0.625rem;
    align-content: start;
  }

  .as__side-title {
    color: var(--steel);
  }

  .as__list {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .as__item {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 0.625rem;
    align-items: start;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--hairline);
    opacity: 0.55;
    transition: opacity 0.3s ease, background 0.3s ease;
  }

  .as__item.is-on {
    opacity: 1;
  }

  .as__num {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    font-size: 0.8125rem;
    letter-spacing: 0;
  }

  .as__text {
    display: grid;
    gap: 0.1rem;
    line-height: 1.35;
  }

  .as__item-title {
    font-weight: 600;
    color: var(--ink);
  }

  .as__item-detail {
    color: var(--steel);
    font-size: 0.8125rem;
  }

  .as__done {
    justify-self: start;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--pass) 10%, var(--white));
    color: var(--pass);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.35s var(--ease-out);
  }

  .as__done.is-on {
    opacity: 1;
    transform: none;
  }

  .as--instant,
  .as--instant * {
    transition: none !important;
    animation: none !important;
  }

  /* Wide stage: plan left, findings right */
  @container (min-width: 600px) {
    .as {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Phones: no-JS fallback for the label scale (the script sets the exact value) */
  @container (max-width: 520px) {
    .as__plan {
      --u: 1.25;
    }
  }

  /* Phones: findings in two columns (number + title, detail below), and the
     "report ready" note fills the empty sixth cell instead of adding a row */
  @container (min-width: 330px) and (max-width: 599px) {
    .as {
      gap: 0.75rem;
    }

    .as__side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.875rem;
      row-gap: 0;
    }

    .as__side-title {
      grid-column: 1 / -1;
      margin-bottom: 0.375rem;
    }

    .as__list {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
    }

    .as__item {
      grid-template-columns: 20px minmax(0, 1fr);
      column-gap: 0.5rem;
      row-gap: 0.125rem;
      align-items: center;
      padding-block: 0.5rem;
    }

    .as__num {
      width: 20px;
      height: 20px;
      font-size: 0.8125rem;
    }

    .as__text {
      display: contents;
    }

    .as__item-title {
      font-size: 0.875rem;
      line-height: 1.3;
    }

    .as__item-detail {
      grid-column: 1 / -1;
      align-self: start;
      font-size: 0.8125rem;
      line-height: 1.35;
    }

    .as__done {
      margin-top: 0.625rem;
      font-size: 0.8125rem;
      letter-spacing: 0.04em;
      line-height: 1.4;
    }

    @supports (grid-template-rows: subgrid) {
      .as__list {
        grid-row: 2 / span 3;
        grid-template-rows: subgrid;
      }

      .as__done {
        grid-column: 2;
        grid-row: 4;
        align-self: center;
        margin-block: 0.5rem;
        text-wrap: balance;
      }
    }
  }
</style>
