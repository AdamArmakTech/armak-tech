---
/**
 * Shared shell for the animated process demos — same sheet language as the cable test
 * (src/components/ui/CableTest.astro): white sheet (no border, no shadow), red "live" dot, Sample badge,
 * replay button, and a plain-English caption telling the visitor what they're looking at.
 *
 * Put the demo's own markup in the default slot. The demo's script finds its frame via
 * `[data-demo="{name}"]` and uses the helpers in src/scripts/demo.ts.
 */
import { RotateCcw } from '@lucide/astro';

interface Props {
  /** Unique demo name, used as data-demo="{name}" for the script to find it */
  name: string;
  /** Short title after "Live demo:", e.g. "Site walk" */
  title: string;
  /** One or two plain-English sentences: what the visitor is watching and why it matters */
  caption: string;
  class?: string;
}

const { name, title, caption, class: className } = Astro.props;
const titleLower = title.charAt(0).toLowerCase() + title.slice(1);
---

<figure class:list={['demo', className]} data-demo={name}>
  <header class="demo__head">
    <span class="t-meta demo__title">Live demo: {titleLower}</span>
    <span class="demo__tools">
      <span class="t-meta demo__sample">Sample</span>
      <button type="button" class="demo__replay" data-demo-replay>
        <RotateCcw size={15} stroke-width={1.75} aria-hidden="true" />
        <span class="visually-hidden">Replay {title} demo</span>
      </button>
    </span>
  </header>

  <div class="demo__body">
    <slot />
  </div>

  <figcaption class="demo__caption t-small">{caption}</figcaption>
  <p class="visually-hidden" aria-live="polite" data-demo-live></p>
</figure>

<style>
  .demo {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--white);
    border-radius: var(--radius-lg);
    font-size: var(--fs-small);
  }

  .demo__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    color: var(--steel);
  }

  .demo__title {
    line-height: 1.45;
  }

  .demo__tools {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .demo__sample {
    font-size: var(--fs-label);
    color: var(--steel);
  }

  .demo__replay {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: var(--radius);
    background: var(--paper-sunken);
    color: var(--steel);
    transition:
      background var(--dur-fast) ease,
      color var(--dur-fast) ease,
      transform 140ms var(--ease-out);
  }

  /* 48 x 48 px touch target (36 px box + 6 px each side) without a bigger box */
  .demo__replay::after {
    content: "";
    position: absolute;
    inset: -6px;
  }

  .demo__replay:hover {
    color: var(--ink);
  }

  .demo__replay:active {
    color: var(--ink);
    transform: scale(0.97);
  }

  /* The arrow winds back a quarter turn while pressed, then springs forward as the demo restarts */
  .demo__replay :global(svg) {
    transition: transform 420ms var(--ease-out);
  }

  .demo__replay:active :global(svg) {
    transform: rotate(-90deg);
    transition-duration: 120ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo__replay:active {
      transform: none;
    }

    .demo__replay :global(svg),
    .demo__replay:active :global(svg) {
      transition: none;
      transform: none;
    }
  }

  .demo__body {
    min-width: 0;
  }

  .demo__caption {
    padding-top: 0.5rem;
    color: var(--text);
    line-height: 1.55;
  }

  /* Phones (narrow stepper stage): tighter frame so the demo fits on one screen */
  @container (max-width: 520px) {
    .demo {
      gap: 0.75rem;
      padding: 0.875rem;
    }

    .demo__caption {
      padding-top: 0.75rem;
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }
</style>
