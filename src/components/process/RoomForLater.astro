---
/**
 * B9: "Enough for today / What Armak installs". Only practices the owner confirmed (shownSignature).
 * Renders nothing when fewer than 3 rows are shown. No competitor column.
 * Motion: the rows arrive once, one after another, as the sheet is scrolled into view, and each ink tick
 * draws itself (stroke-dashoffset). Armed by the script only; without JS or under reduced motion the sheet is simply there.
 * Design rules: 7 (ticks are ink, never green), 1 (the headline, itemized). A white sheet with no outline; the rows keep their lines.
 */
import { signature, shownSignature, type SignatureKey } from '../../data/content';

const keys = Object.keys(signature.items) as SignatureKey[];
const rows = shownSignature(keys);
---

{
  rows.length >= 3 && (
    <div class="rfl" data-rfl>
      <div class="rfl__sheet">
        <table class="rfl__table" role="table">
          <caption class="rfl__cap">
            <h3 class="t-h4 rfl__title">Put in on day one for later</h3>
          </caption>
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader">Enough for today</th>
              <th scope="col" role="columnheader">What Armak installs</th>
              <th scope="col" role="columnheader" class="rfl__markhead"><span class="visually-hidden">Included</span></th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {rows.map((r, i) => (
              <tr role="row" style={`--i: ${i}`}>
                <td role="cell" class="rfl__today">{r.today}</td>
                <td role="cell" class="rfl__installs">
                  <strong class="rfl__label">{r.label}</strong>
                  <span class="rfl__detail">{r.detail}</span>
                </td>
                <td role="cell" class="rfl__mark">
                  {r.confirmed === 'yes' ? (
                    <>
                      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
                        <path d="M3.5 10.5 L8 15 L16.5 5.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" />
                      </svg>
                      <span class="visually-hidden">Yes</span>
                    </>
                  ) : (
                    <span class="rfl__some">On some jobs</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )
}

<script>
  import { onFirstView, prefersReducedMotion } from '../../scripts/demo';

  document.querySelectorAll<HTMLElement>('[data-rfl]').forEach((root) => {
    if (prefersReducedMotion()) return;
    root.classList.add('is-armed');
    onFirstView(root, () => root.classList.add('is-shown'), 0.2);
  });
</script>

<style>
  .rfl {
    margin-top: var(--space-section);
  }

  /* Arrival, once: rows 60 ms apart, each tick drawn as its row lands (opacity and stroke only; the rows
     rise a little where they are cards, under 900px) */
  .rfl.is-armed tbody tr {
    opacity: 0;
  }

  .rfl.is-armed.is-shown tbody tr {
    opacity: 1;
    transition: opacity 480ms ease calc(var(--i) * 60ms);
  }

  .rfl.is-armed .rfl__mark svg path {
    stroke-dasharray: 20;
    stroke-dashoffset: 20;
  }

  .rfl.is-armed.is-shown .rfl__mark svg path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 420ms var(--ease-out) calc(var(--i) * 60ms + 240ms);
  }

  @media (max-width: 899.98px) {
    .rfl.is-armed tbody tr {
      transform: translate3d(0, 10px, 0);
    }

    .rfl.is-armed.is-shown tbody tr {
      transform: none;
      transition:
        opacity 480ms ease calc(var(--i) * 60ms),
        transform 720ms var(--ease-out) calc(var(--i) * 60ms);
    }
  }

  .rfl__sheet {
    background: var(--white);
    border-radius: var(--radius);
    padding: var(--sp-5) var(--sp-4);
  }

  .rfl__table {
    width: 100%;
    border-collapse: collapse;
    color: var(--text);
  }

  .rfl__cap {
    text-align: left;
    padding-bottom: var(--sp-4);
  }

  .rfl__title {
    color: var(--ink);
  }

  .rfl__table th {
    text-align: left;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-small);
    letter-spacing: normal;
    text-transform: none;
    color: var(--steel);
    padding: 0 var(--sp-4) var(--sp-2) 0;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .rfl__table td {
    vertical-align: top;
    padding: var(--sp-3) var(--sp-4) var(--sp-3) 0;
    border-bottom: 1px solid var(--hairline);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .rfl__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .rfl__label {
    display: block;
    font-weight: 600;
    color: var(--ink);
  }

  .rfl__detail {
    display: block;
  }

  .rfl__mark {
    width: 7rem;
    color: var(--ink);
    white-space: nowrap;
    padding-right: 0;
  }

  .rfl__mark svg {
    display: block;
  }

  .rfl__some {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink);
  }

  /* Under 900px: stacked rows. What Armak installs first, then "Instead of: ...", the mark at the top right. */
  @media (max-width: 899.98px) {
    .rfl__table,
    .rfl__table tbody,
    .rfl__table tr,
    .rfl__table td,
    .rfl__table caption {
      display: block;
    }

    .rfl__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .rfl__table tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--sp-3);
      padding: var(--sp-3) 0;
      border-bottom: 1px solid var(--hairline);
    }

    .rfl__table tbody tr:last-child {
      border-bottom: 0;
    }

    .rfl__table td {
      padding: 0;
      border: 0;
    }

    .rfl__installs {
      grid-column: 1;
      grid-row: 1;
    }

    .rfl__mark {
      grid-column: 2;
      grid-row: 1;
      width: auto;
    }

    .rfl__today {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: var(--sp-2);
    }

    .rfl__today::before {
      content: 'Instead of: ';
      font-weight: 500;
    }
  }

  @media (min-width: 900px) {
    .rfl__sheet {
      padding: var(--sp-6) var(--sp-6);
    }

    .rfl__table td:first-child,
    .rfl__table th:first-child {
      width: 30%;
    }
  }
</style>
