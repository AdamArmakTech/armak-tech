---
/**
 * Support — "A move request" (MAC: move, add, change).
 * Four beats: the ticket comes in; the as-built record is looked up and the two ports it names light on
 * the panel; the patch cord is unplugged from A-14, carried across and plugged into A-22 (one cord, really
 * moving); the link is tested (a pulse runs down the new cord and back), the record row is updated and
 * the ticket closes. Teaches: support is quick and tidy because the install was labeled and documented.
 * Server-renders the finished state (no-JS / reduced motion).
 */
import DemoFrame from './DemoFrame.astro';
import { Check } from '@lucide/astro';

// Panel / switch geometry (viewBox 300 × 133): 12 ports per row
const px = (i: number) => 22 + i * 22;
const OLD = 1; // panel A-14 = bottom row, index 1
const NEW = 9; // panel A-22 = bottom row, index 9
const cx = (i: number) => px(i) + 6;
const PANEL_Y = 15; // patch panel box top
const SWITCH_Y = 82; // switch box top
const CORD_TOP = PANEL_Y + 32; // just below the panel's bottom-row port
const CORD_END = SWITCH_Y + 5; // top of the switch's top-row port
const BEND = 23; // how far the cord hangs before it turns
/** The one cord that moves: from a panel port (its top end) down to the switch port it stays on. */
const cord = (tx: number, ty: number) => `M${tx} ${ty} C ${tx} ${ty + BEND}, ${cx(OLD)} ${CORD_END - BEND}, ${cx(OLD)} ${CORD_END}`;
const otherCords = [0, 2, 3, 4, 5].map((i) => `M${cx(i)} ${CORD_TOP} V${CORD_END}`);
const geom = { xOld: cx(OLD), xNew: cx(NEW), top: CORD_TOP, end: CORD_END, bend: BEND };

const records = [
  { jack: '2B-13', port: 'A-13', key: '' },
  { jack: '2B-14', port: 'A-14', key: 'from' },
  { jack: '3A-01', port: 'A-21', key: '' },
  { jack: '3A-02', port: 'A-22', key: 'to' },
];

const stages = ['Request', 'Look up', 'Re-patch', 'Test & update'];
---

<DemoFrame
  name="support"
  title="A move request"
  caption="Moves, adds and changes go fast when the install was labeled and documented: look up the record, move one patch cord, test it, update the record. No tracing wires through the ceiling."
>
  <div class="sp">
    <ol role="list" class="sp__stages t-meta">
      {stages.map((s, i) => (
        <li class="sp__stage is-done" data-sp-stage={i}><span class="sp__stage-dot" aria-hidden="true"></span>{s}</li>
      ))}
    </ol>

    <div class="sp__grid">
      <div class="sp__left">
        <div class="sp__ticket is-on" data-sp-ticket>
          <div class="sp__ticket-top">
            <span class="t-meta">Ticket <span class="t-readout">MAC-0417</span></span>
            <span class="sp__status t-meta" data-sp-status data-state="done">Done</span>
          </div>
          <p class="sp__ticket-body">Move desk <strong>2B-14</strong> to <strong>3A-02</strong></p>
        </div>

        <table class="sp__records">
          <caption class="t-meta">As-built record</caption>
          <thead>
            <tr><th scope="col">Desk jack</th><th scope="col">Panel port</th></tr>
          </thead>
          <tbody>
            {records.map((r) => (
              <tr class:list={['sp__row', { 'is-hit': r.key }]} data-sp-row={r.key || undefined} data-sp-scan>
                <td class="t-readout">{r.jack}</td>
                <td class="t-readout">{r.port}{r.key === 'to' && <span class="sp__updated is-on" data-sp-updated>, in use</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="sp__right">
        <svg class="sp__panel" viewBox="0 0 300 133" role="img" data-fit-text aria-label="Patch panel A above a network switch; the patch cord for the moved desk goes from port A-22 down to the switch">
          <!-- panel A -->
          <rect x="10" y={PANEL_Y} width="280" height="36" class="sp__box" />
          <text x="10" y={PANEL_Y - 5} class="sp__tiny t-readout">Patch panel A</text>
          {Array.from({ length: 12 }, (_, i) => (
            <g>
              <rect x={px(i)} y={PANEL_Y + 5} width="12" height="10" class="sp__port" />
              <rect x={px(i)} y={PANEL_Y + 20} width="12" height="10" class="sp__port" />
            </g>
          ))}
          <!-- switch -->
          <rect x="10" y={SWITCH_Y} width="280" height="36" class="sp__box" />
          <text x="10" y={SWITCH_Y + 48} class="sp__tiny t-readout">Switch</text>
          {Array.from({ length: 12 }, (_, i) => (
            <g>
              <rect x={px(i)} y={SWITCH_Y + 5} width="12" height="10" class="sp__port" />
              <rect x={px(i)} y={SWITCH_Y + 20} width="12" height="10" class="sp__port" />
            </g>
          ))}

          <!-- cords already in place -->
          {otherCords.map((d) => <path d={d} class="sp__cord sp__cord--static" />)}

          <!-- the move: one cord, its top end carried from A-14 to A-22 (the plug rides on the end) -->
          <path d={cord(cx(NEW), CORD_TOP)} class="sp__cord sp__cord--move" data-sp-cord data-geom={JSON.stringify(geom)} />
          <rect class="sp__plug" x="-4" y="-5" width="8" height="6" rx="1" style={`transform: translate(${cx(NEW)}px, ${CORD_TOP}px)`} data-sp-plug />
          <!-- the test pulse that runs the new cord after the move -->
          <circle class="sp__pulse" r="3.5" cx="0" cy="0" data-sp-pulse />

          <!-- port highlights + labels -->
          <g class="sp__mark sp__mark--from is-on is-free" data-sp-mark="from">
            <rect x={px(OLD) - 3} y={PANEL_Y + 17} width="18" height="16" rx="2" />
            <text x={cx(OLD)} y={PANEL_Y + 50} text-anchor="middle">A-14</text>
          </g>
          <g class="sp__mark sp__mark--to is-on is-live" data-sp-mark="to">
            <rect x={px(NEW) - 3} y={PANEL_Y + 17} width="18" height="16" rx="2" />
            <text x={cx(NEW) + 7} y={PANEL_Y + 50} text-anchor="middle">A-22</text>
          </g>
        </svg>

        <ul role="list" class="sp__checks">
          <li class="is-on" data-sp-check><span aria-hidden="true"><Check size={14} stroke-width={2.25} /></span> Link tested at the new desk</li>
          <li class="is-on" data-sp-check><span aria-hidden="true"><Check size={14} stroke-width={2.25} /></span> Record updated: 3A-02 → A-22</li>
        </ul>
      </div>
    </div>
  </div>
</DemoFrame>

<script>
  import { createRun, onFirstView, bindReplay, announce, finished, sleep, prefersReducedMotion, fitSvgText, frames, easeOut, easeInOut, moveAlong, bezierPoints, evenTimes, at } from '../../scripts/demo';

  const MOVE_MS = 900; // unplug, carry across, plug in
  const LIFT = 12; // how far the plug is pulled down out of the port before it is carried across
  const PULSE_MS = 560; // test pulse: down the cord and back

  document.querySelectorAll<HTMLElement>('[data-demo="support"]').forEach((root) => {
    fitSvgText(root);
    const box = root.querySelector<HTMLElement>('.sp')!;
    const stages = [...root.querySelectorAll<HTMLElement>('[data-sp-stage]')];
    const ticket = root.querySelector<HTMLElement>('[data-sp-ticket]')!;
    const status = root.querySelector<HTMLElement>('[data-sp-status]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-sp-scan]')];
    const rowFrom = root.querySelector<HTMLElement>('[data-sp-row="from"]')!;
    const rowTo = root.querySelector<HTMLElement>('[data-sp-row="to"]')!;
    const updated = root.querySelector<HTMLElement>('[data-sp-updated]')!;
    const cordEl = root.querySelector<SVGPathElement>('[data-sp-cord]')!;
    const plug = root.querySelector<SVGRectElement>('[data-sp-plug]')!;
    const pulse = root.querySelector<SVGCircleElement>('[data-sp-pulse]')!;
    const markFrom = root.querySelector<SVGGElement>('[data-sp-mark="from"]')!;
    const markTo = root.querySelector<SVGGElement>('[data-sp-mark="to"]')!;
    const checks = [...root.querySelectorAll<HTMLElement>('[data-sp-check]')];
    const g = JSON.parse(cordEl.dataset.geom || '{}') as { xOld: number; xNew: number; top: number; end: number; bend: number };
    let anims: Animation[] = [];

    const cord = (tx: number, ty: number) => `M${tx} ${ty} C ${tx} ${ty + g.bend}, ${g.xOld} ${g.end - g.bend}, ${g.xOld} ${g.end}`;
    const placeCord = (tx: number, ty: number) => {
      cordEl.setAttribute('d', cord(tx, ty));
      plug.style.transform = `translate(${tx}px, ${ty}px)`;
    };

    const setStage = (n: number) =>
      stages.forEach((s, i) => {
        s.classList.toggle('is-done', i < n);
        s.classList.toggle('is-active', i === n);
      });

    const setStatus = (state: 'open' | 'progress' | 'done') => {
      status.dataset.state = state;
      status.textContent = state === 'open' ? 'Open' : state === 'progress' ? 'In progress' : 'Done';
    };

    // Decided once per demo: reset() hides the parts for the animation, so a setting changed later must not leave it blank.
    const reduced = prefersReducedMotion();

    const reset = () => {
      anims.forEach((a) => a.cancel());
      anims = [];
      box.classList.add('sp--instant', 'sp--armed');
      setStage(-1);
      ticket.classList.remove('is-on');
      setStatus('open');
      rows.forEach((r) => r.classList.remove('is-hit', 'is-scan'));
      updated.classList.remove('is-on');
      placeCord(g.xOld, g.top);
      pulse.classList.remove('is-on');
      markFrom.classList.remove('is-on', 'is-free');
      markTo.classList.remove('is-on', 'is-live');
      checks.forEach((c) => c.classList.remove('is-on'));
      void box.offsetWidth;
      box.classList.remove('sp--instant');
    };

    const run = createRun(async (alive) => {
      if (reduced) return;
      reset();
      await sleep(250);
      if (!alive()) return;

      // 1 · Request: the ticket comes in
      setStage(0);
      ticket.classList.add('is-on');
      announce(root, 'Request: move desk 2B-14 to 3A-02');
      await sleep(850);
      if (!alive()) return;

      // 2 · Look up: a finger runs down the as-built record; each port it names lights on the panel
      setStage(1);
      setStatus('progress');
      rows.forEach((r, i) => {
        at(i * 130, alive, () => r.classList.add('is-scan'));
        at(i * 130 + 150, alive, () => r.classList.remove('is-scan'));
      });
      at(130, alive, () => {
        rowFrom.classList.add('is-hit');
        markFrom.classList.add('is-on');
      });
      at(390, alive, () => {
        rowTo.classList.add('is-hit');
        markTo.classList.add('is-on');
        announce(root, 'Record: 2B-14 is panel port A-14, 3A-02 is A-22');
      });
      await sleep(1150);
      if (!alive()) return;

      // 3 · Re-patch: unplug from A-14, carry the cord across, plug into A-22. One cord, redrawn each frame.
      setStage(2);
      await frames(
        MOVE_MS,
        (t) => {
          const lift = t < 0.22 ? easeOut(t / 0.22) : t < 0.78 ? 1 : 1 - easeOut((t - 0.78) / 0.22);
          const carry = t < 0.22 ? 0 : t < 0.78 ? easeInOut((t - 0.22) / 0.56) : 1;
          placeCord(g.xOld + (g.xNew - g.xOld) * carry, g.top + LIFT * lift);
        },
        alive,
      );
      if (!alive()) return;
      placeCord(g.xNew, g.top);
      markFrom.classList.add('is-free');
      markTo.classList.add('is-live');
      announce(root, 'Patch cord moved to A-22');
      await sleep(350);
      if (!alive()) return;

      // 4 · Test & update: a pulse runs the new cord and back, then the record is updated
      setStage(3);
      const out = bezierPoints([g.xNew, g.top], [g.xNew, g.top + g.bend], [g.xOld, g.end - g.bend], [g.xOld, g.end], 12);
      const back = [...out].reverse();
      pulse.classList.add('is-on');
      anims.push(moveAlong(pulse, [...out, ...back], [...evenTimes(13, PULSE_MS / 2, 0), ...evenTimes(13, PULSE_MS / 2, PULSE_MS / 2)], 'ease-in-out'));
      await sleep(PULSE_MS);
      if (!alive()) return;
      pulse.classList.remove('is-on');
      checks[0].classList.add('is-on');
      await sleep(420);
      if (!alive()) return;
      updated.classList.add('is-on');
      checks[1].classList.add('is-on');
      await sleep(420);
      if (!alive()) return;
      setStatus('done');
      setStage(4);
      announce(root, 'Tested, record updated, ticket done');
      finished(root);
    });

    if (!reduced) {
      reset();
      onFirstView(root, run);
    }
    bindReplay(root, run);
  });
</script>

<style>
  .sp {
    display: grid;
    gap: 1rem;
  }

  /* Stage strip */
  .sp__stages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    color: var(--steel);
  }

  .sp__stage {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color 0.25s ease;
  }

  .sp__stage-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--hairline-strong);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .sp__stage.is-active {
    color: var(--ink);
  }

  .sp__stage.is-active .sp__stage-dot {
    border-color: var(--signal);
    background: var(--signal);
  }

  /* The dot of the stage that just started gives a small pop */
  .sp--armed .sp__stage.is-active .sp__stage-dot {
    animation: sp-pop 320ms var(--ease-out);
  }

  @keyframes sp-pop {
    from {
      transform: scale(1.6);
    }
  }

  .sp__stage.is-done {
    color: var(--ink);
  }

  .sp__stage.is-done .sp__stage-dot {
    border-color: var(--pass);
    background: var(--pass);
  }

  .sp__grid {
    display: grid;
    gap: 1rem;
  }

  .sp__left,
  .sp__right {
    display: grid;
    gap: 0.875rem;
    align-content: start;
    min-width: 0;
  }

  /* Ticket */
  .sp__ticket {
    display: grid;
    gap: 0.4rem;
    padding: 0.75rem 0.875rem;
    border-radius: var(--radius);
    background: var(--paper-sunken);
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.35s ease, transform 0.45s var(--ease-out);
  }

  .sp__ticket.is-on {
    opacity: 1;
    transform: none;
  }

  .sp__ticket-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    color: var(--steel);
  }

  .sp__ticket-body {
    color: var(--ink);
  }

  .sp__status {
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
    background: var(--paper-sunken);
    color: var(--steel);
    transition: background 0.25s ease, color 0.25s ease;
  }

  .sp__status[data-state='progress'] {
    background: color-mix(in srgb, var(--signal) 12%, var(--white));
    color: var(--signal);
  }

  .sp__status[data-state='done'] {
    background: color-mix(in srgb, var(--pass) 12%, var(--white));
    color: var(--pass);
  }

  /* "Done" lands with a small settle, like a stamp */
  .sp--armed .sp__status[data-state='done'] {
    animation: sp-settle 360ms var(--ease-out);
  }

  @keyframes sp-settle {
    from {
      transform: scale(1.18);
    }
  }

  /* Records table */
  .sp__records {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  .sp__records caption {
    text-align: left;
    padding-bottom: 0.4rem;
    color: var(--steel);
  }

  .sp__records th {
    text-align: left;
    font-weight: 500;
    color: var(--steel);
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--hairline-strong);
  }

  .sp__records td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--hairline);
    transition: background 0.22s ease, color 0.3s ease;
  }

  .sp__row td {
    color: var(--steel);
  }

  /* The finger running down the record */
  .sp__row.is-scan td {
    background: var(--paper-sunken);
  }

  .sp__row.is-hit td {
    background: color-mix(in srgb, var(--signal) 8%, var(--white));
    color: var(--ink);
    font-weight: 600;
  }

  .sp__updated {
    color: var(--pass);
  }

  /* Armed by the script: the update is written in from the left */
  .sp--armed .sp__updated {
    display: inline-block;
    clip-path: inset(-10% 100% -10% 0);
    transition: clip-path 320ms var(--ease-out);
  }

  .sp--armed .sp__updated.is-on {
    clip-path: inset(-10% 0 -10% 0);
  }

  /* Panel + switch */
  .sp__panel {
    width: 100%;
    height: auto;
    padding: 0.25rem;
    background: var(--paper-sunken);
    border-radius: var(--radius);
    overflow: visible;
  }

  .sp__box {
    fill: var(--white);
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .sp__port {
    fill: var(--ink);
  }

  /* SVG text is sized in screen pixels via --u (see fitSvgText), capped to fit the drawing */
  .sp__tiny {
    font-family: var(--font-mono);
    font-size: clamp(9px, calc(var(--u, 1) * 9.5px), 10px);
    letter-spacing: normal;
    fill: var(--steel);
  }

  .sp__cord {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .sp__cord--static {
    stroke: var(--hairline-strong);
  }

  .sp__cord--move {
    stroke: var(--t568-blue);
  }

  .sp__plug {
    fill: var(--t568-blue);
    stroke: var(--white);
    stroke-width: 1;
  }

  .sp__pulse {
    fill: var(--white);
    stroke: var(--pass);
    stroke-width: 2;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .sp__pulse.is-on {
    opacity: 1;
  }

  .sp__mark {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .sp__mark.is-on {
    opacity: 1;
  }

  .sp__mark rect {
    fill: none;
    stroke-width: 2;
    transition: stroke 0.3s ease;
  }

  /* Port labels sit over the cords, so they get a paper-coloured halo */
  .sp__mark text {
    font-family: var(--font-mono);
    font-size: clamp(9px, calc(var(--u, 1) * 10.5px), 11.5px);
    font-weight: 600;
    paint-order: stroke;
    stroke: var(--paper-sunken);
    stroke-width: 3px;
    stroke-linejoin: round;
    transition: fill 0.3s ease;
  }

  /* A-14: red while the cord is still in it, steel once it is free */
  .sp__mark--from rect {
    stroke: var(--signal);
  }

  .sp__mark--from text {
    fill: var(--signal);
  }

  .sp__mark--from.is-free rect {
    stroke: var(--steel);
    stroke-dasharray: 3 2;
  }

  .sp__mark--from.is-free text {
    fill: var(--steel);
  }

  /* A-22: steel when the record names it, green once the cord is plugged in */
  .sp__mark--to rect {
    stroke: var(--steel);
  }

  .sp__mark--to text {
    fill: var(--steel);
  }

  .sp__mark--to.is-live rect {
    stroke: var(--pass);
  }

  .sp__mark--to.is-live text {
    fill: var(--pass);
  }

  /* Checks */
  .sp__checks {
    display: grid;
    gap: 0.35rem;
  }

  .sp__checks li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--ink);
    opacity: 0.55;
    transition: opacity 0.3s ease;
  }

  .sp__checks li span {
    display: inline-flex;
    color: var(--pass);
  }

  .sp__checks li.is-on {
    opacity: 1;
  }

  /* Each check draws itself when its line comes on */
  .sp--armed .sp__checks li :global(svg path) {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition: stroke-dashoffset 360ms var(--ease-out) 80ms;
  }

  .sp--armed .sp__checks li.is-on :global(svg path) {
    stroke-dashoffset: 0;
  }

  .sp--instant,
  .sp--instant * {
    transition: none !important;
    animation: none !important;
  }

  @container (min-width: 600px) {
    .sp__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }

  /* Phones (narrow stepper stage): one-line stage strip, tighter ticket, table and spacing
     so the whole demo fits on one screen */
  @container (max-width: 520px) {
    .sp,
    .sp__grid {
      gap: 0.625rem;
    }

    .sp__left,
    .sp__right {
      gap: 0.5rem;
    }

    .sp__stages {
      justify-content: space-between;
      gap: 0.35rem 0.5rem;
      font-size: 0.8125rem;
    }

    .sp__stage {
      gap: 0.3rem;
    }

    .sp__stage-dot {
      width: 7px;
      height: 7px;
    }

    .sp__ticket {
      gap: 0.2rem;
      padding: 0.45rem 0.75rem;
      line-height: 1.4;
    }

    .sp__status {
      padding-block: 0.1rem;
    }

    .sp__records {
      font-size: 0.8125rem;
      line-height: 1.35;
    }

    .sp__records caption {
      padding-bottom: 0.25rem;
    }

    .sp__records th {
      padding: 0.25rem 0.5rem;
    }

    .sp__records td {
      padding: 0.3rem 0.5rem;
    }

    /* No-JS fallback for the label scale (the script sets the exact value) */
    .sp__panel {
      --u: 1.02;
      padding: 0;
    }

    .sp__checks {
      gap: 0.25rem;
      font-size: 0.8125rem;
      line-height: 1.4;
    }
  }
</style>
