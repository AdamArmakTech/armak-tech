---
/**
 * Design — "Site plan".
 * The same office as the Assess demo; the plan is drawn as you watch — walls, then the data drops snap
 * in one by one, each access point lands and its coverage spreads, each camera's view opens, and the
 * cable routes draw the way they get pulled: the trunk out from the closet along the ceiling, then one
 * branch down to each device in order. The bill of materials counts every piece as it lands.
 * Four jacks then show their codes; tapping one opens the same jack in the Trace demo.
 * Teaches: the price comes from a real drawing, not a guess. After it plays, the legend chips
 * highlight one layer at a time. Server-renders the finished plan with the codes (no-JS / reduced motion).
 */
import DemoFrame from './DemoFrame.astro';
import { Check } from '@lucide/astro';
import OfficePlan from './OfficePlan.astro';

const TRUNK_Y = 128;
const RACK = { x: 73, y: 62 };
const TRUNK_END = 386; // the trunk runs along the ceiling to the far wall
const TRUNK_SPUR = 16; // and a short spur the other way, for the corner camera

// Sample layout for this floor
const drops = [
  [118, 166], [146, 166], [178, 166], [206, 166],
  [118, 206], [146, 206], [178, 206], [206, 206],
  [100, 72], [176, 72], [300, 84], [330, 216],
];
const aps = [
  { x: 150, y: 190, r: 82 },
  { x: 255, y: 62, r: 78 },
  { x: 330, y: 200, r: 72 },
];
const cams = [
  { x: 384, y: 168, cone: '384,168 330,250 386,250' }, // lobby → entrance
  { x: 16, y: 244, cone: '16,244 130,150 150,214' }, // open office corner
  { x: 286, y: 116, cone: '286,116 180,150 240,190' }, // hallway over the open office
];

// Four drops are the same jacks the Trace demo lets you pick
const linked = [
  { id: '2B-15', x: 100, y: 72 },
  { id: '2B-14', x: 176, y: 72 },
  { id: '2C-03', x: 300, y: 84 },
  { id: '2A-07', x: 206, y: 166 },
];

// Every device gets a branch from the ceiling trunk down (or up) to it; the trunk runs out from the rack.
// Branches are drawn in the order the trunk reaches them (left to right), so each has a rank.
const devices = [...drops.map(([x, y]) => ({ x, y })), ...aps, ...cams];
const rankOf = (i: number) => devices.filter((e, j) => e.x < devices[i].x || (e.x === devices[i].x && j < i)).length;
const branches = devices.map((d, i) => ({ d: `M${d.x} ${TRUNK_Y} V${d.y}`, rank: rankOf(i) }));
const trunk = `M${RACK.x} ${RACK.y} V${TRUNK_Y} H${TRUNK_END}`;
const spur = `M${RACK.x} ${TRUNK_Y} H${TRUNK_SPUR}`;

const layers = [
  { id: 'drops', label: 'Data drops', count: drops.length },
  { id: 'wifi', label: 'Wi-Fi access points', count: aps.length },
  { id: 'cams', label: 'Cameras', count: cams.length },
  { id: 'routes', label: 'Cable routes', count: devices.length },
];
---

<DemoFrame
  name="design"
  title="Site plan"
  caption="The walk becomes a drawing: every jack, access point and camera placed, Wi-Fi coverage overlapping so there are no dead zones, and every cable routed home to the closet. The quote comes from this plan."
>
  <div class="ds" data-focus="">
    <div class="ds__stage">
      <svg class="ds__plan" viewBox="0 0 400 262" role="img" data-fit-text aria-label="Office floor plan with planned data drops, Wi-Fi coverage, camera views and cable routes back to the telecom closet">
        <!-- Wi-Fi coverage (under everything) -->
        <g class="ds__layer is-on" data-ds-layer="wifi">
          {aps.map((a, i) => <circle class="ds__cover" style={`--i:${i}`} cx={a.x} cy={a.y} r={a.r} />)}
        </g>
        <!-- camera views, each opening from its camera -->
        <g class="ds__layer is-on" data-ds-layer="cams">
          {cams.map((c, i) => <polygon class="ds__cone" style={`--i:${i}; transform-origin: ${c.x}px ${c.y}px`} points={c.cone} />)}
        </g>

        <OfficePlan />

        <!-- cable routes: the trunk out from the rack, then a branch to each device in trunk order -->
        <g class="ds__layer is-on" data-ds-layer="routes">
          <path class="ds__route ds__route--trunk" d={trunk} pathLength="1" />
          <path class="ds__route ds__route--trunk" d={spur} pathLength="1" />
          {branches.map((b) => <path class="ds__route ds__route--branch" style={`--i:${b.rank}`} d={b.d} pathLength="1" />)}
        </g>

        <!-- devices on top -->
        <g class="ds__layer is-on" data-ds-layer="drops">
          {drops.map(([x, y], i) => <rect class="ds__drop" style={`--i:${i}`} x={x - 4} y={y - 4} width="8" height="8" rx="1" />)}
        </g>
        <g class="ds__layer is-on" data-ds-layer="wifi-dev">
          {aps.map((a, i) => (
            <g transform={`translate(${a.x} ${a.y})`}>
              <g class="ds__ap" style={`--i:${i}`}>
                <circle r="5.5" />
                <path d="M-7 -6 Q0 -12 7 -6 M-4 -3 Q0 -7 4 -3" />
              </g>
            </g>
          ))}
        </g>
        <g class="ds__layer is-on" data-ds-layer="cams-dev">
          {cams.map((c, i) => <circle class="ds__cam" style={`--i:${i}`} cx={c.x} cy={c.y} r="4.5" />)}
        </g>
      </svg>

      <!-- Four linked jacks: 44 px links laid over the exact drop points -->
      <ul role="list" class="ds__jacks">
        {linked.map((j, i) => (
          <li style={`left:${(j.x / 400) * 100}%;top:${(j.y / 262) * 100}%;--i:${i}`}>
            <a class="ds__jack" href="#trace" data-jack={j.id} aria-label={`Jack ${j.id}: trace its cable`}>
              <span class="ds__code t-readout" aria-hidden="true">{j.id}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="ds__side">
      <p class="t-meta ds__side-title">Bill of materials, this floor</p>
      <ul role="list" class="ds__legend">
        {layers.map((l) => (
          <li>
            <button type="button" class={`ds__chip ds__chip--${l.id} is-on`} data-ds-chip={l.id} aria-pressed="false">
              <span class="ds__swatch" aria-hidden="true"></span>
              <span class="ds__chip-label">{l.label}</span>
              <span class="ds__count t-readout" data-ds-count={l.count}>{l.count}</span>
            </button>
          </li>
        ))}
        <li>
          <span class="ds__chip ds__chip--static is-on">
            <span class="ds__swatch ds__swatch--rack" aria-hidden="true"></span>
            <span class="ds__chip-label">Rack in the closet</span>
            <span class="ds__count t-readout">1</span>
          </span>
        </li>
      </ul>
      <p class="ds__hint t-small is-on" data-ds-hint>
        <span>Tap a layer to highlight it.</span>
        <span>Tap a labeled jack to trace its cable.</span>
      </p>
      <p class="ds__done is-on t-meta" data-ds-done><Check size={12} stroke-width={2.25} aria-hidden="true" /> Plan ready, priced from the drawing</p>
    </div>
  </div>
</DemoFrame>

<script>
  import { createRun, onFirstView, bindReplay, announce, finished, sleep, prefersReducedMotion, fitSvgText, at } from '../../scripts/demo';

  // Beat timing (ms). The CSS delays below use the same steps, so the counts tick as each piece lands.
  const DROP_STEP = 25;
  const AP_STEP = 140;
  const CAM_STEP = 120;
  const TRUNK_MS = 420;
  const BRANCH_STEP = 40;
  const BRANCH_MS = 200;

  document.querySelectorAll<HTMLElement>('[data-demo="design"]').forEach((root) => {
    const box = root.querySelector<HTMLElement>('.ds')!;
    const layer = (id: string) => root.querySelector<SVGGElement>(`[data-ds-layer="${id}"]`)!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-ds-chip]')];
    const staticChip = root.querySelector<HTMLElement>('.ds__chip--static')!;
    const counts = [...root.querySelectorAll<HTMLElement>('[data-ds-count]')];
    const done = root.querySelector<HTMLElement>('[data-ds-done]')!;
    const hint = root.querySelector<HTMLElement>('[data-ds-hint]')!;
    const jacks = [...root.querySelectorAll<HTMLAnchorElement>('.ds__jack')];
    const walls = [...root.querySelectorAll<SVGPathElement>('.plan__wall')];
    const fades = [...root.querySelectorAll<SVGElement>('.plan__label, .plan__furn')];
    const groups = ['drops', 'wifi', 'wifi-dev', 'cams', 'cams-dev', 'routes'];
    const ease = getComputedStyle(root).getPropertyValue('--ease-out').trim() || 'cubic-bezier(0.16, 1, 0.3, 1)';
    let anims: Animation[] = [];

    fitSvgText(root);

    const chipFor = (id: string) => chips.find((c) => c.dataset.dsChip === id)!;

    /** The count on a chip ticks up one at a time, `step` ms apart, starting after `offset` ms. */
    const tick = (chip: HTMLElement, step: number, offset: number, alive: () => boolean) => {
      const el = chip.querySelector<HTMLElement>('[data-ds-count]')!;
      const n = Number(el.dataset.dsCount);
      for (let k = 1; k <= n; k++) at(offset + (k - 1) * step, alive, () => (el.textContent = String(k)));
    };

    const setFocus = (id: string) => {
      box.dataset.focus = id;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.dsChip === id)));
    };

    // Decided once per demo: reset() hides the parts for the animation, so a setting changed later must not leave it blank.
    const reduced = prefersReducedMotion();

    // Hidden starting state (armed here, so no-JS and reduced motion keep the finished plan)
    const reset = () => {
      anims.forEach((a) => a.cancel());
      anims = [];
      box.classList.add('ds--instant', 'ds--armed');
      box.classList.remove('ds--linked');
      setFocus('');
      groups.forEach((g) => layer(g).classList.remove('is-on'));
      chips.forEach((c) => c.classList.remove('is-on'));
      staticChip.classList.remove('is-on');
      counts.forEach((c) => (c.textContent = '0'));
      done.classList.remove('is-on');
      hint.classList.remove('is-on');
      walls.forEach((w) => {
        const len = w.getTotalLength();
        w.style.strokeDasharray = String(len);
        w.style.strokeDashoffset = String(len);
      });
      fades.forEach((f) => (f.style.opacity = '0'));
      void box.offsetWidth;
      box.classList.remove('ds--instant');
    };

    const drawWalls = () => {
      walls.forEach((w, i) => {
        const len = w.getTotalLength();
        const a = w.animate([{ strokeDashoffset: len }, { strokeDashoffset: 0 }], {
          duration: 600,
          delay: i * 60,
          easing: ease,
          fill: 'both',
        });
        a.onfinish = () => {
          w.style.strokeDasharray = '';
          w.style.strokeDashoffset = '';
          a.cancel();
        };
        anims.push(a);
      });
      fades.forEach((f) => {
        const a = f.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, delay: 300, easing: 'ease', fill: 'both' });
        a.onfinish = () => {
          f.style.opacity = '';
          a.cancel();
        };
        anims.push(a);
      });
    };

    /** One beat: turn the layers on, light the chip, tick its count as the pieces land, wait `ms`. */
    const beat = async (ids: string[], chip: string, step: number, offset: number, ms: number, message: string, alive: () => boolean) => {
      ids.forEach((g) => layer(g).classList.add('is-on'));
      const c = chipFor(chip);
      c.classList.add('is-on');
      tick(c, step, offset, alive);
      announce(root, message);
      await sleep(ms);
      return alive();
    };

    const run = createRun(async (alive) => {
      if (reduced) return;
      reset();
      await sleep(150);
      if (!alive()) return;
      drawWalls(); // walls 600 ms (+60 ms stagger), labels fade from 300 ms
      announce(root, 'Walls drawn');
      await sleep(780);
      if (!alive()) return;
      // 12 drops snap in 25 ms apart; the count ticks with them
      if (!(await beat(['drops'], 'drops', DROP_STEP, 90, 12 * DROP_STEP + 180, 'Data drops placed', alive))) return;
      // each access point lands, then its coverage spreads out
      if (!(await beat(['wifi', 'wifi-dev'], 'wifi', AP_STEP, 120, 3 * AP_STEP + 340, 'Wi-Fi coverage placed', alive))) return;
      // each camera lands and its view opens
      if (!(await beat(['cams', 'cams-dev'], 'cams', CAM_STEP, 100, 3 * CAM_STEP + 280, 'Cameras placed', alive))) return;
      staticChip.classList.add('is-on');
      // the trunk out from the rack, then one branch per device in the order the trunk reaches them
      const n = Number(chipFor('routes').querySelector<HTMLElement>('[data-ds-count]')!.dataset.dsCount);
      const routesMs = TRUNK_MS + (n - 1) * BRANCH_STEP + BRANCH_MS + 120;
      if (!(await beat(['routes'], 'routes', BRANCH_STEP, TRUNK_MS + BRANCH_MS - 40, routesMs, 'Cable routes drawn back to the closet', alive))) return;
      done.classList.add('is-on');
      hint.classList.add('is-on');
      box.classList.add('ds--linked'); // jack codes, 160 ms each, 40 ms apart
      announce(root, 'Plan ready');
      finished(root);
    });

    // Legend chips highlight one layer (press again to show all)
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        const id = c.dataset.dsChip!;
        setFocus(box.dataset.focus === id ? '' : id);
      }),
    );

    // Linked jacks open the same jack in the Trace demo
    jacks.forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('armak:trace', { detail: { jack: a.dataset.jack } }));
      }),
    );

    if (!reduced) {
      reset();
      onFirstView(root, run);
    }
    bindReplay(root, run);
  });
</script>

<style>
  .ds {
    display: grid;
    gap: 1rem;
    --c-drops: var(--ink);
    --c-wifi: var(--armak-blue);
    --c-cams: var(--ink);
    --c-routes: var(--steel);
  }

  .ds__stage {
    position: relative;
  }

  .ds__plan {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-sunken);
    border-radius: var(--radius);
  }

  /* Layers fade in; the Wi-Fi, camera and route layers switch at once and let their pieces land one by one */
  .ds__layer {
    opacity: 0;
    transition: opacity var(--dur) ease;
  }

  .ds__layer.is-on {
    opacity: 1;
  }

  .ds__layer[data-ds-layer='drops'] {
    transition-duration: var(--dur-fast);
  }

  /* These layers are always on as a group; their pieces hide and land one by one (rules below) */
  .ds__layer[data-ds-layer='wifi'],
  .ds__layer[data-ds-layer='wifi-dev'],
  .ds__layer[data-ds-layer='cams'],
  .ds__layer[data-ds-layer='cams-dev'],
  .ds__layer[data-ds-layer='routes'] {
    opacity: 1;
  }

  /* Wi-Fi coverage spreads out from each access point, one after another */
  .ds__cover {
    fill: color-mix(in srgb, var(--c-wifi) 13%, transparent);
    stroke: color-mix(in srgb, var(--c-wifi) 45%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 700ms var(--ease-out) calc(var(--i) * 140ms + 60ms),
      opacity 300ms ease calc(var(--i) * 140ms + 60ms);
  }

  .ds--armed .ds__layer:not(.is-on) .ds__cover {
    transform: scale(0.45);
    opacity: 0;
  }

  /* The access point itself lands first */
  .ds__ap {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 360ms var(--ease-out) calc(var(--i) * 140ms),
      opacity 200ms ease calc(var(--i) * 140ms);
  }

  .ds--armed .ds__layer:not(.is-on) .ds__ap {
    transform: scale(0.5);
    opacity: 0;
  }

  /* Each camera lands, then its view opens out from the camera */
  .ds__cone {
    fill: color-mix(in srgb, var(--c-cams) 10%, transparent);
    stroke: none;
    transform-box: view-box;
    transition:
      transform 520ms var(--ease-out) calc(var(--i) * 120ms + 80ms),
      opacity 240ms ease calc(var(--i) * 120ms + 80ms);
  }

  .ds--armed .ds__layer:not(.is-on) .ds__cone {
    transform: scale(0.25);
    opacity: 0;
  }

  .ds__cam {
    fill: var(--c-cams);
    stroke: var(--white);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 360ms var(--ease-out) calc(var(--i) * 120ms),
      opacity 200ms ease calc(var(--i) * 120ms);
  }

  .ds--armed .ds__layer:not(.is-on) .ds__cam {
    transform: scale(0.4);
    opacity: 0;
  }

  /* Routes: the trunk draws out from the rack along the ceiling, then each branch drops to its device
     in the order the trunk reaches it (the --i rank). Same steps as the script's count ticks. */
  .ds__route {
    fill: none;
    stroke: var(--c-routes);
    stroke-width: 1.25;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    stroke-linecap: round;
  }

  .ds__route--trunk {
    stroke-width: 3;
    stroke-linecap: butt;
    transition: stroke-dashoffset 420ms var(--ease-in-out);
  }

  .ds__route--branch {
    transition: stroke-dashoffset 200ms var(--ease-out) calc(420ms + var(--i) * 40ms);
  }

  .ds__layer.is-on .ds__route {
    stroke-dashoffset: 0;
  }

  .ds__drop {
    fill: var(--white);
    stroke: var(--c-drops);
    stroke-width: 1.75;
  }

  .ds__ap circle {
    fill: var(--c-wifi);
    stroke: var(--white);
    stroke-width: 1.5;
  }

  .ds__ap path {
    fill: none;
    stroke: var(--c-wifi);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* Drops snap into place: a 3-unit slide plus fade, 160 ms, 25 ms apart */
  @media (prefers-reduced-motion: no-preference) {
    .ds--armed .ds__layer.is-on .ds__drop {
      animation: ds-snap var(--dur-fast) var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 25ms);
    }
  }

  @keyframes ds-snap {
    from {
      opacity: 0;
      transform: translate(3px, 3px);
    }
  }

  /* Highlight one layer: dim the others */
  .ds:not([data-focus='']) .ds__layer {
    opacity: 0.12;
  }

  .ds[data-focus='drops'] [data-ds-layer='drops'],
  .ds[data-focus='wifi'] [data-ds-layer='wifi'],
  .ds[data-focus='wifi'] [data-ds-layer='wifi-dev'],
  .ds[data-focus='cams'] [data-ds-layer='cams'],
  .ds[data-focus='cams'] [data-ds-layer='cams-dev'],
  .ds[data-focus='routes'] [data-ds-layer='routes'] {
    opacity: 1;
  }

  /* Linked jacks: 44 px links over the exact drop points, code chip under each */
  .ds__jacks {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .ds__jacks > li {
    position: absolute;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
  }

  .ds__jack {
    position: relative;
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .ds__code {
    position: absolute;
    left: 50%;
    top: calc(50% + 9px);
    transform: translateX(-50%);
    padding: 0.0625rem 0.3125rem;
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    font-size: 0.8125rem;
    line-height: 1.3;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .ds__jack:hover .ds__code {
    background: var(--ink);
    color: var(--paper);
  }

  /* Armed by the script: codes hidden until the plan is ready, then each slips up into place */
  .ds--armed .ds__jacks > li {
    opacity: 0;
    visibility: hidden;
  }

  .ds--armed .ds__code {
    transform: translate(-50%, 4px);
    transition: transform 260ms var(--ease-out) calc(var(--i) * 40ms);
  }

  .ds--armed.ds--linked .ds__jacks > li {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur-fast) ease calc(var(--i) * 40ms),
      visibility 0s linear calc(var(--i) * 40ms);
  }

  .ds--armed.ds--linked .ds__code {
    transform: translateX(-50%);
  }

  /* Legend / bill of materials */
  .ds__side {
    display: grid;
    gap: 0.625rem;
    align-content: start;
  }

  .ds__side-title {
    color: var(--steel);
  }

  .ds__legend {
    display: grid;
    gap: 0.25rem;
  }

  .ds__chip {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    gap: 0.625rem;
    align-items: center;
    width: 100%;
    min-height: 40px;
    padding: 0.5rem 0.25rem;
    text-align: left;
    opacity: 0.3;
    transition: opacity var(--dur) ease, background var(--dur-fast) ease;
  }

  .ds__chip.is-on {
    opacity: 1;
  }

  button.ds__chip:hover {
    background: var(--paper);
  }

  button.ds__chip[aria-pressed='true'] {
    background: var(--paper-sunken);
  }

  .ds__swatch {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--c);
  }

  .ds__chip--drops { --c: var(--c-drops); }
  .ds__chip--wifi { --c: var(--c-wifi); }
  .ds__chip--cams { --c: var(--c-cams); }
  .ds__chip--routes { --c: var(--c-routes); }

  .ds__swatch--rack {
    background: none;
    border: 1.5px solid var(--hairline-strong);
  }

  .ds__chip-label {
    font-weight: 500;
    color: var(--ink);
  }

  .ds__count {
    font-size: 0.875rem;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .ds__hint {
    display: grid;
    gap: 0.125rem;
    color: var(--steel);
    opacity: 0;
    transition: opacity var(--dur) ease;
  }

  .ds__hint.is-on {
    opacity: 1;
  }

  .ds__done {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    justify-self: start;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--pass) 10%, var(--white));
    color: var(--pass);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity var(--dur) ease, transform var(--dur) var(--ease-out);
  }

  .ds__done.is-on {
    opacity: 1;
    transform: none;
  }

  /* The check draws itself once the line is in place */
  .ds--armed .ds__done :global(svg path) {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
