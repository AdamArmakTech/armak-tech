---
/**
 * Install — "Trace a cable".
 * A small interactive under the before/after slider: tap one of four labeled jacks on the sample
 * office plan (shared OfficePlan), and its cable runs up the wall, across the ceiling and into the
 * IDF closet. When the route arrives, the matching port lights on a patch-panel strip and one
 * record row fills in. One route is lit at a time.
 * Same four jacks, same spots and same trunk line as the Design demo (TRUNK_Y 128, rack x 73).
 * Teaches: matching labels on both ends make a connection easy to find. SAMPLE data, no test date.
 * Motion (WAAPI, script only): branch 0-120 ms, trunk 120-560 ms, closet 560-760 ms (into the closet, up
 * the rack's side and into the panel row at the top of the rack, where horizontal cable lands), with a
 * tracer dot running the route ahead of the line; on the closet leg the line and the dot share one set of
 * eased samples, so they turn each corner together. The port lights at 760 ms (fills in one quick step);
 * the record row wipes in 760-960 ms. Reduced motion: everything at once.
 * No JavaScript: jack 2A-A15 is server-rendered already traced; the script clears it on start. Under
 * reduced motion it stays traced: that is the finished picture of the install demo above, whose last
 * beat traces it.
 * Listens for `armak:trace` (sent by the Design demo): scrolls here, lights that jack, focuses its button.
 * Listens on its own frame for `armak:trace-default` (sent by the install demo above as its last beat,
 * detail { since, accepted }): traces the example jack without scrolling or moving focus, and sets
 * `accepted`, unless the visitor has chosen or cleared a jack since `since` (their choice stands).
 */
import DemoFrame from './DemoFrame.astro';
import OfficePlan from './OfficePlan.astro';
import { signature, isShown } from '../../data/content';

const TRUNK_Y = 128;
const RACK_X = 73;
// The closet leg (rack in the plan: x 64-82, y 18-62, top unit 18-28): up from the trunk to just below the
// rack, over to the rack's right side, up the side to the panel row in the top unit, and into the panel
const CLOSET_Y = 68;
const SIDE_X = 78;
const PANEL_Y = 23;
const PANEL_X = 70;

// Plan viewBox 400 x 262. Jack positions match the Design demo's drops exactly.
const jacks = [
  { id: '2A-A15', port: 'A-15', x: 100, y: 72 },
  { id: '2A-A14', port: 'A-14', x: 176, y: 72 },
  { id: '2A-A03', port: 'A-03', x: 300, y: 84 },
  { id: '2A-A07', port: 'A-07', x: 206, y: 166 },
].map((j) => ({
  ...j,
  legs: [
    `M${j.x} ${j.y} V${TRUNK_Y}`,
    `M${j.x} ${TRUNK_Y} H${RACK_X}`,
    `M${RACK_X} ${TRUNK_Y} V${CLOSET_Y} H${SIDE_X} V${PANEL_Y} H${PANEL_X}`,
  ],
}));
const first = jacks[0];
const lineFor = (id: string, port: string) =>
  `Jack ${id} lands on port ${port}. Matching labels mean anyone can find it in seconds.`;
const recordTitle = isShown(signature.items.labelsAndAsBuilts) ? 'Handover record' : 'Test record';
const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(2)}%`;
---

<DemoFrame
  name="trace"
  title="Trace a cable"
  caption="Every jack and port gets a matching label, and the job is documented. That is what makes later moves and changes fast."
>
  <div class="tr" id="trace">
    <div class="tr__plan">
      <div class="tr__stage">
        <svg viewBox="0 0 400 262" role="img" data-fit-text aria-label="Sample office floor plan with four labeled wall jacks and the IDF closet at the top left. Choose a jack on the plan to see its cable route.">
          <OfficePlan />
          {jacks.map((j) => (
            <g class:list={['tr__route', { 'is-lit': j.id === first.id }]} data-tr-route={j.id}>
              {j.legs.map((d) => (
                <path d={d} pathLength="1" class="tr__seg" />
              ))}
            </g>
          ))}
          <!-- the tracer: runs the route ahead of the line while it draws -->
          <circle class="tr__head" r="4.5" cx="0" cy="0" data-tr-head />
          {jacks.map((j) => (
            <circle cx={j.x} cy={j.y} r="4" class:list={['tr__dot', { 'is-lit': j.id === first.id }]} data-tr-dot={j.id} />
          ))}
        </svg>
        <div class="tr__jacks" role="group" aria-label="Jacks to trace">
          {jacks.map((j) => (
            <button
              type="button"
              class="tr__jack"
              style={`left:${pct(j.x, 400)};top:${pct(j.y, 262)}`}
              aria-pressed={j.id === first.id ? 'true' : 'false'}
              aria-label={`Trace jack ${j.id}`}
              data-tr-jack={j.id}
              data-tr-default={j.id === first.id ? '' : undefined}
              data-port={j.port}
              data-x={j.x}
              data-y={j.y}
            >
              <span class="t-readout tr__jack-label">{j.id}</span>
            </button>
          ))}
        </div>
      </div>
      <p class="tr__words" data-tr-words>
        <span class="tr__word is-lit" data-tr-word>Up the wall</span>
        <span class="tr__word is-lit" data-tr-word>across the ceiling</span>
        <span class="tr__word is-lit" data-tr-word>into the closet</span>
      </p>
    </div>

    <div class="tr__side">
      <div class="tr__panel">
        <span class="t-readout tr__panel-name">2A-A</span>
        <div class="tr__ports" aria-hidden="true">
          {Array.from({ length: 24 }, (_, i) => {
            const p = `B-${String(i + 1).padStart(2, '0')}`;
            return <span class:list={['tr__port', { 'is-lit': p === first.port }]} data-tr-port={p}></span>;
          })}
        </div>
        <p class="t-readout tr__readout" data-tr-readout>Port: {first.port}</p>
      </div>

      <div class="tr__record">
        <div class="tr__record-head">
          <span class="tr__record-title">{recordTitle}</span>
          <span class="t-meta tr__tag">Sample</span>
        </div>
        <div class="tr__table" role="table" aria-label={`${recordTitle}, sample`}>
          <div class="tr__row tr__row--head" role="row">
            <span role="columnheader">Jack</span>
            <span role="columnheader">Panel</span>
            <span role="columnheader">Port</span>
            <span role="columnheader">Result</span>
          </div>
          <div class="tr__row tr__row--data" role="row" data-tr-row>
            <span class="t-readout" role="cell" data-tr-cell="jack">{first.id}</span>
            <span class="t-readout" role="cell" data-tr-cell="panel">2A-A</span>
            <span class="t-readout" role="cell" data-tr-cell="port">{first.port}</span>
            <span class="t-readout tr__pass" role="cell" data-tr-cell="result">PASS</span>
          </div>
        </div>
      </div>

      <p class="tr__line" data-tr-line>{lineFor(first.id, first.port)}</p>
    </div>
  </div>
</DemoFrame>

<script>
  import { bindReplay, announce, fitSvgText, prefersReducedMotion, easeInOut } from '../../scripts/demo';

  const EASE_OUT = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const HINT = 'Choose a jack to trace its cable.';
  const FADE = 120;
  // Legs of the route: [start, end] in ms from the moment a jack is chosen
  const LEGS: [number, number][] = [
    [0, 120],
    [120, 560],
    [560, 760],
  ];
  const ARRIVE = 760;
  // Where the legs turn (same plan as the Design demo): the ceiling trunk and the rack in the closet, then up
  // the rack's side to the panel row (the same corners as the markup's closet leg)
  const TRUNK_Y = 128;
  const RACK_X = 73;
  const CLOSET: [number, number][] = [
    [RACK_X, TRUNK_Y],
    [RACK_X, 68],
    [78, 68],
    [78, 23],
    [70, 23],
  ];

  /** The time (0-1) at which easeInOut reaches `f`, by halving: the curve only rises */
  const timeFor = (f: number) => {
    let lo = 0;
    let hi = 1;
    for (let k = 0; k < 30; k++) {
      const mid = (lo + hi) / 2;
      if (easeInOut(mid) < f) lo = mid;
      else hi = mid;
    }
    return (lo + hi) / 2;
  };

  /**
   * Samples along a leg with corners, eased in and out over the leg: `t` is the share of the leg's time, `f`
   * the share of its length drawn by then, `p` the point reached. Each corner gets a sample of its own, so a
   * dot moved straight between samples turns the corner exactly when the line does.
   */
  const sampleLeg = (pts: [number, number][], n = 16) => {
    const lens = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
    const total = lens.reduce((a, b) => a + b, 0) || 1;
    const pointAt = (d: number): [number, number] => {
      let rest = d;
      for (let i = 0; i < lens.length; i++) {
        if (rest <= lens[i] || i === lens.length - 1) {
          const k = lens[i] ? Math.min(1, Math.max(0, rest / lens[i])) : 0;
          return [pts[i][0] + (pts[i + 1][0] - pts[i][0]) * k, pts[i][1] + (pts[i + 1][1] - pts[i][1]) * k];
        }
        rest -= lens[i];
      }
      return pts[pts.length - 1];
    };
    const ts = Array.from({ length: n + 1 }, (_, k) => k / n);
    let acc = 0;
    for (let i = 0; i < lens.length - 1; i++) {
      acc += lens[i];
      ts.push(timeFor(acc / total));
    }
    ts.sort((a, b) => a - b);
    return ts.map((t) => {
      const f = t >= 1 ? 1 : easeInOut(t);
      return { t, f, p: pointAt(f * total) };
    });
  };
  const CLOSET_SAMPLES = sampleLeg(CLOSET);

  document.querySelectorAll<HTMLElement>('[data-demo="trace"]').forEach((root) => {
    const tr = root.querySelector<HTMLElement>('#trace')!;
    const jacks = [...root.querySelectorAll<HTMLButtonElement>('[data-tr-jack]')];
    const routes = [...root.querySelectorAll<SVGGElement>('[data-tr-route]')];
    const dots = [...root.querySelectorAll<SVGCircleElement>('[data-tr-dot]')];
    const head = root.querySelector<SVGCircleElement>('[data-tr-head]')!;
    const ports = [...root.querySelectorAll<HTMLElement>('[data-tr-port]')];
    const words = [...root.querySelectorAll<HTMLElement>('[data-tr-word]')];
    const line = root.querySelector<HTMLElement>('[data-tr-line]')!;
    const readout = root.querySelector<HTMLElement>('[data-tr-readout]')!;
    const row = root.querySelector<HTMLElement>('[data-tr-row]')!;
    const cell = (k: string) => row.querySelector<HTMLElement>(`[data-tr-cell="${k}"]`)!;

    let token = 0;
    let anims: Animation[] = [];
    let current: string | null = null;

    fitSvgText(root);

    const stop = () => {
      token++;
      anims.forEach((a) => a.cancel());
      anims = [];
    };

    const fillRow = (id: string | null, port: string | null) => {
      cell('jack').textContent = id ?? '—';
      cell('panel').textContent = id ? '2A-A' : '—';
      cell('port').textContent = port ?? '—';
      cell('result').textContent = id ? 'PASS' : '—';
      cell('result').classList.toggle('tr__pass', !!id);
    };

    const clear = () => {
      stop();
      current = null;
      jacks.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      routes.forEach((r) => r.classList.remove('is-lit'));
      dots.forEach((d) => d.classList.remove('is-lit'));
      ports.forEach((p) => p.classList.remove('is-lit'));
      words.forEach((w) => w.classList.remove('is-lit'));
      readout.textContent = 'Port: none lit';
      line.textContent = HINT;
      fillRow(null, null);
    };

    const arrive = (id: string, port: string) => {
      ports.find((p) => p.dataset.trPort === port)?.classList.add('is-lit');
      readout.textContent = `Port: ${port}`;
      line.textContent = `Jack ${id} lands on port ${port}. Matching labels mean anyone can find it in seconds.`;
      announce(root, `${line.textContent} Result: pass. Sample record filled in.`);
    };

    const start = (btn: HTMLButtonElement) => {
      const id = btn.dataset.trJack!;
      const port = btn.dataset.port!;
      const mine = ++token;
      current = id;
      jacks.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
      dots.forEach((d) => d.classList.toggle('is-lit', d.dataset.trDot === id));
      ports.forEach((p) => p.classList.remove('is-lit'));
      routes.forEach((r) => r.classList.toggle('is-lit', r.dataset.trRoute === id));
      fillRow(id, port);
      readout.textContent = 'Port: none lit';
      line.textContent = HINT;

      if (prefersReducedMotion()) {
        words.forEach((w) => w.classList.add('is-lit'));
        arrive(id, port);
        return;
      }

      words.forEach((w) => w.classList.remove('is-lit'));
      const route = routes.find((r) => r.dataset.trRoute === id)!;
      const segs = [...route.querySelectorAll<SVGPathElement>('.tr__seg')];
      const next: Animation[] = [];
      // The tracer runs the whole route (jack → ceiling → closet → up the rack side → panel row) on the legs'
      // timing, then fades out: one Web Animation on transform, no script per frame. The first two legs ease
      // out into their corner; on the closet leg it follows the same eased samples as the line.
      const x = Number(btn.dataset.x);
      const y = Number(btn.dataset.y);
      const [c0, c1] = LEGS[2];
      const at = (px: number, py: number) => `translate(${px.toFixed(2)}px, ${py.toFixed(2)}px)`;
      next.push(
        head.animate(
          [
            { transform: at(x, y), offset: 0, easing: EASE_OUT },
            { transform: at(x, TRUNK_Y), offset: LEGS[0][1] / ARRIVE, easing: EASE_OUT },
            ...CLOSET_SAMPLES.map((s) => ({
              transform: at(s.p[0], s.p[1]),
              offset: Math.min(1, (c0 + s.t * (c1 - c0)) / ARRIVE),
              easing: 'linear',
            })),
          ],
          { duration: ARRIVE, fill: 'both' },
        ),
      );
      next.push(
        head.animate(
          [{ opacity: 0, offset: 0 }, { opacity: 1, offset: 0.06 }, { opacity: 1, offset: 0.92 }, { opacity: 0, offset: 1 }],
          { duration: ARRIVE + 80, fill: 'both' },
        ),
      );
      segs.forEach((seg, i) => {
        const [from, to] = LEGS[i];
        const closet = i === LEGS.length - 1;
        next.push(
          seg.animate(
            [
              { strokeDashoffset: 1, opacity: 0, offset: 0 },
              { strokeDashoffset: 1, opacity: 1, offset: 0.001 },
              ...(closet
                ? CLOSET_SAMPLES.filter((s) => s.t > 0.001).map((s) => ({ strokeDashoffset: 1 - s.f, opacity: 1, offset: s.t }))
                : [{ strokeDashoffset: 0, opacity: 1, offset: 1 }]),
            ],
            { delay: from, duration: to - from, easing: closet ? 'linear' : EASE_OUT, fill: 'backwards' },
          ),
        );
        // The word for this leg lights as the leg starts
        const w = words[i];
        const a = w.animate([{ opacity: 0.65, transform: 'translateY(3px)' }, { opacity: 1, transform: 'none' }], {
          delay: from,
          duration: 220,
          easing: EASE_OUT,
          fill: 'backwards',
        });
        next.push(a);
        a.finished.then(() => mine === token && w.classList.add('is-lit')).catch(() => {});
        // Class takes over at the end of the fade, so a cancelled run never leaves a half state
        setTimeout(() => mine === token && w.classList.add('is-lit'), from + 160);
      });
      // Record row: one clip-path wipe, 760-960 ms
      next.push(
        row.animate(
          [{ clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)' }],
          { delay: ARRIVE, duration: 200, easing: EASE_OUT, fill: 'backwards' },
        ),
      );
      anims = next;
      setTimeout(() => mine === token && arrive(id, port), ARRIVE);
    };

    const choose = (btn: HTMLButtonElement) => {
      if (current && !prefersReducedMotion()) {
        // Fade the old route and row first (120 ms), then start the new trace
        const old = routes.find((r) => r.dataset.trRoute === current);
        const mine = ++token;
        anims.forEach((a) => a.cancel());
        anims = [];
        const fades = [old, row]
          .filter(Boolean)
          .map((el) => (el as Element).animate([{ opacity: 1 }, { opacity: 0 }], { duration: FADE, easing: 'ease', fill: 'forwards' }));
        anims = fades;
        setTimeout(() => {
          if (mine !== token) return;
          fades.forEach((a) => a.cancel());
          start(btn);
        }, FADE);
      } else start(btn);
    };

    // When the visitor last chose or cleared a jack (here or from the Design demo): the install demo's last
    // beat never overrides that
    let visitorAt = -Infinity;

    jacks.forEach((b) =>
      b.addEventListener('click', () => {
        visitorAt = performance.now();
        // Pressing the lit jack again turns it off
        if (b.getAttribute('aria-pressed') === 'true') {
          clear();
          announce(root, 'Trace cleared');
        } else choose(b);
      }),
    );

    bindReplay(root, () => {
      visitorAt = performance.now();
      clear();
      announce(root, 'Trace cleared');
    });

    // The Design demo sends this when a labeled jack is chosen there
    document.addEventListener('armak:trace', (e) => {
      const id = (e as CustomEvent<{ jack?: string }>).detail?.jack;
      const btn = jacks.find((b) => b.dataset.trJack === id);
      if (!btn) return;
      requestAnimationFrame(() => {
        // Stamped here, a frame later: the step strip restarts the install demo on this same event, and that
        // run's start must come before this choice, so its last beat leaves this jack alone
        visitorAt = performance.now();
        tr.scrollIntoView({ block: 'nearest', behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
        if (btn.getAttribute('aria-pressed') !== 'true') choose(btn);
        btn.focus({ preventScroll: true });
      });
    });

    // The install demo above sends this to its own frame's neighbour as its last beat ("anyone can trace a
    // connection in seconds"): trace the example jack (the one shown without scripts), here, without scrolling
    // or moving focus. Tracing it again when it is already lit replays the trace.
    root.addEventListener('armak:trace-default', (e) => {
      const ask = (e as CustomEvent<{ since?: number; accepted?: boolean }>).detail;
      if (ask && visitorAt > (ask.since ?? -Infinity)) return;
      const btn = jacks.find((b) => b.dataset.trDefault !== undefined) ?? jacks[0];
      if (!btn) return;
      if (ask) ask.accepted = true;
      choose(btn);
    });

    // Script is running: drop the no-JS example so the visitor starts from a choice. Under reduced motion the
    // example stays: it is the finished picture of the install demo above, whose last beat traces this jack.
    if (prefersReducedMotion()) current = jacks.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.trJack ?? null;
    else clear();
  });
</script>

<style>
  .tr {
    display: grid;
    gap: 1rem;
    min-width: 0;
    scroll-margin-top: 5rem;
  }

  .tr__plan {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .tr__stage {
    position: relative;
    min-width: 0;
  }

  .tr__stage svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper-sunken);
    border-radius: var(--radius);
  }

  /* Route: three legs, each drawn with stroke-dashoffset (pathLength is 1). Hidden until lit. */
  .tr__route {
    opacity: 0;
  }

  .tr__route.is-lit {
    opacity: 1;
  }

  .tr__seg {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .tr__dot {
    fill: var(--white);
    stroke: var(--ink);
    stroke-width: 1.75;
  }

  .tr__dot.is-lit {
    fill: var(--ink);
  }

  /* The chosen jack gives a small pop as the trace starts */
  @media (prefers-reduced-motion: no-preference) {
    .tr__dot.is-lit {
      transform-box: fill-box;
      transform-origin: center;
      animation: tr-dot 360ms var(--ease-out);
    }
  }

  @keyframes tr-dot {
    from {
      transform: scale(1.7);
    }
  }

  /* The tracer dot: placed by the script's transform, invisible until a trace runs */
  .tr__head {
    fill: var(--white);
    stroke: var(--ink);
    stroke-width: 2;
    opacity: 0;
  }

  /* Real buttons laid over the plan; the 44px box is the touch target, the dot is drawn in the svg */
  .tr__jacks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .tr__jack {
    position: absolute;
    display: grid;
    place-items: end center;
    width: 44px;
    height: 44px;
    padding: 0;
    transform: translate(-50%, -50%);
    border-radius: var(--radius);
    background: transparent;
    pointer-events: auto;
    cursor: pointer;
  }

  .tr__jack-label {
    margin-bottom: -0.55rem;
    padding: 0 0.2rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--ink);
    background: var(--white);
    border-radius: var(--radius);
    white-space: nowrap;
    transform: translateY(100%);
  }

  .tr__jack[aria-pressed='true'] .tr__jack-label {
    background: var(--ink);
    color: var(--white);
  }


  /* The three words under the plan, lit one by one as each leg starts */
  .tr__words {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .tr__word {
    opacity: 0.65; /* 6.3:1 on white */
  }

  .tr__word.is-lit {
    opacity: 1;
  }

  .tr__side {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-width: 0;
  }

  .tr__panel {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--paper-sunken);
    border-radius: var(--radius);
    color: var(--steel);
  }

  .tr__panel-name,
  .tr__readout {
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .tr__panel-name {
    color: var(--ink);
  }

  .tr__ports {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 4px;
  }

  .tr__port {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--white);
    border: 1px solid var(--ink);
    border-radius: 1px;
  }

  .tr__port.is-lit {
    background: var(--ink);
    border-color: var(--ink);
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }

  /* When the route arrives the port fills in one quick step, the way a port light comes on */
  @media (prefers-reduced-motion: no-preference) {
    .tr__port.is-lit {
      animation: tr-light 240ms var(--ease-out);
    }
  }

  @keyframes tr-light {
    from {
      transform: scale(0.6);
    }
  }

  /* Record: one sample row, a line between header and row */
  .tr__record {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--paper-sunken);
    border-radius: var(--radius);
  }

  .tr__record-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
