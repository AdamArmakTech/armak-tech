---
/**
 * Closing call to action for inner pages: a full-width dark band that runs into the footer. Pages using it pass footerCta={false} to Base so the
 * footer's generic CTA doesn't repeat it.
 */
import NextStep from '../ui/NextStep.astro';

interface Props {
  code: string;
  title: string;
  body: string;
  /** Service slug or topic carried into the contact form (see src/lib/cta.ts) */
  about?: string;
}

const { code, title, body, about } = Astro.props;
const id = `${code}-cta-title`; // code only keeps the heading id unique; it is no longer shown
---

<section class="page-cta cta-band surface-ink" aria-labelledby={id} data-dock-hide>
  <div class="container page-cta__inner">
    <div class="page-cta__copy">
      <h2 id={id} class="t-h2 page-cta__title" data-split>{title}</h2>
      <p class="t-lead">{body}</p>
    </div>
    <div class="page-cta__side">
      <NextStep about={about} tone="inverse" />
    </div>
  </div>
</section>

<style>
  /* Full-bleed dark band that runs straight into the footer (DESIGN.md rule 8). The footer's own
     top margin is 0, so this band carries the section gap above its content. */
  .page-cta {
    padding-block: var(--space-section);
  }

  .page-cta__inner {
    display: grid;
    gap: 2.5rem var(--col-gap);
  }

  .page-cta__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    align-content: start;
  }

  .page-cta__title {
    max-width: 16ch;
  }

  .page-cta__side {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }

  @media (min-width: 1024px) {
    .page-cta__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    .page-cta__copy {
      grid-column: 1 / span 7;
    }

    .page-cta__side {
      grid-column: 9 / -1;
    }
  }
</style>
