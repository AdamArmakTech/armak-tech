---
/**
 * Closing call to action for inner pages. Pages using it pass footerCta={false} to Base so the
 * footer's generic CTA doesn't repeat it.
 */
import Label from '../ui/Label.astro';
import NextStep from '../ui/NextStep.astro';
import Stripe from '../ui/Stripe.astro';

interface Props {
  code: string;
  title: string;
  body: string;
  /** Service slug or topic carried into the contact form (see src/lib/cta.ts) */
  about?: string;
}

const { code, title, body, about } = Astro.props;
---

<section class="page-cta container" aria-labelledby={`${code}-cta-title`} data-dock-hide>
  <div class="page-cta__panel surface-ink">
    <Stripe height={4} />
    <div class="page-cta__body">
      <div class="page-cta__copy">
        <Label code={code} tone="inverse">Next step</Label>
        <h2 id={`${code}-cta-title`} class="t-h2 page-cta__title" data-split>{title}</h2>
        <p class="t-lead" data-reveal>{body}</p>
      </div>
      <div class="page-cta__side" data-reveal style="--reveal-delay: 120ms">
        <NextStep about={about} tone="inverse" />
      </div>
    </div>
  </div>
</section>

<style>
  .page-cta {
    padding-block: var(--space-block);
  }

  .page-cta__panel {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .page-cta__body {
    display: grid;
    gap: 2.5rem var(--col-gap);
    padding: clamp(1.75rem, 1rem + 3.5vw, 4.5rem);
  }

  .page-cta__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .page-cta__title {
    max-width: 16ch;
  }

  .page-cta__side {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }

  @media (min-width: 1000px) {
    .page-cta__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    .page-cta__copy {
      grid-column: 1 / span 7;
    }

    .page-cta__side {
      grid-column: 9 / -1;
    }
  }
</style>
