---
/**
 * Closing call to action for inner pages: the dark band with the guided next step. Pages using it pass
 * footerCta={false} to Base so the footer's generic CTA doesn't repeat it.
 * `code` only keeps the heading id unique; it is not shown.
 */
import Label from '../ui/Label.astro';
import NextStep from '../ui/NextStep.astro';
import Stripe from '../ui/Stripe.astro';

interface Props {
  code: string;
  title: string;
  body: string;
  /** Service slug or topic carried into the contact form (see src/lib/cta.ts) */
  about?: string;
}

const { code, title, body, about } = Astro.props;
const id = `${code}-cta-title`;
---

<section class="page-cta container" aria-labelledby={id} data-dock-hide>
  <div class="page-cta__panel surface-ink">
    <Stripe height={4} />
    <div class="page-cta__body">
      <div class="page-cta__copy">
        <Label tone="inverse">Next step</Label>
        <h2 id={id} class="t-h2 page-cta__title" data-split>{title}</h2>
        <p class="t-lead">{body}</p>
      </div>
      <div class="page-cta__side">
        <NextStep about={about} tone="inverse" />
      </div>
    </div>
  </div>
</section>

<style>
  .page-cta {
    padding-block: var(--space-block);
  }

  .page-cta__panel {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .page-cta__body {
    display: grid;
    gap: 2.5rem var(--col-gap);
    padding: clamp(1.75rem, 1rem + 3.5vw, 4.5rem);
  }

  .page-cta__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .page-cta__title {
    max-width: 16ch;
  }

  .page-cta__side {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }

  @media (min-width: 1024px) {
    .page-cta__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    /* Copy 6 columns, side 5: the red button needs about 297px and must not wrap its label */
    .page-cta__copy {
      grid-column: 1 / span 6;
    }

    .page-cta__side {
      grid-column: 8 / -1;
    }
  }
</style>
