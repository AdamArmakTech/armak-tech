---
/**
 * Opener shared by every inner page (about, industries, projects, contact, 404).
 * Direction A: by default the page opens on a white SHEET laid on the paper (hairline edge, large
 * headline); with tone="ink" it is the page's one dark band instead. Pages end light either way.
 * breadcrumb → h1 → lead → optional actions (default slot).
 * Optional `aside` slot sits to the right on desktop; optional `spec` renders a SpecStrip foot.
 * `code`/`label`/`labelTone` props are still accepted but no longer shown (DESIGN.md rule 3);
 * callers clean up later.
 */
import SpecStrip from '../ui/SpecStrip.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  /** Accepted for compatibility, not rendered. */
  code?: string;
  /** Accepted for compatibility, not rendered. */
  label?: string;
  title: string;
  lead?: string;
  /** Trail after "Home". The last crumb is the current page. Omit to hide the breadcrumb. */
  crumbs?: Crumb[];
  spec?: string[];
  labelTone?: 'default' | 'signal';
  titleId?: string;
  /** 'paper' (default): a white sheet on the paper. 'ink': the page's one dark band, headline in paper. */
  tone?: 'paper' | 'ink';
}

const { title, lead, crumbs, spec, titleId = 'page-title', tone = 'paper' } = Astro.props;
const trail: Crumb[] | undefined = crumbs ? [{ label: 'Home', href: '/' }, ...crumbs] : undefined;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero', `page-hero--${tone}`, { 'surface-ink': tone === 'ink' }]} aria-labelledby={titleId} data-dock-start>
  <div class="container page-hero__wrap">
    {trail && (
      <nav class="page-hero__crumbs" aria-label="Breadcrumb">
        <ol role="list">
          {trail.map((c, i) =>
            i === trail.length - 1 ? <li aria-current="page">{c.label}</li> : <li><a href={c.href}>{c.label}</a></li>,
          )}
        </ol>
      </nav>
    )}

    <div class="page-hero__sheet">
      <div class:list={['page-hero__grid', { 'page-hero__grid--aside': hasAside }]}>
        <div class="page-hero__copy">
          <h1 id={titleId} class="t-h1 page-hero__title">{title}</h1>
          {lead && <p class="t-lead" data-reveal>{lead}</p>}
          <slot />
        </div>
        {hasAside && (
          <div class="page-hero__aside">
            <slot name="aside" />
          </div>
        )}
      </div>

      {spec && <SpecStrip class="page-hero__spec" items={spec} tone={tone === 'ink' ? 'inverse' : 'default'} />}
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-top: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
    padding-bottom: var(--space-block);
  }

  .page-hero--ink {
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    margin-bottom: var(--space-block);
  }

  .page-hero__wrap {
    display: grid;
    gap: var(--sp-5);
  }

  .page-hero__crumbs {
    font-size: var(--fs-small);
    color: var(--text);
  }

  .page-hero--ink .page-hero__crumbs {
    color: var(--steel-light);
  }

  .page-hero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) 0;
  }

  .page-hero__crumbs li {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .page-hero__crumbs li:not(:last-child)::after {
    content: "/";
    margin-inline: var(--sp-2);
    color: var(--hairline-strong);
  }

  .page-hero__crumbs a {
    display: inline-block;
    padding-block: 0.7rem;
    margin-block: -0.7rem;
    transition: color var(--dur-fast) ease;
  }

  .page-hero__crumbs a:hover,
  .page-hero__crumbs [aria-current] {
    color: var(--ink);
  }

  .page-hero--ink .page-hero__crumbs a:hover,
  .page-hero--ink .page-hero__crumbs [aria-current] {
    color: var(--paper);
  }

  /* The sheet: white, hairline edge, flat (shadow is for the sheet that crosses a band edge) */
  .page-hero__sheet {
    display: grid;
    gap: var(--space-block);
  }

  .page-hero--paper .page-hero__sheet {
    padding: clamp(1.25rem, 0.5rem + 3.4vw, 4rem);
    background: var(--white);
    border: 1px solid var(--hairline);
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-block) var(--col-gap);
  }

  .page-hero__copy {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
    justify-items: start;
    min-width: 0;
  }

  .page-hero--ink .page-hero__copy :global(.t-lead) {
    color: var(--paper);
  }

  .page-hero__title {
    max-width: 22ch;
    font-size: clamp(2.25rem, 1rem + 5.4vw, 6rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
  }

  .page-hero--ink .page-hero__title {
    color: var(--paper);
  }

  .page-hero__grid--aside .page-hero__title {
    font-size: clamp(2.25rem, 1rem + 4.2vw, 4.75rem);
    max-width: 16ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The sheet settles onto the surface once (Direction A paperwork motion) */
    .page-hero--paper .page-hero__sheet {
      animation: page-hero-settle 0.8s var(--ease-out) both;
    }

    .page-hero__title {
      animation: page-hero-in 1.1s var(--ease-out) both;
    }
  }

  @keyframes page-hero-settle {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes page-hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .page-hero__copy > :global(.page-hero__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .page-hero__copy > :global(.page-hero__actions .btn) {
    white-space: normal;
  }

  /* Below 1024px the wrapper has no box of its own (display: contents), so whatever a page slots in is the grid
     item itself. A page that hides its aside card on small screens (contact) then leaves no empty second row and
     no row gap under the lead. A card that stays visible (the 404 link test) lays out exactly as before. */
  .page-hero__aside {
    display: contents;
    min-width: 0;
  }

  .page-hero__aside > :global(*) {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .page-hero__grid--aside {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    .page-hero__grid--aside .page-hero__copy {
      grid-column: 1 / span 7;
    }

    .page-hero__aside {
      display: block;
      grid-column: 9 / -1;
    }
  }
</style>
