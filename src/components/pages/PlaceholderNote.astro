---
/**
 * Clearly marked slot for content Armak hasn't supplied yet. Renders a sunken panel with a
 * "Placeholder" note so nothing invented can be mistaken for a real fact.
 * <PlaceholderNote title="Team photos">What goes here…</PlaceholderNote>
 */
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['ph-note', className]}>
  <p class="t-meta">Placeholder{title ? `: ${title}` : ''}</p>
  <div class="ph-note__body t-small"><slot /></div>
</div>

<style>
  .ph-note {
    display: grid;
    gap: 0.875rem;
    justify-items: start;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .ph-note__body {
    max-width: 40em;
  }
</style>
