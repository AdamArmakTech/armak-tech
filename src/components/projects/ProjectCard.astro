---
/**
 * Project card — same look as the homepage's FeaturedProjects cards.
 * The whole card is clickable via the title link (one link per card for screen readers).
 */
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import Label from '../ui/Label.astro';
import type { Project } from '../../data/content';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { project: p, headingLevel = 'h3', class: className } = Astro.props;
const Heading = headingLevel;
---

<article class:list={['pcard', className]}>
  <div class="pcard__media">
    {p.image && (
      <Image
        src={p.image}
        alt=""
        widths={[480, 720, 960]}
        sizes="(min-width: 1000px) 30vw, (min-width: 700px) 42vw, 100vw"
        loading="lazy"
      />
    )}
    {p.placeholder && <Label tone="signal" class="pcard__flag">Placeholder</Label>}
  </div>

  <div class="pcard__body">
    <p class="t-mono t-muted">{p.sector} · {p.location}</p>
    <Heading class="t-h3 pcard__title">
      <a href={`/projects/${p.slug}/`} class="pcard__link">{p.title}</a>
    </Heading>

    <dl class="pcard__scope">
      {p.scope.map((s) => (
        <div>
          <dt class="t-mono">{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>

    <p class="t-small t-muted pcard__summary">{p.summary}</p>

    <span class="t-mono pcard__more" aria-hidden="true">
      View project <ArrowUpRight size={16} stroke-width={1.75} />
    </span>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: grid;
    height: 100%;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--dur) ease;
  }

  .pcard:hover,
  .pcard:focus-within {
    border-color: var(--ink);
  }

  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .pcard:hover .pcard__media img {
    transform: scale(1.04);
  }

  .pcard__media :global(.pcard__flag) {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--paper);
  }

  .pcard__body {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .pcard__title {
    max-width: 20ch;
  }

  .pcard__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .pcard__link:focus-visible {
    outline: none;
  }

  .pcard:has(.pcard__link:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .pcard__scope {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--hairline);
  }

  .pcard__scope div {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding: 0.875rem 0.75rem 0.875rem 0;
  }

  .pcard__scope div + div {
    padding-left: 0.75rem;
    border-left: 1px solid var(--hairline);
  }

  .pcard__scope dt {
    order: 2;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--steel);
    line-height: 1.3;
  }

  .pcard__scope dd {
    order: 1;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .pcard__summary {
    max-width: 34em;
  }

  .pcard__more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    justify-self: start;
    color: var(--ink);
  }

  .pcard__more :global(svg) {
    transition: transform var(--dur) var(--ease-out);
  }

  .pcard:hover .pcard__more :global(svg) {
    transform: translate(2px, -2px);
  }

  /* Tablet: horizontal cards, image left */
  @media (min-width: 640px) and (max-width: 1023px) {
    .pcard {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .pcard__media {
      aspect-ratio: auto;
      min-height: 100%;
    }

    .pcard__media img {
      position: absolute;
      inset: 0;
    }
  }

  @media (min-width: 1024px) {
    .pcard {
      grid-template-rows: auto 1fr;
    }

    .pcard__body {
      padding: 1.5rem 1.5rem 1.75rem;
    }
  }
</style>
