---
/**
 * Standard section opener: heading, optional intro, optional slot.
 * `code` and `label` are accepted so callers compile but are never rendered
 * (owner removed decorative codes and small labels above headings).
 * Sections are separated by space, never by a top rule.
 */
interface Props {
  code?: string;
  label?: string;
  title: string;
  intro?: string;
  tone?: 'default' | 'inverse';
  headingLevel?: 'h1' | 'h2';
  split?: boolean;
}

const { title, intro, tone = 'default', headingLevel = 'h2', split = true } = Astro.props;
const Heading = headingLevel;
---

<header class:list={['section-head', `section-head--${tone}`]}>
  <div class="section-head__body">
    <Heading class="t-h2 section-head__title" data-split={split ? '' : undefined}>{title}</Heading>
    {intro && <p class="t-lead section-head__intro" data-reveal>{intro}</p>}
    <slot />
  </div>
</header>

<style>
  .section-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin-bottom: var(--space-block);
  }

  .section-head__body {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
  }

  .section-head__title {
    max-width: 24ch;
  }

  .section-head__intro {
    max-width: 40em;
  }

  @media (min-width: 900px) {
    .section-head__body {
      grid-column: 1 / span 9;
    }
  }
</style>
