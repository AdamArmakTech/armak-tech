---
import Label from './Label.astro';

/**
 * Standard section opener on the 12-col grid:
 * hairline rule ─ label (cols 1–3) │ heading + intro (cols 4–12)
 */
interface Props {
  code?: string;
  label: string;
  title: string;
  intro?: string;
  tone?: 'default' | 'inverse';
  headingLevel?: 'h1' | 'h2';
  split?: boolean;
}

const { code, label, title, intro, tone = 'default', headingLevel = 'h2', split = true } = Astro.props;
const Heading = headingLevel;
---

<header class:list={['section-head', `section-head--${tone}`]}>
  <div class="section-head__meta">
    <Label code={code} tone={tone === 'inverse' ? 'inverse' : 'default'}>{label}</Label>
  </div>
  <div class="section-head__body">
    <Heading class="t-h2 section-head__title" data-split={split ? '' : undefined}>{title}</Heading>
    {intro && <p class="t-lead section-head__intro" data-reveal>{intro}</p>}
    <slot />
  </div>
</header>

<style>
  .section-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
    margin-bottom: var(--space-block);
  }

  .section-head--inverse {
    border-top-color: var(--hairline-inverse);
  }

  .section-head__meta {
    grid-column: 1 / -1;
  }

  .section-head__body {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
  }

  .section-head__title {
    max-width: 18ch;
  }

  .section-head__intro {
    max-width: 40em;
  }

  @media (min-width: 900px) {
    .section-head__meta {
      grid-column: 1 / span 3;
      padding-top: 0.55rem;
    }

    .section-head__body {
      grid-column: 4 / -1;
    }
  }
</style>
