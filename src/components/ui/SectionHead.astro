---
/**
 * Standard section opener (DESIGN.md rules 3, 4, 5): the heading leads, the intro sits below it.
 * No top rule and no label column. Sections are separated by space, not lines.
 *
 * `code` and `label` are still accepted so existing callers do not break, but they are IGNORED
 * and nothing is rendered for them. Callers will drop these props in a later wave.
 */
interface Props {
  code?: string;
  label?: string;
  title: string;
  intro?: string;
  tone?: 'default' | 'inverse';
  headingLevel?: 'h1' | 'h2';
  split?: boolean;
}

const { title, intro, tone = 'default', headingLevel = 'h2', split = true } = Astro.props;
const Heading = headingLevel;
---

<header class:list={['section-head', `section-head--${tone}`]}>
  <Heading class="t-h2 section-head__title" data-split={split ? '' : undefined}>{title}</Heading>
  {intro && <p class="t-lead section-head__intro" data-reveal>{intro}</p>}
  <slot />
</header>

<style>
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-5);
    margin-bottom: var(--space-block);
  }

  .section-head__title {
    max-width: 18ch;
  }

  .section-head__intro {
    max-width: 38em;
  }
</style>
