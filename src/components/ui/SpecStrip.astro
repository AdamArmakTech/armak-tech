---
/**
 * Spec line in sentence-case sans (DESIGN.md rule 4); 4px steel squares separate the items.
 */
interface Props {
  items: string[];
  tone?: 'default' | 'inverse';
  class?: string;
}

const { items, tone = 'default', class: className } = Astro.props;
---

<ul role="list" class:list={['spec-strip', `spec-strip--${tone}`, className]}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .spec-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    padding-block: 1rem;
    border-block: 1px solid var(--hairline);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--text);
  }

  .spec-strip li {
    display: inline-flex;
    align-items: center;
  }

  .spec-strip li:not(:last-child)::after {
    content: "";
    width: 4px;
    height: 4px;
    margin-inline: 1rem;
    background: var(--steel);
  }

  .spec-strip--inverse {
    border-color: var(--hairline-inverse);
    color: var(--paper);
  }
</style>
