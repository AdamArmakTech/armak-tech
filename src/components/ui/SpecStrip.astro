---
/**
 * Quiet one-line fact list in the text face: "Est. 1998, Glendale HQ, 24/7 support".
 */
interface Props {
  items: string[];
  tone?: 'default' | 'inverse';
  class?: string;
}

const { items, tone = 'default', class: className } = Astro.props;
---

<ul role="list" class:list={['spec-strip', `spec-strip--${tone}`, 't-meta', className]}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .spec-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
  }

  .spec-strip li {
    display: inline;
    white-space: pre-wrap;
  }

  .spec-strip li:not(:last-child)::after {
    content: ", ";
  }

  .spec-strip--inverse {
    color: var(--steel-light);
  }
</style>
