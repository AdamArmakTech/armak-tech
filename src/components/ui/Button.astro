---
import { ArrowRight, Phone } from '@lucide/astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'ink' | 'outline' | 'outline-inverse' | 'link';
  size?: 'md' | 'lg';
  icon?: 'arrow' | 'phone' | 'none';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon = 'arrow',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  {icon === 'phone' && <Phone class="btn__icon btn__icon--lead" size={18} stroke-width={1.75} aria-hidden="true" />}
  <span class="btn__label"><slot /></span>
  {icon === 'arrow' && <ArrowRight class="btn__icon btn__icon--trail" size={18} stroke-width={1.75} aria-hidden="true" />}
</Tag>

<style>
  .btn {
    --btn-bg: transparent;
    --btn-fg: var(--ink);
    --btn-border: transparent;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 1.375rem;
    min-height: 48px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    border: 1px solid var(--btn-border);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.2;
    white-space: nowrap;
    transition:
      background var(--dur-fast) ease,
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  @media (max-width: 420px) {
    .btn {
      white-space: normal;
      text-align: center;
    }
  }

  .btn--lg {
    padding: 1.125rem 1.75rem;
    min-height: 58px;
    font-size: 1.0625rem;
  }

  .btn__icon--trail {
    transition: transform var(--dur) var(--ease-out);
  }

  .btn:hover .btn__icon--trail {
    transform: translateX(4px);
  }

  .btn--primary {
    --btn-bg: var(--signal);
    --btn-fg: var(--white);
  }

  .btn--primary:hover {
    --btn-bg: var(--signal-hover);
  }

  .btn--ink {
    --btn-bg: var(--ink);
    --btn-fg: var(--paper);
  }

  .btn--ink:hover {
    --btn-bg: var(--graphite);
  }

  .btn--outline {
    --btn-border: var(--field-line);
  }

  .btn--outline:hover {
    --btn-border: var(--ink);
    --btn-bg: var(--white);
  }

  .btn--outline-inverse {
    --btn-fg: var(--paper);
    --btn-border: var(--hairline-inverse);
  }

  .btn--outline-inverse:hover {
    --btn-border: var(--paper);
  }

  .btn--link {
    padding: 0.7rem 0;
    margin-block: -0.7rem;
    min-height: 44px;
    border: 0;
    border-radius: 0;
    background:
      linear-gradient(currentColor, currentColor) left bottom / 0% 1px no-repeat;
    transition: background-size var(--dur) var(--ease-out);
  }

  .btn--link:hover {
    background-size: 100% 1px;
  }
</style>
