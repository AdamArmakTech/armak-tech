---
/**
 * Quiet text label in the text face (class t-meta). Slot text only.
 * `code` and `tone` are accepted so existing callers compile, but the code is never rendered
 * (owner removed decorative codes and boxed tags).
 */
interface Props {
  code?: string;
  tone?: 'default' | 'inverse' | 'signal';
  class?: string;
}

const { tone = 'default', class: className } = Astro.props;
---

<span class:list={['t-meta', 'label', `label--${tone}`, className]}><slot /></span>

<style>
  .label {
    display: inline-block;
  }

  .label--inverse {
    color: var(--steel-light);
  }
</style>
