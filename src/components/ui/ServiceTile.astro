---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  href: string;
  code: string;
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  size?: 'default' | 'feature';
  /** Optional sub-service list, rendered as a compact mono list pinned to the tile's foot */
  includes?: string[];
  class?: string;
  [key: string]: unknown;
}

const { href, code, title, description, image, imageAlt = '', size = 'default', includes, class: className, ...rest } = Astro.props;
const hasIncludes = !!includes && includes.length > 0;
---

<a href={href} class:list={['tile', `tile--${size}`, className]} {...rest}>
  {image && (
    <div class="tile__media">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 800, 1200]}
        sizes={size === 'feature' ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
        loading="lazy"
      />
    </div>
  )}
  <div class:list={['tile__body', { 'tile__body--includes': hasIncludes }]}>
    <div class="tile__top">
      <span class="t-mono tile__code">{code}</span>
      <ArrowUpRight class="tile__arrow" size={22} stroke-width={1.5} aria-hidden="true" />
    </div>
    <h3 class="t-h3 tile__title">{title}</h3>
    <p class="tile__desc t-muted">{description}</p>
    {hasIncludes && (
      <ul role="list" class="tile__includes">
        {includes!.map((item) => <li>{item}</li>)}
      </ul>
    )}
  </div>
</a>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--dur) ease;
  }

  .tile:hover {
    border-color: var(--ink);
  }

  .tile__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .tile--feature .tile__media {
    aspect-ratio: 16 / 10;
  }

  .tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .tile:hover .tile__media img {
    transform: scale(1.04);
  }

  .tile__body {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.5rem;
    flex: 1;
    align-content: start;
  }

  .tile__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tile__code {
    color: var(--signal);
  }

  .tile__arrow {
    transition: transform var(--dur) var(--ease-out);
  }

  .tile:hover .tile__arrow {
    transform: translate(3px, -3px);
  }

  .tile__desc {
    font-size: var(--fs-small);
    max-width: 36em;
  }

  /* Includes list sits at the foot of the tile, however tall the grid row makes it */
  .tile__body--includes {
    grid-template-rows: auto auto auto 1fr;
  }

  .tile__includes {
    align-self: end;
    display: grid;
    margin-top: 1rem;
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--steel);
  }

  .tile__includes li {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .tile__includes li::before {
    content: "";
    flex: none;
    width: 5px;
    height: 5px;
    border: 1px solid var(--hairline-strong);
    transform: translateY(-1px);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .tile:hover .tile__includes li::before {
    background: var(--ink);
    border-color: var(--ink);
  }
</style>
