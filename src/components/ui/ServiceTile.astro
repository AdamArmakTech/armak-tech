---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  /** Accepted so callers compile; never rendered (service codes were removed) */
  code?: string;
  title: string;
  description: string;
  image?: ImageMetadata;
  /** Not rendered: the photo sits inside the link and the visible title already names it,
      so the image is decorative (alt="") and the link reads as just the service name */
  imageAlt?: string;
  size?: 'default' | 'feature';
  /** Optional sub-service list, rendered as a quiet text list pinned to the tile's foot */
  includes?: string[];
  class?: string;
  [key: string]: unknown;
}

const { href, code: _code, title, description, image, imageAlt: _imageAlt, size = 'default', includes, class: className, ...rest } = Astro.props;
const hasIncludes = !!includes && includes.length > 0;
---

<a href={href} class:list={['tile', `tile--${size}`, className]} {...rest}>
  {image && (
    <div class="tile__media">
      <Image
        src={image}
        alt=""
        widths={[480, 800, 1200]}
        sizes={size === 'feature' ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
        loading="lazy"
      />
    </div>
  )}
  <div class:list={['tile__body', { 'tile__body--includes': hasIncludes }]}>
    <h3 class="t-h3 tile__title">{title}</h3>
    <p class="tile__desc t-muted">{description}</p>
    {hasIncludes && (
      <ul role="list" class="tile__includes">
        {includes!.map((item) => <li>{item}</li>)}
      </ul>
    )}
  </div>
</a>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .tile__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .tile--feature .tile__media {
    aspect-ratio: 16 / 10;
  }

  .tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover .tile__media img {
      transform: scale(1.04);
    }

    .tile:hover .tile__title {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  .tile__body {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem 1.5rem 1.75rem;
    flex: 1;
    align-content: start;
  }

  .tile__desc {
    color: var(--text);
    font-size: var(--fs-small);
    max-width: 36em;
  }

  /* Includes list sits at the foot of the tile, however tall the grid row makes it */
  .tile__body--includes {
    grid-template-rows: auto auto 1fr;
  }

  .tile__includes {
    align-self: end;
    display: grid;
    gap: 0.375rem;
    margin-top: 1rem;
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.35;
    color: var(--steel);
  }
</style>
