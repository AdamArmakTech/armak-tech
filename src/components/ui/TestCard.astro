---
/**
 * Stylized cable-certification result. Turns "every cable tested" into visible evidence.
 * Values are illustrative and the card is labeled as a sample.
 */
import { Check } from '@lucide/astro';

interface Props {
  cableId?: string;
  standard?: string;
  length?: string;
  rows?: { label: string; value: string }[];
  class?: string;
}

const {
  cableId = 'IDF2-A-024',
  standard = 'TIA Cat 6A Perm. Link',
  length = '47.2 m',
  rows = [
    { label: 'NEXT margin', value: '+5.8 dB' },
    { label: 'Return loss', value: '+4.1 dB' },
    { label: 'Insertion loss', value: '+12.3 dB' },
    { label: 'Propagation delay', value: '231 ns' },
  ],
  class: className,
} = Astro.props;

// T568B wire map: pin → color key
const wiremap = [
  ['1', 'wo'], ['2', 'o'], ['3', 'wg'], ['4', 'bl'],
  ['5', 'wbl'], ['6', 'g'], ['7', 'wbr'], ['8', 'br'],
];
---

<figure class:list={['test-card', className]}>
  <header class="test-card__head t-mono">
    <span>Certification report</span>
    <span class="test-card__sample">Sample</span>
  </header>

  <div class="test-card__result">
    <span class="test-card__badge" aria-hidden="true"><Check size={22} stroke-width={2.5} /></span>
    <div>
      <p class="test-card__pass">PASS</p>
      <p class="t-mono test-card__std">{standard}</p>
    </div>
  </div>

  <dl class="test-card__rows">
    <div><dt>Cable ID</dt><dd>{cableId}</dd></div>
    <div><dt>Length</dt><dd>{length}</dd></div>
    {rows.map((r) => <div><dt>{r.label}</dt><dd class="is-pass">{r.value}</dd></div>)}
  </dl>

  <div class="test-card__wiremap" aria-label="Wire map: all 8 conductors pass, T568B">
    <span class="t-mono">Wire map · T568B</span>
    <ol role="list">
      {wiremap.map(([pin, c]) => (
        <li><span class={`wire wire--${c}`} /><span class="pin">{pin}</span></li>
      ))}
    </ol>
  </div>

  <figcaption class="visually-hidden">
    Sample certification result. Every drop Armak installs is tested and documented with a report like this.
  </figcaption>
</figure>

<style>
  .test-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raise);
    padding: 1.25rem;
    display: grid;
    gap: 1.25rem;
    max-width: 380px;
    font-size: var(--fs-small);
  }

  .test-card__head {
    display: flex;
    justify-content: space-between;
    color: var(--steel);
  }

  .test-card__sample {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
  }

  .test-card__result {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .test-card__badge {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pass);
    color: var(--white);
  }

  .test-card__pass {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--pass);
  }

  .test-card__std {
    margin-top: 0.35rem;
    color: var(--steel);
  }

  .test-card__rows {
    display: grid;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .test-card__rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .test-card__rows dt {
    color: var(--steel);
  }

  .test-card__rows dd.is-pass {
    color: var(--pass);
  }

  .test-card__wiremap {
    display: grid;
    gap: 0.625rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
    color: var(--steel);
  }

  .test-card__wiremap ol {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 4px;
  }

  .test-card__wiremap li {
    display: grid;
    gap: 4px;
    justify-items: center;
  }

  .wire {
    width: 100%;
    height: 28px;
    border-radius: 1px;
  }

  .pin {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .wire--o { background: var(--t568-orange); }
  .wire--g { background: var(--t568-green); }
  .wire--bl { background: var(--t568-blue); }
  .wire--br { background: var(--t568-brown); }

  .wire--wo,
  .wire--wg,
  .wire--wbl,
  .wire--wbr {
    background: repeating-linear-gradient(0deg, var(--white) 0 5px, var(--wire-color) 5px 8px);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .wire--wo { --wire-color: var(--t568-orange); }
  .wire--wg { --wire-color: var(--t568-green); }
  .wire--wbl { --wire-color: var(--t568-blue); }
  .wire--wbr { --wire-color: var(--t568-brown); }
</style>
