---
/** Native <details>/<summary> disclosure list — accessible and works without JS. */
import { Plus } from '@lucide/astro';
import SectionHead from '../ui/SectionHead.astro';
import { createPageLinker } from '../../lib/glossaryLinks';
import type { Faq } from '../../data/services-detail';

interface Props {
  code?: string;
  title?: string;
  faqs: Faq[];
  /** Optional: the service this page is about, so its own name is never linked. */
  serviceName?: string;
}

const { title = 'Common questions.', faqs, serviceName = undefined } = Astro.props;
const linker = createPageLinker();
---

<section class="section faq">
  <div class="container faq__layout">
    <SectionHead title={title} />

    <div class="faq__list">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary class="faq__q">
            <span class="faq__qtext">{f.q}</span>
            <Plus class="faq__icon" size={22} stroke-width={1.5} aria-hidden="true" />
          </summary>
          <div class="faq__panel">
            <p class="faq__a" set:html={linker.link(f.a, { exclude: serviceName ? [serviceName] : [] })} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Direction A: the questions are a ruled sheet; heading at the left on desktop */
  .faq__layout {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
  }

  .faq__layout > :global(.section-head) {
    margin-bottom: 0;
  }

  .faq__list {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0 var(--sp-5);
  }

  .faq__item + .faq__item {
    border-top: 1px solid var(--hairline);
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    min-height: 44px;
    padding-block: var(--sp-5);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) ease;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--signal);
  }

  .faq__qtext {
    font-size: clamp(1.125rem, 1.04rem + 0.4vw, 1.375rem);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
  }

  .faq__q :global(.faq__icon) {
    flex: none;
    margin-top: 0.15rem;
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__item[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }

  /* Unfold: the details content slot is kept rendered so its grid row can animate 0fr to 1fr.
     Browsers without ::details-content still open it natively, just without the motion. */
  @media (prefers-reduced-motion: no-preference) {
    .faq__item::details-content {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 240ms var(--ease-out), content-visibility 240ms allow-discrete;
    }

    .faq__item[open]::details-content {
      grid-template-rows: 1fr;
    }

    .faq__panel {
      min-height: 0;
      overflow: hidden;
    }
  }

  .faq__a {
    max-width: 44em;
    padding-bottom: var(--sp-5);
    padding-right: var(--sp-7);
    color: var(--text);
  }

  .faq__a :global(.gl) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 3px;
  }

  .faq__a :global(.gl:hover) {
    text-decoration-color: var(--ink);
  }

  @media (min-width: 900px) {
    .faq__list {
      padding: 0 var(--sp-7);
    }
  }

  @media (min-width: 1024px) {
    .faq__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .faq__layout > :global(.section-head) {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .faq__list {
      grid-column: 5 / -1;
    }
  }
</style>
