---
import SectionHead from '../ui/SectionHead.astro';
import { linkGlossaryTerms } from '../../lib/glossaryLinks';
import type { Capability } from '../../data/services-detail';

interface Props {
  code?: string;
  serviceName: string;
  items: Capability[];
}

const { serviceName, items } = Astro.props;
---

<section class="section caps" aria-label={`${serviceName} capabilities`}>
  <div class="container">
    <SectionHead
      title="What we handle."
      intro="Every job is scoped to your site after a walk-through."
    />

    <ul role="list" class="caps__grid" data-reveal-group>
      {items.map((item) => (
        <li class="cap">
          <h3 class="t-h3 cap__title">{item.title}</h3>
          <p class="cap__body" set:html={linkGlossaryTerms(item.body, { exclude: [serviceName] })} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .caps__grid {
    display: grid;
    gap: var(--sp-7) var(--sp-8);
  }

  .cap {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }

  .cap__body {
    max-width: 34em;
    color: var(--text);
  }

  .cap__body :global(.gl) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 3px;
  }

  .cap__body :global(.gl:hover) {
    text-decoration-color: var(--ink);
  }

  @media (min-width: 700px) {
    .caps__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
