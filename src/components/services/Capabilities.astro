---
import SectionHead from '../ui/SectionHead.astro';
import { linkGlossaryTerms } from '../../lib/glossaryLinks';
import type { Capability } from '../../data/services-detail';

interface Props {
  code?: string;
  serviceName: string;
  items: Capability[];
}

const { serviceName, items } = Astro.props;
---

<section class="section caps" aria-label={`${serviceName} capabilities`}>
  <div class="container caps__layout">
    <SectionHead
      title={`What we handle in ${serviceName.toLowerCase()}.`}
      intro="Every job is scoped to your site after a walk-through."
    />

    <ol role="list" class="caps__sheet">
      {items.map((item) => (
        <li class="cap">
          <h3 class="cap__title">{item.title}</h3>
          <p class="cap__body" set:html={linkGlossaryTerms(item.body, { exclude: [serviceName] })} />
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /*
   * Direction A: the capabilities are a schedule sheet, one ruled row per capability.
   * Heading at the left (held in place on desktop), the sheet at the right.
   */
  .caps__layout {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
  }

  .caps__layout > :global(.section-head) {
    margin-bottom: 0;
  }

  .caps__sheet {
    display: grid;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--sp-2) var(--sp-5);
  }

  /* Hairlines only between rows (rule 5) */
  .cap + .cap {
    border-top: 1px solid var(--hairline);
  }

  .cap {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding-block: var(--sp-5);
  }

  .cap__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    color: var(--ink);
  }

  .cap__body {
    max-width: 36em;
    font-size: var(--fs-body);
    color: var(--text);
  }

  .cap__body :global(.gl) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 3px;
  }

  .cap__body :global(.gl:hover) {
    text-decoration-color: var(--ink);
  }

  @media (min-width: 900px) {
    .caps__sheet {
      padding: var(--sp-3) var(--sp-7);
    }

    .cap {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
      gap: var(--col-gap);
      padding-block: var(--sp-6);
    }
  }

  @media (min-width: 1024px) {
    .caps__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .caps__layout > :global(.section-head) {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .caps__sheet {
      grid-column: 5 / -1;
    }
  }
</style>
