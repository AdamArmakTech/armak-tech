---
/**
 * Closing call to action for service pages. Light panel so it doesn't stack against the dark
 * footer; pages using it pass footerCta={false} to Base so the footer's generic CTA doesn't repeat.
 */
import Label from '../ui/Label.astro';
import NextStep from '../ui/NextStep.astro';

interface Props {
  title: string;
  body: string;
  /** Service slug carried into the contact form so it opens with that service selected */
  about?: string;
}

const { title, body, about } = Astro.props;
---

<section class="cta container" aria-labelledby="cta-title" data-dock-hide>
  <div class="cta__panel">
    <div class="cta__body">
      <div class="cta__copy">
        <Label>Next step</Label>
        <h2 id="cta-title" class="t-h2 cta__title" data-split>{title}</h2>
        <p class="t-lead">{body}</p>
      </div>
      <div class="cta__side">
        <NextStep about={about} tone="light" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: var(--space-block);
  }

  .cta__panel {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-top: 2px solid var(--ink);
    border-radius: var(--radius);
  }

  .cta__body {
    display: grid;
    gap: 2.5rem var(--col-gap);
    padding: clamp(1.25rem, 0.5rem + 3.8vw, 4.5rem);
  }

  .cta__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .cta__title {
    max-width: 16ch;
  }

  /* DESIGN.md rule 9: headings fit two lines on a 375px phone. The 16ch cap and the 28px floor made the longest title run to three. */
  @media (max-width: 420px) {
    .cta__title {
      font-size: 1.5rem;
      max-width: none;
    }
  }

  .cta__side {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }

  @media (min-width: 1024px) {
    .cta__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    .cta__copy {
      grid-column: 1 / span 6;
    }

    .cta__side {
      grid-column: 8 / -1;
    }
  }
</style>
