---
/**
 * Closing call to action for service pages: the same white sheet on paper as PageCta, above the footer. Pages using it pass footerCta={false} to Base so the footer's generic CTA doesn't repeat.
 */
import NextStep from '../ui/NextStep.astro';

interface Props {
  code?: string;
  title: string;
  body: string;
  /** Service slug carried into the contact form so it opens with that service selected */
  about?: string;
}

const { title, body, about } = Astro.props;
---

<section class="cta cta-band" aria-labelledby="cta-title" data-dock-hide>
  <div class="container">
    <div class="cta__sheet cta__inner">
    <div class="cta__copy">
      <h2 id="cta-title" class="t-h2 cta__title" data-split>{title}</h2>
      <p class="t-lead cta__lead">{body}</p>
    </div>
    <div class="cta__side">
      <NextStep about={about} tone="light" />
    </div>
    </div>
  </div>
</section>

<style>
  /* One white sheet on paper (DESIGN.md Direction A). The section carries the gap above the footer. */
  .cta {
    padding-block: var(--space-section);
  }

  .cta__sheet {
    padding: var(--sp-6) var(--sp-5);
    background: var(--white);
    border: 1px solid var(--hairline);
  }

  @media (min-width: 640px) {
    .cta__sheet {
      padding: var(--sp-7);
    }
  }

  @media (min-width: 1024px) {
    .cta__sheet {
      padding: var(--sp-8);
    }
  }

  .cta__inner {
    display: grid;
    gap: 2.5rem var(--col-gap);
  }

  .cta__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    align-content: start;
  }

  .cta__title {
    color: var(--ink);
    max-width: 16ch;
  }

  /* DESIGN.md rule 9: headings fit two lines on a 375px phone. The 16ch cap and the 28px floor made the longest title run to three. */
  @media (max-width: 420px) {
    .cta__title {
      font-size: 1.5rem;
      max-width: none;
    }
  }

  .cta__lead {
    color: var(--text);
  }

  .cta__side {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }

  @media (min-width: 1024px) {
    .cta__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    /* Copy takes 6 columns and the side takes 5, with one empty column between. The red
       button needs about 297px; the old 4-column side was 259px at 1024 and wrapped its label. */
    .cta__copy {
      grid-column: 1 / span 6;
    }

    .cta__side {
      grid-column: 8 / -1;
    }
  }
</style>
