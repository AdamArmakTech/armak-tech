---
/**
 * Closing call to action for service pages: the same full-width dark band as PageCta, running into
 * the footer. Pages using it pass footerCta={false} to Base so the footer's generic CTA doesn't repeat.
 */
import NextStep from '../ui/NextStep.astro';

interface Props {
  code: string;
  title: string;
  body: string;
  /** Service slug carried into the contact form so it opens with that service selected */
  about?: string;
}

const { title, body, about } = Astro.props;
---

<section class="cta cta-band surface-ink" aria-labelledby="cta-title" data-dock-hide>
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 id="cta-title" class="t-h2 cta__title" data-split>{title}</h2>
      <p class="t-lead">{body}</p>
    </div>
    <div class="cta__side">
      <NextStep about={about} tone="inverse" />
    </div>
  </div>
</section>

<style>
  /* Full-bleed dark band that runs straight into the footer (DESIGN.md rule 8). The footer's own
     top margin is 0, so this band carries the section gap above its content. */
  .cta {
    padding-block: var(--space-section);
  }

  .cta__inner {
    display: grid;
    gap: 2.5rem var(--col-gap);
  }

  .cta__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    align-content: start;
  }

  .cta__title {
    max-width: 16ch;
  }

  .cta__side {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }

  @media (min-width: 1024px) {
    .cta__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }

    .cta__copy {
      grid-column: 1 / span 7;
    }

    .cta__side {
      grid-column: 9 / -1;
    }
  }
</style>
