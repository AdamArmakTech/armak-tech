---
/** Compact "how we deliver" timeline built from `process` in content.ts. Direction A: the page's one ink band, steps on white sheets. */
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { contactHref } from '../../lib/cta';
import { process as steps } from '../../data/content';

interface Props {
  code?: string;
  title?: string;
  intro?: string;
  /** Show the "Request a site assessment" prompt under the steps */
  cta?: boolean;
  /** Service slug carried into the contact form */
  about?: string;
}

const {
  cta = false,
  about,
  title = 'Five steps, every job.',
  intro = 'The same process from a single-rack retrofit to a multi-site rollout. Nothing is signed off until it has been tested and documented.',
} = Astro.props;
// section--tight is on purpose. It opts this band out of the "neighbouring sections share one gap"
// rule in global.css, which zeroes the top padding of a .section that follows another .section
// (service detail pages: Capabilities, then this band). The padding itself comes from .delivery below.
---

<section class="section section--tight delivery surface-ink">
  <div class="container">
    <SectionHead title={title} intro={intro} />

    <ol role="list" class="delivery__steps">
      {steps.map((step) => (
        <li class="dstep">
          <span class="dstep__num" aria-hidden="true">{step.code}</span>
          <h3 class="dstep__title"><span class="visually-hidden">Step {step.code}: </span>{step.title}</h3>
          <p class="dstep__body">{step.body}</p>
        </li>
      ))}
    </ol>

    {cta && (
      <div class="delivery__next" data-dock-hide>
        <p class="t-small t-muted">Every job starts at step 01.</p>
        <Button href={contactHref({ about })} icon="arrow">Request a site assessment</Button>
      </div>
    )}
  </div>
</section>

<style>
  .delivery {
    padding-block: var(--space-section);
  }

  .delivery :global(.section-head__title) {
    color: var(--paper);
    max-width: 20ch;
  }

  .delivery__next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: var(--sp-7);
  }

  .delivery__next :global(.btn) {
    white-space: normal;
  }

  .delivery__steps {
    display: grid;
    gap: var(--sp-3);
  }

  /* Each step is a white sheet laid on the ink */
  .dstep {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--sp-2) var(--sp-3);
    align-content: start;
    padding: var(--sp-5);
    background: var(--white);
    color: var(--text);
    border-radius: var(--radius);
  }

  .dstep__num {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: 2rem;
    letter-spacing: -0.06em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--steel);
  }

  .dstep__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    color: var(--ink);
  }

  .dstep__body {
    max-width: 32em;
    font-size: var(--fs-small);
    color: var(--text);
  }

  @media (min-width: 640px) {
    .delivery__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dstep:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .delivery__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .dstep:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .dstep {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-3);
      padding: var(--sp-5) var(--sp-4) var(--sp-6);
    }

    .dstep__num {
      grid-row: auto;
      font-size: clamp(2.5rem, 1.6rem + 1.4vw, 3.5rem);
      margin-bottom: var(--sp-6);
    }

    .dstep__title {
      font-size: var(--fs-h4);
      font-weight: 600;
    }
  }
</style>
