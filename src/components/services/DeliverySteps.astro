---
/** Compact "how we deliver" steps built from `process` in content.ts. */
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { contactHref, CTA_LABEL } from '../../lib/cta';
import { process as steps } from '../../data/content';

interface Props {
  code?: string;
  title?: string;
  intro?: string;
  /** Show the "Request a site assessment" prompt under the steps */
  cta?: boolean;
  /** Service slug carried into the contact form */
  about?: string;
}

const {
  cta = false,
  about,
  title = 'Five steps, every job.',
  intro = 'The same process from a single-rack retrofit to a multi-site rollout. Nothing is signed off until it has been tested and documented.',
} = Astro.props;
---

<section class="section section--tight delivery">
  <div class="container">
    <SectionHead title={title} intro={intro} />

    <ol role="list" class="delivery__steps" data-reveal-group>
      {steps.map((step) => (
        <li class="dstep">
          <h3 class="t-h3 dstep__title">{step.title}</h3>
          <p class="dstep__body">{step.body}</p>
        </li>
      ))}
    </ol>

    {cta && (
      <div class="delivery__next" data-dock-hide data-reveal>
        <p class="t-meta">Every job starts with the assessment.</p>
        <Button href={contactHref({ about })} icon="arrow">{CTA_LABEL}</Button>
      </div>
    )}
  </div>
</section>

<style>
  .delivery__next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: var(--sp-7);
  }

  .delivery__next :global(.btn) {
    white-space: normal;
  }

  .delivery {
    background: var(--white);
  }

  .delivery__steps {
    display: grid;
    gap: var(--sp-6);
  }

  .dstep {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
  }

  .dstep__body {
    max-width: 32em;
    color: var(--text);
  }

  @media (min-width: 1000px) {
    .delivery__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--sp-6);
    }
  }
</style>
