---
/**
 * Manufacturer wordmarks filtered by category, as one wrapped row. Renders nothing when no partner matches.
 */
import { Image } from 'astro:assets';
import { partners, type Partner } from '../../data/content';

interface Props {
  code?: string;
  categories: Partner['category'][];
}

const { categories } = Astro.props;
const list = partners.filter((p) => categories.includes(p.category));

const H = 26;
---

{list.length > 0 && (
  <section class="plogos" aria-labelledby="plogos-title">
    <div class="container plogos__inner">
      <p id="plogos-title" class="plogos__sentence" data-reveal>
        Hardware from the manufacturers we install and support.
      </p>
      <ul role="list" class="plogos__row" data-reveal-group="fade" data-reveal-step="40">
        {list.map((p) => (
          <li class="plogos__item">
            <Image
              src={p.logo}
              alt={p.name}
              height={H}
              width={Math.round((p.logo.width / p.logo.height) * H)}
              densities={[1, 2]}
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .plogos {
    padding-block: var(--space-block);
  }

  .plogos__inner {
    display: grid;
    gap: var(--sp-5);
  }

  .plogos__sentence {
    max-width: 34em;
    color: var(--text);
  }

  .plogos__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5) var(--sp-7);
  }

  .plogos__item {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .plogos__item img {
    height: 26px;
    width: auto;
    max-width: 100%;
    opacity: 0.78;
    transition: opacity var(--dur) ease;
  }

  .plogos__item:hover img {
    opacity: 1;
  }
</style>
