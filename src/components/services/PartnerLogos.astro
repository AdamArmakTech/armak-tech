---
/**
 * Manufacturer logos filtered by category. Renders nothing when no partner matches.
 * Same optical-sizing rule as the homepage strip: wide wordmarks render shorter.
 */
import { Image } from 'astro:assets';
import { partners, type Partner } from '../../data/content';

interface Props {
  code?: string;
  categories: Partner['category'][];
}

const { categories } = Astro.props;
const list = partners.filter((p) => categories.includes(p.category));

const heightFor = (w: number, h: number) => {
  const aspect = w / h;
  return Math.round(Math.min(44, Math.max(18, 58 / Math.sqrt(aspect))));
};

const n = list.length;
const cols = `--c-sm:${Math.min(n, 2)};--c-md:${Math.min(n, 3)};--c-lg:${Math.min(n, 6)}`;
---

{n > 0 && (
  <section class="plogos" aria-labelledby="plogos-title">
    <div class="container">
      <div class="plogos__sheet">
        <div class="plogos__head">
          <h2 id="plogos-title" class="plogos__title">Platforms we install</h2>
          <p class="t-small t-muted">
            Hardware from the manufacturers we install and support.
          </p>
        </div>
        <ul role="list" class="plogos__grid" style={cols}>
          {list.map((p) => {
            const h = heightFor(p.logo.width, p.logo.height);
            return (
              <li class="plogos__item">
                <Image
                  src={p.logo}
                  alt={p.name}
                  height={h}
                  width={Math.round((p.logo.width / p.logo.height) * h)}
                  densities={[1, 2]}
                  loading="lazy"
                />
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  /* Direction A: the manufacturers sit on one white sheet; cells are ruled like a schedule */
  .plogos {
    padding-top: var(--space-section);
  }

  .plogos__sheet {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
    padding: var(--sp-5);
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .plogos__head {
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
    align-content: start;
  }

  .plogos__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    color: var(--ink);
  }

  .plogos__head p {
    max-width: 22em;
  }

  .plogos__grid {
    --c: var(--c-sm);
    display: grid;
    grid-template-columns: repeat(var(--c), minmax(0, 1fr));
    gap: 1px;
    width: 100%;
    max-width: calc(var(--c) * 14rem);
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }

  .plogos__item {
    display: grid;
    place-items: center;
    min-height: 104px;
    padding: 1.25rem;
    background: var(--white);
  }

  .plogos__item img {
    width: auto;
    max-width: 100%;
    opacity: 0.78;
    transition: opacity var(--dur) ease;
  }

  .plogos__item:hover img {
    opacity: 1;
  }

  @media (min-width: 640px) {
    .plogos__grid {
      --c: var(--c-md);
    }
  }

  @media (min-width: 1024px) {
    .plogos__sheet {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      padding: var(--sp-7);
    }

    .plogos__head {
      grid-column: 1 / span 4;
    }

    .plogos__grid {
      --c: var(--c-lg);
      grid-column: 5 / -1;
    }
  }
</style>
