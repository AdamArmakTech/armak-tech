---
/**
 * Wide photo band under the service hero. Optionally overlays the compact live cable-test demo.
 * Photos come from `servicePhotos` in src/data/services-detail.ts — TODO(photo) lives there.
 */
import { Image } from 'astro:assets';
import CableTest from '../ui/CableTest.astro';
import type { ServicePhoto } from '../../data/services-detail';

interface Props {
  photo: ServicePhoto;
  testCard?: boolean;
  /** Optional plain caption shown under the image. */
  caption?: string;
}

const { photo, testCard = false, caption } = Astro.props;
---

<div class:list={['band container', { 'band--card': testCard }]}>
  <figure class="band__frame">
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 1360px) 1280px, 100vw"
      loading="lazy"
    />
    {caption && <figcaption class="band__caption">{caption}</figcaption>}
  </figure>
  {testCard && <CableTest variant="compact" demoHref="/#cable-test" class="band__card" />}
</div>

<style>
  .band {
    position: relative;
    /* width of the cable-test card; the caption keeps this much room clear on its right from 640 to 1023px */
    --band-card-w: 330px;
  }

  /* Direction A: the photo is a print mounted on a white sheet, caption underneath */
  .band__frame {
    position: relative;
    padding: var(--sp-3);
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }

  .band__frame img {
    border-radius: 0;
    background: var(--paper-sunken);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .band__caption {
    padding: var(--sp-3) var(--sp-1) var(--sp-1);
    font-size: var(--fs-small);
    color: var(--steel);
  }

  /* Card is skipped on phones (it would dwarf the photo) and overlaps the photo from 640px */
  .band :global(.band__card) {
    display: none;
  }

  @media (min-width: 640px) {
    .band__frame img {
      aspect-ratio: 21 / 9;
    }

    .band :global(.band__card) {
      display: grid;
      position: relative;
      width: min(var(--band-card-w), 88%);
      margin: -6rem 1.5rem 0 auto;
    }
  }

  /* 640-1023: the card sits in flow, pulled up over the bottom edge of the photo, which is where the caption
     lives. Keep the caption clear of it: card width + 2rem of padding on the right makes the sentence wrap
     before the card, not run under it (balanced, so no single word is left alone on line two). The sentence
     says the photo is not an Armak job site, so it has to stay readable. Only when the card is there. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .band--card .band__caption {
      padding-right: calc(var(--band-card-w) + 2rem);
      text-wrap: balance;
    }
  }

  @media (min-width: 1024px) {
    .band :global(.band__card) {
      position: absolute;
      right: calc(var(--gutter) + 2.5rem + var(--sp-3));
      bottom: -3rem;
      margin: 0;
    }

    .band--card {
      margin-bottom: 3rem;
    }
  }
</style>
