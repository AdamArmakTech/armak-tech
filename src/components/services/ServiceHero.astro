---
/**
 * Service page opener: breadcrumb, h1 (service name), headline line, intro, CTAs,
 * and a "scope sheet" card summarising what's included and the standards involved.
 */
import { Printer } from '@lucide/astro';
import Button from '../ui/Button.astro';
import { contactHref } from '../../lib/cta';
import { site, type Service } from '../../data/site';
import type { ServiceDetail } from '../../data/services-detail';

interface Props {
  service: Service;
  detail: ServiceDetail;
}

const { service, detail } = Astro.props;
---

<section class="svc-hero container" aria-labelledby="svc-hero-title">
  <nav class="svc-hero__crumbs" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href="/">Home</a></li>
      <li><a href="/services/">Services</a></li>
      <li aria-current="page">{service.name}</li>
    </ol>
  </nav>

  <div class="svc-hero__grid">
    <div class="svc-hero__copy">
      <h1 id="svc-hero-title" class="t-h1 svc-hero__headline">{service.name}</h1>
      <p class="t-h3 svc-hero__sub">{detail.headline}</p>
      <p class="t-lead" data-reveal>{detail.intro}</p>
      <div class="svc-hero__ctas" data-dock-start>
        <Button href={contactHref({ about: service.slug })} size="lg">Request a site assessment</Button>
        <Button href={site.phoneHref} variant="outline" size="lg" icon="phone">{site.phone}</Button>
      </div>
    </div>

    <aside class="sheet" aria-label={`${service.name} scope summary`}>
      <div class="sheet__print-title" aria-hidden="true">
        <p class="sheet__print-name">{service.name}</p>
        <p class="sheet__print-headline">{detail.headline}</p>
      </div>
      <header class="sheet__head">
        <span>Scope sheet</span>
        <span class="sheet__id">{service.code}</span>
      </header>

      <div class="sheet__block">
        <p class="sheet__heading">Includes</p>
        <ul role="list" class="sheet__list sheet__list--includes">
          {service.includes.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="sheet__block">
        <p class="sheet__heading">Standards &amp; technology</p>
        <ul role="list" class="sheet__list sheet__list--specs t-mono">
          {detail.standards.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <footer class="sheet__foot">
        <span>{service.layer}</span>
        <span class="sheet__area">Southern California</span>
      </footer>

      <div class="sheet__print-wrap">
        <button type="button" class="sheet__print" data-print-sheet>
          <Printer size={18} stroke-width={1.75} aria-hidden="true" />
          Print this scope sheet
        </button>
      </div>

      <p class="sheet__print-foot" aria-hidden="true">{site.name} · {site.phone} · {site.email} · armak.tech</p>
    </aside>
  </div>
</section>

<script>
  // Scope-sheet rows reveal line by line the first time the sheet is on screen.
  // Bundled (not inline) so the site's Content-Security-Policy allows it; rows stay visible if it never runs.
  (function () {
    var sheets = document.querySelectorAll('.sheet');
    if (!sheets.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    sheets.forEach(function (sheet) {
      var rows = sheet.querySelectorAll('.sheet__list li');
      rows.forEach(function (li, i) {
        (li as HTMLElement).style.setProperty('--i', String(i));
      });
      sheet.setAttribute('data-rows', 'pending');
      var io = new IntersectionObserver(
        function (entries) {
          if (!entries.some(function (e) { return e.isIntersecting; })) return;
          io.disconnect();
          sheet.setAttribute('data-rows', 'in');
        },
        { threshold: 0.2 },
      );
      io.observe(sheet);
    });
  })();
</script>

<script>
  // Print only the scope sheet. body.print-sheet is set around the print dialog; CSS in this component does the hiding.
  (function () {
    var btns = document.querySelectorAll('[data-print-sheet]');
    if (!btns.length) return;
    window.addEventListener('beforeprint', function () {
      if (document.body.classList.contains('print-sheet-armed')) document.body.classList.add('print-sheet');
    });
    window.addEventListener('afterprint', function () {
      document.body.classList.remove('print-sheet', 'print-sheet-armed');
    });
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.body.classList.add('print-sheet-armed', 'print-sheet');
        window.print();
      });
    });
  })();
</script>

<style>
  .svc-hero {
    padding-top: clamp(1.25rem, 0.9rem + 1.5vw, 2.25rem);
    padding-bottom: var(--space-block);
  }

  /* ── Breadcrumb ── */
  .svc-hero__crumbs {
    margin-bottom: clamp(2rem, 1.4rem + 2.6vw, 4rem);
    font-size: var(--fs-small);
    color: var(--text);
  }

  .svc-hero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) 0;
  }

  .svc-hero__crumbs li {
    display: inline-flex;
    align-items: center;
  }

  .svc-hero__crumbs li:not(:last-child)::after {
    content: "/";
    margin-inline: var(--sp-2);
    color: var(--hairline-strong);
  }

  .svc-hero__crumbs a {
    transition: color var(--dur-fast) ease;
  }

  .svc-hero__crumbs a:hover {
    color: var(--ink);
  }

  .svc-hero__crumbs [aria-current] {
    color: var(--ink);
  }

  /* ── Layout ── */
  .svc-hero__grid {
    display: grid;
    gap: var(--space-block) var(--col-gap);
  }

  .svc-hero__copy {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
    justify-items: start;
  }

  .svc-hero__headline {
    display: block;
    max-width: 14ch;
  }

  .svc-hero__sub {
    max-width: 24ch;
    color: var(--ink);
    font-family: var(--font-sans, inherit);
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-hero__headline {
      animation: svc-title-in 1.1s var(--ease-out) both;
    }
  }

  @keyframes svc-title-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .svc-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Scope sheet ── */
  .sheet {
    display: grid;
    align-content: start;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    font-size: var(--fs-small);
  }

  .sheet__head,
  .sheet__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    color: var(--steel);
  }

  .sheet__head {
    border-bottom: 1px solid var(--ink);
  }

  .sheet__id {
    font-family: var(--font-mono);
    color: var(--steel);
  }

  .sheet__block {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .sheet__heading,
  .sheet__head > span:first-child {
    font-family: var(--font-sans, inherit);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--steel);
  }

  .sheet__list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--hairline);
  }

  .sheet__list li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .sheet__list--includes li {
    font-weight: 500;
  }

  .sheet__list--includes li::before {
    content: "";
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--ink);
    transform: translateY(-2px);
  }

  .sheet__list--specs {
    color: var(--ink);
  }

  .sheet__list--specs li::before {
    content: "";
    flex: none;
    width: 6px;
    height: 6px;
    border: 1px solid var(--hairline-strong);
    transform: translateY(-1px);
  }

  .sheet__foot {
    font-size: var(--fs-label);
  }

  /* Rows rise 6px and fade in, 50ms apart. Header and footer stay static. */
  .sheet[data-rows] .sheet__list li {
    transition:
      opacity var(--dur) var(--ease-out) calc(var(--i, 0) * 50ms),
      transform var(--dur) var(--ease-out) calc(var(--i, 0) * 50ms);
  }

  .sheet[data-rows="pending"] .sheet__list li {
    opacity: 0;
    transform: translateY(6px);
  }

  /* ── Print button (screen) ── */
  .sheet__print-wrap {
    padding: 0.25rem 1.25rem 0.75rem;
  }

  .sheet__print {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-sans, inherit);
    font-size: var(--fs-small);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sheet__print-title,
  .sheet__print-foot {
    display: none;
  }

  /* ── Print: only the scope sheet ── */
  @media print {
    :global(body.print-sheet .site-header),
    :global(body.print-sheet .site-footer),
    :global(body.print-sheet .cta-dock),
    :global(body.print-sheet main > *:not(.svc-hero)),
    :global(body.print-sheet .svc-hero__crumbs),
    :global(body.print-sheet .svc-hero__copy),
    :global(body.print-sheet .sheet__print-wrap) {
      display: none !important;
    }

    :global(body.print-sheet) {
      background: #fff !important;
      color: #000 !important;
    }

    :global(body.print-sheet .svc-hero) {
      display: block;
      padding: 0;
      max-width: none;
      width: 100%;
    }

    :global(body.print-sheet .sheet) {
      display: block;
      width: 100%;
      max-width: none;
      border: 0;
      border-radius: 0;
      background: #fff;
      color: #000;
      font-size: 12pt;
    }

    :global(body.print-sheet .sheet__print-title) {
      display: block;
      padding: 0 0 1rem;
    }

    :global(body.print-sheet .sheet__print-name) {
      font-family: var(--font-sans, inherit);
      font-size: 22pt;
      font-weight: 600;
      color: #000;
    }

    :global(body.print-sheet .sheet__print-headline) {
      margin-top: 0.25rem;
      font-family: var(--font-sans, inherit);
      font-size: 14pt;
      color: #000;
    }

    :global(body.print-sheet .sheet__head),
    :global(body.print-sheet .sheet__foot),
    :global(body.print-sheet .sheet__id),
    :global(body.print-sheet .sheet__heading),
    :global(body.print-sheet .sheet__head > span:first-child) {
      color: #000;
    }

    :global(body.print-sheet .sheet__head) {
      border-bottom: 1px solid #000;
    }

    :global(body.print-sheet .sheet__block) {
      border-bottom: 1px solid #000;
      break-inside: avoid;
    }

    :global(body.print-sheet .sheet__list li) {
      border-top-color: #000;
      color: #000;
      opacity: 1 !important;
      transform: none !important;
    }

    :global(body.print-sheet .sheet__print-foot) {
      display: block;
      margin-top: 1.5rem;
      padding-top: 0.75rem;
      border-top: 1px solid #000;
      font-family: var(--font-sans, inherit);
      font-size: 10pt;
      color: #000;
    }
  }

  @media (min-width: 1024px) {
    .svc-hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .svc-hero__copy {
      grid-column: 1 / span 7;
    }

    .sheet {
      grid-column: 9 / -1;
    }
  }
</style>
