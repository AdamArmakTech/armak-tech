---
/**
 * Service page opener: breadcrumb, h1 (headline), intro, CTAs,
 * and a white scope sheet summarising what is included and the standards involved.
 */
import Button from '../ui/Button.astro';
import { contactHref, CTA_LABEL } from '../../lib/cta';
import { site, type Service } from '../../data/site';
import type { ServiceDetail } from '../../data/services-detail';

interface Props {
  service: Service;
  detail: ServiceDetail;
}

const { service, detail } = Astro.props;
---

<section class="svc-hero container" aria-labelledby="svc-hero-title">
  <nav class="svc-hero__crumbs t-meta" aria-label="Breadcrumb" data-reveal="fade">
    <ol role="list">
      <li><a href="/">Home</a></li>
      <li><a href="/services/">Services</a></li>
      <li aria-current="page">{service.name}</li>
    </ol>
  </nav>

  <div class="svc-hero__grid">
    <div class="svc-hero__copy">
      <h1 id="svc-hero-title" class="t-h1 svc-hero__headline">{service.name}</h1>
      <p class="t-lead" data-reveal>{detail.headline}</p>
      <p class="svc-hero__intro" data-reveal>{detail.intro}</p>
      <div class="svc-hero__ctas" data-dock-start data-reveal>
        <Button href={contactHref({ about: service.slug })} size="lg">{CTA_LABEL}</Button>
        <Button href={site.phoneHref} variant="outline" size="lg" icon="phone">{site.phone}</Button>
      </div>
    </div>

    <aside class="sheet" aria-label={`${service.name} scope summary`} data-reveal="scale">
      <div class="sheet__block">
        <p class="t-meta sheet__heading">Includes</p>
        <ul role="list" class="sheet__list">
          {service.includes.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="sheet__block">
        <p class="t-meta sheet__heading">Standards and technology</p>
        <ul role="list" class="sheet__list">
          {detail.standards.map((s) => <li>{typeof s === 'string' ? s : s.text}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</section>

<script>
  import { prefersReducedMotion } from '../../scripts/demo';

  // Scope-sheet rows reveal line by line the first time the sheet is on screen.
  // Bundled (not inline) so the site's Content-Security-Policy allows it; rows stay visible if it never runs.
  (function () {
    var sheets = document.querySelectorAll('.sheet');
    if (!sheets.length || prefersReducedMotion()) return;
    if (!('IntersectionObserver' in window)) return;
    sheets.forEach(function (sheet) {
      var rows = sheet.querySelectorAll('.sheet__list li');
      rows.forEach(function (li, i) {
        (li as HTMLElement).style.setProperty('--i', String(i));
      });
      sheet.setAttribute('data-rows', 'pending');
      var io = new IntersectionObserver(
        function (entries) {
          if (!entries.some(function (e) { return e.isIntersecting; })) return;
          io.disconnect();
          sheet.setAttribute('data-rows', 'in');
        },
        { threshold: 0.2 },
      );
      io.observe(sheet);
    });
  })();
</script>

<style>
  .svc-hero {
    padding-top: clamp(1.25rem, 0.9rem + 1.5vw, 2.25rem);
    padding-bottom: var(--space-block);
  }

  /* Breadcrumb */
  .svc-hero__crumbs {
    margin-bottom: clamp(2rem, 1.4rem + 2.6vw, 4rem);
  }

  .svc-hero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
  }

  .svc-hero__crumbs li {
    display: inline-flex;
    align-items: center;
  }

  .svc-hero__crumbs li:not(:last-child)::after {
    content: "/";
    margin-inline: 0.625rem;
  }

  .svc-hero__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--dur-fast) ease;
  }

  .svc-hero__crumbs a:hover {
    color: var(--ink);
  }

  .svc-hero__crumbs [aria-current] {
    color: var(--ink);
  }

  /* Layout */
  .svc-hero__grid {
    display: grid;
    gap: var(--space-block) var(--col-gap);
  }

  .svc-hero__copy {
    display: grid;
    gap: 1.75rem;
    align-content: start;
    justify-items: start;
  }

  .svc-hero__headline {
    max-width: 20ch;
  }

  .svc-hero__intro {
    max-width: 38em;
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-hero__headline {
      animation: svc-title-in 1.1s var(--ease-out) both;
    }
  }

  @keyframes svc-title-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.3em, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .svc-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Scope sheet: a raised white sheet, no border */
  .sheet {
    display: grid;
    align-content: start;
    gap: var(--sp-6);
    padding: var(--sp-6);
    background: var(--white);
    border-radius: var(--radius-lg);
    font-size: var(--fs-small);
  }

  .sheet__block {
    display: grid;
    gap: var(--sp-3);
  }

  .sheet__list {
    display: grid;
    gap: var(--sp-3);
  }

  .sheet__list li {
    color: var(--text);
  }

  /* Rows rise 6px and fade in, 50ms apart. */
  .sheet[data-rows] .sheet__list li {
    transition:
      opacity var(--dur) var(--ease-out) calc(var(--i, 0) * 50ms),
      transform var(--dur) var(--ease-out) calc(var(--i, 0) * 50ms);
  }

  .sheet[data-rows="pending"] .sheet__list li {
    opacity: 0;
    transform: translateY(6px);
  }

  @media (min-width: 1024px) {
    .svc-hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .svc-hero__copy {
      grid-column: 1 / span 7;
    }

    .sheet {
      grid-column: 9 / -1;
    }
  }
</style>
