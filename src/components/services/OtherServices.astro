---
import { services, type ServiceSlug } from '../../data/site';

interface Props {
  current: ServiceSlug;
  code?: string;
}

const { current } = Astro.props;
const others = services.filter((s) => s.slug !== current);
---

<nav class="others container" aria-label="Other services">
  <div class="others__head" data-reveal>
    <h2 class="t-h3" id="others-title">Other services</h2>
    <p class="others__intro">Most projects involve more than one system. One team handles all of them.</p>
  </div>
  <ul role="list" class="others__grid" data-reveal-group>
    {others.map((s) => (
      <li>
        <a class="other" href={`/services/${s.slug}/`}>
          <span class="other__name">{s.name}</span>
          <span class="other__short">{s.short}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .others {
    display: grid;
    gap: var(--sp-7);
    padding-block: var(--space-block);
  }

  .others__head {
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }

  .others__intro {
    max-width: 34em;
    color: var(--text);
  }

  .others__grid {
    display: grid;
    gap: var(--sp-5) var(--sp-7);
  }

  .other {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    min-height: 44px;
    height: 100%;
  }

  .other__name {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .other__short {
    color: var(--text);
  }

  @media (hover: hover) and (pointer: fine) {
    .other:hover .other__name {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
    }
  }

  .other:focus-visible .other__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  @media (min-width: 640px) {
    .others__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .others__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--sp-6);
    }
  }
</style>
