---
import SectionHead from '../ui/SectionHead.astro';
import Label from '../ui/Label.astro';
import CableTest from '../ui/CableTest.astro';
import { process as steps, pillars } from '../../data/content';
---

<section id="process" class="section process">
  <div class="container">
    <SectionHead
      code="D-01"
      label="The Armak standard"
      title="Assessed, designed, installed — then proven."
      intro="The same five steps on every job, from a single-rack retrofit to a multi-site rollout. Nothing is signed off until it has been tested and documented."
    />

    <div class="process__layout">
      <ol role="list" class="process__steps" data-reveal-stagger="80">
        {steps.map((step) => {
          const isCertify = step.title === 'Certify';
          return (
            <li class:list={['step', { 'step--certify': isCertify }]} data-reveal>
              <span class="step__num" aria-hidden="true">{step.code}</span>
              <div class="step__copy">
                <h3 class="t-h3 step__title">
                  <span class="visually-hidden">Step {step.code}: </span>{step.title}
                </h3>
                <p class="step__body t-muted">{step.body}</p>
                {isCertify && <a class="t-mono step__ref" href="#cable-test">Try the live test demo →</a>}
              </div>
            </li>
          );
        })}
      </ol>

      <aside class="process__aside" aria-label="Step 04 in action: a live cable test">
        <p class="t-mono process__aside-label">Step 04 · Certify — see it work</p>
        <CableTest variant="full" id="cable-test" />
      </aside>
    </div>

    <div class="pillars">
      <Label code="D-03">Principles</Label>
      <ul role="list" class="pillars__grid" data-reveal-stagger="80">
        {pillars.map((p, i) => (
          <li class="pillar" data-reveal>
            <span class="t-mono pillar__index">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="t-h4 pillar__title">{p.title}</h3>
            <p class="t-small t-muted pillar__body">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .process__layout {
    display: grid;
    gap: var(--space-block) var(--col-gap);
  }

  /* ── Steps ── */
  .process__steps {
    border-bottom: 1px solid var(--hairline);
  }

  .step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0.25rem var(--col-gap);
    padding-block: 1.75rem;
    border-top: 1px solid var(--hairline);
  }

  .step__num {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
    color: var(--hairline-strong);
    transition: color var(--dur) ease;
  }

  .step:hover .step__num {
    color: var(--ink);
  }

  .step__copy {
    display: grid;
    gap: 0.625rem;
    align-content: start;
  }

  .step__body {
    max-width: 34em;
  }

  .step--certify .step__num {
    color: var(--ink);
  }

  .step__ref {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.5rem;
    color: var(--ink);
  }

  .step__ref:hover {
    color: var(--signal);
  }

  .step__ref::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--signal);
  }

  /* ── Aside: the live cable-test demo (step 04 in action) ── */
  .process__aside {
    display: grid;
    gap: 0.875rem;
    align-content: start;
  }

  .process__aside-label {
    color: var(--steel);
  }

  /* ── Pillars ── */
  .pillars {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    margin-top: var(--space-section);
  }

  .pillars__grid {
    display: grid;
    width: 100%;
    border-top: 1px solid var(--ink);
  }

  .pillar {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.5rem 0 2rem;
    border-bottom: 1px solid var(--hairline);
  }

  .pillar__index {
    color: var(--signal);
  }

  .pillar__body {
    max-width: 30em;
  }

  @media (min-width: 700px) {
    .step {
      grid-template-columns: 6rem minmax(0, 1fr);
    }

    .pillars__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillar {
      padding: 1.5rem 1.5rem 2rem;
    }

    .pillar:nth-child(odd) {
      padding-left: 0;
    }

    .pillar:nth-child(even) {
      border-left: 1px solid var(--hairline);
    }
  }

  @media (min-width: 1000px) {
    .process__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .process__steps {
      grid-column: 1 / span 6;
    }

    .process__aside {
      grid-column: 7 / -1;
    }

    .step {
      padding-block: 2.25rem;
    }
  }

  @media (min-width: 1100px) {
    .pillars__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .pillar,
    .pillar:nth-child(odd) {
      padding: 1.5rem 1.5rem 0.5rem;
      border-bottom: 0;
      border-left: 1px solid var(--hairline);
    }

    .pillar:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
