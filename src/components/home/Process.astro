---
/**
 * "The Armak standard" — the five steps, each with a live demo.
 * Works like the System explorer: the tabs move on by themselves once the active step's demo has played
 * to the end (a short hold, then a crossfade to the next step); one stage shows the active step and plays
 * its demo. Using a tab, or a control inside a demo, hands control to the visitor. Without JS every
 * step + demo is shown stacked.
 */
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import CableTest from '../ui/CableTest.astro';
import AssessDemo from '../process/AssessDemo.astro';
import DesignDemo from '../process/DesignDemo.astro';
import InstallDemo from '../process/InstallDemo.astro';
import SupportDemo from '../process/SupportDemo.astro';
import RoomForLater from '../process/RoomForLater.astro';
import { process as steps, pillars } from '../../data/content';
import { CTA_LABEL } from '../../lib/cta';

const demos: Record<string, any> = {
  '01': AssessDemo,
  '02': DesignDemo,
  '03': InstallDemo,
  '05': SupportDemo,
};
---

<section id="process" class="section process">
  <div class="container">
    <SectionHead
      label="The Armak standard"
      title="How every job runs."
      intro="The same five steps on every job, from a single-rack retrofit to a multi-site rollout. Nothing is signed off until it has been tested and documented."
    />

    <div class="steps" data-steps>
      <div class="steps__tabs-wrap">
        <p id="steps-tabs-label" class="visually-hidden">The five steps</p>
        <div class="steps__tabs" role="tablist" aria-labelledby="steps-tabs-label" aria-orientation="vertical" data-tabs>
          {steps.map((s, i) => (
            <button
              type="button"
              class="steps__tab"
              role="tab"
              id={`step-tab-${s.code}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`step-panel-${s.code}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="steps__name">{s.title}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="steps__stage">
        {steps.map((s, i) => {
          const Demo = demos[s.code];
          return (
            <div
              class:list={['steps__panel', { 'is-active': i === 0 }]}
              role="tabpanel"
              id={`step-panel-${s.code}`}
              aria-labelledby={`step-tab-${s.code}`}
              data-step-panel
            >
              <div class="steps__intro">
                <h3 class="visually-hidden">{s.title}</h3>
                <p class="steps__intro-body">{s.body}</p>
              </div>
              {s.code === '04' ? <CableTest variant="full" id="cable-test" /> : Demo && <Demo />}
            </div>
          );
        })}
      </div>
    </div>

    <div class="process__next" data-dock-hide>
      <p class="t-meta process__start">Every job starts with the assessment.</p>
      <Button href="#contact" icon="arrow">{CTA_LABEL}</Button>
    </div>

    <div class="pillars">
      <h3 class="t-h3">Principles</h3>
      <ul role="list" class="pillars__grid">
        {pillars.map((p) => (
          <li class="pillar">
            <h4 class="t-h4 pillar__title">{p.title}</h4>
            <p class="t-small pillar__body">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>

    <RoomForLater />
  </div>
</section>

<script>
  import { prefersReducedMotion } from '../../scripts/demo';

  /** The finished demo stays on screen this long before the next step (ms). */
  const HOLD_MS = 1600;
  /** If a demo never reports that it is done, move on anyway after this long (ms). */
  const FALLBACK_MS = 22000;
  /** Touching one of these inside a demo hands control to the visitor. A scroll or a tap on the drawing does not. */
  const CONTROL = 'button, a, input, select, textarea, summary, [role="slider"], [role="button"]';

  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-step-panel]')];
    const stage = root.querySelector<HTMLElement>('.steps__stage')!;
    const tabsEl = root.querySelector<HTMLElement>('[data-tabs]');
    if (!tabs.length) return;

    root.classList.add('is-enhanced');

    let index = 0;
    let timer: number | undefined;
    let switching: number | undefined;
    let inView = false;
    let userTookOver = false;
    let hovering = false;
    let focused = false;
    let doneSeen = false; // the active step's demo has played to the end
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    const autoOn = () => !prefersReducedMotion() && !userTookOver && inView && !hovering && !focused;

    /** Restart the active step's demo from the beginning */
    const playDemo = (panel: HTMLElement) => {
      panel.querySelector<HTMLButtonElement>('[data-demo-replay], [data-ct-run]')?.click();
    };

    const stopAuto = () => {
      window.clearTimeout(timer);
      timer = undefined;
    };

    /** Move on to the next step after `ms`, as long as the stepper is still running by itself. */
    const armAdvance = (ms: number) => {
      window.clearTimeout(timer);
      timer = undefined;
      if (!autoOn()) return;
      timer = window.setTimeout(() => {
        timer = undefined;
        if (!autoOn()) return;
        select(index + 1, { play: true });
        armAdvance(FALLBACK_MS);
      }, ms);
    };

    /** Carry on after a pause: straight to the hold if the demo already finished, else wait for it. */
    const resume = () => armAdvance(doneSeen ? HOLD_MS : FALLBACK_MS);

    // Each demo reports when it has played to the end (finished() in src/scripts/demo.ts): hold, then next step.
    stage.addEventListener('armak:demo-done', (e) => {
      if (!panels[index].contains(e.target as Node)) return;
      doneSeen = true;
      armAdvance(HOLD_MS);
    });

    /** Crossfade the two panels and ease the stage from the old height to the new one, so nothing jumps. */
    const swapPanels = (from: HTMLElement, to: HTMLElement) => {
      window.clearTimeout(switching);
      switching = undefined;
      panels.forEach((p) => p.classList.remove('is-leaving'));
      if (prefersReducedMotion()) {
        stage.classList.remove('is-switching');
        stage.style.removeProperty('--stage-h');
        from.classList.remove('is-active');
        to.classList.add('is-active');
        return;
      }
      const h0 = stage.getBoundingClientRect().height;
      stage.style.setProperty('--stage-h', `${h0}px`);
      stage.classList.add('is-switching');
      from.classList.add('is-leaving');
      from.classList.remove('is-active');
      to.classList.add('is-active');
      const h1 = to.offsetHeight;
      void stage.offsetWidth; // commit the start height before changing it, so the height eases instead of jumping
      stage.style.setProperty('--stage-h', `${h1}px`);
      switching = window.setTimeout(() => {
        from.classList.remove('is-leaving');
        stage.classList.remove('is-switching');
        stage.style.removeProperty('--stage-h');
      }, 480);
    };

    /** Scroll the phone tab strip so the active tab is in view (on desktop the strip does not scroll). */
    const showTab = (tab: HTMLElement) => {
      if (!tabsEl || tabsEl.scrollWidth <= tabsEl.clientWidth + 1) return;
      const left = tab.offsetLeft - (tabsEl.clientWidth - tab.offsetWidth) / 2;
      tabsEl.scrollTo({ left: Math.max(0, left), behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
    };

    function select(i: number, { focus = false, play = false } = {}) {
      const next = (i + tabs.length) % tabs.length;
      const from = panels[index];
      const to = panels[next];
      index = next;
      doneSeen = false;
      tabs.forEach((t, n) => {
        const on = n === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      if (from !== to) swapPanels(from, to);
      moveSlider();
      showTab(tabs[index]);
      if (focus) tabs[index].focus();
      if (play) playDemo(to);
    }

    /** One highlight behind the active tab. It is a 1px square moved and stretched with transform only,
     *  so it never triggers layout. Created here, so without JS the tabs are untouched. */
    let slider: HTMLElement | null = null;
    function moveSlider() {
      if (!tabsEl) return;
      const tab = tabs[index];
      if (!tab || !tab.offsetWidth) return;
      if (!slider) {
        slider = document.createElement('span');
        slider.className = 'steps__slider';
        slider.setAttribute('aria-hidden', 'true');
        tabsEl.prepend(slider);
        root.classList.add('has-slider');
      }
      slider.style.transform = `translate(${tab.offsetLeft}px, ${tab.offsetTop}px) scale(${tab.offsetWidth}, ${tab.offsetHeight})`;
      // Turn the transition on only after the first placement, so it does not slide in from the corner
      if (!slider.classList.contains('is-ready')) requestAnimationFrame(() => slider?.classList.add('is-ready'));
    }
    moveSlider();
    new ResizeObserver(moveSlider).observe(tabsEl ?? root);
    document.fonts?.ready.then(moveSlider);

    const takeOver = () => {
      if (userTookOver) return;
      userTookOver = true;
      root.classList.add('is-manual');
      stopAuto();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        takeOver();
        select(i, { play: true });
      });
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {
          ArrowDown: index + 1,
          ArrowRight: index + 1,
          ArrowUp: index - 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(e.key in keys)) return;
        e.preventDefault();
        takeOver();
        select(keys[e.key], { focus: true, play: true });
      });
    });

    // Using a control inside a demo (cable switch, slider, replay, a jack) hands over control.
    // A scroll or a tap on the drawing does not, so the steps keep moving on phones.
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest?.(CONTROL)) takeOver();
    });
    stage.addEventListener('keydown', takeOver);

    // With a real pointer: hold still while it is over the steps, so the step never changes under someone
    // who is reading; carry on once it leaves. (A phone fires mouseenter on a tap and never leaves, so not there.)
    if (canHover) {
      root.addEventListener('mouseenter', () => {
        hovering = true;
        stopAuto();
      });
      root.addEventListener('mouseleave', () => {
        hovering = false;
        resume();
      });
    }
    root.addEventListener('focusin', () => {
      focused = true;
      stopAuto();
    });
    root.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      // Moving between controls inside, or the whole window losing focus, keeps it paused
      if ((to && root.contains(to)) || (!to && root.contains(document.activeElement))) return;
      focused = false;
      resume();
    });

    // Links to the cable test (hero "See how we test") open step 04 first, so the target is visible.
    // Capture phase: runs before the smooth-scroll handler measures the target.
    const certify = panels.findIndex((p) => p.querySelector('#cable-test'));
    const openCertify = () => {
      if (certify < 0) return;
      takeOver();
      select(certify, { play: true });
    };
    document.addEventListener(
      'click',
      (e) => {
        const a = (e.target as Element).closest?.('a[href$="#cable-test"]');
        if (a) openCertify();
      },
      true,
    );
    if (location.hash === '#cable-test') openCertify();

    // The design demo's labeled jacks open the trace demo (step 03). TraceDemo scrolls to it and lights the jack.
    const trace = panels.findIndex((p) => p.querySelector('[data-demo="trace"]'));
    document.addEventListener('armak:trace', () => {
      if (trace < 0) return;
      takeOver();
      select(trace, { play: true });
    });

    // Run only while the section is on screen: play the current demo on arrival, stop when it leaves
    new IntersectionObserver(
      ([entry]) => {
        const wasInView = inView;
        inView = entry.isIntersecting;
        if (inView && !wasInView) {
          if (!userTookOver) {
            doneSeen = false;
            playDemo(panels[index]);
          }
          resume();
        } else if (!inView) {
          stopAuto();
        }
      },
      { threshold: 0.3 },
    ).observe(root);
  });
</script>

<style>
  .process__next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }

  .process__next :global(.btn) {
    white-space: normal;
  }

  /* ── Stepper ── */
  .steps {
    display: grid;
    gap: 1.5rem var(--col-gap);
  }

  .steps > * {
    min-width: 0;
  }

  /* Without JS: no tabs, every step + demo stacked */
  .steps:not(.is-enhanced) .steps__tabs-wrap {
    display: none;
  }

  .steps:not(.is-enhanced) .steps__stage {
    gap: var(--space-block);
  }

  .steps.is-enhanced .steps__panel:not(.is-active) {
    display: none;
  }

  /* Tabs: horizontal scroller on phones, vertical list on desktop (same as the System explorer) */
  .steps__tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    /* A scrolling strip clips anything outside its padding box, which cut the focus ring (3px gap plus a
       2px line) down to two side bars. 6px of room above and below, pulled back by an equal negative
       margin, shows the whole ring and moves nothing (the bottom keeps its old 2px). From 900px the strip
       is a column and the rule further down resets both. */
    padding-block: 6px 8px;
    margin-block: -6px;
  }

  .steps__tabs::-webkit-scrollbar {
    display: none;
  }

  .steps__tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-shrink: 0;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--paper-sunken);
    text-align: left;
    overflow: hidden;
    transition:
      background var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .steps__tab[aria-selected='false']:hover {
      background: var(--white);
    }
  }

  /* Sliding highlight: one element behind the tabs. The selected tab itself goes clear and shows it. */
  .steps__tabs {
    position: relative;
  }

  .steps :global(.steps__slider) {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    background: var(--ink);
    transform-origin: 0 0;
    pointer-events: none;
  }

  .steps :global(.steps__slider).is-ready {
    transition: transform var(--dur) var(--ease-out);
  }

  .steps.has-slider .steps__tab[aria-selected='true'],
  .steps.has-slider .steps__tab[aria-selected='true']:hover {
    background: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .steps :global(.steps__slider).is-ready {
      transition: none;
    }
  }

  .steps__tab[aria-selected='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .steps__tab {
      transition: none;
    }
  }

  .steps__name {
    font-weight: 500;
    font-size: var(--fs-small);
  }

  /* Stage */
  .steps__stage {
    display: grid;
    container-type: inline-size;
  }

  .steps__panel {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    align-self: start;
  }

  /* Switching steps (owner, 2026-11-06: "it should look seamless"): the two panels share one cell, the old one
     fades out as the new one fades in, and the stage eases from the old height to the new one so the page never
     jumps (grid-template-rows, the same way the FAQ answers unfold). Under reduced motion it is an instant swap. */
  .steps__stage.is-switching {
    grid-template-rows: var(--stage-h);
    overflow: clip;
    transition: grid-template-rows 420ms var(--ease-out);
  }

  .steps__stage.is-switching > .steps__panel {
    grid-area: 1 / 1;
  }

  .steps.is-enhanced .steps__panel.is-leaving {
    display: grid;
    pointer-events: none;
    animation: steps-out 240ms var(--ease-out) forwards;
  }

  .steps.is-enhanced .steps__panel.is-active {
    animation: steps-in 420ms var(--ease-out);
  }

  @keyframes steps-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes steps-out {
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .steps__stage.is-switching {
      transition: none;
    }

    .steps.is-enhanced .steps__panel.is-active,
    .steps.is-enhanced .steps__panel.is-leaving {
      animation: none;
    }
  }

  .steps__intro {
    display: grid;
    gap: 0.5rem;
  }

  .steps__intro-body {
    color: var(--text);
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 40em;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: 4fr 8fr;
      align-items: start;
    }

    .steps__tabs-wrap {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .steps__tabs {
      flex-direction: column;
      gap: var(--sp-2);
      overflow: visible;
      margin: 0;
      padding: 0;
    }

    .steps__tab {
      display: flex;
      padding: 1.375rem 1rem;
    }

    .steps__tab[aria-selected='true']:hover {
      background: var(--ink);
    }

    .steps__name {
      font-size: var(--fs-h4);
    }

    .steps__stage {
      min-height: 640px;
    }
  }

  /* ── Pillars ── */
  .pillars {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    margin-top: var(--space-section);
  }

  .pillars__grid {
    display: grid;
    width: 100%;
    gap: var(--sp-6) var(--sp-7);
  }

  .pillar {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .pillar__body {
    color: var(--text);
    max-width: 30em;
  }

  @media (min-width: 640px) {
    .pillars__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (min-width: 1024px) {
    .pillars__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

  }
</style>
