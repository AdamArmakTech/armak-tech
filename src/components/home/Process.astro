---
/**
 * "The Armak standard" — the five steps, each with a live demo.
 * Works like the System explorer: tabs on the left auto-advance (red progress line under the
 * active one); one stage on the right shows the active step and plays its demo. Any click or
 * interaction hands control to the visitor. Without JS every step + demo is shown stacked.
 */
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import CableTest from '../ui/CableTest.astro';
import AssessDemo from '../process/AssessDemo.astro';
import DesignDemo from '../process/DesignDemo.astro';
import InstallDemo from '../process/InstallDemo.astro';
import SupportDemo from '../process/SupportDemo.astro';
import JobTimeline from '../process/JobTimeline.astro';
import RoomForLater from '../process/RoomForLater.astro';
import { process as steps, pillars, assessmentTiers } from '../../data/content';

const demos: Record<string, any> = {
  '01': AssessDemo,
  '02': DesignDemo,
  '03': InstallDemo,
  '05': SupportDemo,
};

// How long each step stays up before advancing (ms). The cable test plays a little longer.
const dwell = (code: string) => (code === '04' ? 8500 : 6500);
---

<section id="process" class="section process">
  <div class="container">
    <SectionHead
      title="How every job runs."
      intro="The same five steps on every job, from a single-rack retrofit to a multi-site rollout. Nothing is signed off until it has been tested and documented."
    />

    <JobTimeline />

    <div class="steps" data-steps>
      <div class="steps__tabs-wrap">
        <p id="steps-tabs-label" class="t-small t-muted steps__hint">The five steps</p>
        <div class="steps__tabs" role="tablist" aria-labelledby="steps-tabs-label" aria-orientation="vertical" data-tabs>
          {steps.map((s, i) => (
            <button
              type="button"
              class="steps__tab"
              role="tab"
              id={`step-tab-${s.code}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`step-panel-${s.code}`}
              tabindex={i === 0 ? 0 : -1}
              style={`--dwell:${dwell(s.code)}ms`}
              data-dwell={dwell(s.code)}
            >
              <span class="t-mono steps__code">{s.code}</span>
              <span class="steps__name">{s.title}</span>
              <span class="steps__progress" aria-hidden="true"></span>
            </button>
          ))}
        </div>
      </div>

      <div class="steps__stage">
        {steps.map((s, i) => {
          const Demo = demos[s.code];
          return (
            <div
              class:list={['steps__panel', { 'is-active': i === 0 }]}
              role="tabpanel"
              id={`step-panel-${s.code}`}
              aria-labelledby={`step-tab-${s.code}`}
              data-step-panel
            >
              <div class="steps__intro">
                <p class="steps__intro-label"><span class="t-mono">Step <span class="steps__num"><span class="steps__num-v">{s.code}</span></span></span> · {s.title}</p>
                <h3 class="visually-hidden">{s.title}</h3>
                <p class="steps__intro-body">{s.body}</p>
                {s.code === '01' && (
                  <div class="steps__ways">
                    <p class="steps__ways-lead">Two ways to start:</p>
                    <ul role="list" class="steps__ways-list">
                      {assessmentTiers.map((t) => (
                        <li class="steps__way">
                          <strong class="steps__way-title">{t.title}</strong>
                          <span class="steps__way-body">{t.body}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
              {s.code === '04' ? <CableTest variant="full" id="cable-test" /> : Demo && <Demo />}
            </div>
          );
        })}
      </div>
    </div>

    <div class="process__next" data-dock-hide>
      <p class="process__start">Every job starts at step 01.</p>
      <Button href="#contact" icon="arrow">Request a site assessment</Button>
    </div>

    <div class="pillars">
      <h3 class="t-h4 pillars__heading">Principles</h3>
      <ul role="list" class="pillars__grid">
        {pillars.map((p) => (
          <li class="pillar">
            <h4 class="t-h4 pillar__title">{p.title}</h4>
            <p class="t-small pillar__body">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>

    <RoomForLater />
  </div>
</section>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-step-panel]')];
    const stage = root.querySelector<HTMLElement>('.steps__stage')!;
    if (!tabs.length) return;

    root.classList.add('is-enhanced');

    let index = 0;
    let timer: number | undefined;
    let inView = false;
    let userTookOver = false;
    let hovering = false;
    let focused = false;

    /** Restart the active step's demo from the beginning */
    const playDemo = (panel: HTMLElement) => {
      panel.querySelector<HTMLButtonElement>('[data-demo-replay], [data-ct-run]')?.click();
    };

    const startProgress = (tab: HTMLElement) => {
      tabs.forEach((t) => t.classList.remove('is-timing'));
      void tab.offsetWidth;
      tab.classList.add('is-timing');
    };

    const stopAuto = () => {
      window.clearTimeout(timer);
      timer = undefined;
      tabs.forEach((t) => t.classList.remove('is-timing'));
    };

    const scheduleNext = () => {
      window.clearTimeout(timer);
      if (reduceMotion || userTookOver || !inView || hovering || focused) return;
      const tab = tabs[index];
      startProgress(tab);
      timer = window.setTimeout(() => {
        select(index + 1, { play: true });
        scheduleNext();
      }, Number(tab.dataset.dwell) || 6500);
    };

    function select(i: number, { focus = false, play = false } = {}) {
      const prev = index;
      // Forward (down the list, or wrapping 05 to 01) or back
      const dir = i >= tabs.length ? 1 : i < 0 ? -1 : Math.sign(i - prev) || 1;
      index = (i + tabs.length) % tabs.length;
      tabs.forEach((t, n) => {
        const on = n === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, n) => p.classList.toggle('is-active', n === index));
      if (index !== prev) tickNumber(panels[index], tabs[prev].querySelector('.steps__code')?.textContent ?? '', dir);
      moveSlider();
      if (focus) tabs[index].focus();
      if (play) playDemo(panels[index]);
    }

    /** The step number in the panel label ticks over. Forward: the old number slides up and out, the new one
     *  slides in from below. Back: the same, the other way. Transform and opacity only. */
    const tickNumber = (panel: HTMLElement, oldCode: string, dir: number) => {
      if (reduceMotion) return;
      const num = panel.querySelector<HTMLElement>('.steps__num');
      const value = num?.querySelector<HTMLElement>('.steps__num-v');
      if (!num || !value || !oldCode) return;
      const css = getComputedStyle(document.documentElement);
      const raw = css.getPropertyValue('--dur').trim();
      const ms = (raw.endsWith('ms') ? parseFloat(raw) : parseFloat(raw) * 1000) || 320;
      const easing = css.getPropertyValue('--ease-out').trim() || 'ease-out';
      const opts = { duration: ms, easing, fill: 'both' as FillMode };
      num.querySelector('.steps__num-old')?.remove();
      const ghost = document.createElement('span');
      ghost.className = 'steps__num-old';
      ghost.setAttribute('aria-hidden', 'true');
      ghost.textContent = oldCode;
      num.append(ghost);
      value.animate(
        [{ transform: `translateY(${dir * 100}%)`, opacity: 0 }, { transform: 'translateY(0)', opacity: 1 }],
        opts,
      );
      ghost
        .animate([{ transform: 'translateY(0)', opacity: 1 }, { transform: `translateY(${dir * -100}%)`, opacity: 0 }], opts)
        .finished.then(() => ghost.remove(), () => ghost.remove());
    };

    /** One highlight behind the active tab. It is a 1px square moved and stretched with transform only,
     *  so it never triggers layout. Created here, so without JS the tabs are untouched. */
    const tabsEl = root.querySelector<HTMLElement>('[data-tabs]');
    let slider: HTMLElement | null = null;
    function moveSlider() {
      if (!tabsEl) return;
      const tab = tabs[index];
      if (!tab || !tab.offsetWidth) return;
      if (!slider) {
        slider = document.createElement('span');
        slider.className = 'steps__slider';
        slider.setAttribute('aria-hidden', 'true');
        tabsEl.prepend(slider);
        root.classList.add('has-slider');
      }
      slider.style.transform = `translate(${tab.offsetLeft}px, ${tab.offsetTop}px) scale(${tab.offsetWidth}, ${tab.offsetHeight})`;
      // Turn the transition on only after the first placement, so it does not slide in from the corner
      if (!slider.classList.contains('is-ready')) requestAnimationFrame(() => slider?.classList.add('is-ready'));
    }
    moveSlider();
    new ResizeObserver(moveSlider).observe(tabsEl ?? root);
    document.fonts?.ready.then(moveSlider);

    const takeOver = () => {
      if (userTookOver) return;
      userTookOver = true;
      root.classList.add('is-manual');
      stopAuto();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        takeOver();
        select(i, { play: true });
      });
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {
          ArrowDown: index + 1,
          ArrowRight: index + 1,
          ArrowUp: index - 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(e.key in keys)) return;
        e.preventDefault();
        takeOver();
        select(keys[e.key], { focus: true, play: true });
      });
    });

    // Interacting with a demo (cable switch, slider, replay…) also hands over control
    stage.addEventListener('pointerdown', takeOver);
    stage.addEventListener('keydown', takeOver);

    // Hold still while the pointer is over it or keyboard focus is inside it, so the step
    // never changes under someone who is reading or tabbing; carry on once they leave.
    root.addEventListener('mouseenter', () => {
      hovering = true;
      stopAuto();
    });
    root.addEventListener('mouseleave', () => {
      hovering = false;
      scheduleNext();
    });
    root.addEventListener('focusin', () => {
      focused = true;
      stopAuto();
    });
    root.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      // Moving between controls inside, or the whole window losing focus, keeps it paused
      if ((to && root.contains(to)) || (!to && root.contains(document.activeElement))) return;
      focused = false;
      scheduleNext();
    });

    // Links to the cable test (hero "See how we test") open step 04 first, so the target is visible.
    // Capture phase: runs before the smooth-scroll handler measures the target.
    const certify = panels.findIndex((p) => p.querySelector('#cable-test'));
    const openCertify = () => {
      if (certify < 0) return;
      takeOver();
      select(certify, { play: true });
    };
    document.addEventListener(
      'click',
      (e) => {
        const a = (e.target as Element).closest?.('a[href$="#cable-test"]');
        if (a) openCertify();
      },
      true,
    );
    if (location.hash === '#cable-test') openCertify();

    // The design demo's labeled jacks open the trace demo (step 03). TraceDemo scrolls to it and lights the jack.
    const trace = panels.findIndex((p) => p.querySelector('[data-demo="trace"]'));
    document.addEventListener('armak:trace', () => {
      if (trace < 0) return;
      takeOver();
      select(trace, { play: true });
    });

    // Auto-advance only while the section is on screen
    new IntersectionObserver(
      ([entry]) => {
        const wasInView = inView;
        inView = entry.isIntersecting;
        if (inView && !wasInView) {
          if (!userTookOver) playDemo(panels[index]);
          scheduleNext();
        } else if (!inView) {
          stopAuto();
        }
      },
      { threshold: 0.3 },
    ).observe(root);
  });
</script>

<style>
  /* Direction A: the five steps are one white sheet of the package, laid on the paper.
     Heading and intro split across the top; the step codes are set large like sheet numbers. */
  @media (min-width: 1024px) {
    .process :global(.section-head) {
      grid-template-columns: 5fr 6fr;
      column-gap: var(--col-gap);
      align-items: end;
    }

    .process :global(.section-head__title) {
      font-size: var(--fs-h1);
    }
  }

  /* Hairline edge (DESIGN.md Direction A: sheets have a 1px hairline edge). White on paper is only
     about 1.1:1, so without it the sheet has no visible boundary. Phones: full-bleed band, so top and
     bottom only. 900px and up: inset sheet, all four sides. */
  .steps {
    background: var(--white);
    padding: var(--sp-5) var(--gutter) var(--sp-6);
    margin-inline: calc(var(--gutter) * -1);
    border-block: 1px solid var(--hairline);
  }

  .steps :global(.demo),
  .steps :global(.ct) {
    box-shadow: none;
  }

  @media (min-width: 900px) {
    .steps {
      margin-inline: 0;
      padding: clamp(2rem, 1rem + 2vw, 3.5rem);
      border: 1px solid var(--hairline);
    }
  }

  .process__next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }

  .process__start {
    color: var(--text);
    font-size: var(--fs-small);
  }

  .process__next :global(.btn) {
    white-space: normal;
  }

  /* ── Stepper ── */
  .steps {
    display: grid;
    gap: 1.5rem var(--col-gap);
  }

  .steps > * {
    min-width: 0;
  }

  /* Without JS: no tabs, every step + demo stacked */
  .steps:not(.is-enhanced) .steps__tabs-wrap {
    display: none;
  }

  .steps:not(.is-enhanced) .steps__stage {
    gap: var(--space-block);
  }

  .steps.is-enhanced .steps__panel:not(.is-active) {
    display: none;
  }

  .steps__hint {
    margin-bottom: 0.75rem;
  }

  /* Tabs: horizontal scroller on phones, vertical list on desktop (same as the System explorer) */
  .steps__tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    /* A scrolling strip clips anything outside its padding box, which cut the focus ring (3px gap plus a
       2px line) down to two side bars. 6px of room above and below, pulled back by an equal negative
       margin, shows the whole ring and moves nothing (the bottom keeps its old 2px). From 900px the strip
       is a column and the rule further down resets both. */
    padding-block: 6px 8px;
    margin-block: -6px;
  }

  .steps__tabs::-webkit-scrollbar {
    display: none;
  }

  .steps__tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-shrink: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--field-line);
    border-radius: var(--radius);
    background: transparent;
    text-align: left;
    overflow: hidden;
    transition:
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .steps__tab:hover {
    border-color: var(--ink);
  }

  /* Sliding highlight: one element behind the tabs. The selected tab itself goes clear and shows it. */
  .steps__tabs {
    position: relative;
  }

  .steps :global(.steps__slider) {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    background: var(--ink);
    transform-origin: 0 0;
    pointer-events: none;
  }

  .steps :global(.steps__slider).is-ready {
    transition: transform var(--dur) var(--ease-out);
  }

  .steps.has-slider .steps__tab[aria-selected='true'],
  .steps.has-slider .steps__tab[aria-selected='true']:hover {
    background: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .steps :global(.steps__slider).is-ready {
      transition: none;
    }
  }

  .steps__tab[aria-selected='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .steps__code {
    color: var(--steel); /* DESIGN.md rule 7: red is for the one action and FAIL */
    transition: color var(--dur) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .steps__tab,
    .steps__code {
      transition: none;
    }
  }

  .steps__tab[aria-selected='true'] .steps__code {
    color: var(--paper);
  }

  .steps__name {
    font-weight: 500;
    font-size: var(--fs-small);
  }

  .steps__progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .steps__tab.is-timing .steps__progress {
    animation: steps-progress var(--dwell, 6500ms) linear forwards;
  }

  @keyframes steps-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Stage */
  .steps__stage {
    display: grid;
    container-type: inline-size;
  }

  .steps__panel {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .steps.is-enhanced .steps__panel.is-active {
    animation: steps-in 0.4s var(--ease-out);
  }

  @keyframes steps-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .steps__intro {
    display: grid;
    gap: 0.5rem;
  }

  .steps__intro-label {
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  /* Step number in the label: a clipped slot the digits slide through */
  .steps__num {
    position: relative;
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    line-height: 1.3;
  }

  .steps__num-v {
    display: inline-block;
  }

  .steps__num :global(.steps__num-old) {
    position: absolute;
    inset: 0;
  }

  /* Two ways to start (Assess step): two rows, a hairline between them (rule 5) */
  .steps__ways {
    display: grid;
    gap: var(--sp-2);
    max-width: 40em;
  }

  .steps__ways-lead {
    color: var(--text);
    font-size: var(--fs-small);
  }

  .steps__ways-list {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .steps__way {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-3) 0;
    color: var(--text);
    font-size: var(--fs-small);
    line-height: 1.5;
    border-bottom: 1px solid var(--hairline);
  }

  .steps__way:last-child {
    border-bottom: 0;
  }

  .steps__way-title {
    font-weight: 600;
    color: var(--ink);
  }

  .steps__intro-body {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 40em;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: 4fr 8fr;
      align-items: start;
    }

    .steps__tabs-wrap {
      align-self: start;
      margin-top: 0;
    }

    .steps__tabs {
      flex-direction: column;
      gap: 0;
      overflow: visible;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--hairline);
    }

    .steps__tab {
      display: grid;
      grid-template-columns: 4.5rem 1fr;
      align-items: center;
      padding: 1.25rem 1rem;
      border: 0;
      border-bottom: 1px solid var(--hairline);
      border-radius: 0;
    }

    .steps__tab:hover {
      background: var(--white);
    }

    .steps__tab[aria-selected='true']:hover {
      background: var(--ink);
    }

    .steps__name {
      font-size: var(--fs-h4);
    }

    .steps__code {
      font-size: var(--fs-h3);
      letter-spacing: -0.04em;
    }

    .steps__tab:hover {
      background: var(--paper);
    }

    .steps__stage {
      min-height: 640px;
    }
  }

  /* ── Pillars ── */
  .pillars {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    margin-top: var(--space-section);
    margin-bottom: 0;
  }

  .pillars__heading {
    font-size: var(--fs-h2);
    letter-spacing: var(--tracking-heading);
  }

  .pillars__grid {
    display: grid;
    width: 100%;
    border-top: 1px solid var(--ink);
  }

  .pillar {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.5rem 0 2rem;
    border-bottom: 1px solid var(--hairline);
  }

  .pillar__index {
    color: var(--steel);
  }

  .pillar__body {
    color: var(--text);
    max-width: 30em;
  }

  @media (min-width: 640px) {
    .pillars__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillar {
      padding: 1.5rem 1.5rem 2rem;
    }

    .pillar:nth-child(odd) {
      padding-left: 0;
    }

    .pillar:nth-child(even) {
      border-left: 1px solid var(--hairline);
    }
  }

  @media (min-width: 1024px) {
    .pillars {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--col-gap);
      align-items: start;
    }
  }
</style>
