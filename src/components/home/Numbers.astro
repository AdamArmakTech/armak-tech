---
/**
 * "Armak in numbers": four figures. The numbers count up once on first view (motion.ts, [data-count]);
 * this file adds the rest of the arrival: each figure rises in turn, its unit and note are written in as
 * it counts, and the "+" lands as the count settles. Armed only by the script, so without JS or under
 * reduced motion everything is simply there.
 */
import Stat from '../ui/Stat.astro';
import { site, yearsInBusiness, FOUNDED, serviceArea, counties } from '../../data/site';
---

<section class="section numbers" aria-labelledby="numbers-title">
  <div class="container">
    <div class="numbers__head">
      <h2 id="numbers-title" class="t-h3 numbers__title" data-reveal>
        Armak in numbers. <span class="t-muted">Since {FOUNDED}, across Southern California.</span>
      </h2>
    </div>

    <div class="numbers__grid" data-numbers>
      <div class="numbers__cell" style="--i: 0">
        <Stat value={yearsInBusiness} label="Years in business" />
      </div>
      <div class="numbers__cell" style="--i: 1">
        <Stat value={site.projectsDelivered} suffix="+" label="Projects delivered" />
      </div>
      <div class="numbers__cell" style="--i: 2">
        <Stat value={site.supportHours} label="Support" detail={`For ${site.supportScope}.`} />
      </div>
      <div class="numbers__cell" style="--i: 3">
        <Stat value={serviceArea.length} label="Cities served" detail={`Across ${counties.length} counties.`} />
      </div>
    </div>
  </div>
</section>

<script>
  import { prefersReducedMotion } from '../../scripts/demo';

  /* One trigger, not two: motion.ts starts each count and announces it with a bubbling event on the counter
     ('armak:count-start' when it begins, 'armak:count-end' when it settles). A cell goes live (unit and note
     written in) on the start and gets its "+" on the end. A cell with no counter (the non-numeric figure)
     has nothing to announce, so it alone keeps a small observer of its own. */
  document.querySelectorAll<HTMLElement>('[data-numbers]').forEach((grid) => {
    if (prefersReducedMotion()) return;
    grid.classList.add('is-armed');

    const cellOf = (target: EventTarget | null) => (target instanceof Element ? target.closest<HTMLElement>('.numbers__cell') : null);
    grid.addEventListener('armak:count-start', (e) => cellOf(e.target)?.classList.add('is-live'));
    grid.addEventListener('armak:count-end', (e) => cellOf(e.target)?.classList.add('is-done'));

    const loose: HTMLElement[] = [];
    grid.querySelectorAll<HTMLElement>('.numbers__cell').forEach((cell) => {
      const counter = cell.querySelector<HTMLElement>('[data-count]');
      if (!counter) {
        loose.push(cell);
        return;
      }
      // A count that began before this listener attached
      if (counter.dataset.countState) cell.classList.add('is-live');
      if (counter.dataset.countState === 'done') cell.classList.add('is-done');
    });

    if (loose.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.unobserve(entry.target);
            entry.target.classList.add('is-live', 'is-done');
          }
        },
        { threshold: 0.6 },
      );
      loose.forEach((cell) => io.observe(cell));
    }

    // If motion.ts never booted, nothing would announce a count: show the figures rather than leave them hidden
    window.setTimeout(() => {
      if (document.documentElement.classList.contains('motion-ready')) return;
      grid.querySelectorAll('.numbers__cell').forEach((cell) => cell.classList.add('is-live', 'is-done'));
    }, 4000);
  });
</script>

<style>
  .numbers__head {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin-bottom: var(--space-block);
  }

  .numbers__title {
    max-width: 26ch;
  }

  .numbers__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem var(--col-gap);
  }

  .numbers__cell {
    min-width: 0;
  }

  /* No rule above each stat; caption in the text face, sentence case */
  .numbers__grid :global(.stat) {
    padding-top: 0;
    border-top: 0;
  }

  .numbers__grid :global(.stat__label) {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
    color: var(--steel);
  }

  /* Keep the big mono numerals inside narrow phone columns */
  .numbers__grid :global(.stat__value) {
    font-size: clamp(2.5rem, 1.6rem + 4.2vw, 6rem);
  }

  /* ── Arrival (armed by the script) ──
     Each figure rises in turn (90 ms apart); its unit is written in from the left as it counts, the note
     just after; the "+" lands when the 1.6 s count comes to rest (motion.ts announces both moments).
     Transform, opacity and clip-path only. */
  .numbers__grid.is-armed :global(.stat__value) {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
    transition:
      opacity 600ms ease calc(var(--i) * 90ms),
      transform 900ms var(--ease-out) calc(var(--i) * 90ms);
  }

  .numbers__grid.is-armed :global(.stat__label),
  .numbers__grid.is-armed :global(.stat__detail) {
    clip-path: inset(-6% 100% -6% 0);
    transition: clip-path 560ms var(--ease-out) calc(var(--i) * 90ms + 220ms);
  }

  .numbers__grid.is-armed :global(.stat__detail) {
    transition-delay: calc(var(--i) * 90ms + 420ms);
  }

  .numbers__grid.is-armed :global(.stat__suffix) {
    display: inline-block;
    opacity: 0;
    transform: translate3d(0, 0.12em, 0);
    transition:
      opacity 320ms ease,
      transform 480ms var(--ease-out);
  }

  .numbers__grid.is-armed .numbers__cell.is-live :global(.stat__value),
  .numbers__grid.is-armed .numbers__cell.is-done :global(.stat__suffix) {
    opacity: 1;
    transform: none;
  }

  .numbers__grid.is-armed .numbers__cell.is-live :global(.stat__label),
  .numbers__grid.is-armed .numbers__cell.is-live :global(.stat__detail) {
    clip-path: inset(-6% 0 -6% 0);
  }

  @media (min-width: 900px) {
    .numbers__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }

    .numbers__title {
      grid-column: 1 / -1;
    }

    .numbers__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Paper never waits on a scroll: printed before the row scrolled into view, it still prints finished */
  @media print {
    .numbers__grid.is-armed :global(.stat__value),
    .numbers__grid.is-armed :global(.stat__suffix) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .numbers__grid.is-armed :global(.stat__label),
    .numbers__grid.is-armed :global(.stat__detail) {
      clip-path: none !important;
      transition: none !important;
    }
  }
</style>
