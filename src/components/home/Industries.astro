---
import { ArrowUpRight } from '@lucide/astro';
import SectionHead from '../ui/SectionHead.astro';
import { industries } from '../../data/content';
---

<section id="industries" class="section industries">
  <div class="container industries__layout">
    <SectionHead
      title="Buildings we plan for."
      intro="Every type of building has its own constraints, like operating hours, compliance rules and size. We plan the install around them."
    />

    <ul role="list" class="industries__grid" data-schedule>
      {industries.map((ind, i) => (
        <li class="industry" style={`--i: ${i}`}>
          <a href={`/industries/#${ind.slug}`} class="industry__link">
            <h3 class="t-h4 industry__name">{ind.name}</h3>
            <p class="t-small industry__need">{ind.need}</p>
            <ArrowUpRight class="industry__arrow" size={18} stroke-width={1.5} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Rows write in one after another the first time the sheet is seen. Without this script, or
  // under reduced motion, the sheet is never armed and shows its final state.
  import { onFirstView, reduceMotion } from '../../scripts/demo';

  const sheet = document.querySelector<HTMLElement>('[data-schedule]');
  if (sheet && !reduceMotion) {
    sheet.classList.add('is-armed');
    onFirstView(sheet, () => sheet.classList.add('is-written'), 0.15);
  }
</script>

<style>
  /*
   * Direction A: the building types are a schedule sheet, like a room schedule on a drawing set.
   * Heading at the left (held in place on desktop), the sheet at the right, one row per type.
   */
  .industries__layout {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
  }

  .industries__grid {
    display: grid;
    background: var(--white);
    padding: var(--sp-2) var(--gutter);
    margin-inline: calc(var(--gutter) * -1);
  }

  /* Hairlines only between rows (rule 5). Drawn as a pseudo-element so it can scale in. */
  .industry {
    position: relative;
  }

  .industry + .industry::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--hairline);
    transform-origin: left center;
  }

  /* Schedule fill-in: line draws (200ms), then name and description write in (320ms), rows 60ms
     apart. Plays once. */
  @media (prefers-reduced-motion: no-preference) {
    .industries__grid.is-armed .industry + .industry::before {
      transform: scaleX(0);
    }

    .industries__grid.is-armed .industry__name,
    .industries__grid.is-armed .industry__need {
      opacity: 0;
      transform: translateX(-8px);
    }

    .industries__grid.is-written .industry + .industry::before {
      animation: sched-line 200ms var(--ease-out) calc(var(--i) * 60ms) both;
    }

    .industries__grid.is-written .industry__name,
    .industries__grid.is-written .industry__need {
      animation: sched-text 320ms var(--ease-out) calc(var(--i) * 60ms + 120ms) both;
    }
  }

  @keyframes sched-line {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes sched-text {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .industry__link {
    position: relative;
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-5) var(--sp-7) var(--sp-5) 0;
    transition: color var(--dur-fast) ease;
  }

  .industry__link:hover .industry__name {
    color: var(--signal);
  }

  .industry__link:focus-visible {
    outline-offset: 2px;
  }

  .industry__name {
    font-size: var(--fs-h3);
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    transition: color var(--dur-fast) ease;
  }

  .industry__need {
    max-width: 34em;
    color: var(--text);
    font-size: var(--fs-body);
  }

  .industry__link :global(.industry__arrow) {
    position: absolute;
    right: 0;
    top: var(--sp-5);
    color: var(--steel);
    transition: transform var(--dur) var(--ease-out), color var(--dur-fast) ease;
  }

  .industry__link:hover :global(.industry__arrow),
  .industry__link:focus-visible :global(.industry__arrow) {
    color: var(--signal);
    transform: translate(3px, -3px);
  }

  @media (min-width: 900px) {
    .industries__grid {
      margin-inline: 0;
      padding: var(--sp-3) var(--sp-7);
    }

    .industry__link {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
      gap: var(--col-gap);
      padding-block: var(--sp-6);
    }

    .industry__link :global(.industry__arrow) {
      top: var(--sp-6);
    }
  }

  @media (min-width: 1024px) {
    .industries__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .industries__layout > :global(.section-head) {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .industries__layout > :global(.section-head .section-head__title) {
      font-size: var(--fs-h1);
    }

    .industries__grid {
      grid-column: 5 / -1;
    }
  }
</style>
