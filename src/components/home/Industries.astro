---
import { ArrowUpRight } from '@lucide/astro';
import SectionHead from '../ui/SectionHead.astro';
import { industries } from '../../data/content';
---

<section id="industries" class="section industries">
  <div class="container industries__layout">
    <SectionHead
      title="Buildings we plan for."
      intro="Every type of building has its own constraints, like operating hours, compliance rules and size. We plan the install around them."
    />

    <ul role="list" class="industries__grid">
      {industries.map((ind) => (
        <li class="industry">
          <a href={`/industries/#${ind.slug}`} class="industry__link">
            <h3 class="t-h4 industry__name">{ind.name}</h3>
            <p class="t-small industry__need">{ind.need}</p>
            <ArrowUpRight class="industry__arrow" size={18} stroke-width={1.5} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /*
   * Direction A: the building types are a schedule sheet, like a room schedule on a drawing set.
   * Heading at the left (held in place on desktop), the sheet at the right, one row per type.
   */
  .industries__layout {
    display: grid;
    gap: var(--sp-6) var(--col-gap);
  }

  .industries__grid {
    display: grid;
    background: var(--white);
    padding: var(--sp-2) var(--gutter);
    margin-inline: calc(var(--gutter) * -1);
  }

  /* Hairlines only between rows (rule 5) */
  .industry + .industry {
    border-top: 1px solid var(--hairline);
  }

  .industry__link {
    position: relative;
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-5) var(--sp-7) var(--sp-5) 0;
    transition: color var(--dur-fast) ease;
  }

  .industry__link:hover .industry__name {
    color: var(--signal);
  }

  .industry__link:focus-visible {
    outline-offset: 2px;
  }

  .industry__name {
    font-size: var(--fs-h3);
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    transition: color var(--dur-fast) ease;
  }

  .industry__need {
    max-width: 34em;
    color: var(--text);
    font-size: var(--fs-body);
  }

  .industry__link :global(.industry__arrow) {
    position: absolute;
    right: 0;
    top: var(--sp-5);
    color: var(--steel);
    transition: transform var(--dur) var(--ease-out), color var(--dur-fast) ease;
  }

  .industry__link:hover :global(.industry__arrow),
  .industry__link:focus-visible :global(.industry__arrow) {
    color: var(--signal);
    transform: translate(3px, -3px);
  }

  @media (min-width: 900px) {
    .industries__grid {
      margin-inline: 0;
      padding: var(--sp-3) var(--sp-7);
    }

    .industry__link {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
      gap: var(--col-gap);
      padding-block: var(--sp-6);
    }

    .industry__link :global(.industry__arrow) {
      top: var(--sp-6);
    }
  }

  @media (min-width: 1024px) {
    .industries__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .industries__layout > :global(.section-head) {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .industries__layout > :global(.section-head .section-head__title) {
      font-size: var(--fs-h1);
    }

    .industries__grid {
      grid-column: 5 / -1;
    }
  }
</style>
