---
import SectionHead from '../ui/SectionHead.astro';
import { industries } from '../../data/content';
---

<section id="industries" class="section industries">
  <div class="container">
    <SectionHead
      title="Buildings we plan for."
      intro="Every type of building has its own constraints, like operating hours, compliance rules and size. We plan the install around them."
    />

    <ul role="list" class="industries__grid" data-reveal-group>
      {industries.map((ind) => (
        <li class="industry">
          <a href={`/industries/#${ind.slug}`} class="industry__link">
            <h3 class="t-h3 industry__name">{ind.name}</h3>
            <p class="industry__need">{ind.need}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Eight building types, two columns (four on wide screens), separated by space only */
  .industries__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-7) var(--sp-5);
  }

  .industry__link {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    height: 100%;
  }

  .industry__need {
    max-width: 28em;
    font-size: var(--fs-small);
    color: var(--text);
  }

  @media (hover: hover) and (pointer: fine) {
    .industry__link:hover .industry__name {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  @media (max-width: 520px) {
    .industries__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 900px) {
    .industries__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--sp-8) var(--sp-6);
    }
  }
</style>
