---
/**
 * Blueprint-style cutaway of a 3-storey commercial building.
 * Each system is a <g data-layer="{service slug}"> that BuildingExplorer highlights.
 *
 * Coordinate notes (viewBox 880×620):
 *   building x 140–740 · ceilings L3 130 / L2 274 / L1 419 · floors L3 266 / L2 411 / L1 560
 *   cable trays run at ceiling + 10 · riser at x 195 from the MDF rack up to L3
 *
 * B7, "years from now" (BuildingExplorer sets data-when="later" on the svg). What changes is drawn in ink, what
 * stays in blue. (a) Two open-office desks slide into a group of three and leave a dashed ghost; (b) the L3 office
 * access point, the conference display and an outside camera fade out and new ones appear; (c) the riser, the trays
 * and every untouched drop trace once, and the numbered marks fade in one by one. The numbers come from the
 * explorer's "Put in on day one for later" list (`laterNums`), so the drawing never shows a number the list does not.
 * CSS transitions only (transform, opacity, stroke-dashoffset): flipping back turns round from wherever things are,
 * and reduced motion shows the end state at once. Later-view text and numbers are sized in screen pixels via --u
 * (fitSvgText), so they stay readable on a phone.
 */

import { services, type ServiceSlug } from '../../data/site';
import type { SignatureKey } from '../../data/content';

interface Props {
  /** B7: the number each "put in on day one for later" item carries in BuildingExplorer's list ('01', '02', …).
   *  Only keys given here get a numbered mark in the drawing. */
  laterNums?: Partial<Record<SignatureKey, string>>;
}
const { laterNums = {} } = Astro.props;

const L3 = { ceil: 130, floor: 266 };
const L2 = { ceil: 274, floor: 411 };
const L1 = { ceil: 419, floor: 560 };
const tray = (ceil: number) => ceil + 10;

// Desks: [x, floorY]
const desksL3 = [175, 280, 380].map((x) => [x, L3.floor]);
const desksL2 = [255, 355, 455, 555, 655].map((x) => [x, L2.floor]);
const desks = [...desksL3, ...desksL2];

// B7: in the "years from now" view two open-office desks slide right into a group of three with the desk at 655
// (index into `desks` → viewBox units). Their phones, drops and jack dots go with them: with zone cabling a desk
// moves with a short new run, so those two drops turn ink (new) while every other run stays blue (same cable).
const deskMoves: Record<number, number> = { 5: 72, 6: 36 };
const dxOf = (i: number) => deskMoves[i] ?? 0;
const dxStyle = (i: number) => (dxOf(i) ? `--dx:${dxOf(i)}px` : undefined);
// The dashed ghost marks where the desk at 455 stood. The one at 555 moves only 36 and its old place is covered by
// the new group, so it gets none.
const ghost = { x: 455, f: L2.floor };

// Wi-Fi access points: [x, ceilY]
const aps = [
  [330, L3.ceil],
  [640, L3.ceil],
  [400, L2.ceil],
  [610, L2.ceil],
  [470, L1.ceil],
];

const wifiArcs = (x: number, c: number) => [
  `M${x - 9} ${c + 26} Q${x} ${c + 33} ${x + 9} ${c + 26}`,
  `M${x - 16} ${c + 31} Q${x} ${c + 43} ${x + 16} ${c + 31}`,
];

// Cable drops: [x, y of the device end, y of the tray it rises to]. Drawn in the cabling layer, and
// counted for the room routes below, so the callout numbers always match what is on the drawing.
type Drop = { x: number; y: number; tray: number };
const drops: Drop[] = [
  ...desks.map(([x, f]) => ({ x: x + 50, y: f - 34, tray: tray(f === L3.floor ? L3.ceil : L2.ceil) })),
  { x: 300, y: 455, tray: tray(L1.ceil) },
  { x: 512, y: 526, tray: tray(L1.ceil) },
  { x: 615, y: 154, tray: tray(L3.ceil) },
];
const deskDots = [...desks.map(([x, f]) => [x + 50, f - 34]), [512, 526]];

type Box = [number, number, number, number];
/**
 * Rooms for the mouse-hover lookup. `systems` is read off this drawing: a system is listed only if
 * some element of its layer is drawn inside the room's bounds (or its trunk/riser runs through it).
 * Bounds: [x, y, w, h] in viewBox units, matching the walls above.
 * `routed` rooms draw their cables back to `closet` (B1); the closets themselves and the break room do not.
 */
// Names in sentence case, as drawn on the plan; the two closets keep their codes.
const rooms: { id: string; name: string; box: Box; systems: ServiceSlug[]; routed: boolean; closet: 'IDF-2' | 'MDF' }[] = [
  { id: 'offices', name: 'Offices', box: [140, 130, 330, 136], systems: ['structured-cabling', 'networking', 'voip-unified-comms'], routed: true, closet: 'IDF-2' },
  { id: 'conference', name: 'Conference', box: [470, 130, 270, 136], systems: ['structured-cabling', 'networking', 'access-control', 'voip-unified-comms', 'audio-video'], routed: true, closet: 'IDF-2' },
  { id: 'idf-2', name: 'IDF-2', box: [140, 274, 85, 137], systems: ['structured-cabling', 'networking'], routed: false, closet: 'IDF-2' },
  { id: 'open-office', name: 'Open office', box: [225, 274, 515, 137], systems: ['structured-cabling', 'networking', 'video-surveillance', 'voip-unified-comms'], routed: true, closet: 'IDF-2' },
  { id: 'mdf', name: 'MDF', box: [140, 419, 110, 141], systems: ['structured-cabling', 'networking', 'video-surveillance'], routed: false, closet: 'MDF' },
  { id: 'lobby', name: 'Lobby', box: [250, 419, 320, 141], systems: ['structured-cabling', 'networking', 'video-surveillance', 'access-control', 'voip-unified-comms', 'audio-video'], routed: true, closet: 'MDF' },
  { id: 'break-room', name: 'Break room', box: [570, 419, 170, 141], systems: ['structured-cabling', 'access-control', 'voip-unified-comms', 'audio-video'], routed: false, closet: 'MDF' },
];
const codes = (slugs: ServiceSlug[]) => slugs.map((sl) => services.find((x) => x.slug === sl)!.code).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

const inBox = (x: number, y: number, b: Box) => x >= b[0] && x <= b[0] + b[2] && y >= b[1] && y <= b[1] + b[3];

// Where each routed room's note sits: a leader line, then two lines of text. `anchor` is the text's side.
const notes: Record<string, { leader: string; x: number; y: number; anchor?: 'end' }> = {
  offices: { leader: 'M236 140 V186', x: 242, y: 188 },
  conference: { leader: 'M598 98 V140', x: 590, y: 92, anchor: 'end' },
  'open-office': { leader: 'M231 284 V330', x: 238, y: 334 },
  lobby: { leader: 'M262 586 V560', x: 268, y: 600 },
};
const sentence = (s: string) => s.charAt(0) + s.slice(1).toLowerCase();

const routes = rooms
  .filter((r) => r.routed)
  .map((r) => {
    const ds = drops.filter((d) => inBox(d.x, d.tray, r.box));
    const apCount = aps.filter(([x, c]) => inBox(x, c, r.box)).length;
    const far = ds.reduce((a, d) => (d.x > a.x ? d : a), ds[0]);
    const toY = r.closet === 'MDF' ? 465 : 326; // the MDF rack top, or the IDF-2 cabinet top
    const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
    return {
      ...r,
      label: sentence(r.name),
      dropCount: ds.length,
      apCount,
      dropsPath: ds.map((d) => `M${d.x} ${d.y} V${d.tray}`).join(' '),
      homePath: `M${far.x} ${far.tray} H195 V${toY}`,
      line1: `${plural(ds.length, 'cable drop')}, ${plural(apCount, 'access point')}`,
      note: notes[r.id],
    };
  });

// B7: what stays. Every run that nobody touched gets a soft blue band that traces it once: the riser from the MDF
// up, the three trays out from the riser, then the drops (all but the two that moved with their desks).
const stayTrays = [L3, L2, L1].map((lv) => `M195 ${tray(lv.ceil)} H726`);
const stayDrops = drops.filter((_, i) => !dxOf(i)).map((d) => `M${d.x} ${d.tray} V${d.y}`);

// B7: the numbered marks. `at` is the spot the leader starts from, `n` the number's centre (viewBox units). Placed so
// the numbers, which grow to about 2.2× on a phone (--bs), clear each other, the walls and the ink labels.
const keyMarks: { key: SignatureKey; at: [number, number]; n: [number, number] }[] = [
  { key: 'cat6aDefault', at: [615, 150], n: [766, 150] }, // the conference display's drop: same drop, new display
  { key: 'twoDropsPerAp', at: [352, 156], n: [382, 168] }, // the second cable beside the new L3 office access point
  { key: 'spareFiberStrands', at: [183, 403], n: [114, 403] }, // spare strands between the IDF-2 cabinet and the MDF rack
  { key: 'emptyConduit', at: [205, 310], n: [114, 310] }, // the empty conduit beside the riser
  { key: 'zoneCabling', at: [480, 291], n: [480, 314] }, // the zone point in the open-office ceiling
  { key: 'ceilingGridJacks', at: [660, 293], n: [676, 316] }, // a spare jack in the open-office ceiling
  { key: 'labelsAndAsBuilts', at: [173, 474], n: [114, 458] }, // the labeled patch panels in the MDF rack
];
const keyed = keyMarks
  .filter((m) => laterNums[m.key])
  .map((m) => ({ ...m, num: laterNums[m.key]!, i: Math.max(0, Number(laterNums[m.key]) - 1) }));
---

<svg class="bx" viewBox="0 0 880 620" xmlns="http://www.w3.org/2000/svg" role="img" data-fit-text aria-label="Cutaway drawing of a three-storey commercial building showing where each of the six systems runs: cabling, networking and Wi-Fi, cameras, access control, phones, and audio-video. The system selected in the tabs is highlighted. Choosing a room shows how its cables run back to the wiring closet that serves it, and the Today and Years from now switch shows what changes in a building over time and what stays." focusable="false">
  <defs>
    <pattern id="bx-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="8" class="bx-hatch-line" />
    </pattern>
  </defs>

  <!-- Drawing sheet: title on the left, the system on view on the right (no background grid: it named nothing) -->
  <text x="40" y="52" class="bx-sheet">Typical commercial building</text>
  <text x="840" y="52" class="bx-sheet bx-end" data-bx-layer-name>All systems</text>

  <!-- ───────────── Structure (always visible) ───────────── -->
  <g class="bx-structure">
    <rect x="40" y="560" width="800" height="22" fill="url(#bx-hatch)" class="bx-ground-fill" />
    <line x1="40" y1="560" x2="840" y2="560" class="bx-struct" />

    <rect x="610" y="98" width="80" height="22" class="bx-struct" />
    <line x1="622" y1="104" x2="622" y2="116" class="bx-furn" />
    <line x1="634" y1="104" x2="634" y2="116" class="bx-furn" />
    <line x1="646" y1="104" x2="646" y2="116" class="bx-furn" />
    <rect x="132" y="120" width="616" height="10" class="bx-slab" />

    <rect x="140" y="130" width="600" height="430" class="bx-struct" />
    <rect x="140" y="266" width="600" height="8" class="bx-slab" />
    <rect x="140" y="411" width="600" height="8" class="bx-slab" />

    <!-- interior walls -->
    <line x1="470" y1="130" x2="470" y2="266" class="bx-struct" />
    <line x1="225" y1="274" x2="225" y2="411" class="bx-struct" />
    <line x1="250" y1="419" x2="250" y2="560" class="bx-struct" />
    <line x1="570" y1="419" x2="570" y2="560" class="bx-struct" />

    <!-- level tags -->
    <g class="bx-tag">
      <text x="104" y="203">L3</text>
      <text x="104" y="347">L2</text>
      <text x="104" y="494">L1</text>
      <line x1="124" y1="198" x2="134" y2="198" />
      <line x1="124" y1="342" x2="134" y2="342" />
      <line x1="124" y1="489" x2="134" y2="489" />
    </g>

    <!-- furniture (the two desks in deskMoves slide in the "years from now" view) -->
    {desks.map(([x, f], i) => (
      <g class:list={['bx-furn bx-desk', { 'bx-mv': dxOf(i) > 0 }]} style={dxStyle(i)} data-desk>
        <rect x={x} y={f - 34} width="64" height="4" />
        <line x1={x + 4} y1={f - 30} x2={x + 4} y2={f} />
        <line x1={x + 60} y1={f - 30} x2={x + 60} y2={f} />
        <rect x={x + 18} y={f - 58} width="26" height="18" />
        <line x1={x + 31} y1={f - 40} x2={x + 31} y2={f - 34} />
      </g>
    ))}
    <g class="bx-furn">
      <!-- conference table -->
      <rect x="530" y="232" width="170" height="5" />
      <line x1="540" y1="237" x2="540" y2="266" />
      <line x1="690" y1="237" x2="690" y2="266" />
      <!-- reception counter -->
      <rect x="470" y="526" width="84" height="34" />
      <!-- break room table -->
      <rect x="640" y="526" width="70" height="4" />
      <line x1="646" y1="530" x2="646" y2="560" />
      <line x1="704" y1="530" x2="704" y2="560" />
    </g>

    <!-- doors -->
    <rect x="330" y="470" width="36" height="90" class="bx-door" />
    <rect x="366" y="470" width="36" height="90" class="bx-door" />
    <rect x="484" y="178" width="34" height="88" class="bx-door" />

    <!-- MDF rack + IDF cabinet shells -->
    <rect x="165" y="465" width="60" height="95" class="bx-door" />
    <rect x="150" y="326" width="60" height="70" class="bx-door" />
  </g>

  <!-- ───────────── B7, what stays and what moved: drawn under the system layers, shown only in the "years from now" view ───────────── -->
  <g class="bx-stay" aria-hidden="true">
    <g class="bx-glows">
      <path class="bx-glow bx-glow--riser" pathLength="1" d={`M195 465 V${tray(L3.ceil)}`} />
      {stayTrays.map((d) => <path class="bx-glow bx-glow--tray" pathLength="1" d={d} />)}
      {stayDrops.map((d) => <path class="bx-glow bx-glow--drop" pathLength="1" d={d} />)}
      <!-- the MDF patch panels -->
      <rect class="bx-glow-box" x="167" y="467" width="56" height="22" />
    </g>
  </g>
  <g class="bx-ghosts" aria-hidden="true">
    <g class="bx-ghost">
      <rect x={ghost.x} y={ghost.f - 34} width="64" height="4" />
      <line x1={ghost.x + 4} y1={ghost.f - 30} x2={ghost.x + 4} y2={ghost.f} />
      <line x1={ghost.x + 60} y1={ghost.f - 30} x2={ghost.x + 60} y2={ghost.f} />
      <rect x={ghost.x + 18} y={ghost.f - 58} width="26" height="18" />
      <line x1={ghost.x + 31} y1={ghost.f - 40} x2={ghost.x + 31} y2={ghost.f - 34} />
    </g>
  </g>

  <!-- ───────────── A-01 Structured cabling ───────────── -->
  <g class="bx-layer" data-layer="structured-cabling">
    <path class="bx-trunk" d={`M195 465 V${tray(L3.ceil)}`} />
    <path class="bx-trunk" d={`M195 ${tray(L3.ceil)} H726`} />
    <path class="bx-trunk" d={`M195 ${tray(L2.ceil)} H726`} />
    <path class="bx-trunk" d={`M195 ${tray(L1.ceil)} H726`} />
    {drops.map((d, i) => <path class:list={['bx-drop', { 'bx-mv': dxOf(i) > 0 }]} style={dxStyle(i)} d={`M${d.x} ${d.tray} V${d.y}`} />)}
    {deskDots.map(([x, y], i) => (
      <circle class:list={['bx-dot', { 'bx-mv': dxOf(i) > 0 }]} style={dxStyle(i)} cx={x} cy={y} r="2.5" />
    ))}
    <!-- ISP fiber entrance -->
    <path class="bx-fiber" d="M165 545 H58" />
    <text x="40" y="536" class="bx-callout">ISP fiber</text>
    <g class="bx-fill">
      <rect x="171" y="471" width="48" height="5" />
      <rect x="171" y="480" width="48" height="5" />
    </g>
  </g>

  <!-- ───────────── A-02 Networking & wireless ───────────── -->
  <g class="bx-layer" data-layer="networking">
    <g class="bx-fill">
      <rect x="171" y="492" width="48" height="7" />
      <rect x="171" y="503" width="48" height="7" />
      <rect x="156" y="336" width="48" height="7" />
      <rect x="156" y="347" width="48" height="7" />
      <!-- UPS -->
      <rect x="171" y="538" width="48" height="16" />
    </g>
    <!-- the L3 office access point (first) is replaced in the "years from now" view -->
    {aps.map(([x, c], i) => (
      <g class:list={[{ 'bx-old': i === 0 }]} style={i === 0 ? '--d:360ms' : undefined}>
        <rect class="bx-fill" x={x - 12} y={c + 13} width="24" height="5" rx="2" />
        {wifiArcs(x, c).map((d) => <path class="bx-arc" d={d} />)}
      </g>
    ))}
  </g>

  <!-- ───────────── A-03 Video surveillance ───────────── -->
  <g class="bx-layer" data-layer="video-surveillance">
    <!-- exterior, upper left -->
    <polygon class="bx-cone" points="124,158 52,250 104,262" />
    <line x1="140" y1="152" x2="132" y2="152" />
    <rect class="bx-fill" x="116" y="148" width="17" height="9" rx="1.5" />
    <!-- exterior, lower right toward parking (replaced in the "years from now" view) -->
    <g class="bx-old" style="--d:520ms">
      <polygon class="bx-cone" points="760,447 836,540 784,556" />
      <line x1="740" y1="441" x2="748" y2="441" />
      <rect class="bx-fill" x="747" y="437" width="17" height="9" rx="1.5" />
    </g>
    <!-- lobby -->
    <polygon class="bx-cone" points="548,431 420,548 508,556" />
    <line x1="560" y1="419" x2="560" y2="425" />
    <rect class="bx-fill" x="543" y="424" width="17" height="9" rx="1.5" />
    <!-- open office -->
    <polygon class="bx-cone" points="722,287 596,398 688,404" />
    <line x1="735" y1="274" x2="735" y2="280" />
    <rect class="bx-fill" x="718" y="279" width="17" height="9" rx="1.5" />
    <!-- LED perimeter pole -->
    <polygon class="bx-cone bx-cone--light" points="790,444 756,560 828,560" />
    <line x1="812" y1="440" x2="812" y2="560" />
    <line x1="812" y1="440" x2="794" y2="440" />
    <rect class="bx-fill" x="780" y="438" width="18" height="5" rx="1" />
    <!-- NVR -->
    <rect class="bx-fill" x="171" y="514" width="48" height="7" />
  </g>

  <!-- ───────────── A-04 Access control ───────────── -->
  <g class="bx-layer" data-layer="access-control">
    <rect x="330" y="470" width="72" height="90" class="bx-outline" />
    <rect class="bx-fill" x="356" y="465" width="20" height="4" />
    <rect class="bx-fill" x="409" y="504" width="9" height="15" rx="1.5" />
    <rect x="484" y="178" width="34" height="88" class="bx-outline" />
    <rect class="bx-fill" x="523" y="212" width="8" height="13" rx="1.5" />
    <!-- time clock -->
    <rect x="596" y="468" width="20" height="26" rx="1.5" class="bx-outline" />
    <rect class="bx-fill" x="600" y="472" width="12" height="7" />
  </g>

  <!-- ───────────── A-05 Voice & unified comms ───────────── -->
  <g class="bx-layer" data-layer="voip-unified-comms">
    <!-- desk phones: base + handset (they move with their desks) -->
    {desks.map(([x, f], i) => (
      <g class:list={['bx-desk', { 'bx-mv': dxOf(i) > 0 }]} style={dxStyle(i)}>
        <rect class="bx-fill" x={x + 48} y={f - 44} width="16" height="10" rx="2" />
        <rect class="bx-fill" x={x + 46} y={f - 49} width="20" height="4" rx="2" />
      </g>
    ))}
    <!-- reception phone -->
    <rect class="bx-fill" x="476" y="514" width="18" height="10" rx="2" />
    <rect class="bx-fill" x="474" y="509" width="22" height="4" rx="2" />
    <!-- conference speakerphone -->
    <path class="bx-fill" d="M600 232 L606 222 H624 L630 232 Z" />
    <!-- paging horns L1 + L2 -->
    <path class="bx-fill" d="M626 421 H654 L661 436 H619 Z" />
    <path class="bx-arc" d="M626 444 Q640 453 654 444" />
    <path class="bx-arc" d="M618 451 Q640 465 662 451" />
    <path class="bx-fill" d="M498 276 H522 L528 289 H492 Z" />
    <path class="bx-arc" d="M498 297 Q510 305 522 297" />
  </g>

  <!-- ───────────── A-06 Audio & video ───────────── -->
  <g class="bx-layer" data-layer="audio-video">
    <!-- conference display (replaced in the "years from now" view) + soundbar + camera -->
    <rect x="560" y="152" width="110" height="58" class="bx-outline bx-screen bx-old" style="--d:440ms" />
    <rect class="bx-fill" x="585" y="213" width="60" height="6" rx="1.5" />
    <rect class="bx-fill" x="609" y="146" width="12" height="5" rx="1" />
    <!-- ceiling speakers -->
    {[[520, L3.ceil], [700, L3.ceil], [300, L1.ceil], [520, L1.ceil]].map(([x, c]) => (
      <g>
        <rect class="bx-fill" x={x - 9} y={c + 13} width="18" height="5" rx="1" />
        <path class="bx-arc" d={`M${x - 7} ${c + 25} Q${x} ${c + 31} ${x + 7} ${c + 25}`} />
      </g>
    ))}
    <!-- lobby signage + break room display -->
    <rect x="268" y="455" width="56" height="34" class="bx-outline bx-screen" />
    <rect x="652" y="466" width="50" height="30" class="bx-outline bx-screen" />
  </g>

  <!-- Room names: drawn over the system layers with a white halo, so a cable passes behind a name instead of
       through it (the way text breaks a line on a drawing). Sentence case in the text face; the closet codes in mono. -->
  <g class="bx-label">
    <text x="150" y="168">Offices</text>
    <text x="482" y="168">Conference</text>
    <text x="150" y="306" class="bx-mono">IDF-2</text>
    <text x="237" y="306">Open office</text>
    <text x="150" y="451" class="bx-mono">MDF</text>
    <text x="262" y="451">Lobby</text>
    <text x="582" y="451">Break room</text>
  </g>

  <!-- ───────────── B1 room routes: one per routed room, outside every layer so the layer draw-in never touches them.
       Hidden until the explorer script shows one. Numbers come from the drops and aps arrays above. ───────────── -->
  <g class="bx-routes">
    {routes.map((r) => (
      <g class="bx-route" data-route={r.id} data-label={r.label} data-closet={r.closet} data-drops={r.dropCount} data-aps={r.apCount} aria-hidden="true">
        <path class="bx-route-halo bx-r-drops" pathLength="1" d={r.dropsPath} />
