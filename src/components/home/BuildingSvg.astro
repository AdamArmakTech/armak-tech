---
/**
 * Blueprint-style cutaway of a 3-storey commercial building.
 * Each system is a <g data-layer="{service slug}"> that BuildingExplorer highlights.
 *
 * Coordinate notes (viewBox 880×620):
 *   building x 140–740 · ceilings L3 130 / L2 274 / L1 419 · floors L3 266 / L2 411 / L1 560
 *   cable trays run at ceiling + 10 · riser at x 195 from the MDF rack up to L3
 *
 * Closets: the MDF rack (L1) and the IDF-2 cabinet (L2) each hold a patch panel at the top and a UPS at the bottom.
 * The backbone between them is fiber in a white jacket (x 182); the horizontal cabling (closet to outlet) is solid:
 * MDF to the L1 tray, IDF-2 to the L2 and L3 trays, all up the riser at x 195. The carrier's fiber comes in through a
 * conduit sleeve in the wall to a demarc on the MDF backboard, and an orange hand-off cord runs to the firewall.
 *
 * B7, "years from now" (BuildingExplorer sets data-when="later" on the svg). What changes is drawn in ink, what
 * stays in blue. A numbered sequence, one beat per item of the explorer's "Put in on day one for later" list
 * (`laterNums`, so the drawing never shows a number the list does not), in its order:
 *   Cat 6A          the conference display is swapped on the same drop (the drop traces blue)
 *   Two cables/AP   the L3 office access point is replaced; its second cable lights blue up to the new one
 *   Spare fiber     one more white strand lights beside the backbone, MDF up to IDF-2
 *   Empty conduit   the conduit beside the riser, its pull string, then a new ink cable pulled up through it
 *   Zone cabling    two desks slide; the old drops go, short ink runs come from the zone box, the home run stays blue
 *   Ceiling jacks   a new camera clips onto a ceiling jack, with no new run
 *   Labels          the label strips on the MDF and IDF-2 panels tick in
 * then a last beat traces every untouched run (risers, backbone, trays, drops) once. CSS transitions only
 * (transform, opacity, stroke-dashoffset), stepped by classes the explorer adds: flipping back turns round from
 * wherever things are, and reduced motion shows the finished picture at once. Later-view text and numbers are sized
 * in screen pixels via --u (fitSvgText), so they stay readable on a phone.
 */

import { services, type ServiceSlug } from '../../data/site';
import type { SignatureKey } from '../../data/content';

interface Props {
  /** B7: the number each "put in on day one for later" item carries in BuildingExplorer's list ('01', '02', …).
   *  Only keys given here get a numbered mark in the drawing. */
  laterNums?: Partial<Record<SignatureKey, string>>;
}
const { laterNums = {} } = Astro.props;

const L3 = { ceil: 130, floor: 266 };
const L2 = { ceil: 274, floor: 411 };
const L1 = { ceil: 419, floor: 560 };
const tray = (ceil: number) => ceil + 10;

// Desks: [x, floorY]
const desksL3 = [175, 280, 380].map((x) => [x, L3.floor]);
const desksL2 = [255, 355, 455, 555, 655].map((x) => [x, L2.floor]);
const desks = [...desksL3, ...desksL2];

// B7, the "years from now" view is a numbered sequence (BuildingExplorer steps it, about 9 s). Beat n is the item
// numbered n in the explorer's "Put in on day one for later" list; every piece that belongs to beat n carries
// `bx-k bx-k{n}` and waits until the explorer puts `bx-b{n}` on the svg. The beat after the last number (closeBeat)
// traces what stays. A piece's own start inside its beat is `--t` (ms); see the B7 CSS below for the roles.
const beatNums = Object.values(laterNums).map(Number).filter((n) => n > 0);
const closeBeat = (beatNums.length ? Math.max(...beatNums) : 0) + 1;
const beatOf = (key: SignatureKey) => (laterNums[key] ? Number(laterNums[key]) : closeBeat);
const kc = (b: number) => `bx-k bx-k${b}`;
const B = {
  display: beatOf('cat6aDefault'),
  ap: beatOf('twoDropsPerAp'),
  zone: beatOf('zoneCabling'),
  cam: beatOf('ceilingGridJacks'),
  close: closeBeat,
};
const hasZone = Boolean(laterNums.zoneCabling);
const hasCam = Boolean(laterNums.ceilingGridJacks);

// B7: in the "years from now" view two open-office desks slide right into a group of three with the desk at 655
// (index into `desks` → viewBox units). With zone cabling a desk moves with a short new run: the two old drops go,
// and new ink runs come from the zone box in the ceiling while the home run back to the closet stays blue.
const deskMoves: Record<number, number> = { 5: 72, 6: 36 };
const dxOf = (i: number) => deskMoves[i] ?? 0;
const dxStyle = (i: number) => (dxOf(i) ? `--dx:${dxOf(i)}px;--t:300ms` : undefined);
const moveCls = (i: number, ink = false) => (dxOf(i) ? `${kc(B.zone)} bx-slide${ink ? ' bx-ink' : ''}` : false);
// The dashed ghost marks where the desk at 455 stood. The one at 555 moves only 36 and its old place is covered by
// the new group, so it gets none.
const ghost = { x: 455, f: L2.floor };

// Wi-Fi access points: [x, ceilY]
const aps = [
  [330, L3.ceil],
  [640, L3.ceil],
  [400, L2.ceil],
  [610, L2.ceil],
  [470, L1.ceil],
];

const wifiArcs = (x: number, c: number) => [
  `M${x - 9} ${c + 26} Q${x} ${c + 33} ${x + 9} ${c + 26}`,
  `M${x - 16} ${c + 31} Q${x} ${c + 43} ${x + 16} ${c + 31}`,
];

// Cable drops: [x, y of the device end, y of the tray it rises to]. Drawn in the cabling layer, and
// counted for the room routes below, so the callout numbers always match what is on the drawing.
type Drop = { x: number; y: number; tray: number };
const drops: Drop[] = [
  ...desks.map(([x, f]) => ({ x: x + 50, y: f - 34, tray: tray(f === L3.floor ? L3.ceil : L2.ceil) })),
  { x: 300, y: 455, tray: tray(L1.ceil) },
  { x: 512, y: 526, tray: tray(L1.ceil) },
  { x: 615, y: 154, tray: tray(L3.ceil) },
];
const deskDots = [...desks.map(([x, f]) => [x + 50, f - 34]), [512, 526]];

type Box = [number, number, number, number];
/**
 * Rooms for the mouse-hover lookup. `systems` is read off this drawing: a system is listed only if
 * some element of its layer is drawn inside the room's bounds (or its trunk/riser runs through it).
 * Bounds: [x, y, w, h] in viewBox units, matching the walls above.
 * `routed` rooms draw their cables back to `closet` (B1); the closets themselves and the break room do not.
 */
// Names in sentence case, as drawn on the plan; the two closets keep their codes.
const rooms: { id: string; name: string; box: Box; systems: ServiceSlug[]; routed: boolean; closet: 'IDF-2' | 'MDF' }[] = [
  { id: 'offices', name: 'Offices', box: [140, 130, 330, 136], systems: ['structured-cabling', 'networking', 'voip-unified-comms'], routed: true, closet: 'IDF-2' },
  { id: 'conference', name: 'Conference', box: [470, 130, 270, 136], systems: ['structured-cabling', 'networking', 'access-control', 'voip-unified-comms', 'audio-video'], routed: true, closet: 'IDF-2' },
  { id: 'idf-2', name: 'IDF-2', box: [140, 274, 85, 137], systems: ['structured-cabling', 'networking'], routed: false, closet: 'IDF-2' },
  { id: 'open-office', name: 'Open office', box: [225, 274, 515, 137], systems: ['structured-cabling', 'networking', 'video-surveillance', 'voip-unified-comms'], routed: true, closet: 'IDF-2' },
  { id: 'mdf', name: 'MDF', box: [140, 419, 110, 141], systems: ['structured-cabling', 'networking', 'video-surveillance'], routed: false, closet: 'MDF' },
  { id: 'lobby', name: 'Lobby', box: [250, 419, 320, 141], systems: ['structured-cabling', 'networking', 'video-surveillance', 'access-control', 'voip-unified-comms', 'audio-video'], routed: true, closet: 'MDF' },
  { id: 'break-room', name: 'Break room', box: [570, 419, 170, 141], systems: ['structured-cabling', 'access-control', 'voip-unified-comms', 'audio-video'], routed: false, closet: 'MDF' },
];
const codes = (slugs: ServiceSlug[]) => slugs.map((sl) => services.find((x) => x.slug === sl)!.code).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

const inBox = (x: number, y: number, b: Box) => x >= b[0] && x <= b[0] + b[2] && y >= b[1] && y <= b[1] + b[3];

// Where each routed room's note sits: a leader line, then two lines of text. `anchor` is the text's side.
const notes: Record<string, { leader: string; x: number; y: number; anchor?: 'end' }> = {
  offices: { leader: 'M236 140 V186', x: 242, y: 188 },
  conference: { leader: 'M598 98 V140', x: 590, y: 92, anchor: 'end' },
  'open-office': { leader: 'M231 284 V330', x: 238, y: 334 },
  lobby: { leader: 'M262 586 V560', x: 268, y: 600 },
};
const sentence = (s: string) => s.charAt(0) + s.slice(1).toLowerCase();

const routes = rooms
  .filter((r) => r.routed)
  .map((r) => {
    const ds = drops.filter((d) => inBox(d.x, d.tray, r.box));
    const apCount = aps.filter(([x, c]) => inBox(x, c, r.box)).length;
    const far = ds.reduce((a, d) => (d.x > a.x ? d : a), ds[0]);
    const toY = r.closet === 'MDF' ? 465 : 326; // the MDF rack top, or the IDF-2 cabinet top
    const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
    return {
      ...r,
      label: sentence(r.name),
      dropCount: ds.length,
      apCount,
      dropsPath: ds.map((d) => `M${d.x} ${d.y} V${d.tray}`).join(' '),
      homePath: `M${far.x} ${far.tray} H195 V${toY}`,
      line1: `${plural(ds.length, 'cable drop')}, ${plural(apCount, 'access point')}`,
      note: notes[r.id],
    };
  });

// B7: what stays. Every run that nobody touched gets a soft blue band that traces it once, in the last beat: the
// risers out of the two closets and the fiber backbone between them, the three trays out from the riser, then the
// drops (all but the two desks that moved, and the conference display's drop, which traces in beat 1: same drop).
const displayDrop = drops[drops.length - 1];
const stayRisers = [`M195 465 V${tray(L1.ceil)}`, `M195 326 V${tray(L3.ceil)}`, 'M182 465 V396'];
const stayTrays = [L3, L2, L1].map((lv) => `M195 ${tray(lv.ceil)} H726`);
const stayDrops = drops.filter((d, i) => !dxOf(i) && d !== displayDrop).map((d) => `M${d.x} ${d.tray} V${d.y}`);

// B7: zone cabling. The zone box sits on the open-office tray at x 472–488; the new short runs leave its underside and
// go to the two desks that moved (their jacks end at x 577 and 641, y 377).
const zoneRuns = [
  { from: 486, y: 295, to: 505 + dxOf(5) },
  { from: 482, y: 298, to: 605 + dxOf(6) },
].map((r) => `M${r.from} 291 V${r.y} H${r.to} V${L2.floor - 34}`);

// B7: the numbered marks. `at` is the spot the leader starts from, `n` the number's centre (viewBox units). Placed so
// the numbers, which grow to about 2.2× on a phone (--bs), clear each other, the walls and the ink labels.
// `m` is when, inside the item's beat, the dot and leader appear (the number follows 200 ms later).
const keyMarks: { key: SignatureKey; at: [number, number]; n: [number, number]; m: number }[] = [
  { key: 'cat6aDefault', at: [615, 150], n: [766, 150], m: 400 }, // the conference display's drop: same drop, new display
  { key: 'twoDropsPerAp', at: [380, 148], n: [404, 172], m: 640 }, // the second cable to the new L3 office access point
  { key: 'spareFiberStrands', at: [188, 403], n: [114, 403], m: 360 }, // a spare strand between the IDF-2 cabinet and the MDF rack
  { key: 'emptyConduit', at: [215, 310], n: [114, 310], m: 500 }, // the empty conduit beside the riser
  { key: 'zoneCabling', at: [476, 291], n: [480, 314], m: 120 }, // the zone box in the open-office ceiling
  { key: 'ceilingGridJacks', at: [444, 291], n: [452, 360], m: 160 }, // the ceiling jack the new camera clips onto
  { key: 'labelsAndAsBuilts', at: [173, 474], n: [114, 458], m: 0 }, // the labeled patch panels in the MDF rack
];
const keyed = keyMarks
  .filter((m) => laterNums[m.key])
  .map((m) => ({ ...m, num: laterNums[m.key]!, b: Number(laterNums[m.key]) }));
// Label strips on the patch panels, MDF first (two panels), then IDF-2; they tick in left to right, 50 ms apart
const labelTicks = [
  ...[471, 480].flatMap((y) => [176, 190, 204].map((x) => [x, y + 1.5])),
  ...[161, 175, 189].map((x) => [x, 330.5]),
];
---

<svg class="bx" viewBox="0 0 880 620" xmlns="http://www.w3.org/2000/svg" role="img" data-fit-text data-later-close={closeBeat} aria-label="Cutaway drawing of a three-storey commercial building showing where each of the six systems runs: cabling, networking and Wi-Fi, cameras, access control, phones, and audio-video. The system selected in the tabs is highlighted. Choosing a room shows how its cables run back to the wiring closet that serves it, and the Today and Years from now switch shows what changes in a building over time and what stays." focusable="false">
  <defs>
    <pattern id="bx-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="8" class="bx-hatch-line" />
    </pattern>
  </defs>

  <!-- Drawing sheet: title on the left, the system on view on the right (no background grid: it named nothing) -->
  <text x="40" y="52" class="bx-sheet">Typical commercial building</text>
  <text x="840" y="52" class="bx-sheet bx-end" data-bx-layer-name>All systems</text>

  <!-- ───────────── Structure (always visible) ───────────── -->
  <g class="bx-structure">
    <rect x="40" y="560" width="800" height="22" fill="url(#bx-hatch)" class="bx-ground-fill" />
    <line x1="40" y1="560" x2="840" y2="560" class="bx-struct" />

    <rect x="610" y="98" width="80" height="22" class="bx-struct" />
    <line x1="622" y1="104" x2="622" y2="116" class="bx-furn" />
    <line x1="634" y1="104" x2="634" y2="116" class="bx-furn" />
    <line x1="646" y1="104" x2="646" y2="116" class="bx-furn" />
    <rect x="132" y="120" width="616" height="10" class="bx-slab" />

    <rect x="140" y="130" width="600" height="430" class="bx-struct" />
    <rect x="140" y="266" width="600" height="8" class="bx-slab" />
    <rect x="140" y="411" width="600" height="8" class="bx-slab" />

    <!-- interior walls -->
    <line x1="470" y1="130" x2="470" y2="266" class="bx-struct" />
    <line x1="225" y1="274" x2="225" y2="411" class="bx-struct" />
    <line x1="250" y1="419" x2="250" y2="560" class="bx-struct" />
    <line x1="570" y1="419" x2="570" y2="560" class="bx-struct" />

    <!-- level tags -->
    <g class="bx-tag">
      <text x="104" y="203">L3</text>
      <text x="104" y="347">L2</text>
      <text x="104" y="494">L1</text>
      <line x1="124" y1="198" x2="134" y2="198" />
      <line x1="124" y1="342" x2="134" y2="342" />
      <line x1="124" y1="489" x2="134" y2="489" />
    </g>

    <!-- furniture (the two desks in deskMoves slide in the "years from now" view) -->
    {desks.map(([x, f], i) => (
      <g class:list={['bx-furn bx-desk', moveCls(i, true)]} style={dxStyle(i)} data-desk>
        <rect x={x} y={f - 34} width="64" height="4" />
        <line x1={x + 4} y1={f - 30} x2={x + 4} y2={f} />
        <line x1={x + 60} y1={f - 30} x2={x + 60} y2={f} />
        <rect x={x + 18} y={f - 58} width="26" height="18" />
        <line x1={x + 31} y1={f - 40} x2={x + 31} y2={f - 34} />
      </g>
    ))}
    <g class="bx-furn">
      <!-- conference table -->
      <rect x="530" y="232" width="170" height="5" />
      <line x1="540" y1="237" x2="540" y2="266" />
      <line x1="690" y1="237" x2="690" y2="266" />
      <!-- reception counter -->
      <rect x="470" y="526" width="84" height="34" />
      <!-- break room table -->
      <rect x="640" y="526" width="70" height="4" />
      <line x1="646" y1="530" x2="646" y2="560" />
      <line x1="704" y1="530" x2="704" y2="560" />
    </g>

    <!-- doors -->
    <rect x="330" y="470" width="36" height="90" class="bx-door" />
    <rect x="366" y="470" width="36" height="90" class="bx-door" />
    <rect x="484" y="178" width="34" height="88" class="bx-door" />

    <!-- MDF rack + IDF cabinet shells -->
    <rect x="165" y="465" width="60" height="95" class="bx-door" />
    <rect x="150" y="326" width="60" height="70" class="bx-door" />
  </g>

  <!-- ───────────── B7, what stays and what moved: drawn under the system layers, shown only in the "years from now" view ───────────── -->
  <g class="bx-stay" aria-hidden="true">
    <g class="bx-glows">
      <!-- beat 1: the conference display's drop is the same cable -->
      <path class={`bx-glow bx-draw ${kc(B.display)}`} pathLength="1" style="--t:120ms;--dur-in:360ms" d={`M${displayDrop.x} ${displayDrop.tray} V${displayDrop.y}`} />
      <!-- zone cabling: the home run from the IDF-2 up the riser and along the tray to the zone box stays -->
      {hasZone && <path class={`bx-glow bx-draw ${kc(B.zone)}`} pathLength="1" style="--dur-in:440ms" d={`M195 326 V${tray(L2.ceil)} H472`} />}
      <!-- the last beat: everything nobody touched -->
      {stayRisers.map((d) => <path class={`bx-glow bx-draw ${kc(B.close)}`} pathLength="1" style="--dur-in:360ms" d={d} />)}
      {stayTrays.map((d) => <path class={`bx-glow bx-draw ${kc(B.close)}`} pathLength="1" style="--t:240ms;--dur-in:440ms" d={d} />)}
      {stayDrops.map((d) => <path class={`bx-glow bx-draw ${kc(B.close)}`} pathLength="1" style="--t:560ms;--dur-in:300ms" d={d} />)}
      <!-- the patch panels in the MDF rack and the IDF-2 cabinet -->
      <rect class={`bx-glow-box bx-in ${kc(B.close)}`} style="--t:560ms" x="167" y="467" width="56" height="22" />
      <rect class={`bx-glow-box bx-in ${kc(B.close)}`} style="--t:560ms" x="152" y="327" width="56" height="9" />
    </g>
  </g>
  <g class="bx-ghosts" aria-hidden="true">
    <g class={`bx-ghost bx-in ${kc(B.zone)}`} style="--t:200ms">
      <rect x={ghost.x} y={ghost.f - 34} width="64" height="4" />
      <line x1={ghost.x + 4} y1={ghost.f - 30} x2={ghost.x + 4} y2={ghost.f} />
      <line x1={ghost.x + 60} y1={ghost.f - 30} x2={ghost.x + 60} y2={ghost.f} />
      <rect x={ghost.x + 18} y={ghost.f - 58} width="26" height="18" />
      <line x1={ghost.x + 31} y1={ghost.f - 40} x2={ghost.x + 31} y2={ghost.f - 34} />
    </g>
  </g>

  <!-- ───────────── A-01 Structured cabling ───────────── -->
  <g class="bx-layer" data-layer="structured-cabling">
    <!-- Horizontal cabling (closet to outlet): out of the MDF rack to the L1 tray, out of the IDF-2 cabinet to the L2
         and L3 trays, then along the trays and down to each outlet -->
    <path class="bx-trunk" d={`M195 465 V${tray(L1.ceil)}`} />
    <path class="bx-trunk" d={`M195 326 V${tray(L3.ceil)}`} />
    <path class="bx-trunk" d={`M195 ${tray(L3.ceil)} H726`} />
    <path class="bx-trunk" d={`M195 ${tray(L2.ceil)} H726`} />
    <path class="bx-trunk" d={`M195 ${tray(L1.ceil)} H726`} />
    {drops.map((d, i) => (
      <path
        class:list={['bx-drop', dxOf(i) > 0 && (hasZone ? `${kc(B.zone)} bx-out` : moveCls(i, true))]}
        style={dxOf(i) ? (hasZone ? '--t:200ms' : dxStyle(i)) : undefined}
        d={`M${d.x} ${d.tray} V${d.y}`}
      />
    ))}
    {deskDots.map(([x, y], i) => (
      <circle class:list={['bx-dot', moveCls(i, true)]} style={dxStyle(i)} cx={x} cy={y} r="2.5" />
    ))}
    <!-- Backbone (closet to closet): fiber from the MDF rack up to the IDF-2 cabinet, a white jacket (install legend) -->
    <path class="bx-bb-edge" d="M182 465 V396" />
    <path class="bx-bb-core" d="M182 465 V396" />
    <!-- ISP fiber entrance: through a conduit sleeve in the wall to the demarc on the MDF backboard, then an orange
         hand-off cord to the firewall in the rack -->
    <path class="bx-fiber" d="M146 545 H58" />
    <rect class="bx-outline" x="131" y="541" width="14" height="8" />
    <rect class="bx-outline" x="146" y="534" width="15" height="20" />
    <path class="bx-handoff" d="M161 540 C167 540 165 528 171 528" />
    <text x="40" y="536" class="bx-callout">ISP fiber</text>
    <g class="bx-fill">
      <rect x="171" y="471" width="48" height="5" />
      <rect x="171" y="480" width="48" height="5" />
      <!-- IDF-2 patch panel -->
      <rect x="156" y="329" width="48" height="5" />
    </g>
  </g>

  <!-- ───────────── A-02 Networking & wireless ───────────── -->
  <g class="bx-layer" data-layer="networking">
    <g class="bx-fill">
      <rect x="171" y="492" width="48" height="7" />
      <rect x="171" y="503" width="48" height="7" />
      <rect x="156" y="336" width="48" height="7" />
      <rect x="156" y="347" width="48" height="7" />
      <!-- firewall (the carrier hand-off lands here) -->
      <rect x="171" y="525" width="48" height="6" />
      <!-- UPS, MDF and IDF-2 -->
      <rect x="171" y="538" width="48" height="16" />
      <rect x="156" y="377" width="48" height="14" />
    </g>
    <!-- the L3 office access point (first) is replaced in the "years from now" view -->
    {aps.map(([x, c], i) => (
      <g class={i === 0 ? `${kc(B.ap)} bx-out` : undefined}>
        <rect class="bx-fill" x={x - 12} y={c + 13} width="24" height="5" rx="2" />
        {wifiArcs(x, c).map((d) => <path class="bx-arc" d={d} />)}
      </g>
    ))}
  </g>

  <!-- ───────────── A-03 Video surveillance ───────────── -->
  <g class="bx-layer" data-layer="video-surveillance">
    <!-- exterior, upper left -->
    <polygon class="bx-cone" points="124,158 52,250 104,262" />
    <line x1="140" y1="152" x2="132" y2="152" />
    <rect class="bx-fill" x="116" y="148" width="17" height="9" rx="1.5" />
    <!-- exterior, lower right toward parking -->
    <g>
      <polygon class="bx-cone" points="760,447 836,540 784,556" />
      <line x1="740" y1="441" x2="748" y2="441" />
      <rect class="bx-fill" x="747" y="437" width="17" height="9" rx="1.5" />
    </g>
    <!-- lobby -->
    <polygon class="bx-cone" points="548,431 420,548 508,556" />
    <line x1="560" y1="419" x2="560" y2="425" />
    <rect class="bx-fill" x="543" y="424" width="17" height="9" rx="1.5" />
    <!-- open office -->
    <polygon class="bx-cone" points="722,287 596,398 688,404" />
    <line x1="735" y1="274" x2="735" y2="280" />
    <rect class="bx-fill" x="718" y="279" width="17" height="9" rx="1.5" />
    <!-- LED perimeter pole -->
    <polygon class="bx-cone bx-cone--light" points="790,444 756,560 828,560" />
    <line x1="812" y1="440" x2="812" y2="560" />
    <line x1="812" y1="440" x2="794" y2="440" />
    <rect class="bx-fill" x="780" y="438" width="18" height="5" rx="1" />
    <!-- NVR -->
    <rect class="bx-fill" x="171" y="514" width="48" height="7" />
  </g>

  <!-- ───────────── A-04 Access control ───────────── -->
  <g class="bx-layer" data-layer="access-control">
    <rect x="330" y="470" width="72" height="90" class="bx-outline" />
    <rect class="bx-fill" x="356" y="465" width="20" height="4" />
    <rect class="bx-fill" x="409" y="504" width="9" height="15" rx="1.5" />
    <rect x="484" y="178" width="34" height="88" class="bx-outline" />
    <rect class="bx-fill" x="523" y="212" width="8" height="13" rx="1.5" />
    <!-- time clock -->
    <rect x="596" y="468" width="20" height="26" rx="1.5" class="bx-outline" />
    <rect class="bx-fill" x="600" y="472" width="12" height="7" />
  </g>

  <!-- ───────────── A-05 Voice & unified comms ───────────── -->
  <g class="bx-layer" data-layer="voip-unified-comms">
    <!-- desk phones: base + handset (they move with their desks) -->
    {desks.map(([x, f], i) => (
      <g class:list={['bx-desk', moveCls(i)]} style={dxStyle(i)}>
        <rect class="bx-fill" x={x + 48} y={f - 44} width="16" height="10" rx="2" />
        <rect class="bx-fill" x={x + 46} y={f - 49} width="20" height="4" rx="2" />
      </g>
    ))}
    <!-- reception phone -->
    <rect class="bx-fill" x="476" y="514" width="18" height="10" rx="2" />
    <rect class="bx-fill" x="474" y="509" width="22" height="4" rx="2" />
    <!-- conference speakerphone -->
    <path class="bx-fill" d="M600 232 L606 222 H624 L630 232 Z" />
    <!-- paging horns L1 + L2 -->
    <path class="bx-fill" d="M626 421 H654 L661 436 H619 Z" />
    <path class="bx-arc" d="M626 444 Q640 453 654 444" />
    <path class="bx-arc" d="M618 451 Q640 465 662 451" />
    <path class="bx-fill" d="M498 276 H522 L528 289 H492 Z" />
    <path class="bx-arc" d="M498 297 Q510 305 522 297" />
  </g>

  <!-- ───────────── A-06 Audio & video ───────────── -->
  <g class="bx-layer" data-layer="audio-video">
    <!-- conference display (replaced in the "years from now" view) + soundbar + camera -->
    <rect x="560" y="152" width="110" height="58" class={`bx-outline bx-screen ${kc(B.display)} bx-out`} />
    <rect class="bx-fill" x="585" y="213" width="60" height="6" rx="1.5" />
    <rect class="bx-fill" x="609" y="146" width="12" height="5" rx="1" />
    <!-- ceiling speakers -->
    {[[520, L3.ceil], [700, L3.ceil], [300, L1.ceil], [520, L1.ceil]].map(([x, c]) => (
      <g>
        <rect class="bx-fill" x={x - 9} y={c + 13} width="18" height="5" rx="1" />
        <path class="bx-arc" d={`M${x - 7} ${c + 25} Q${x} ${c + 31} ${x + 7} ${c + 25}`} />
      </g>
    ))}
    <!-- lobby signage + break room display -->
    <rect x="268" y="455" width="56" height="34" class="bx-outline bx-screen" />
    <rect x="652" y="466" width="50" height="30" class="bx-outline bx-screen" />
  </g>

  <!-- Room names: drawn over the system layers with a white halo, so a cable passes behind a name instead of
       through it (the way text breaks a line on a drawing). Sentence case in the text face; the closet codes in mono. -->
  <g class="bx-label">
    <text x="150" y="168">Offices</text>
    <text x="482" y="168">Conference</text>
    <text x="150" y="306" class="bx-mono">IDF-2</text>
    <text x="237" y="306">Open office</text>
    <text x="150" y="451" class="bx-mono">MDF</text>
    <text x="262" y="451">Lobby</text>
    <text x="582" y="451">Break room</text>
  </g>

  <!-- ───────────── B1 room routes: one per routed room, outside every layer so the layer draw-in never touches them.
       Hidden until the explorer script shows one. Numbers come from the drops and aps arrays above. ───────────── -->
  <g class="bx-routes">
    {routes.map((r) => (
      <g class="bx-route" data-route={r.id} data-label={r.label} data-closet={r.closet} data-drops={r.dropCount} data-aps={r.apCount} aria-hidden="true">
        <path class="bx-route-halo bx-r-drops" pathLength="1" d={r.dropsPath} />
        <path class="bx-route-halo bx-r-home" pathLength="1" d={r.homePath} />
        <path class="bx-route-line bx-r-drops" pathLength="1" d={r.dropsPath} />
        <path class="bx-route-line bx-r-home" pathLength="1" d={r.homePath} />
        <g class="bx-route-note">
          <path class="bx-lead" d={r.note.leader} />
          <text class="bx-note" x={r.note.x} y={r.note.y} text-anchor={r.note.anchor ?? 'start'}>
            <tspan x={r.note.x}>{r.line1}</tspan>
            <tspan x={r.note.x} dy="16">to <tspan class="bx-mono">{r.closet}</tspan></tspan>
          </text>
        </g>
      </g>
    ))}
  </g>

  <!-- ───────────── B7, what changed: new devices and new runs in ink ───────────── -->
  <g class="bx-news" aria-hidden="true">
    <!-- L3 offices: a new access point -->
    <g class={`bx-rise ${kc(B.ap)}`} style="--t:160ms">
      <path class="bx-new-fill" d="M316 143 H344 V145 Q344 153 330 153 Q316 153 316 145 Z" />
      <path class="bx-new-line" d="M321 161 Q330 168 339 161" />
      <path class="bx-new-line" d="M314 166 Q330 178 346 166" />
    </g>
    <!-- conference: a new display on the same drop -->
    <g class={`bx-rise ${kc(B.display)}`} style="--t:160ms">
      <rect class="bx-new-screen" x="548" y="155" width="134" height="55" rx="1" />
    </g>
    <!-- open office: short new runs from the zone box to the two desks that moved -->
    {hasZone && zoneRuns.map((d) => <path class={`bx-new-run bx-draw ${kc(B.zone)}`} pathLength="1" style="--t:760ms;--dur-in:480ms" d={d} />)}
    <!-- open office: a new camera clips onto a ceiling jack that was put in on day one (no new run) -->
    {hasCam && (
      <>
        <polygon class={`bx-new-cone bx-in ${kc(B.cam)}`} style="--t:480ms" points="433,304 330,398 392,404" />
        <g class={`bx-rise ${kc(B.cam)}`} style="--t:240ms">
          <line class="bx-new-line" x1="440" y1="293" x2="440" y2="296" />
          <rect class="bx-new-fill" x="431" y="296" width="18" height="9" rx="2" />
        </g>
      </>
    )}
  </g>

  <!-- What changed, in words. Long labels from 640 px up, a short "new" below that (sized in screen pixels via --u). -->
  <g class="bx-says" aria-hidden="true">
    <text class={`bx-txt bx-txt--l bx-in ${kc(B.zone)}`} x="591" y="343" text-anchor="middle" style="--t:800ms">desks moved</text>
    <text class={`bx-txt bx-txt--l bx-in ${kc(B.ap)}`} x="277" y="178" text-anchor="middle" style="--t:400ms"><tspan x="277">new</tspan><tspan x="277" dy="1.2em">access point</tspan></text>
    <text class={`bx-txt bx-txt--s bx-in ${kc(B.ap)}`} x="277" y="192" text-anchor="middle" style="--t:400ms">new</text>
    <text class={`bx-txt bx-txt--s bx-in ${kc(B.display)}`} x="711" y="192" text-anchor="middle" style="--t:400ms">new</text>
    {hasCam && (
      <>
        <text class={`bx-txt bx-txt--l bx-in ${kc(B.cam)}`} x="432" y="334" text-anchor="end" style="--t:480ms">new camera</text>
        <text class={`bx-txt bx-txt--s bx-in ${kc(B.cam)}`} x="412" y="336" text-anchor="end" style="--t:480ms">new</text>
      </>
    )}
    <!-- under the L1 tray, kept clear of the LOBBY label so the two do not read as one phrase -->
    <text class={`bx-txt bx-txt--l bx-in ${kc(B.close)}`} x="446" y="447" text-anchor="end" style="--t:700ms">same cable</text>
  </g>

  <!-- ───────────── B7, put in on day one: one numbered mark per item in the explorer's list (laterNums), in blue.
       Each mark is its own beat (bx-k{n}, n = the item's number), so the marks land one by one in list order, each
       with the step of the job it stands for: the second cable off the tray into the new access point; a spare
       strand beside the backbone (white jacket, blue edge); the conduit's two walls and dashed pull string, then a
       new cable pulled up through it in ink; the zone box; the ceiling jacks; the panels' label strips. ───────────── -->
  <g class="bx-laters" aria-hidden="true">
    {keyed.map((m) => (
      <g class={`bx-later ${kc(m.b)}`}>
        {m.key === 'cat6aDefault' && (
          <text class="bx-txt bx-txt--l bx-in" style={`--t:${m.m + 200}ms`} x="783" y="147"><tspan x="783">same drop,</tspan><tspan x="783" dy="1.2em">new display</tspan></text>
        )}
        {m.key === 'twoDropsPerAp' && (
          <path class="bx-mk bx-draw" pathLength="1" style="--t:520ms;--dur-in:400ms" d="M380 140 V148 H345" />
        )}
        {m.key === 'spareFiberStrands' && (
          <>
            <path class="bx-strand-edge bx-draw" pathLength="1" style="--dur-in:600ms" d="M188 465 V396" />
            <path class="bx-strand-core bx-draw" pathLength="1" style="--dur-in:600ms" d="M188 465 V396" />
          </>
        )}
        {m.key === 'emptyConduit' && (
          <>
            <path class="bx-conduit bx-in" d="M211.5 465 V139 M218.5 465 V139" />
            <path class="bx-mk bx-mk-dash bx-in" d="M215 465 V139" />
            <circle class="bx-mk bx-in" cx="215" cy="135" r="3.5" />
            <path class="bx-new-run bx-draw" pathLength="1" style="--t:300ms;--dur-in:600ms" d="M215 465 V139" />
          </>
        )}
        {m.key === 'zoneCabling' && <rect class="bx-mk-plate bx-in" x="472" y="277" width="16" height="14" />}
        {m.key === 'ceilingGridJacks' && [440, 660].map((x) => <rect class="bx-mk-plate bx-in" x={x - 4} y="286" width="8" height="7" />)}
        {m.key === 'labelsAndAsBuilts' &&
          labelTicks.map(([x, y], j) => <rect class="bx-mk-tick bx-tick" style={`--t:${j * 50}ms`} x={x} y={y} width="6" height="2" />)}
        <path class="bx-kl bx-draw" pathLength="1" style={`--t:${m.m}ms;--dur-in:240ms`} d={`M${m.at[0]} ${m.at[1]} L${m.n[0]} ${m.n[1]}`} />
        <circle class="bx-mk-dot bx-in" style={`--t:${m.m}ms`} cx={m.at[0]} cy={m.at[1]} r="2.5" />
        <g class="bx-bal" style={`transform-origin:${m.n[0]}px ${m.n[1]}px`}>
          <g class="bx-bal-in bx-pop" style={`transform-origin:${m.n[0]}px ${m.n[1]}px;--t:${m.m + 200}ms`}>
            <circle cx={m.n[0]} cy={m.n[1]} r="11" />
            <text class="bx-num" x={m.n[0]} y={m.n[1] + 4}>{m.num}</text>
          </g>
        </g>
      </g>
    ))}
  </g>

  <!-- ───────────── Rooms: mouse-hover targets only, aria-hidden and not tab stops (drawn last so they sit on top) ───────────── -->
  <g class="bx-rooms">
    {rooms.map((r) => (
      <rect
        class="bx-room"
        x={r.box[0]}
        y={r.box[1]}
        width={r.box[2]}
        height={r.box[3]}
        aria-hidden="true"
        data-room={r.id}
        data-room-name={r.name}
        data-routed={r.routed ? 'true' : 'false'}
        data-systems={r.systems.join(' ')}
        data-codes={codes(r.systems).join(' ')}
      />
    ))}
  </g>
</svg>

<style>
  .bx {
    width: 100%;
    height: auto;
    /* Armak blue, not red: red is only for the one action and FAIL (rule 7). Blue stays apart from the ink walls. */
    --bx-active: var(--armak-blue);
    --bx-idle: var(--steel-light);
    /* B7 numbers: drawn at r 11 for a full-size drawing and scaled up as the drawing shrinks (--u from fitSvgText),
       so they stay about 9 px across on a phone */
    --bs: clamp(1, calc(var(--u, 1) * 0.82), 2.3);
  }

  .bx-hatch-line {
    stroke: var(--hairline-strong);
    stroke-width: 1;
  }

  /* Rule 4: words on the drawing are set in the text face; mono is kept for codes (L1 to L3, IDF-2, MDF) */
  .bx-sheet {
    font-family: var(--font-sans);
    /* SVG units: the drawing scales to ~0.75-0.9x where this shows (640px and up), so 16 here is ~12-14px on screen */
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0;
    fill: var(--steel);
  }

  .bx-end {
    text-anchor: end;
  }

  .bx-struct {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .bx-slab {
    fill: var(--paper-sunken);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .bx-ground-fill {
    stroke: none;
  }

  .bx-furn {
    fill: none;
    stroke: var(--hairline-strong);
    stroke-width: 1.25;
  }

  .bx-door {
    fill: var(--white);
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .bx-tag {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    fill: var(--ink);
    stroke: var(--ink);
    stroke-width: 0;
  }

  .bx-tag line {
    stroke-width: 1.25;
  }

  .bx-label,
  .bx-callout {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0;
    fill: var(--steel);
  }

  /* The white halo knocks the lines out around each letter, so names stay readable over the cabling */
  .bx-label {
    paint-order: stroke;
    stroke: var(--white);
    stroke-width: 5px;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* Callout sits outside the wall, so it stays smaller than the room labels */
  .bx-callout {
    font-size: 15px;
  }

  /* ── System layers ── */
  .bx-layer {
    color: var(--bx-idle);
    opacity: 0.55;
    transition: opacity var(--dur) ease, color var(--dur) ease;
  }

  .bx-layer line,
  .bx-layer path:not(.bx-fill),
  .bx-outline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .bx-fill {
    fill: currentColor;
    stroke: none;
  }

  .bx-dot {
    fill: var(--white);
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .bx-trunk {
    stroke-width: 3 !important;
  }

  .bx-drop {
    stroke-width: 1.25 !important;
  }

  .bx-fiber {
    stroke-width: 2.5 !important;
    stroke-dasharray: 2 4;
  }

  /* The backbone between the closets is fiber in a white jacket (the install legend's white): a white core over the
     layer's own colour, so it reads as a white cable on the white sheet and stays apart from the solid horizontal runs.
     Widths follow --u so the white core still shows on a phone. */
  .bx-layer path.bx-bb-edge {
    stroke-width: max(3.5px, calc(var(--u, 1) * 3px)) !important;
  }

  .bx-layer path.bx-bb-core {
    stroke: var(--cable-white) !important;
    stroke-width: max(1.5px, calc(var(--u, 1) * 1.25px)) !important;
  }

  /* The carrier's hand-off cord from the demarc to the firewall: orange, as in the install legend */
  .bx-layer path.bx-handoff {
    stroke: var(--cable-orange) !important;
    stroke-width: max(2px, calc(var(--u, 1) * 1.5px)) !important;
  }

  .bx-cone {
    fill: currentColor;
    fill-opacity: 0.06;
    stroke: none;
  }

  .bx-screen {
    fill: color-mix(in srgb, currentColor 12%, transparent);
    stroke-width: 2.25 !important;
  }

  .bx-layer.is-active .bx-screen {
    fill: color-mix(in srgb, currentColor 22%, transparent);
  }

  .bx-callout {
    fill: currentColor;
  }

  /* Blueprint trace: until the drawing has traced itself, the system layers wait (set by the script
     below, only when motion is allowed). Removing the class lets them fade in on the normal transition.
     !important because the dimming rules below have the same specificity and come later; without it
     the layers show (cabling lit, the rest faint) while the walls are still hidden. */
  :global(.bx.bx-wait) .bx-layer {
    opacity: 0 !important;
    transition: none !important;
  }

  /* The "years from now" pieces wait too, in case the switch is flipped while the drawing traces itself */
  :global(.bx.bx-wait) .bx-stay,
  :global(.bx.bx-wait) .bx-ghosts,
  :global(.bx.bx-wait) .bx-news,
  :global(.bx.bx-wait) .bx-says,
  :global(.bx.bx-wait) .bx-laters {
    visibility: hidden;
  }

  /* Dim everything when one layer is in focus */
  :global(.bx[data-active]) .bx-layer {
    opacity: 0.22;
  }

  :global(.bx[data-active]) .bx-layer.is-active {
    color: var(--bx-active);
    opacity: 1;
  }

  .bx-layer.is-active .bx-cone {
    fill-opacity: 0.12;
  }

  /* The perimeter light's cone: same blue as the rest of the lit layer, a little fainter (rule 6: no cable colours here) */
  .bx-layer.is-active .bx-cone--light {
    fill-opacity: 0.08;
  }

  /* While a room route shows, the layers dim a touch faster than usual (160 ms) */
  :global(.bx[data-route]) .bx-layer {
    transition-duration: var(--dur-fast);
  }

  /* ── B7: "years from now" view (rule 10: the Today / 10 years from now switch) ──
     Ink = what changed, blue = what was put in on day one and stays. The view is a numbered sequence that
     BuildingExplorer steps (about 9 s): beat n is item n of the explorer's "Put in on day one for later" list, and the
     beat after the last number traces what stays. Every piece of the later view belongs to one beat (`bx-k bx-k{n}`).
     While the sequence runs the svg carries `bx-seq`, and the explorer adds `bx-b{n}` as each beat starts.

     One switch per piece: `--off` is 1 when the piece's step has not happened (the Today view, or the later view before
     its beat) and 0 once it has; `--go` is the opposite. The role classes turn that into motion, with plain CSS
     transitions on transform, opacity and stroke-dashoffset only, so flipping the switch back turns round from wherever
     things are. `--t` is the piece's start inside its beat (the way there only; the way back has no delay and is quick).
       bx-in     fades in               bx-out    fades out (an old device)
       bx-rise   a new device drops 6 units into place
       bx-draw   a run draws itself (pathLength 1)   bx-slide  a desk slides by --dx
       bx-pop    a number lands (scale 0.4 → 1)      bx-tick   a label strip ticks in from the left
       bx-ink    a moved piece turns ink (switches at --t, does not fade)
     Without bx-seq (reduced motion, or once the sequence has settled) the later view shows its finished picture. */
  :global(.bx[data-when='later']) .bx-layer:not([data-layer='structured-cabling']) {
    opacity: 0.22;
  }

  :global(.bx[data-when='later']) .bx-layer[data-layer='structured-cabling'] {
    opacity: 1;
    color: var(--bx-active);
  }

  .bx-k {
    --off: 1;
    --go: 0;
    --ink-on: initial;
  }

  :global(.bx[data-when='later']:not(.bx-seq)) .bx-k,
  :global(.bx[data-when='later'].bx-b1) .bx-k1,
  :global(.bx[data-when='later'].bx-b2) .bx-k2,
  :global(.bx[data-when='later'].bx-b3) .bx-k3,
  :global(.bx[data-when='later'].bx-b4) .bx-k4,
  :global(.bx[data-when='later'].bx-b5) .bx-k5,
  :global(.bx[data-when='later'].bx-b6) .bx-k6,
  :global(.bx[data-when='later'].bx-b7) .bx-k7,
  :global(.bx[data-when='later'].bx-b8) .bx-k8,
  :global(.bx[data-when='later'].bx-b9) .bx-k9,
  :global(.bx[data-when='later'].bx-b10) .bx-k10,
  :global(.bx[data-when='later'].bx-b11) .bx-k11,
  :global(.bx[data-when='later'].bx-b12) .bx-k12 {
    --off: 0;
    --go: 1;
    --ink-on: var(--ink);
  }

  .bx-in {
    opacity: var(--go, 1);
    transition: opacity calc(260ms * var(--go, 1) + 160ms * var(--off, 0)) ease calc(var(--t, 0ms) * var(--go, 1));
  }

  .bx-out {
    opacity: var(--off, 0);
    transition: opacity calc(240ms * var(--go, 1) + 160ms * var(--off, 0)) ease calc(var(--t, 0ms) * var(--go, 1));
  }

  /* On the way back the device fades first, then jumps back up out of sight */
  .bx-rise {
    opacity: var(--go, 1);
    transform: translateY(calc(var(--off, 0) * -6px));
    transition:
      opacity calc(240ms * var(--go, 1) + 160ms * var(--off, 0)) ease calc(var(--t, 0ms) * var(--go, 1)),
      transform calc(360ms * var(--go, 1)) var(--ease-out) calc(var(--t, 0ms) * var(--go, 1) + 160ms * var(--off, 0));
  }

  /* pathLength 1: a dash as long as the run and a longer gap, so offset 1 hides it and 0 shows all of it */
  .bx-draw {
    stroke-dasharray: 1 2;
    stroke-dashoffset: var(--off, 0);
    transition: stroke-dashoffset calc(var(--dur-in, 400ms) * var(--go, 1) + 160ms * var(--off, 0)) var(--ease-in-out)
      calc(var(--t, 0ms) * var(--go, 1));
  }

  .bx-slide {
    transform: translateX(calc(var(--go, 1) * var(--dx, 0px)));
    transition:
      transform calc(460ms * var(--go, 1) + 320ms * var(--off, 0)) var(--ease-out) calc(var(--t, 0ms) * var(--go, 1)),
      stroke 0s linear calc(var(--t, 0ms) * var(--go, 1));
  }

  .bx-furn.bx-ink {
    stroke: var(--ink-on, var(--hairline-strong));
  }

  .bx-dot.bx-ink,
  .bx-layer path.bx-drop.bx-ink {
    stroke: var(--ink-on, currentColor);
  }

  .bx-tick {
    transform: scaleX(var(--go, 1));
    transform-box: fill-box;
    transform-origin: 0 50%;
    transition: transform calc(200ms * var(--go, 1) + 120ms * var(--off, 0)) var(--ease-out) calc(var(--t, 0ms) * var(--go, 1));
  }

  .bx-ghost {
    fill: none;
    stroke: var(--field-line);
    stroke-width: max(1.25px, calc(var(--u, 1) * 1.1px));
    stroke-dasharray: 4 3;
  }

  /* New runs (the zone runs, the cable pulled up the conduit): ink, the colour of what changed */
  .bx-new-run {
    fill: none;
    stroke: var(--ink);
    stroke-width: max(1.5px, calc(var(--u, 1) * 1.1px));
    stroke-linejoin: round;
  }

  /* The empty conduit's two walls, put in on day one (blue, thin) */
  .bx-conduit {
    fill: none;
    stroke: var(--armak-blue);
    stroke-width: max(1px, calc(var(--u, 1) * 0.8px));
  }

  /* The spare backbone strand: a white jacket like the backbone, its edge in the blue of what was put in on day one */
  .bx-strand-edge,
  .bx-strand-core {
    fill: none;
  }

  .bx-strand-edge {
    stroke: var(--armak-blue);
    stroke-width: max(3.5px, calc(var(--u, 1) * 3px));
  }

  .bx-strand-core {
    stroke: var(--cable-white);
    stroke-width: max(1.5px, calc(var(--u, 1) * 1.25px));
  }

  .bx-new-fill {
    fill: var(--ink);
    stroke: none;
  }

  .bx-new-line,
  .bx-new-screen {
    fill: none;
    stroke: var(--ink);
    stroke-width: max(1.5px, calc(var(--u, 1) * 1.1px));
  }

  .bx-new-screen {
    fill: color-mix(in srgb, var(--ink) 6%, transparent);
    stroke-width: max(1.75px, calc(var(--u, 1) * 1.25px));
  }

  .bx-new-cone {
    fill: var(--ink);
    fill-opacity: 0.06;
    stroke: none;
  }

  /* Words on the drawing: plain sans in ink over a white halo (rule 4: no mono for words) */
  .bx-txt {
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--white);
    stroke-width: calc(var(--u, 1) * 3.5px);
    stroke-linejoin: round;
  }

  .bx-txt--l {
    font-size: clamp(13px, calc(var(--u, 1) * 11px), 15px);
  }

  .bx-txt--s {
    font-size: clamp(16px, calc(var(--u, 1) * 10.5px), 30px);
  }

  /* What stays: a soft blue band traces each untouched run once (each run is a bx-draw in its beat). The band is one
     group at 20%, so where two runs meet the blue does not double up. */
  .bx-glows {
    opacity: 0.2;
  }

  .bx-glow {
    fill: none;
    stroke: var(--armak-blue);
    stroke-width: clamp(8px, calc(var(--u, 1) * 7px), 20px);
  }

  .bx-glow-box {
    fill: none;
    stroke: var(--armak-blue);
    stroke-width: clamp(6px, calc(var(--u, 1) * 5px), 14px);
  }

  /* Both scale round the number's centre (inline transform-origin, in viewBox units) */
  .bx-bal,
  .bx-bal-in {
    transform-box: view-box;
  }

  .bx-bal {
    transform: scale(var(--bs, 1));
  }

  /* A number lands: it fades in as it grows from 0.4 to full size; on the way back it fades, then shrinks */
  .bx-pop {
    opacity: var(--go, 1);
    transform: scale(calc(0.4 + 0.6 * var(--go, 1)));
    transition:
      opacity calc(160ms * var(--go, 1) + 120ms * var(--off, 0)) ease calc(var(--t, 0ms) * var(--go, 1)),
      transform calc(320ms * var(--go, 1)) var(--ease-out) calc(var(--t, 0ms) * var(--go, 1) + 140ms * var(--off, 0));
  }

  .bx-bal circle {
    fill: var(--white);
    stroke: var(--armak-blue);
    stroke-width: 1.25;
  }

  /* Callout numbers are plain figures in the text face (1, 2, 3), the way a drawing numbers its balloons */
  .bx-num {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    text-anchor: middle;
    fill: var(--armak-blue);
  }

  .bx-kl {
    fill: none;
    stroke: var(--armak-blue);
    stroke-width: calc(var(--u, 1) * 1px);
  }

  .bx-routes,
  .bx-stay,
  .bx-ghosts,
  .bx-news,
  .bx-says,
  .bx-laters {
    pointer-events: none;
  }

  .bx-mk,
  .bx-mk-dot,
  .bx-mk-plate,
  .bx-lead {
    stroke: var(--armak-blue);
    stroke-width: 1.5;
    fill: none;
  }

  .bx-mk,
  .bx-mk-plate {
    stroke-width: max(1.5px, calc(var(--u, 1) * 1.1px));
  }

  .bx-lead {
    stroke-width: 1;
  }

  .bx-mk-dash {
    stroke-dasharray: 5 3;
  }

  .bx-mk-dot {
    fill: var(--armak-blue);
  }

  .bx-mk-plate {
    fill: var(--white);
  }

  /* Label strips on the patch panels (the panels themselves are blue in this view) */
  .bx-mk-tick {
    fill: var(--white);
    stroke: none;
  }

  .bx-note {
    font-family: var(--font-sans);
    font-size: 14px;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--white);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .bx-mono {
    font-family: var(--font-mono);
  }

  /* ── B1: room routes. Ink over a white halo so they read over any lit layer. Hidden until shown. ── */
  .bx-route {
    opacity: 0;
    visibility: hidden;
  }

  .bx-route.is-on {
    opacity: 1;
    visibility: visible;
  }

  .bx-route-halo,
  .bx-route-line {
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    stroke-linejoin: round;
  }

  .bx-route-halo {
    stroke: var(--white);
  }

  .bx-route-halo.bx-r-drops {
    stroke-width: 6;
  }

  .bx-route-halo.bx-r-home {
    stroke-width: 7;
  }

  .bx-route-line {
    stroke: var(--ink);
  }

  .bx-route-line.bx-r-drops {
    stroke-width: 2;
  }

  .bx-route-line.bx-r-home {
    stroke-width: 3;
  }

  /* Rooms: invisible hit areas; a faint outline shows which room is under the pointer (mouse only: the rooms are not keyboard stops) */
  .bx-room {
    fill: transparent;
    stroke: none;
    pointer-events: all;
    outline: none;
  }

  .bx-room.is-shown {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }

  /* Hover outline only where a real pointer exists (a tap on a phone must not leave one stuck) */
  @media (hover: hover) and (pointer: fine) {
    .bx-room:hover {
      stroke: var(--ink);
      stroke-width: 1.5;
      stroke-dasharray: 5 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bx-layer,
    .bx-in,
    .bx-out,
    .bx-rise,
    .bx-draw,
    .bx-slide,
    .bx-pop,
    .bx-tick {
      transition: none !important;
    }
  }

  /* Print: the later view prints finished, even if it is printed halfway through its sequence. Today is unchanged. */
  @media print {
    :global(.bx[data-when='later']) .bx-k {
      --off: 0;
      --go: 1;
      --ink-on: var(--ink);
    }

    .bx-in,
    .bx-out,
    .bx-rise,
    .bx-draw,
    .bx-slide,
    .bx-pop,
    .bx-tick {
      transition: none !important;
    }
  }

  @media (min-width: 640px) {
    .bx-txt--s {
      display: none;
    }
  }

  /* Room labels are unreadable at phone size — hide them there. The later view keeps its numbers and a short "new"
     (sized via --u); its longer words wait for 640 px, and the dashes get longer so they still read as dashes. */
  @media (max-width: 639px) {
    .bx-label,
    .bx-sheet,
    .bx-callout,
    .bx-route-note,
    .bx-txt--l {
      display: none;
    }

    .bx-ghost {
      stroke-dasharray: 9 6;
    }

    .bx-mk-dash {
      stroke-dasharray: 10 6;
    }
  }
</style>

<script>
  import { prefersReducedMotion, fitSvgText } from '../../scripts/demo';

  // Keep the later view's words and numbers readable at any drawing size (sets --u on the svg).
  document.querySelectorAll<SVGSVGElement>('svg.bx').forEach((svg) => {
    if (svg.parentElement) fitSvgText(svg.parentElement);
  });

  // The first time a layer becomes active, its solid strokes draw in (once per layer, never again).
  // Dashed/dotted lines (the ISP fiber) are skipped and keep the opacity transition.
  // BuildingExplorer toggles .is-active; we only watch for it. Opacity dimming stays in CSS.
  const STROKES = 'line, path:not(.bx-fill), rect.bx-outline, circle.bx-dot';

  if (!prefersReducedMotion()) {
    const running = new WeakMap<Element, Animation>();

    const draw = (layer: Element) => {
      const css = getComputedStyle(document.documentElement);
      const raw = css.getPropertyValue('--dur-slow').trim();
      const duration = (raw.endsWith('ms') ? parseFloat(raw) : parseFloat(raw) * 1000) || 900;
      const easing = css.getPropertyValue('--ease-out').trim() || 'ease-out';
      layer.querySelectorAll<SVGGeometryElement>(STROKES).forEach((el) => {
        if (typeof el.getTotalLength !== 'function') return;
        if (el.classList.contains('bx-fiber')) return;
        const cs = getComputedStyle(el);
        if (cs.stroke === 'none') return;
        if (cs.strokeDasharray && cs.strokeDasharray !== 'none') return;
        let len = 0;
        try {
          len = el.getTotalLength();
        } catch {
          return;
        }
        if (!len) return;
        running.get(el)?.cancel();
        const a = el.animate(
          [
            { strokeDasharray: `${len}`, strokeDashoffset: `${len}` },
            { strokeDasharray: `${len}`, strokeDashoffset: '0' },
          ],
          { duration, easing },
        );
        running.set(el, a);
      });
    };

    document.querySelectorAll<SVGElement>('.bx').forEach((svg) => {
      const layers = [...svg.querySelectorAll<Element>('.bx-layer')];
      const was = new WeakMap<Element, boolean>();
      const drawn = new Set<Element>();
      layers.forEach((l) => was.set(l, l.classList.contains('is-active')));
      const mo = new MutationObserver((records) => {
        for (const r of records) {
          const l = r.target as Element;
          const on = l.classList.contains('is-active');
          if (on && !was.get(l) && !drawn.has(l)) {
            drawn.add(l);
            draw(l);
          }
          was.set(l, on);
        }
      });
      layers.forEach((l) => mo.observe(l, { attributes: true, attributeFilter: ['class'] }));
    });

    // "The blueprint draws itself": the first time the drawing scrolls into view, the structure (walls,
    // slabs, furniture, doors, labels, grid) traces in over ~900 ms, staggered top to bottom. Once only.
    // Animations are created paused so the structure is hidden until the trigger; they are cancelled when
    // done, handing the elements back to plain CSS. Then the active layer fades in as it always does.
    document.querySelectorAll<SVGSVGElement>('.bx').forEach((svg) => {
      const TRACE = 560; // ms per line
      const SPREAD = 340; // ms between the top and bottom lines starting (560 + 340 = 900)
      const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)'; // --ease-out
      const targets = [...svg.querySelectorAll<SVGGraphicsElement>('.bx-structure line, .bx-structure rect, .bx-structure path')];
      const fades = [...svg.querySelectorAll<SVGGraphicsElement>(':scope > text, .bx-structure text, .bx-label text')];
      const all = [...targets, ...fades];
      if (!all.length || typeof IntersectionObserver === 'undefined') return;

      const ys = new Map<Element, number>();
      let min = Infinity;
      let max = -Infinity;
      all.forEach((el) => {
        try {
          const y = el.getBBox().y;
          ys.set(el, y);
          min = Math.min(min, y);
          max = Math.max(max, y);
        } catch {
          /* display:none on small screens */
        }
      });
      const span = Math.max(1, max - min);
      const delayOf = (el: Element) => (ys.has(el) ? ((ys.get(el)! - min) / span) * SPREAD : 0);

      const anims: Animation[] = [];
      targets.forEach((el) => {
        const geo = el as unknown as SVGGeometryElement;
        const cs = getComputedStyle(el);
        const timing = { duration: TRACE, delay: delayOf(el), easing: EASE, fill: 'both' as FillMode };
        if (cs.strokeDasharray && cs.strokeDasharray !== 'none') {
          anims.push(el.animate([{ opacity: 0 }, { opacity: 1 }], timing));
          return;
        }
        let len = 0;
        try {
          len = cs.stroke === 'none' ? 0 : geo.getTotalLength();
        } catch {
          len = 0;
        }
        if (!len) {
          anims.push(el.animate([{ opacity: 0 }, { opacity: 1 }], timing));
          return;
        }
        anims.push(
          el.animate(
            [
              { strokeDasharray: `${len}`, strokeDashoffset: `${len}`, opacity: 0 },
              { strokeDasharray: `${len}`, strokeDashoffset: `${len * 0.85}`, opacity: 1, offset: 0.12 },
              { strokeDasharray: `${len}`, strokeDashoffset: '0', opacity: 1 },
            ],
            timing,
          ),
        );
      });
      fades.forEach((el) => {
        anims.push(el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: TRACE, delay: delayOf(el), easing: EASE, fill: 'both' }));
      });
      anims.forEach((a) => a.pause());
      svg.classList.add('bx-wait');

      const finish = () => {
        anims.forEach((a) => a.cancel());
        svg.classList.remove('bx-wait');
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              io.disconnect();
              anims.forEach((a) => a.play());
              Promise.all(anims.map((a) => a.finished)).then(finish, finish);
              return;
            }
            // Already scrolled past before the first observation: show the drawing as is.
            if (e.boundingClientRect.bottom < 0) {
              io.disconnect();
              finish();
              return;
            }
          }
        },
        { threshold: 0.2 },
      );
      io.observe(svg);
    });
  }
</script>
