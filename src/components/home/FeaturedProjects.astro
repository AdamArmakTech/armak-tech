---
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { publishedProjects } from '../../data/content';

// Only real projects — the homepage hides this whole section until at least one exists
const featured = publishedProjects.slice(0, 3);
---

<section id="projects" class="section projects">
  <div class="container">
    <SectionHead
      title="Selected projects."
      intro="Representative installs from across Southern California. Each one links to the full story: the site, the constraints and what we handed over."
    />

    <ul role="list" class="projects__grid">
      {featured.map((p) => (
        <li class="project">
          <article class="project__card">
            <div class="project__media">
              {p.image && (
                <Image
                  src={p.image}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1000px) 30vw, (min-width: 700px) 42vw, 100vw"
                  loading="lazy"
                />
              )}
              {p.placeholder && <span class="t-meta project__flag">Placeholder</span>}
            </div>

            <div class="project__body">
              <p class="t-meta project__meta">{p.sector}, {p.location}</p>
              <h3 class="t-h3 project__title">
                <a href={`/projects/${p.slug}/`} class="project__link">{p.title}</a>
              </h3>

              <dl class="project__scope">
                {p.scope.map((s) => (
                  <div>
                    <dt class="t-meta">{s.label}</dt>
                    <dd>{s.value}</dd>
                  </div>
                ))}
              </dl>

              <p class="t-small project__summary">{p.summary}</p>

              <span class="t-meta project__more" aria-hidden="true">View project</span>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <div class="projects__foot">
      <p class="t-meta">Case studies with full scope and outcome.</p>
      <Button href="/projects/" variant="outline">All projects</Button>
    </div>
  </div>
</section>

<style>
  .projects__grid {
    display: grid;
    gap: var(--col-gap);
  }

  .project__card {
    position: relative;
    display: grid;
    height: 100%;
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .project__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .project__card:hover .project__media img {
    transform: scale(1.04);
  }

  .project__media :global(.project__flag) {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.25rem 0.625rem;
    background: var(--paper);
    border-radius: var(--radius);
  }

  .project__body {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .project__title {
    max-width: 20ch;
  }

  /* Whole card is clickable via the title link; one link per card for screen readers */
  .project__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .project__link:focus-visible {
    outline: none;
  }

  .project__card:has(.project__link:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .project__scope {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
  }

  .project__scope div {
    display: grid;
    gap: 0.375rem;
    align-content: start;
  }

  .project__scope dt {
    order: 2;
    font-size: var(--fs-label);
    color: var(--steel);
    line-height: 1.3;
  }

  .project__scope dd {
    order: 1;
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .project__summary {
    max-width: 34em;
  }

  .project__more {
    justify-self: start;
    color: var(--ink);
  }

  .projects__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: var(--col-gap);
  }

  /* Tablet: horizontal cards, image left */
  @media (min-width: 640px) and (max-width: 1023px) {
    .project__card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .project__media {
      aspect-ratio: auto;
      min-height: 100%;
    }

    .project__media img {
      position: absolute;
      inset: 0;
    }
  }

  @media (min-width: 1024px) {
    .projects__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .project__card {
      grid-template-rows: auto 1fr;
    }

    .project__body {
      padding: 1.5rem 1.5rem 1.75rem;
    }
  }
</style>
