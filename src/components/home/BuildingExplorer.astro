---
/**
 * Interactive building cutaway — the homepage's signature section.
 * Tabs (one per service) highlight that system's layer in BuildingSvg.
 * Click-only: nothing advances on its own (DESIGN.md rule 10).
 * Keyboard: the chips, the tabs and the buttons in the sheet are the tab stops. The sheet itself is not
 * one (it holds focusable controls), and the drawing's rooms are pointer-only, so they get no focus listeners.
 */
import { ArrowRight } from '@lucide/astro';
import SectionHead from '../ui/SectionHead.astro';
import BuildingSvg from './BuildingSvg.astro';
import { services } from '../../data/site';
import { industries, lifespans, cablingSourced, shownSignature, type SignatureKey } from '../../data/content';
import { contactHref } from '../../lib/cta';

const industryRows = industries.map((ind) => {
  const sys = ind.systems.map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean);
  return { ...ind, sys, summary: `${ind.name}: typically ${sys.map((s) => s.name).join(', ')}` };
});

// B7: the switch's second option, the sheet title for that view, and the list of items drawn on the building.
const tenYears = cablingSourced && (lifespans.cabling.years ?? 0) >= 10;
const laterLabel = tenYears ? '10 years from now' : 'Years from now';
const laterTitle = `${laterLabel}: cabling stays`;
// "Put in on day one for later", in this order. Only items the owner confirmed are shown (shownSignature).
// Each item BuildingSvg has a spot for (its keyMarks) gets a number, 1 up (plain, the way a drawing numbers its
// callouts), and the drawing puts the same number on that spot; an item with no sensible spot would be listed
// without a number.
const laterKeys: SignatureKey[] = ['cat6aDefault', 'twoDropsPerAp', 'spareFiberStrands', 'emptyConduit', 'zoneCabling', 'ceilingGridJacks', 'labelsAndAsBuilts'];
const drawnKeys = new Set<SignatureKey>(['cat6aDefault', 'twoDropsPerAp', 'spareFiberStrands', 'emptyConduit', 'zoneCabling', 'ceilingGridJacks', 'labelsAndAsBuilts']);
let laterCount = 0;
const laterItems = shownSignature(laterKeys).map((it) => ({
  ...it,
  num: drawnKeys.has(it.key) ? String(++laterCount) : null,
}));
const laterNums: Partial<Record<SignatureKey, string>> = Object.fromEntries(
  laterItems.flatMap((it) => (it.num ? [[it.key, it.num]] : [])),
);
// B1: the rooms that have a route (ids match the rooms in BuildingSvg).
const roomButtons = [
  { id: 'offices', label: 'Offices' },
  { id: 'conference', label: 'Conference' },
  { id: 'open-office', label: 'Open office' },
  { id: 'lobby', label: 'Lobby' },
];
---

<section class="explorer section" id="systems" aria-labelledby="explorer-tabs-label">
  <div class="container">
    <SectionHead
      label="System explorer"
      title="How the six systems fit in a building."
      intro="Most of a building’s systems are hidden in the walls and ceilings. We design, install and test all six so they work together from the start."
    />

    <div class="explorer__body" data-explorer>
      <div class="explorer__tabs-wrap">
        <p id="explorer-chips-label" class="explorer__chips-label">I manage a:</p>
        <div class="explorer__chips" role="group" aria-labelledby="explorer-chips-label">
          {industryRows.map((ind) => (
            <button type="button" class="explorer__chip" aria-pressed="false" data-industry={ind.slug} data-systems={ind.systems.join(' ')}>
              {ind.name}
            </button>
          ))}
        </div>
        <p id="explorer-tabs-label" class="t-meta explorer__hint">Select a system.</p>
        <div class="explorer__tabs" role="tablist" aria-labelledby="explorer-tabs-label" aria-orientation="vertical">
          {services.map((s, i) => (
            <button
              class="explorer__tab"
              role="tab"
              id={`explorer-tab-${s.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="explorer-panel"
              tabindex={i === 0 ? 0 : -1}
              data-slug={s.slug}
              data-layer-name={s.layer}
            >
              <span class="explorer__name">{s.name}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="explorer__stage" id="explorer-panel" role="tabpanel" aria-labelledby={`explorer-tab-${services[0].slug}`}>
        <div class="explorer__drawing">
          <div class="bx-frame">
          <div class="bx-bar" hidden>
            <fieldset class="bx-when" data-bx-when data-later-title={laterTitle} data-later-label={laterLabel}>
              <legend class="visually-hidden">Show the building</legend>
              <label><input type="radio" name="bx-when" value="today" checked data-bx-when-input /><span>Today</span></label>
              <label><input type="radio" name="bx-when" value="later" data-bx-when-input /><span>{laterLabel}</span></label>
            </fieldset>
          </div>
          <BuildingSvg laterNums={laterNums} />
          </div>
          <p class="visually-hidden" role="status" data-bx-when-live></p>

          <div class="bx-later-info" data-bx-later-info hidden>
            <!-- The caption doubles as the drawing's key: a dashed outline then ink for what moved or is new, blue for what stays -->
            <p class="bx-later-caption">
              <span class="bx-key">
                <svg class="bx-key-sw" viewBox="0 0 40 16" aria-hidden="true" focusable="false">
                  <rect class="bx-key-ghost" x="1.5" y="4.5" width="12" height="7" />
                  <path class="bx-key-arrow" d="M17 8 H23 M20.5 5.5 L23 8 L20.5 10.5" />
                  <rect class="bx-key-new" x="26.5" y="4.5" width="12" height="7" />
                </svg>
                <span>Desks move and devices get replaced.</span>
              </span>{' '}
              <span class="bx-key">
                <svg class="bx-key-sw" viewBox="0 0 40 16" aria-hidden="true" focusable="false">
                  <path class="bx-key-glow" d="M5 8 H35" />
                  <path class="bx-key-cable" d="M5 8 H35" />
                </svg>
                <span>The cabling in the walls and ceilings stays.</span>
              </span>
            </p>
            {tenYears && lifespans.cabling.footnote && lifespans.cabling.sourceUrl && (
              <p class="bx-later-note">
                {lifespans.cabling.footnote} Source: <a href={lifespans.cabling.sourceUrl}>BICSI 005-2016 (PDF)</a>
              </p>
            )}
            {laterItems.length > 0 && (
              <>
                <p class="bx-later-head" id="bx-later-head">Put in on day one for later:</p>
                <ul role="list" class="bx-later-list" aria-labelledby="bx-later-head">
                  {laterItems.map((it) => (
                    <li>
                      <span class:list={['bx-later-num', { 'is-none': !it.num }]} aria-hidden="true">{it.num}</span>
                      <span class="bx-later-text">
                        <strong class="bx-later-title">{it.label}<span class="visually-hidden">.</span></strong>
                        <span class="bx-later-body">
                          {it.detail}
                          {it.confirmed === 'sometimes' ? ' On some jobs.' : ''}
                        </span>
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>

          <div class="bx-rooms-ui" data-bx-room-buttons hidden>
            <p class="bx-rooms-label" id="bx-rooms-label">Show a room’s cables:</p>
            <div class="bx-rooms-group" role="group" aria-labelledby="bx-rooms-label">
              {roomButtons.map((r) => (
                <button type="button" class="bx-room-btn" aria-pressed="false" data-room-btn={r.id}>{r.label}</button>
              ))}
            </div>
            <p class="bx-live" aria-live="polite" data-bx-live></p>
          </div>
        </div>

        {industryRows.map((ind) => (
          <div class="explorer__detail" data-industry-detail={ind.slug} hidden>
            <p class="explorer__summary">{ind.summary}</p>
            <p class="explorer__text">{ind.need}</p>
            <div class="explorer__actions">
              <a class="explorer__ask" href={contactHref({ about: ind.name })}>
                Ask about {ind.name.toLowerCase()}
                <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" />
              </a>
            </div>
          </div>
        ))}

        {services.map((s, i) => (
          <div class="explorer__detail" data-detail={s.slug} hidden={i !== 0}>
            <div class="explorer__detail-head">
              <h3 class="t-h3">{s.name}</h3>
            </div>
            <p class="explorer__text">{s.short}</p>
            <ul role="list" class="explorer__includes t-meta">
              {s.includes.map((inc) => <li>{inc}</li>)}
            </ul>
            <div class="explorer__actions">
              <a class="explorer__ask" href={contactHref({ about: s.slug })}>
                Ask about {s.name.toLowerCase()}
                <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" />
              </a>
              <a class="explorer__link" href={`/services/${s.slug}/`}>See {s.name}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { autoPlay, prefersReducedMotion } from '../../scripts/demo';

  const css = getComputedStyle(document.documentElement);
  const EASE_OUT = css.getPropertyValue('--ease-out').trim() || 'cubic-bezier(0.16, 1, 0.3, 1)';
  const canHover = matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const tabList = root.querySelector<HTMLElement>('.explorer__tabs');
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]');
    const svg = root.querySelector<SVGSVGElement>('.bx');
    const layerName = root.querySelector<SVGTextElement>('[data-bx-layer-name]');
    const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    const industryDetails = [...root.querySelectorAll<HTMLElement>('[data-industry-detail]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-industry]')];
    const rooms = [...root.querySelectorAll<SVGElement>('[data-room]')];
    const routes = new Map<string, SVGGElement>(
      [...root.querySelectorAll<SVGGElement>('[data-route]')].map((g) => [g.dataset.route!, g]),
    );
    const roomBox = root.querySelector<HTMLElement>('[data-bx-room-buttons]');
    const roomBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-room-btn]')];
    const live = root.querySelector<HTMLElement>('[data-bx-live]');
    const whenBox = root.querySelector<HTMLFieldSetElement>('[data-bx-when]');
    const whenInputs = [...root.querySelectorAll<HTMLInputElement>('[data-bx-when-input]')];
    const whenInfo = root.querySelector<HTMLElement>('[data-bx-later-info]');
    const whenLive = root.querySelector<HTMLElement>('[data-bx-when-live]');
    if (!tabs.length || !panel || !svg) return;

    let index = 0;
    // What the drawing shows when nothing else is asked for: the selected tab, or the chosen industry.
    let base: { slugs: string[]; label: string } = { slugs: [], label: '' };
    let when: 'today' | 'later' = 'today';
    // The room route on screen (hovered or pinned by a button), and the animations drawing it.
    let route: { id: string; pinned: boolean } | null = null;
    let routeAnims: Animation[] = [];
    let fade: Animation | null = null;

    /** Light the given layers (one or many) and set the label in the sheet title. */
    const paint = (slugs: string[], label: string) => {
      svg.setAttribute('data-active', slugs.join(' '));
      svg.querySelectorAll('[data-layer]').forEach((g) => {
        g.classList.toggle('is-active', slugs.includes(g.getAttribute('data-layer')!));
      });
      if (layerName) layerName.textContent = label;
    };

    /* ───────── B1: a room's cables run back to its closet ───────── */

    const setLive = (id: string | null) => {
      if (!live) return;
      live.textContent = '';
      const g = id ? routes.get(id) : null;
      if (!g) return;
      const d = Number(g.dataset.drops);
      const a = Number(g.dataset.aps);
      live.append(
        `${g.dataset.label}: ${d} cable drop${d === 1 ? '' : 's'}, ${a} access point${a === 1 ? '' : 's'}, runs to `,
      );
      const code = document.createElement('span');
      code.className = 't-readout';
      code.textContent = g.dataset.closet ?? '';
      live.append(code, '.');
    };

    const dropFade = () => {
      if (fade) {
        fade.cancel();
        fade = null;
      }
    };

    /** Stop drawing and hide every route at once (used before another one starts). */
    const wipeRoutes = () => {
      routeAnims.forEach((a) => a.cancel());
      routeAnims = [];
      dropFade();
      routes.forEach((g) => g.classList.remove('is-on'));
    };

    const showRoute = (id: string, pinned: boolean) => {
      const g = routes.get(id);
      if (!g) return;
      wipeRoutes();
      route = { id, pinned };
      rooms.forEach((r) => r.classList.toggle('is-shown', r.dataset.room === id));
      svg.setAttribute('data-route', id);
      const closet = g.dataset.closet ?? '';
      // No active layer: the existing dimming drops every layer to 0.22.
      paint([], `${rooms.find((r) => r.dataset.room === id)?.dataset.roomName ?? ''}: to ${closet}`);
      g.classList.add('is-on');
      setLive(id);
      if (prefersReducedMotion()) return;
      g.querySelectorAll<SVGElement>('.bx-r-drops').forEach((p) =>
        routeAnims.push(p.animate([{ strokeDashoffset: '1' }, { strokeDashoffset: '0' }], { duration: 240, easing: EASE_OUT, fill: 'both' })),
      );
      g.querySelectorAll<SVGElement>('.bx-r-home').forEach((p) =>
        routeAnims.push(p.animate([{ strokeDashoffset: '1' }, { strokeDashoffset: '0' }], { duration: 480, delay: 240, easing: EASE_OUT, fill: 'both' })),
      );
      const note = g.querySelector<SVGElement>('.bx-route-note');
      if (note) routeAnims.push(note.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, delay: 720, easing: 'ease', fill: 'both' }));
    };

    /** Take the route away (fading, unless asked not to or motion is reduced) and, by default, show the base view again. */
    const clearRoute = ({ paintBase = true, instant = false } = {}) => {
      roomBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      if (!route) return;
      const g = routes.get(route.id);
      route = null;
      rooms.forEach((r) => r.classList.remove('is-shown'));
      svg.removeAttribute('data-route');
      setLive(null);
      routeAnims.forEach((a) => a.cancel());
      routeAnims = [];
      if (paintBase) paint(base.slugs, base.label);
      if (!g) return;
      if (instant || prefersReducedMotion()) {
        wipeRoutes();
        return;
      }
      dropFade();
      const a = g.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 160, easing: 'ease', fill: 'forwards' });
      fade = a;
      const done = () => {
        if (fade !== a) return;
        g.classList.remove('is-on');
        a.cancel();
        fade = null;
      };
      a.onfinish = done;
      setTimeout(done, 200); // in case no frame is drawn (a hidden tab)
    };

    /* ───────── B7: today / years from now ───────── */

    // The text under the drawing comes in with it: the key at once, the heading as the drawing's numbered marks
    // begin, then each list row with its number (the same 640 ms + 80 ms steps as BuildingSvg's CSS). Opacity and
    // a 6 px rise only; cancelled when the switch goes back, skipped under reduced motion.
    let laterAnims: Animation[] = [];
    const stopLater = () => {
      laterAnims.forEach((a) => a.cancel());
      laterAnims = [];
    };
    const revealLater = () => {
      stopLater();
      if (!whenInfo || prefersReducedMotion()) return;
      const enter = (el: Element, delay: number, rise = false) =>
        laterAnims.push(
          el.animate(rise ? [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }] : [{ opacity: 0 }, { opacity: 1 }], {
            duration: rise ? 280 : 220,
            delay,
            easing: rise ? EASE_OUT : 'ease',
            fill: 'backwards',
          }),
        );
      whenInfo.querySelectorAll('.bx-later-caption, .bx-later-note').forEach((el) => enter(el, 0));
      whenInfo.querySelectorAll('.bx-later-head').forEach((el) => enter(el, 560));
      whenInfo.querySelectorAll('.bx-later-list > li').forEach((el, i) => enter(el, 640 + i * 80, true));
    };

    const setWhen = (next: 'today' | 'later', { paintBase = true } = {}) => {
      if (next === when) return;
      when = next;
      whenInputs.forEach((i) => (i.checked = i.value === next));
      if (next === 'later') {
        clearRoute({ paintBase: false });
        svg.setAttribute('data-when', 'later');
        if (layerName) layerName.textContent = whenBox?.dataset.laterTitle ?? 'Years from now: cabling stays';
      } else {
        svg.removeAttribute('data-when');
        if (paintBase) paint(base.slugs, base.label);
      }
      if (whenInfo) whenInfo.hidden = next !== 'later';
      if (next === 'later') revealLater();
      else stopLater();
      if (whenLive) {
        whenLive.textContent =
          next === 'later' ? `${whenBox?.dataset.laterLabel ?? 'Years from now'}: desks moved and devices replaced, but the cabling stays.` : 'Today.';
      }
    };

    /** Anything that asks for a different view first puts the building back to today and clears a room route. */
    const resetOverlays = () => {
      setWhen('today', { paintBase: false });
      clearRoute({ paintBase: false });
    };

    const select = (i: number, { focus = false } = {}) => {
      resetOverlays();
      index = (i + tabs.length) % tabs.length;
      const tab = tabs[index];
      const slug = tab.dataset.slug!;

      tabs.forEach((t, n) => {
        const on = n === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      industryDetails.forEach((d) => (d.hidden = true));
      panel.setAttribute('aria-labelledby', tab.id);
      details.forEach((d) => (d.hidden = d.dataset.detail !== slug));

      base = {
        slugs: [slug],
        label: tab.dataset.layerName ?? '',
      };
      paint(base.slugs, base.label);
      placeHighlight();

      if (focus) tab.focus();
    };

    /** Multi-system mode for an industry chip. Choosing the pressed chip again returns to the tab. */
    const chooseIndustry = (chip: HTMLButtonElement) => {
      if (chip.getAttribute('aria-pressed') === 'true') {
        select(index);
        return;
      }
      resetOverlays();
      const slug = chip.dataset.industry!;
      const detail = industryDetails.find((d) => d.dataset.industryDetail === slug);
      const systems = (chip.dataset.systems ?? '').split(' ').filter(Boolean);
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
      details.forEach((d) => (d.hidden = true));
      industryDetails.forEach((d) => (d.hidden = d !== detail));
      panel.setAttribute('aria-labelledby', 'explorer-chips-label');
      base = {
        slugs: systems,
        label: chip.textContent?.trim() ?? '',
      };
      paint(base.slugs, base.label);
      placeHighlight();
    };

    /* ───────── A10: one highlight slides behind the selected tab ─────────
       Created here, so without JavaScript the tab keeps its own static selected style. Moves with
       transform only (translate to the tab, scale to its size). Instant under reduced motion (CSS). */
    let hl: HTMLElement | null = null;
    let hlPlaced = false;
    function placeHighlight(instant = false) {
      if (!hl) return;
      const sel = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (!sel) {
        hl.style.opacity = '0';
        return;
      }
      const snap = instant || !hlPlaced;
      if (snap) hl.style.transition = 'none';
      hl.style.opacity = '1';
      hl.style.transform = `translate(${sel.offsetLeft}px, ${sel.offsetTop}px) scale(${sel.offsetWidth / 100}, ${sel.offsetHeight / 100})`;
      if (snap) {
        void hl.offsetWidth; // apply the jump before the transition comes back
        hl.style.transition = '';
        hlPlaced = true;
      }
    }

    if (tabList) {
      hl = document.createElement('span');
      hl.className = 'explorer__hl';
      hl.setAttribute('aria-hidden', 'true');
      tabList.prepend(hl);
      tabList.classList.add('has-hl');
      if (typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(() => placeHighlight(true));
        ro.observe(tabList);
        tabs.forEach((t) => ro.observe(t));
      }
    }

    /* ───────── wiring ───────── */

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {
          ArrowDown: index + 1,
          ArrowRight: index + 1,
          ArrowUp: index - 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(e.key in keys)) return;
        e.preventDefault();
        select(keys[e.key], { focus: true });
      });
    });

    chips.forEach((chip) => chip.addEventListener('click', () => chooseIndustry(chip)));

    // Room buttons (pin a route). Rendered hidden; shown only now that the script is running.
    if (roomBox) roomBox.hidden = false;
    roomBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.getAttribute('aria-pressed') === 'true') {
          clearRoute();
          return;
        }
        setWhen('today', { paintBase: false });
        roomBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        showRoute(btn.dataset.roomBtn!, true);
      });
    });
    roomBox?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && route?.pinned) {
        e.preventDefault();
        clearRoute();
      }
    });

    // Switch: today / years from now. Rendered hidden; shown now.
    if (whenBox) {
      whenBox.hidden = false;
      if (whenBox.parentElement) whenBox.parentElement.hidden = false;
    }
    whenInputs.forEach((input) => input.addEventListener('change', () => input.checked && setWhen(input.value as 'today' | 'later')));

    // Room hover. A routed room draws its cable route; the others light the systems drawn in them (as before).
    // Pointer only on purpose: the rooms are aria-hidden shapes with no name, and Chromium turns an SVG
    // element into a keyboard tab stop as soon as it has a focus or blur listener, so there are none.
    // Real pointers only, so a tap on a phone never leaves a route stuck. A pinned route ignores hover.
    rooms.forEach((room) => {
      const routed = room.dataset.routed === 'true';
      room.addEventListener('mouseenter', () => {
        if (!canHover.matches || when === 'later' || route?.pinned) return;
        if (routed) {
          showRoute(room.dataset.room!, false);
        } else {
          const slugs = (room.dataset.systems ?? '').split(' ').filter(Boolean);
          paint(slugs, room.dataset.roomName ?? '');
        }
      });
      room.addEventListener('mouseleave', () => {
        if (!canHover.matches || when === 'later' || route?.pinned) return;
        if (route) clearRoute();
        else paint(base.slugs, base.label);
      });
    });

    select(0);
    placeHighlight(true);

    /* ───────── The site's rule (autoPlay in demo.ts; owner, 2026-11-06 night) ─────────
       As the explorer scrolls into view the systems show themselves one after another, each lit in the drawing
       with its text, then the "years from now" view closes the lap and it starts over. A press on a tab, a chip,
       a room button or the switch stops that; once the explorer has scrolled away and comes back it runs again
       from whatever is showing. Hovering a room changes nothing about the lap. */
    const HOLD_MS = 2400; // each system stays lit this long
    const LATER_MS = 4200; // the "years from now" view, with its list, at the end of a lap
    let lap: number | undefined;
    const stopLap = () => {
      window.clearTimeout(lap);
      lap = undefined;
    };
    const nextBeat = () => {
      lap = undefined;
      if (!auto.on) return;
      if (when === 'later') select(0); // the lap is over: back to the first system (select() puts the building back to today)
      else if (index === tabs.length - 1 && tabs.some((t) => t.getAttribute('aria-selected') === 'true')) setWhen('later');
      else select(index + 1);
      lap = window.setTimeout(nextBeat, when === 'later' ? LATER_MS : HOLD_MS);
    };
    const auto = autoPlay(root, {
      start: () => {
        stopLap();
        lap = window.setTimeout(nextBeat, when === 'later' ? LATER_MS : HOLD_MS);
      },
      stop: stopLap,
    });
  });
</script>

