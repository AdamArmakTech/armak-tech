---
/**
 * Interactive building cutaway — the homepage's signature section.
 * Tabs (one per service) highlight that system's layer in BuildingSvg.
 * Click-only: nothing advances on its own (DESIGN.md rule 10).
 */
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import BuildingSvg from './BuildingSvg.astro';
import { services } from '../../data/site';
import { industries } from '../../data/content';
import { contactHref } from '../../lib/cta';

const industryRows = industries.map((ind) => {
  const sys = ind.systems.map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean);
  return { ...ind, sys, summary: `Typical for ${ind.name}: ${sys.map((s) => s.name).join(' · ')}` };
});
---

<section class="explorer section" id="systems" aria-labelledby="explorer-tabs-label">
  <div class="container">
    <SectionHead
      title="How the six systems fit in a building."
      intro="Most of a building’s systems are hidden in the walls and ceilings. We design, install and test all six so they work together from the start."
    />

    <div class="explorer__body" data-explorer>
      <div class="explorer__tabs-wrap">
        <p id="explorer-chips-label" class="explorer__chips-label">I manage a:</p>
        <div class="explorer__chips" role="group" aria-labelledby="explorer-chips-label">
          {industryRows.map((ind) => (
            <button type="button" class="explorer__chip" aria-pressed="false" data-industry={ind.slug} data-systems={ind.systems.join(' ')}>
              {ind.name}
            </button>
          ))}
        </div>
        <p id="explorer-tabs-label" class="t-muted explorer__hint">Select a system</p>
        <div class="explorer__tabs" role="tablist" aria-labelledby="explorer-tabs-label" aria-orientation="vertical">
          {services.map((s, i) => (
            <button
              class="explorer__tab"
              role="tab"
              id={`explorer-tab-${s.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="explorer-panel"
              tabindex={i === 0 ? 0 : -1}
              data-slug={s.slug}
              data-layer-name={s.layer}
            >
              <span class="t-mono explorer__code">{s.code}</span>
              <span class="explorer__name">{s.name}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="explorer__stage" id="explorer-panel" role="tabpanel" aria-labelledby={`explorer-tab-${services[0].slug}`} tabindex="0">
        <div class="explorer__drawing">
          <BuildingSvg />
        </div>

        {industryRows.map((ind) => (
          <div class="explorer__detail" data-industry-detail={ind.slug} hidden>
            <p class="explorer__summary">{ind.summary}</p>
            <p class="t-muted">{ind.need}</p>
            <div class="explorer__actions">
              <Button href={contactHref({ about: ind.slug })} variant="outline">
                Ask about {ind.name.toLowerCase()}
              </Button>
            </div>
          </div>
        ))}

        {services.map((s, i) => (
          <div class="explorer__detail" data-detail={s.slug} hidden={i !== 0}>
            <div class="explorer__detail-head">
              <span class="t-mono explorer__layer">{s.code} · {s.layer}</span>
              <h3 class="t-h3">{s.name}</h3>
            </div>
            <p class="t-muted">{s.short}</p>
            <ul role="list" class="explorer__includes">
              {s.includes.map((inc) => <li>{inc}</li>)}
            </ul>
            <div class="explorer__actions">
              <Button href={contactHref({ about: s.slug })} variant="outline">
                Ask about {s.name.toLowerCase()}
              </Button>
              <a class="explorer__link" href={`/services/${s.slug}/`}>See {s.name}</a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="explorer__foot">
      <p class="explorer__foot-text">{services.length} disciplines · One point of contact</p>
      <Button href="/services/" variant="outline">All services</Button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]');
    const svg = root.querySelector<SVGSVGElement>('.bx');
    const layerName = root.querySelector<SVGTextElement>('[data-bx-layer-name]');
    const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    const industryDetails = [...root.querySelectorAll<HTMLElement>('[data-industry-detail]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-industry]')];
    const rooms = [...root.querySelectorAll<SVGElement>('[data-room]')];
    if (!tabs.length || !panel || !svg) return;

    const codeOf = (slug: string) => tabs.find((t) => t.dataset.slug === slug)?.querySelector('.explorer__code')?.textContent ?? '';

    let index = 0;
    // What the drawing shows when no room is hovered: the selected tab, or the chosen industry.
    let base: { slugs: string[]; label: string } = { slugs: [], label: '' };

    /** Light the given layers (one or many) and set the label in the sheet title. */
    const paint = (slugs: string[], label: string) => {
      svg.setAttribute('data-active', slugs.join(' '));
      svg.querySelectorAll('[data-layer]').forEach((g) => {
        g.classList.toggle('is-active', slugs.includes(g.getAttribute('data-layer')!));
      });
      if (layerName) layerName.textContent = label;
    };

    const select = (i: number, { focus = false } = {}) => {
      index = (i + tabs.length) % tabs.length;
      const tab = tabs[index];
      const slug = tab.dataset.slug!;

      tabs.forEach((t, n) => {
        const on = n === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      industryDetails.forEach((d) => (d.hidden = true));
      panel.setAttribute('aria-labelledby', tab.id);
      details.forEach((d) => (d.hidden = d.dataset.detail !== slug));

      base = {
        slugs: [slug],
        label: `LAYER ${tab.querySelector('.explorer__code')?.textContent} · ${tab.dataset.layerName?.toUpperCase()}`,
      };
      paint(base.slugs, base.label);

      if (focus) tab.focus();
    };

    /** Multi-system mode for an industry chip. Choosing the pressed chip again returns to the tab. */
    const chooseIndustry = (chip: HTMLButtonElement) => {
      if (chip.getAttribute('aria-pressed') === 'true') {
        select(index);
        return;
      }
      const slug = chip.dataset.industry!;
      const detail = industryDetails.find((d) => d.dataset.industryDetail === slug);
      const systems = (chip.dataset.systems ?? '').split(' ').filter(Boolean);
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
      details.forEach((d) => (d.hidden = true));
      industryDetails.forEach((d) => (d.hidden = d !== detail));
      panel.setAttribute('aria-labelledby', 'explorer-chips-label');
      base = {
        slugs: systems,
        label: `${chip.textContent?.trim().toUpperCase()} · ${systems.map(codeOf).join(' ')}`,
      };
      paint(base.slugs, base.label);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {
          ArrowDown: index + 1,
          ArrowRight: index + 1,
          ArrowUp: index - 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(e.key in keys)) return;
        e.preventDefault();
        select(keys[e.key], { focus: true });
      });
    });

    chips.forEach((chip) => chip.addEventListener('click', () => chooseIndustry(chip)));

    // Room hover / focus: light the systems drawn in that room, then restore on leave.
    rooms.forEach((room) => {
      const show = () => {
        const slugs = (room.dataset.systems ?? '').split(' ').filter(Boolean);
        paint(slugs, `${room.dataset.roomName} · ${(room.dataset.codes ?? '')}`);
      };
      const hide = () => paint(base.slugs, base.label);
      room.addEventListener('mouseenter', show);
      room.addEventListener('mouseleave', hide);
      room.addEventListener('focus', show);
      room.addEventListener('blur', hide);
    });

    select(0);
  });
</script>

<style>
  .explorer__body {
    display: grid;
    gap: 1.5rem var(--col-gap);
  }

  /* Grid items default to min-width:auto, which lets the scrolling tab strip push the
     column wider than the phone screen. */
  .explorer__body > * {
    min-width: 0;
  }

  .explorer__chips-label {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--steel);
    margin-bottom: 0.5rem;
  }

  .explorer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .explorer__chip {
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--field-line);
    border-radius: var(--radius);
    background: transparent;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 500;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .explorer__chip:hover {
    border-color: var(--ink);
  }

  .explorer__chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .explorer__summary {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--text);
  }

  .explorer__hint {
    margin-bottom: 0.75rem;
  }

  /* Tabs: horizontal scroller on phones, vertical list on desktop */
  .explorer__tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: 2px;
  }

  .explorer__tabs::-webkit-scrollbar {
    display: none;
  }

  .explorer__tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-shrink: 0;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--field-line);
    border-radius: var(--radius);
    background: transparent;
    text-align: left;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .explorer__tab:hover {
    border-color: var(--ink);
  }

  .explorer__tab[aria-selected='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .explorer__code {
    color: var(--steel);
  }

  .explorer__tab[aria-selected='true'] .explorer__code {
    color: var(--paper);
  }

  .explorer__code {
    font-size: var(--fs-label);
  }

  .explorer__name {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-small);
  }

  /* Stage */
  .explorer__stage {
    display: grid;
    gap: 1.5rem;
    outline-offset: 6px;
  }

  .explorer__drawing {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: clamp(0.5rem, 0.2rem + 1.5vw, 1.5rem);
  }

  .explorer__detail {
    display: grid;
    gap: 0.875rem;
    justify-items: start;
  }

  /* display:grid above beats the browser's [hidden] rule, so inactive systems stayed visible
     (and their links stayed in the Tab order) */
  .explorer__detail[hidden] {
    display: none;
  }

  .explorer__detail-head {
    display: grid;
    gap: 0.5rem;
  }

  .explorer__layer {
    color: var(--steel);
  }

  .explorer__includes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
  }

  .explorer__includes li {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    color: var(--text);
  }

  .explorer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 0;
  }

  .explorer__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4) var(--sp-6);
    margin-top: var(--space-block);
  }

  .explorer__foot-text {
    font-family: var(--font-sans);
    color: var(--text);
    font-size: var(--fs-small);
  }

  .explorer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    font-size: var(--fs-small);
    padding-bottom: 2px;
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat;
    transition: color var(--dur-fast) ease;
  }

  .explorer__link:hover {
    color: var(--signal);
  }

  @media (min-width: 1024px) {
    .explorer__body {
      grid-template-columns: 4fr 8fr;
      align-items: start;
    }

    .explorer__tabs-wrap {
      align-self: start;
      margin-top: 0;
    }

    .explorer__tabs {
      flex-direction: column;
      gap: 0;
      overflow: visible;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--hairline);
    }

    .explorer__tab {
      display: grid;
      grid-template-columns: 3.5rem 1fr;
      padding: 1.125rem 1rem;
      border: 0;
      border-bottom: 1px solid var(--hairline);
      border-radius: 0;
    }

    .explorer__tab:hover {
      background: var(--white);
    }

    .explorer__name {
      font-size: 1.0625rem;
    }

    .explorer__stage {
      grid-template-columns: 1fr;
    }
  }
</style>
