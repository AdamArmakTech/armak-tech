---
/**
 * Services as a typographic schedule, like the legend on a drawing (DESIGN.md rules 2, 5).
 * One row per service: code, name, one line, what is included, link. No photos until real
 * product images exist.
 */
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { services } from '../../data/site';

const href = (slug: string) => `/services/${slug}/`;
---

<section id="services" class="section services">
  <div class="container">
    <SectionHead
      title="Every low-voltage system your building runs on."
      intro="We handle cabling, networks, security cameras, door access, phones and AV, so you deal with one team and one point of contact."
    />

    <ul role="list" class="services__list">
      {services.map((s) => (
        <li class="services__row">
          <span class="t-mono services__code">{s.code}</span>
          <h3 class="services__name">{s.name}</h3>
          <p class="services__desc">{s.short}</p>
          {s.includes && s.includes.length > 0 && (
            <p class="services__includes">{s.includes.join(' · ')}</p>
          )}
          <a class="services__link" href={href(s.slug)}>
            See service <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="services__foot">
      <p class="t-muted">{services.length} disciplines · One point of contact</p>
      <Button href="/services/" variant="ink">All services</Button>
    </div>
  </div>
</section>

<style>
  .services__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--col-gap);
    border-top: 1px solid var(--hairline);
  }

  .services__row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
    min-width: 0;
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--hairline);
  }

  .services__code {
    color: var(--steel);
  }

  .services__name {
    font-family: var(--font-sans);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: var(--tracking-heading);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .services__desc {
    color: var(--text);
    font-size: var(--fs-body);
    max-width: 36em;
  }

  .services__includes {
    color: var(--text);
    font-size: var(--fs-small);
    max-width: 36em;
  }

  .services__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    margin-top: auto;
    font-weight: 500;
    font-size: var(--fs-small);
    color: var(--ink);
    transition: color var(--dur-fast) ease;
  }

  .services__link:hover {
    color: var(--signal);
  }

  .services__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4) var(--sp-6);
    margin-top: var(--space-block);
  }

  /* Two columns: each row still has its own bottom hairline, so the list reads as a table */
  @media (min-width: 640px) {
    .services__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-6);
    }
  }

  @media (min-width: 1024px) {
    .services__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--sp-7);
    }
  }
</style>
