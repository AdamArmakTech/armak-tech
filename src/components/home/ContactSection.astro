---
/**
 * Homepage closing section: site-assessment form + direct contact details (old look).
 */
import SectionHead from '../ui/SectionHead.astro';
import ContactForm from '../forms/ContactForm.astro';
import { site } from '../../data/site';
---

<section class="contact section" id="contact" data-dock-hide>
  <div class="container">
    <SectionHead
      title="Tell us about the site."
      intro="Pick the systems and leave your details. We’ll walk the site, scope the work and send you a clear written estimate."
    />

    <div class="contact__body">
      <div class="contact__panel" data-reveal="scale">
        <ContactForm id="home-assessment" />
      </div>

      <aside class="contact__info" aria-label="Contact details" data-reveal-group>
        <div class="contact__direct">
          <p class="t-meta">Prefer to talk?</p>
          <a class="contact__phone tel" href={site.phoneHref}>{site.phone}</a>
          <a class="contact__email" href={site.emailHref}>{site.email}</a>
        </div>

        <ul role="list" class="contact__rows">
          <li>
            <span class="t-meta contact__key">Hours</span>
            <span>{site.hours}</span>
          </li>
          <li>
            <span class="t-meta contact__key">Support</span>
            <span>{site.support}</span>
          </li>
          <li>
            <span class="t-meta contact__key">Headquarters</span>
            <span>{site.hq.city}, California<br /><span class="t-meta">Serving all of Southern California</span></span>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact__body {
    display: grid;
    gap: var(--col-gap);
    align-items: start;
  }

  .contact__panel {
    padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    background: var(--white);
    border-radius: var(--radius);
    min-width: 0;
  }

  .contact__info {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  .contact__direct {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .contact__phone {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .contact__email {
    color: var(--text);
  }

  .contact__phone,
  .contact__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__phone:hover,
    .contact__email:hover {
      text-decoration-color: currentColor;
    }
  }

  .contact__rows {
    display: grid;
    gap: var(--sp-4);
  }

  .contact__rows li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 0.875rem;
    align-items: start;
    font-size: var(--fs-small);
    overflow-wrap: anywhere;
  }

  .contact__key {
    padding-top: 0.2rem;
    color: var(--steel);
  }

  @media (max-width: 420px) {
    .contact__rows li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .contact__body {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .contact__panel {
      grid-column: 1 / span 8;
    }

    .contact__info {
      grid-column: 9 / -1;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
