---
/**
 * Homepage closing section: site-assessment form + direct contact details.
 * It is the page's dark end band and runs straight into the footer (DESIGN.md rule 8).
 */
import SectionHead from '../ui/SectionHead.astro';
import ContactForm from '../forms/ContactForm.astro';
import { site } from '../../data/site';
---

<section class="contact cta-band surface-ink" id="contact" data-dock-hide>
  <div class="container">
    <!-- Direction A: the form is the coupon at the back of the package: a white card on the dark
         end band (rule 8), the stub (heading and direct contact) parted from the form by a
         perforation with a notch cut at each end. -->
    <div class="coupon surface-card">
      <div class="coupon__stub">
        <SectionHead
          title="Tell us about the site."
          intro="Pick the systems and leave your details. We’ll walk the site, scope the work and send you a clear written plan and price."
        />
      </div>

      <div class="coupon__form" data-reveal>
        <ContactForm id="home-assessment" />
      </div>

      <aside class="coupon__info contact__info" aria-label="Contact details">
        <div class="contact__direct">
          <p class="contact__prefer">Prefer to talk?</p>
          <a class="contact__phone tel" href={site.phoneHref}>{site.phone}</a>
          <a class="contact__email" href={site.emailHref}>{site.email}</a>
        </div>

        <ul role="list" class="contact__rows">
          <li>
            <span class="contact__key">Hours</span>
            <span>{site.hours}</span>
          </li>
          <li>
            <span class="contact__key">Support</span>
            <span>{site.support}</span>
          </li>
          <li>
            <span class="contact__key">Headquarters</span>
            <span>{site.hq.city}, California<br /><span class="contact__muted">Serving all of Southern California</span></span>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-section);
    margin-bottom: 0;
  }

  /* ── The coupon ── */
  .coupon {
    --notch: 28px;
    --perf: 5px dotted var(--ink);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--white);
    color: var(--text);
  }

  .coupon__stub,
  .coupon__info {
    padding: var(--sp-6) var(--sp-5);
  }

  .coupon__stub :global(.section-head) {
    margin-bottom: 0;
  }

  .coupon__stub :global(.section-head__title) {
    color: var(--ink);
  }

  .coupon__stub :global(.section-head__intro) {
    color: var(--text);
  }

  .coupon__form {
    position: relative;
    min-width: 0;
    padding: var(--sp-6) var(--sp-5);
    border-top: var(--perf);
  }

  /* Notches: two ink half-circles where the perforation meets the card's edges */
  .coupon__form::before,
  .coupon__form::after {
    content: '';
    position: absolute;
    width: var(--notch);
    height: var(--notch);
    border-radius: 50%;
    background: var(--ink);
    top: calc(var(--notch) / -2 - 2.5px);
  }

  .coupon__form::before {
    left: calc(var(--notch) / -2);
  }

  .coupon__form::after {
    right: calc(var(--notch) / -2);
  }

  .coupon__info {
    display: grid;
    gap: var(--sp-6);
    align-content: start;
    border-top: var(--perf);
  }

  .contact__direct {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .contact__prefer,
  .contact__muted {
    color: var(--steel);
  }

  .contact__prefer {
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .contact__phone {
    color: var(--ink);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .contact__email {
    color: var(--text);
  }

  /* 44px tap height without moving the layout */
  .contact__phone,
  .contact__email {
    padding-block: 0.625rem;
    margin-block: -0.625rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur) var(--ease-out);
  }

  .contact__phone:hover,
  .contact__email:hover {
    text-decoration-color: currentColor;
  }

  .contact__rows {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .contact__rows li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 0.875rem;
    align-items: start;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--hairline);
    font-size: var(--fs-small);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .contact__key {
    padding-top: 0.2rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--steel);
  }

  @media (max-width: 420px) {
    .contact__rows li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 640px) {
    .coupon__stub,
    .coupon__info,
    .coupon__form {
      padding: var(--sp-7);
    }
  }

  @media (min-width: 1024px) {
    .coupon {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
    }

    .coupon__stub {
      grid-column: 1;
      grid-row: 1;
      padding-bottom: var(--sp-5);
    }

    .coupon__info {
      grid-column: 1;
      grid-row: 2;
      border-top: 0;
      padding-top: var(--sp-5);
    }

    .coupon__form {
      grid-column: 2;
      grid-row: 1 / 3;
      border-top: 0;
      border-left: var(--perf);
      padding: var(--sp-8) var(--sp-8) var(--sp-8) var(--sp-7);
    }

    .coupon__form::before,
    .coupon__form::after {
      left: calc(var(--notch) / -2 - 2.5px);
      right: auto;
    }

    .coupon__form::before {
      top: calc(var(--notch) / -2);
    }

    .coupon__form::after {
      top: auto;
      bottom: calc(var(--notch) / -2);
    }
  }
</style>
