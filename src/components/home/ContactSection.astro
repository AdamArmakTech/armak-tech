---
/**
 * Homepage closing section: site-assessment form + direct contact details.
 * Direction A: the page ends light. The coupon (white sheet) sits on paper, above the paper footer.
 */
import SectionHead from '../ui/SectionHead.astro';
import ContactForm from '../forms/ContactForm.astro';
import { site } from '../../data/site';
---

<section class="contact cta-band" id="contact" data-dock-hide>
  <div class="container">
    <!-- Direction A: the form is the coupon at the back of the package: a white card on paper,
         the stub (heading and direct contact) parted from the form by a
         perforation with a notch cut at each end. -->
    <div class="coupon surface-card">
      <div class="coupon__stub">
        <SectionHead
          title="Tell us about the site."
          intro="Pick the systems and leave your details. Start with a free rough quote, or book an on-site assessment for an accurate estimate."
        />
      </div>

      <div class="coupon__form" data-reveal>
        <span class="coupon__perf" aria-hidden="true"></span>
        <ContactForm id="home-assessment" />
      </div>

      <aside class="coupon__info contact__info" aria-label="Contact details">
        <div class="contact__direct">
          <p class="contact__prefer">Prefer to talk?</p>
          <a class="contact__phone tel" href={site.phoneHref}>{site.phone}</a>
          <a class="contact__email" href={site.emailHref}>{site.email}</a>
        </div>

        <ul role="list" class="contact__rows">
          <li>
            <span class="contact__key">Hours</span>
            <span>{site.hours}</span>
          </li>
          <li>
            <span class="contact__key">Support</span>
            <span>{site.support}</span>
          </li>
          <li>
            <span class="contact__key">Headquarters</span>
            <span>{site.hq.city}, California<br /><span class="contact__muted">Serving all of Southern California</span></span>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-section);
    margin-bottom: 0;
  }

  /* ── The coupon: a white sheet on paper ── */
  .coupon {
    --notch: 28px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--white);
    color: var(--text);
    border: 1px solid var(--hairline);
  }

  .coupon__stub,
  .coupon__info {
    padding: var(--sp-6) var(--sp-5);
  }

  .coupon__stub :global(.section-head) {
    margin-bottom: 0;
  }

  .coupon__stub :global(.section-head__title) {
    color: var(--ink);
  }

  .coupon__stub :global(.section-head__intro) {
    color: var(--text);
  }

  .coupon__form {
    position: relative;
    min-width: 0;
    padding: var(--sp-6) var(--sp-5);
  }

  /* The perforation: a dashed line drawn in --hairline-strong on the white sheet. Mobile: along the
     form's top edge. Desktop: down its left edge. It runs between the two notches, stops short of each
     one and sits above both in z-order, so both ends look the same. The pattern tile is 11px: 2px of gap,
     a 6px dash, 3px of gap. `space` lays out a whole number of tiles with the first and last flush to
     the ends of the line, so the line starts 1px later than it ends (--perf-start, --perf-end) and the
     first and last dash both sit 5px from their notch. */
  .coupon__perf {
    --perf-start: calc(var(--notch) / 2 + 2px);
    --perf-end: calc(var(--notch) / 2 + 1px);
    position: absolute;
    z-index: 1;
    top: -1px;
    left: var(--perf-start);
    right: var(--perf-end);
    height: 2px;
    background: linear-gradient(90deg, transparent 2px, var(--hairline-strong) 2px 8px, transparent 8px) 0 0 / 11px 100% space;
    pointer-events: none;
  }

  /* Notches: a bite cut from the sheet at each end of the perforation. Each is a paper half-disc whose flat
     side lies on the sheet's outer edge and whose curved side is the 1px hairline, so only the half inside
     the sheet is drawn and nothing floats on the paper outside it. Mobile: bites in the left and right
     edges, centred on the perforation. */
  .coupon__form::before,
  .coupon__form::after {
    content: '';
    position: absolute;
    top: calc(var(--notch) / -2);
    width: calc(var(--notch) / 2);
    height: var(--notch);
    background: var(--paper);
    border: 1px solid var(--hairline);
  }

  .coupon__form::before {
    left: -1px;
    border-left-width: 0;
    border-radius: 0 calc(var(--notch) / 2) calc(var(--notch) / 2) 0;
  }

  .coupon__form::after {
    right: -1px;
    border-right-width: 0;
    border-radius: calc(var(--notch) / 2) 0 0 calc(var(--notch) / 2);
  }

  .coupon__info {
    display: grid;
    gap: var(--sp-6);
    align-content: start;
    border-top: 1px dashed var(--hairline-strong);
  }

  .contact__direct {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .contact__prefer,
  .contact__muted {
    color: var(--steel);
  }

  .contact__prefer {
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .contact__phone {
    color: var(--ink);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .contact__email {
    color: var(--text);
  }

  /* 44px tap height without moving the layout */
  .contact__phone,
  .contact__email {
    padding-block: 0.625rem;
    margin-block: -0.625rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur) var(--ease-out);
  }

  .contact__phone:hover,
  .contact__email:hover {
    text-decoration-color: currentColor;
  }

  .contact__rows {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  .contact__rows li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 0.875rem;
    align-items: start;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--hairline);
    font-size: var(--fs-small);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .contact__key {
    padding-top: 0.2rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--steel);
  }

  @media (max-width: 420px) {
    .contact__rows li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 640px) {
    .coupon__stub,
    .coupon__info,
    .coupon__form {
      padding: var(--sp-7);
    }
  }

  @media (min-width: 1024px) {
    .coupon {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
    }

    .coupon__stub {
      grid-column: 1;
      grid-row: 1;
      padding-bottom: var(--sp-5);
    }

    .coupon__info {
      grid-column: 1;
      grid-row: 2;
      border-top: 0;
      padding-top: var(--sp-5);
    }

    .coupon__form {
      grid-column: 2;
      grid-row: 1 / 3;
      padding: var(--sp-8) var(--sp-8) var(--sp-8) var(--sp-7);
    }

    /* Desktop: the perforation runs down the form's left edge, and the notches become bites in the sheet's
       top and bottom edges, centred on the line. */
    .coupon__perf {
      top: var(--perf-start);
      bottom: var(--perf-end);
      left: -1px;
      right: auto;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, transparent 2px, var(--hairline-strong) 2px 8px, transparent 8px) 0 0 / 100% 11px space;
    }

    .coupon__form::before,
    .coupon__form::after {
      left: calc(var(--notch) / -2);
      right: auto;
      width: var(--notch);
      height: calc(var(--notch) / 2);
      border-width: 1px;
    }

    .coupon__form::before {
      top: -1px;
      border-top-width: 0;
      border-radius: 0 0 calc(var(--notch) / 2) calc(var(--notch) / 2);
    }

    .coupon__form::after {
      top: auto;
      bottom: -1px;
      border-bottom-width: 0;
      border-radius: calc(var(--notch) / 2) calc(var(--notch) / 2) 0 0;
    }
  }

  /* The perforation pulls (owner-approved, DESIGN.md Direction A): on hover or when focus is inside the
     coupon, the stub side slides 3px away from the line and the dashes tighten. 200 ms ease-out, returns
     on leave. Pointer devices only; transform only. Reduced motion: none. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .coupon__stub,
    .coupon__info,
    .coupon__perf {
      transition: transform 200ms var(--ease-out);
    }

    .coupon:hover .coupon__stub,
    .coupon:focus-within .coupon__stub {
      transform: translateY(-3px);
    }

    .coupon:hover .coupon__perf,
    .coupon:focus-within .coupon__perf {
      transform: scaleX(0.97);
    }

    @media (min-width: 1024px) {
      .coupon:hover .coupon__stub,
      .coupon:hover .coupon__info,
      .coupon:focus-within .coupon__stub,
      .coupon:focus-within .coupon__info {
        transform: translateX(-3px);
      }

      .coupon:hover .coupon__perf,
      .coupon:focus-within .coupon__perf {
        transform: scaleY(0.97);
      }
    }
  }
</style>
