---
import CableTest from '../ui/CableTest.astro';
import Button from '../ui/Button.astro';
import { site, yearsInBusiness } from '../../data/site';
import { credentials } from '../../data/content';
import { contactHref } from '../../lib/cta';

// Two quieter routes under the one red action (rule 7: one red-filled button per screen)
const routes = [
  {
    href: '/plan/',
    title: 'Planning a project?',
    detail: 'Still figuring it out. Get the checklist and a rough estimate.',
  },
  {
    href: contactHref({ intent: 'support' }),
    title: 'Something’s broken?',
    detail: 'Existing customer with a problem or a change.',
  },
];
---

<section class="hero surface-ink" aria-labelledby="hero-title">
  <div class="container hero__grid">
  <!-- CSS-only entrance (no data-split): the LCP headline must never wait on a JS download -->
  <h1 id="hero-title" class="hero__title">Built for the future.</h1>
  <div class="hero__copy">
    <!-- hero-in = the same fade/rise as [data-reveal], but CSS-only so the hero paints on first
         render instead of waiting for motion.ts to download and boot -->
    <p class="t-lead hero-in">
      {yearsInBusiness} years designing, installing and certifying the cabling, networks and security
      systems Southern California businesses run on.
    </p>
    <div class="hero__choose hero-in" style="--reveal-delay: 120ms">
      <div data-dock-start>
        <Button href={contactHref()} size="lg">Request a site assessment</Button>
      </div>
      <ul role="list" class="hero__routes">
        {routes.map((r) => (
          <li>
            <a class="route" href={r.href}>
              <span class="route__title">{r.title}</span>
              <span class="route__detail">{r.detail}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="t-small hero__phone">Or call <a class="tel" href={site.phoneHref}>{site.phone}</a>, {site.hours.replace(' · ', ', ')}<span data-hero-status data-hours={site.hours} hidden></span></p>
    </div>
    <ul role="list" class="t-small hero__creds hero-in" style="--reveal-delay: 220ms">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <div class="hero__media surface-card hero-in" style="--reveal-delay: 150ms">
    <CableTest variant="compact" class="hero__card" />
  </div>
  </div>
</section>

<script>
  import { parseHours, openStatus } from '../../lib/hours';

  // Appends " · Open now" (hours are already in the line) (or the next opening) after the call line; empty until the client fills it
  const el = document.querySelector<HTMLElement>('[data-hero-status]');
  const hours = el ? parseHours(el.dataset.hours ?? '') : null;
  if (el && hours) {
    const update = () => {
      const s = openStatus(new Date(), hours);
      const short = s.label.replace(/ · until .*$/, '');
      el.textContent = short ? ` · ${short}` : '';
      el.hidden = !s.label;
    };
    update();
    const timer = window.setInterval(update, 60_000);
    window.addEventListener('pagehide', () => window.clearInterval(timer), { once: true });
  }
</script>

<style>
  /*
   * Direction A, "the closeout package": the hero is the dark cover of the package.
   * The headline runs the full width at poster size; the cable test report is the first sheet,
   * and it hangs over the band's bottom edge into the paper below (--hero-overhang).
   */
  .hero {
    position: relative;
    z-index: 1;
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 6rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 1.4rem + 2.4vw, 3.5rem) var(--col-gap);
  }

  .hero__title {
    color: var(--paper);
    font-size: clamp(3.5rem, 1rem + 15vw, 11rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    font-weight: 600;
    max-width: none;
    text-wrap: balance;
  }

  .hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    align-content: start;
  }

  .hero__copy :global(.t-lead) {
    color: var(--paper);
    max-width: 30em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title {
      animation: hero-title-in 800ms var(--ease-out) both;
    }

    /* Same values as the global [data-reveal] transition (opacity + 24px rise, --ease-out); 680ms so the longest delay (220ms) ends by 900ms */
    .hero-in {
      animation: hero-in 680ms var(--ease-out) var(--reveal-delay, 0ms) both;
    }

    /* The report sheet is placed on the desk: drops in from 24px up with a slight tilt, shadow
       grows as it lands. Starts ~250ms after the headline; one play, 650ms. Overrides hero-in. */
    .hero__media.hero-in {
      animation: hero-sheet-settle 650ms cubic-bezier(0.22, 1.2, 0.36, 1) 250ms both;
      transform-origin: 50% 0;
    }

    .hero__media.hero-in::after {
      animation: hero-sheet-shadow 650ms var(--ease-out) 250ms both;
    }
  }

  /* Shadow lives on a pseudo-element so only its opacity animates */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    box-shadow: var(--shadow-raise);
    pointer-events: none;
  }

  @keyframes hero-sheet-settle {
    from {
      opacity: 0;
      transform: translate3d(0, -24px, 0) rotate(-1.2deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-sheet-shadow {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-title-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.25em, 0);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 -20% 0);
    }
  }

  .hero__choose {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 36rem;
  }

  /* Two plain rows, hairline-separated like a schedule (rule 5) */
  .hero__routes {
    border-top: 1px solid var(--hairline-inverse);
  }

  .hero__routes li {
    border-bottom: 1px solid var(--hairline-inverse);
  }

  .route {
    display: grid;
    gap: 0.25rem;
    min-height: 44px;
    padding-block: 1rem;
  }

  .route__title {
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--paper);
  }

  .route:hover .route__title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .route__detail {
    font-size: var(--fs-body);
    line-height: 1.45;
    color: var(--steel-light);
  }

  .hero__phone {
    color: var(--steel-light);
  }

  .hero__phone a {
    color: var(--paper);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    display: inline-block;
    padding-block: 0.7rem;
    margin-block: -0.7rem;
  }

  .hero__creds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    color: var(--steel-light);
  }

  .hero__creds li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
  }

  /* 4px square between items */
  .hero__creds li + li::before {
    content: '';
    width: 4px;
    height: 4px;
    background: var(--steel-light);
    flex: none;
  }

  /* The cable test report is the first sheet of the package: white, flat, hanging over the edge */
  .hero__media {
    display: grid;
    color: var(--text);
    position: relative;
    margin-bottom: calc(var(--hero-overhang) * -1);
  }

  .hero__media :global(.hero__card) {
    width: 100%;
    max-width: none;
    background: var(--white);
    box-shadow: none;
    border: 0;
    border-radius: 0;
  }

  @media (max-width: 899px) {
    /* The sheet settles in tilted, and edge to edge that swings its corner 10-16px past the screen
       edge for the first second, so the page could be panned sideways. Clip the band sideways only:
       clip (not hidden) makes no scroll container, and the sheet still hangs over the band's foot. */
    .hero {
      overflow-x: clip;
    }

    /* On a phone the sheet runs edge to edge, like a page laid on the desk */
    .hero__media {
      margin-inline: calc(var(--gutter) * -1);
    }
  }

  @media (min-width: 1024px) {
    /* The headline holds seven columns; the report sheet takes the other five, starting level
       with the headline's second line so type and sheet lock together. */
    .hero {
      /* 10rem, not 11rem: "the future." has to fit the seven-column box, which stops growing once the
         container reaches 1360px. At 11rem it no longer fit from ~1475px wide, the headline broke into
         three lines and the sheet dropped ~150px. At 10rem it fits with ~24px to spare. */
      --hero-fs: min(10rem, 11.2vw);
    }

    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      align-items: start;
    }

    .hero__title {
      grid-column: 1 / 8;
      grid-row: 1;
      font-size: var(--hero-fs);
    }

    .hero__copy {
      grid-column: 1 / 7;
      grid-row: 2;
      padding-bottom: clamp(3rem, 1rem + 3vw, 4.5rem);
    }

    /* Anchored to the band's foot so it always crosses the edge into the paper below:
       headline top left, report bottom right, one diagonal through the cover. */
    .hero__media {
      grid-column: 8 / -1;
      grid-row: 1 / 3;
      align-self: end;
    }

    .hero__choose {
      max-width: none;
    }

    .hero__routes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--col-gap);
    }

    .hero__media :global(.hero__card) {
      padding: clamp(1.25rem, 0.25rem + 1.4vw, 2.25rem);
    }
  }
</style>
