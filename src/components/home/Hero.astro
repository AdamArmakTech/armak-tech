---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import CableTest from '../ui/CableTest.astro';
import { site, yearsInBusiness } from '../../data/site';
import { credentials } from '../../data/content';
import { contactHref } from '../../lib/cta';

// The front door: sort visitors by what they came for instead of one button for everyone
const paths = [
  {
    href: contactHref(),
    title: 'I need a quote',
    detail: 'You know what you need. Tell us the site and we’ll scope it.',
    go: 'Request a site assessment',
    primary: true,
  },
  {
    href: '/plan/',
    title: 'I’m planning a project',
    detail: 'Still figuring it out. Get the checklist and a rough estimate.',
    go: 'Checklist · Estimator',
    primary: false,
  },
  {
    href: contactHref({ intent: 'support' }),
    title: 'Something’s broken',
    detail: 'Existing customer with a problem or a change.',
    go: 'Call or send a request',
    primary: false,
  },
];
// TODO(photo): interim stock (Unsplash, see assets/photos/CREDITS.md) — replace with a real Armak install photo
import heroPhoto from '../../assets/photos/hero-tech-rack.jpg';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__copy">
    <nav class="hero__links t-mono" aria-label="Quick links">
      <ul role="list">
        <li><a href="/industries/">Industries</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <!-- CSS-only entrance (no data-split): the LCP headline must never wait on a JS download -->
    <h1 id="hero-title" class="t-display hero__title">Built for the future.</h1>
    <!-- hero-in = the same fade/rise as [data-reveal], but CSS-only so the hero (and its LCP photo)
         paints on first render instead of waiting for motion.ts to download and boot -->
    <p class="t-lead hero-in">
      {yearsInBusiness} years designing, installing and certifying the cabling, networks and security
      systems Southern California businesses run on.
    </p>
    <div class="hero__choose hero-in" data-dock-start style="--reveal-delay: 120ms">
      <p class="t-mono hero__choose-label" id="hero-paths-label">Pick the closest fit</p>
      <ul role="list" class="hero__paths" aria-labelledby="hero-paths-label">
        {paths.map((p) => (
          <li>
            <a class:list={['path', { 'path--primary': p.primary }]} href={p.href}>
              <span class="path__title">{p.title}</span>
              <span class="path__detail">{p.detail}</span>
              <span class="t-mono path__go">{p.go} <ArrowRight size={14} stroke-width={2} aria-hidden="true" /></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="t-small hero__phone">Or call <a href={site.phoneHref}>{site.phone}</a>, {site.hours.replace(' · ', ', ')}</p>
    </div>
    <ul role="list" class="hero__creds t-mono hero-in" style="--reveal-delay: 220ms">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <div class="hero__media hero-in" style="--reveal-delay: 150ms">
    <div class="hero__frame">
      <!-- sizes = the photo's real rendered width: 5/12 of the container on desktop (520px at the
           1360px cap), full width minus the side gutters below 1000px -->
      <Image
        src={heroPhoto}
        alt="A technician in a hi-vis vest working at a network rack with tools laid out on the floor"
        widths={[560, 720, 840, 1120, 1280, 1600]}
        sizes="(min-width: 1360px) 520px, (min-width: 1000px) 39vw, calc(100vw - 2rem)"
        loading="eager"
        fetchpriority="high"
      />
      <span class="hero__tag t-mono" aria-hidden="true">A-01 · Physical layer</span>
    </div>
    <CableTest variant="compact" class="hero__card" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-block) var(--col-gap);
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-bottom: var(--space-section);
  }

  .hero__copy {
    display: grid;
    gap: 1.75rem;
    align-content: end;
    justify-items: start;
  }


  /* Quick links row (same spot and look as the old spec strip, but clickable) */
  .hero__links {
    width: 100%;
    padding-block: 1rem;
    border-block: 1px solid var(--hairline);
  }

  .hero__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
  }

  .hero__links li {
    display: inline-flex;
    align-items: center;
  }

  .hero__links li:not(:last-child)::after {
    content: "";
    width: 4px;
    height: 4px;
    margin-inline: 1rem;
    background: var(--signal);
  }

  .hero__links a {
    font-size: 0.8125rem;
    color: var(--ink);
    transition: color var(--dur-fast) ease;
  }

  .hero__links a:hover {
    color: var(--signal);
  }

  .hero__title {
    max-width: 11ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title {
      animation: hero-title-in 1.1s var(--ease-out) both;
    }
  }

  /* Same values as the global [data-reveal] transition (opacity + 24px rise, --dur-slow, --ease-out) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in var(--dur-slow) var(--ease-out) var(--reveal-delay, 0ms) both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-title-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.35em, 0);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 -20% 0);
    }
  }

  /* Three-way chooser */
  .hero__choose {
    display: grid;
    gap: 0.875rem;
    width: 100%;
  }

  .hero__choose-label {
    color: var(--steel);
  }

  .hero__paths {
    display: grid;
    gap: 0.625rem;
  }

  .path {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 0.875rem 1rem 1rem;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-top: 2px solid var(--ink);
    border-radius: var(--radius);
    transition: border-color var(--dur-fast) ease, transform var(--dur) var(--ease-out);
  }

  .path--primary {
    border-top-color: var(--signal);
  }

  .path:hover {
    border-color: var(--ink);
    border-top-color: inherit;
  }

  .path--primary:hover {
    border-top-color: var(--signal);
  }

  .path__title {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .path__detail {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--steel);
  }

  .path__go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    color: var(--ink);
    transition: color var(--dur-fast) ease;
  }

  .path--primary .path__go,
  .path:hover .path__go {
    color: var(--signal);
  }

  .path__go :global(svg) {
    transition: transform var(--dur) var(--ease-out);
  }

  .path:hover .path__go :global(svg) {
    transform: translateX(3px);
  }

  .hero__phone {
    color: var(--steel);
  }

  .hero__phone a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    .hero__paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hero__creds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--steel);
  }

  .hero__creds li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__creds li::before {
    content: "";
    width: 6px;
    height: 6px;
    border: 1px solid var(--ink);
  }

  .hero__media {
    position: relative;
  }

  .hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .hero__frame img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hero__tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.35rem 0.55rem;
    background: var(--paper);
    border-radius: var(--radius);
  }

  /* Phones/tablets: card overlaps the lower part of the photo, right-aligned */
  .hero__media :global(.hero__card) {
    position: relative;
    width: min(320px, 86%);
    margin: -6rem 0.75rem 0 auto;
  }

  @media (min-width: 1000px) {
    .hero {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      min-height: calc(100svh - var(--header-h));
    }

    /* Keep the copy clear of the cable-test card, which hangs 4.5rem into the gutter */
    .hero__copy {
      padding-right: calc(4.5rem - var(--col-gap) + 1rem);
    }

    .hero__media {
      padding-bottom: 4rem;
    }

    .hero__frame img {
      aspect-ratio: 4 / 5;
      max-height: min(78vh, 760px);
    }

    /* Desktop: card floats over the photo's lower-left edge */
    .hero__media :global(.hero__card) {
      position: absolute;
      left: -4.5rem;
      bottom: 0;
      width: min(330px, 88%);
      margin: 0;
    }
  }
</style>
