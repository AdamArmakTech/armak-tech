---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import CableTest from '../ui/CableTest.astro';
import { site, yearsInBusiness } from '../../data/site';
import { credentials } from '../../data/content';
import { contactHref, CTA_LABEL } from '../../lib/cta';

// The front door: sort visitors by what they came for instead of one button for everyone
const paths = [
  {
    href: contactHref(),
    title: 'I need a quote',
    detail: 'You know what you need. Tell us the site and we’ll scope it.',
    go: CTA_LABEL,
    primary: true,
  },
  {
    href: '/plan/',
    title: 'I’m planning a project',
    detail: 'Still figuring it out. Get the checklist and a rough estimate.',
    go: 'Checklist and estimator',
    primary: false,
  },
  {
    href: contactHref({ intent: 'support' }),
    title: 'Something’s broken',
    detail: 'Existing customer with a problem or a change.',
    go: 'Call or send a request',
    primary: false,
  },
];
// TODO(photo): interim stock (Unsplash, see assets/photos/CREDITS.md) — replace with a real Armak install photo
import heroPhoto from '../../assets/photos/hero-tech-rack.jpg';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__copy">
    <nav class="hero__links t-meta" aria-label="Quick links">
      <ul role="list">
        <li><a href="/industries/">Industries</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <!-- CSS-only entrance (no data-split): the LCP headline must never wait on a JS download -->
    <h1 id="hero-title" class="t-display hero__title">Built for the future.</h1>
    <!-- hero-in = the same fade/rise as [data-reveal], but CSS-only so the hero (and its LCP photo)
         paints on first render instead of waiting for motion.ts to download and boot -->
    <p class="t-lead hero__lead hero-in">
      {yearsInBusiness} years designing, installing and certifying the cabling, networks and security
      systems Southern California businesses run on.
    </p>
    <Button class="hero__cta hero-in" href={contactHref()} style="--reveal-delay: 80ms">{CTA_LABEL}</Button>
    <div class="hero__media hero-in" style="--reveal-delay: 150ms">
      <div class="hero__frame">
        <!-- sizes = the photo's real rendered width: 5/12 of the container on desktop (520px at the
             1360px cap), full width minus the side gutters below 1000px -->
        <Image
          src={heroPhoto}
          alt="A technician in a hi-vis vest working at a network rack with tools laid out on the floor"
          widths={[560, 720, 840, 1120, 1280, 1600]}
          sizes="(min-width: 1360px) 520px, (min-width: 1000px) 39vw, calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <CableTest variant="compact" class="hero__card" />
    </div>
    <div class="hero__choose hero-in" data-dock-start style="--reveal-delay: 120ms">
      <p class="t-meta hero__choose-label" id="hero-paths-label">Pick the closest fit</p>
      <ul role="list" class="hero__paths" aria-labelledby="hero-paths-label">
        {paths.map((p) => (
          <li>
            <a class:list={['path', { 'path--primary': p.primary }]} href={p.href}>
              <span class="path__title">{p.title}</span>
              <span class="path__detail">{p.detail}</span>
              <span class="t-meta path__go">{p.go}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="t-small hero__phone">Or call <a class="tel" href={site.phoneHref}>{site.phone}</a>, {site.hours.replace(' · ', ', ')}<span data-hero-status data-hours={site.hours} hidden></span></p>
    </div>
    <ul role="list" class="hero__creds t-meta hero-in" style="--reveal-delay: 220ms">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<script>
  import { mountOpenStatus } from '../../lib/hours';

  // Appends ". Open now" (hours are already in the line) or the next opening after the call line; empty until the client fills it
  mountOpenStatus(document.querySelector<HTMLElement>('[data-hero-status]'), (s, el) => {
    const short = s.label.replace(/, until .*$/, '');
    el.textContent = short ? `. ${short}` : '';
    el.hidden = !s.label;
  });
</script>

<style>
  .hero {
    display: grid;
    gap: 1.75rem var(--col-gap);
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-bottom: var(--space-section);
  }

  /* The copy wrapper dissolves into the page grid at every width, so the HTML order (links, title,
     lead, button, photo and card, the three tiles, credentials) is also the order on screen and for
     the keyboard. Desktop places the same items in two columns with grid-template-areas below. */
  .hero__copy {
    display: contents;
  }

  .hero :global(.hero__cta) {
    justify-self: start;
  }

  .hero__title,
  .hero__lead,
  .hero :global(.hero__cta),
  .hero__creds {
    justify-self: start;
  }

  /* Quick links row: plain text, spacing only */
  .hero__links {
    width: 100%;
  }

  .hero__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-5);
  }

  .hero__links li {
    display: inline-flex;
    align-items: center;
  }

  .hero__links a {
    display: inline-block;
    /* Taller tap area (48px; rows overlap a little when the links wrap, still above the 24px minimum); the negative margin cancels the padding so spacing is unchanged */
    padding-block: 0.8rem;
    margin-block: -0.8rem;
    color: var(--steel);
    transition: color var(--dur-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__links a:hover {
      color: var(--ink);
    }
  }

  .hero__title {
    max-width: 11ch;
  }

  .hero__lead {
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title {
      animation: hero-title-in 1.1s var(--ease-out) both;
    }
  }

  /* Same values as the global [data-reveal] transition (opacity + 24px rise, --dur-slow, --ease-out) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in var(--dur-slow) var(--ease-out) var(--reveal-delay, 0ms) both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-title-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.35em, 0);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 -20% 0);
    }
  }

  /* Three-way chooser */
  .hero__choose {
    display: grid;
    gap: 0.875rem;
    width: 100%;
  }

  .hero__paths {
    display: grid;
    gap: var(--sp-3);
  }

  .path {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 1rem 1.125rem 1.125rem;
    background: var(--white);
    border-radius: var(--radius);
    transition: transform var(--dur) var(--ease-out);
  }

  /* Press feedback: small squeeze (none under reduced motion) */
  .path:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .path:active {
      transform: none;
    }
  }

  .path__title {
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .path__detail {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--text);
  }

  .path__go {
    margin-top: 0.4rem;
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .path:hover .path__go {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .hero__phone {
    color: var(--text);
  }

  /* Taller tap area (44px) without moving the line */
  .hero__phone a {
    padding-block: 0.7rem;
    margin-block: -0.7rem;
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    .hero__paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hero__creds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--sp-5);
  }

  .hero__media {
    position: relative;
  }

  .hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .hero__frame img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* Phones: the card sits below the photo */
  .hero__media :global(.hero__card) {
    position: relative;
    width: min(320px, 100%);
    margin: var(--sp-3) 0 0;
  }

  /* Tablets: card overlaps the lower part of the photo, right-aligned */
  @media (min-width: 640px) {
    .hero__media :global(.hero__card) {
      width: min(320px, 86%);
      margin: -6rem 0.75rem 0 auto;
    }
  }

  @media (min-width: 1000px) {
    .hero {
      grid-template-columns: 7fr 5fr;
      /* 5.5rem keeps the copy clear of the cable-test card, which hangs 4.5rem into the gutter */
      column-gap: 5.5rem;
      grid-template-areas:
        'links media'
        'title media'
        'lead media'
        'cta media'
        'choose media'
        'creds media';
      align-content: end;
      justify-items: start;
      min-height: calc(100svh - var(--header-h));
    }

    .hero__links { grid-area: links; }
    .hero__title { grid-area: title; }
    .hero__lead { grid-area: lead; }
    .hero :global(.hero__cta) { grid-area: cta; }
    .hero__choose { grid-area: choose; justify-self: stretch; }
    .hero__creds { grid-area: creds; }

    .hero__media {
      grid-area: media;
      align-self: end;
      justify-self: stretch;
      padding-bottom: 4rem;
    }

    .hero__frame img {
      aspect-ratio: 4 / 5;
      max-height: min(78vh, 760px);
    }

    /* Desktop: card floats over the photo's lower-left edge */
    .hero__media :global(.hero__card) {
      position: absolute;
      left: -4.5rem;
      bottom: 0;
      width: min(330px, 88%);
      margin: 0;
    }
  }
</style>
