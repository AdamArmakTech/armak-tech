---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import CableTest from '../ui/CableTest.astro';
import { site, yearsInBusiness } from '../../data/site';
import { credentials } from '../../data/content';
// TODO(photo): interim stock (Unsplash, see assets/photos/CREDITS.md) — replace with a real Armak install photo
import heroPhoto from '../../assets/photos/hero-tech-rack.jpg';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__copy">
    <nav class="hero__links t-mono" aria-label="Quick links">
      <ul role="list">
        <li><a href="/industries/">Industries</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <!-- CSS-only entrance (no data-split): the LCP headline must never wait on a JS download -->
    <h1 id="hero-title" class="t-display hero__title">Built for the future.</h1>
    <p class="t-lead" data-reveal>
      {yearsInBusiness} years designing, installing and certifying the cabling, networks and security
      systems Southern California’s facilities run on — from first conduit to final certification.
    </p>
    <div class="hero__ctas" data-reveal style="--reveal-delay: 120ms">
      <Button href="#contact" size="lg">Request a site assessment</Button>
      <Button href={site.phoneHref} variant="outline" size="lg" icon="phone">{site.phone}</Button>
    </div>
    <ul role="list" class="hero__creds t-mono" data-reveal style="--reveal-delay: 220ms">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <div class="hero__media" data-reveal style="--reveal-delay: 150ms">
    <div class="hero__frame">
      <Image
        src={heroPhoto}
        alt="A technician in a hi-vis vest working at a network rack with tools laid out on the floor"
        widths={[560, 840, 1120, 1600]}
        sizes="(min-width: 1000px) 42vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <span class="hero__tag t-mono">A-01 · Physical layer</span>
    </div>
    <CableTest variant="compact" class="hero__card" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-block) var(--col-gap);
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-bottom: var(--space-section);
  }

  .hero__copy {
    display: grid;
    gap: 1.75rem;
    align-content: end;
    justify-items: start;
  }


  /* Quick links row (same spot and look as the old spec strip, but clickable) */
  .hero__links {
    width: 100%;
    padding-block: 1rem;
    border-block: 1px solid var(--hairline);
  }

  .hero__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
  }

  .hero__links li {
    display: inline-flex;
    align-items: center;
  }

  .hero__links li:not(:last-child)::after {
    content: "";
    width: 4px;
    height: 4px;
    margin-inline: 1rem;
    background: var(--signal);
  }

  .hero__links a {
    font-size: 0.8125rem;
    color: var(--ink);
    transition: color var(--dur-fast) ease;
  }

  .hero__links a:hover {
    color: var(--signal);
  }

  .hero__title {
    max-width: 11ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title {
      animation: hero-title-in 1.1s var(--ease-out) both;
    }
  }

  @keyframes hero-title-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.35em, 0);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 -20% 0);
    }
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__creds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--steel);
  }

  .hero__creds li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__creds li::before {
    content: "";
    width: 6px;
    height: 6px;
    border: 1px solid var(--ink);
  }

  .hero__media {
    position: relative;
  }

  .hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-sunken);
  }

  .hero__frame img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hero__tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.35rem 0.55rem;
    background: var(--paper);
    border-radius: var(--radius);
  }

  /* Phones/tablets: card overlaps the lower part of the photo, right-aligned */
  .hero__media :global(.hero__card) {
    position: relative;
    width: min(320px, 86%);
    margin: -6rem 0.75rem 0 auto;
  }

  @media (min-width: 1000px) {
    .hero {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      min-height: calc(100svh - var(--header-h));
    }

    .hero__media {
      padding-bottom: 4rem;
    }

    .hero__frame img {
      aspect-ratio: 4 / 5;
      max-height: min(78vh, 760px);
    }

    /* Desktop: card floats over the photo's lower-left edge */
    .hero__media :global(.hero__card) {
      position: absolute;
      left: -4.5rem;
      bottom: 0;
      width: min(330px, 88%);
      margin: 0;
    }
  }
</style>
