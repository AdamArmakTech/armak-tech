---
import CableTest from '../ui/CableTest.astro';
import Button from '../ui/Button.astro';
import { site, yearsInBusiness } from '../../data/site';
import { credentials } from '../../data/content';
import { contactHref } from '../../lib/cta';

// Two quieter routes under the one red action (rule 7: one red-filled button per screen)
const routes = [
  {
    href: '/plan/',
    title: 'Planning a project?',
    detail: 'Still figuring it out. Get the checklist and a rough estimate.',
  },
  {
    href: contactHref({ intent: 'support' }),
    title: 'Something’s broken?',
    detail: 'Existing customer with a problem or a change.',
  },
];
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__copy">
    <!-- CSS-only entrance (no data-split): the LCP headline must never wait on a JS download -->
    <h1 id="hero-title" class="t-display hero__title">Built for the future.</h1>
    <!-- hero-in = the same fade/rise as [data-reveal], but CSS-only so the hero paints on first
         render instead of waiting for motion.ts to download and boot -->
    <p class="t-lead hero-in">
      {yearsInBusiness} years designing, installing and certifying the cabling, networks and security
      systems Southern California businesses run on.
    </p>
    <div class="hero__choose hero-in" style="--reveal-delay: 120ms">
      <div data-dock-start>
        <Button href={contactHref()} size="lg">Request a site assessment</Button>
      </div>
      <ul role="list" class="hero__routes">
        {routes.map((r) => (
          <li>
            <a class="route" href={r.href}>
              <span class="route__title">{r.title}</span>
              <span class="route__detail">{r.detail}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="t-small hero__phone">Or call <a class="tel" href={site.phoneHref}>{site.phone}</a>, {site.hours.replace(' · ', ', ')}</p>
    </div>
    <ul role="list" class="t-small hero__creds hero-in" style="--reveal-delay: 220ms">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <div class="hero__media hero-in" style="--reveal-delay: 150ms">
    <CableTest variant="compact" class="hero__card" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-block) var(--col-gap);
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-bottom: var(--space-section);
  }

  .hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .hero__title {
    max-width: 14ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title {
      animation: hero-title-in 1.1s var(--ease-out) both;
    }
  }

  /* Same values as the global [data-reveal] transition (opacity + 24px rise, --dur-slow, --ease-out) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in var(--dur-slow) var(--ease-out) var(--reveal-delay, 0ms) both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-title-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.35em, 0);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: none;
      clip-path: inset(0 0 -20% 0);
    }
  }

  .hero__choose {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 36rem;
  }

  /* Two plain rows, hairline-separated like a schedule (rule 5) */
  .hero__routes {
    border-top: 1px solid var(--hairline);
  }

  .hero__routes li {
    border-bottom: 1px solid var(--hairline);
  }

  .route {
    display: grid;
    gap: 0.25rem;
    min-height: 44px;
    padding-block: 0.875rem;
  }

  .route__title {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    transition: color var(--dur-fast) ease;
  }

  .route:hover .route__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .route__detail {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--text);
  }

  .hero__phone {
    color: var(--text);
  }

  .hero__phone a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero__creds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    color: var(--steel);
  }

  .hero__creds li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
  }

  /* 4px steel square between items */
  .hero__creds li + li::before {
    content: '';
    width: 4px;
    height: 4px;
    background: var(--steel);
    flex: none;
  }

  /* The cable test is the hero's visual: full column width, white surface */
  .hero__media {
    display: grid;
  }

  .hero__media :global(.hero__card) {
    width: 100%;
    max-width: none;
    background: var(--white);
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 7fr 5fr;
      grid-template-rows: 1fr;
      align-items: start;
      padding-bottom: var(--space-block);
      min-height: calc(100svh - var(--header-h));
    }

    /* Two lines on desktop: the display size is capped so the sentence breaks once */
    .hero__title {
      max-width: 20ch;
      font-size: clamp(2.75rem, 1rem + 4.2vw, 4.25rem);
    }

    .hero__media {
      grid-template-rows: 1fr;
    }

    .hero__media :global(.hero__card) {
      align-content: space-between;
    }
  }
</style>
