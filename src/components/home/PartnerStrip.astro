---
/**
 * "Brands we install and support": a wrapping row of wordmarks (never a marquee, nothing scrolls sideways).
 * The logos arrive once in a calm stagger the first time the row is seen; armed only by the script, so
 * without JS or under reduced motion they are simply there.
 */
import { Image } from 'astro:assets';
import { partners } from '../../data/content';

/** Optical sizing: wide wordmarks get shorter so every logo carries similar visual weight. */
const heightFor = (w: number, h: number) => {
  const aspect = w / h;
  return Math.round(Math.min(44, Math.max(18, 58 / Math.sqrt(aspect))));
};
---

<section class="partners" aria-labelledby="partners-title">
  <div class="container">
    <p id="partners-title" class="t-meta partners__line">Brands we install and support.</p>
    <ul role="list" class="partners__row" data-partners>
      {partners.map((p, i) => {
        const h = heightFor(p.logo.width, p.logo.height);
        return (
          <li style={`--i: ${i}`}>
            <Image
              src={p.logo}
              alt={p.name}
              height={h}
              width={Math.round((p.logo.width / p.logo.height) * h)}
              densities={[1, 2]}
              loading="lazy"
            />
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  import { onFirstView, prefersReducedMotion } from '../../scripts/demo';

  document.querySelectorAll<HTMLElement>('[data-partners]').forEach((row) => {
    if (prefersReducedMotion()) return;
    row.classList.add('is-armed');
    onFirstView(row, () => row.classList.add('is-shown'), 0.3);
  });
</script>

<style>
  .partners {
    padding-block: var(--space-block);
  }

  .partners__line {
    margin-bottom: var(--sp-5);
  }

  .partners__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-6) var(--sp-7);
  }

  .partners__row img {
    height: 26px;
    width: auto;
    opacity: 0.78;
    transition: opacity var(--dur) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .partners__row li:hover img {
      opacity: 1;
    }
  }

  /* Arrival, once: each wordmark rises and fades in 45 ms after the one before (armed by the script) */
  .partners__row.is-armed li {
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }

  .partners__row.is-armed.is-shown li {
    opacity: 1;
    transform: none;
    transition:
      opacity 520ms ease calc(var(--i) * 45ms),
      transform 760ms var(--ease-out) calc(var(--i) * 45ms);
  }
  /* Paper never waits on a scroll: printed before the row scrolled into view, it still prints finished */
  @media print {
    .partners__row.is-armed li {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
