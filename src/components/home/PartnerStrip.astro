---
import { Image } from 'astro:assets';
import { partners } from '../../data/content';

/** Every logo is drawn at one visual height (DESIGN.md rule 5: a schedule of equal cells). */
const LOGO_H = 32;
---

<section class="partners" aria-labelledby="partners-title">
  <div class="container">
    <h2 id="partners-title" class="t-h3 partners__title">Brands we install and support.</h2>
    <ul role="list" class="partners__grid">
      {partners.map((p) => (
        <li class="partners__item">
          <Image
            src={p.logo}
            alt={p.name}
            height={LOGO_H}
            width={Math.round((p.logo.width / p.logo.height) * LOGO_H)}
            densities={[1, 2]}
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Paper ground: the hero's report sheet hangs into the top right of this section,
     so the heading sits at the left beside it and the logos run below at a readable size. */
  .partners {
    padding-top: calc(var(--hero-overhang, 0px) + var(--sp-7));
    padding-bottom: var(--sp-6);
  }

  .partners__title {
    max-width: 18ch;
    margin-bottom: var(--sp-7);
    font-size: var(--fs-h2);
  }

  .partners__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-2);
  }

  .partners__item {
    display: grid;
    place-items: center;
    min-height: 72px;
    padding: 1.25rem;
  }

  .partners__item img {
    width: auto;
    height: 28px;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.8;
    transition: opacity var(--dur) ease;
  }

  .partners__item:hover img {
    opacity: 1;
  }

  @media (min-width: 640px) {
    .partners__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .partners {
      /* the sheet hangs over the right half only, so the heading rises beside it */
      padding-top: var(--sp-8);
    }

    .partners__title {
      max-width: 18ch;
      font-size: var(--fs-h1);
      margin-bottom: clamp(3rem, 1rem + 4vw, 6rem);
    }

    .partners__grid {
      grid-template-columns: repeat(7, 1fr);
    }

    .partners__item {
      min-height: 120px;
    }
  }
</style>
