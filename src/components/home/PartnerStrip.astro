---
import { Image } from 'astro:assets';
import { partners } from '../../data/content';

/** Every logo is drawn at one visual height (DESIGN.md rule 5: a schedule of equal cells). */
const LOGO_H = 32;
---

<section class="partners" aria-labelledby="partners-title">
  <div class="container">
    <h2 id="partners-title" class="t-h3 partners__title">Brands we install and support.</h2>
    <ul role="list" class="partners__grid">
      {partners.map((p) => (
        <li class="partners__item">
          <Image
            src={p.logo}
            alt={p.name}
            height={LOGO_H}
            width={Math.round((p.logo.width / p.logo.height) * LOGO_H)}
            densities={[1, 2]}
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners {
    padding-block: var(--space-block);
    background: var(--white);
  }

  .partners__title {
    margin-bottom: var(--sp-6);
  }

  .partners__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /* hairlines only between rows: every cell has a top line, the first row's is clipped off */
    clip-path: inset(1px 0 0 0);
  }

  .partners__item {
    display: grid;
    place-items: center;
    min-height: 104px;
    padding: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .partners__item img {
    width: auto;
    height: 32px;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1) contrast(0.9);
    opacity: 0.7;
    transition: opacity var(--dur) ease;
  }

  .partners__item:hover img {
    opacity: 1;
  }

  @media (min-width: 640px) {
    .partners__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .partners__grid {
      grid-template-columns: repeat(7, 1fr);
    }
  }
</style>
